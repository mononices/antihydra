import struct
f=open('../ctf_files/finderskeepers.mp4','rb').read()
print(len(f))
def walk(data, off, end, depth=0):
    while off < end-8:
        size, typ = struct.unpack('>I4s', data[off:off+8])
        typ=typ.decode('latin1')
        hdr=8
        if size==1:
            size=struct.unpack('>Q',data[off+8:off+16])[0]; hdr=16
        elif size==0:
            size=end-off
        print('  '*depth, typ, size, 'at', off)
        if typ in ('moov','trak','mdia','minf','stbl','edts','dinf','udta','ilst','mvex','moof','traf'):
            walk(data, off+hdr, off+size, depth+1)
        off+=size
walk(f,0,len(f))
EOF
