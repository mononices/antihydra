    d=np.frombuffer(buf,dtype=np.uint8).reshape(H,W,3).astype(np.float32)
    if acc is None:
        acc=d.copy(); acc2=(d*d); 
    else:
        acc+=d; acc2+=d*d
    n+=1
mean=acc/n
var=acc2/n-mean*mean
std=np.sqrt(np.clip(var,0,None)).mean(axis=2)
np.save('std_full.npy',std)
a=(std/std.max()*255).astype(np.uint8)
Image.fromarray(a).save('std_full.png')
