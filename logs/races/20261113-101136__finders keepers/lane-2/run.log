import numpy as np, subprocess, json
from scipy import ndimage
W,H=1920,1080
base=[(233,169,172),(150,192,210),(169,195,172),(153,205,180),(230,177,176),(193,175,195),(207,169,230),(163,199,229)]
base=np.array(base,dtype=np.int16)
p=subprocess.Popen(['ffmpeg','-v','error','-i','../ctf_files/finderskeepers.mp4','-pix_fmt','rgb24','-f','rawvideo','-'],stdout=subprocess.PIPE)
allf=[]
i=0
while True:
    buf=p.stdout.read(W*H*3)
    if len(buf)<W*H*3: break
    d=np.frombuffer(buf,dtype=np.uint8).reshape(H,W,3).astype(np.int16)
    res={}
    for k,b in enumerate(base):
        dist=np.abs(d-b).sum(axis=2)
        mask=dist<25
        lab,n=ndimage.label(mask)
        comps=[]
        for j in range(1,n+1):
            m=lab==j
            a=m.sum()
            if a<3000: continue
            ys,xs=np.nonzero(m)
            comps.append(dict(area=int(a),cx=float(xs.mean()),cy=float(ys.mean()),
                              x0=int(xs.min()),x1=int(xs.max()),y0=int(ys.min()),y1=int(ys.max())))
        res[k]=comps
    allf.append(res)
    i+=1
json.dump(allf,open('track.json','w'))
print('frames',len(allf))
for k in range(8):
    print(k, base[k], [len(f[str(k)]) for f in allf[:10]])
EOF
