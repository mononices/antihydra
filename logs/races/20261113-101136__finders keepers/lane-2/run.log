[21] run_command cd /home/ctfplayer/workspace && cat > detect.py <<'EOF'
import numpy as np, subprocess, json, sys
from scipy import ndimage
W,H=1920,1080
p=subprocess.Popen(['ffmpeg','-v','error','-i','../ctf_files/finderskeepers.mp4','-pix_fmt','rgb24','-f','rawvideo','-'],stdout=subprocess.PIPE)
frames=[]
i=0
while True:
    buf=p.stdout.read(W*H*3)
    if len(buf)<W*H*3: break
    d=np.frombuffer(buf,dtype=np.uint8).reshape(H,W,3).astype(np.int16)
    bg=np.array([13,12,17])
    mask=(np.abs(d-bg).sum(axis=2)>40)
    lab,n=ndimage.label(mask)
    objs=ndimage.find_objects(lab)
    out=[]
    for j,sl in enumerate(objs):
        ys,xs=sl
        m=lab[sl]==j+1
        a=m.sum()
        if a<500: continue
        px=d[sl][m]
        med=tuple(int(v) for v in np.median(px,axis=0))
        out.append(dict(x=int(xs.start),y=int(ys.start),w=int(xs.stop-xs.start),h=int(ys.stop-ys.start),area=int(a),c=med))
    frames.append(out)
    i+=1
    if i%50==0: print(i,file=sys.stderr)
json.dump(frames,open('rects.json','w'))
print('frames',len(frames))
EOF
