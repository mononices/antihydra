import numpy as np, subprocess, json
from scipy import ndimage
W,H=1920,1080
p=subprocess.Popen(['ffmpeg','-v','error','-i','../ctf_files/finderskeepers.mp4','-pix_fmt','rgb24','-f','rawvideo','-'],stdout=subprocess.PIPE)
res=[]
i=0
while True:
    buf=p.stdout.read(W*H*3)
    if len(buf)<W*H*3: break
    d=np.frombuffer(buf,dtype=np.uint8).reshape(H,W,3).astype(np.int16)
    mx=d.max(axis=2); mn=d.min(axis=2); mean=d.mean(axis=2)
    sat=mx-mn
    bright=mean>140
    bd=ndimage.binary_dilation(bright,iterations=4)
    mask=(sat<50)&(mean>25)&(mean<150)&(~bd)
    lab,n=ndimage.label(mask, structure=np.ones((3,3)))
    boxes=[]
    for j in range(1,n+1):
        m=lab==j
        a=int(m.sum())
        if a<25: continue
        ys,xs=np.nonzero(m)
        boxes.append([int(xs.min()),int(ys.min()),int(xs.max()),int(ys.max()),a])
    res.append(boxes)
    i+=1
json.dump(res,open('textboxes2.json','w'))
print('frames',len(res))
for i in range(180,300,5):
    print(i,res[i][:8])
