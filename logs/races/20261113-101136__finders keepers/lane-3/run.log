from scipy import ndimage
n,h,w=300,1080,1920
proc=subprocess.Popen(['ffmpeg','-v','error','-i','/home/ctfplayer/ctf_files/finderskeepers.mp4','-f','rawvideo','-pix_fmt','gray','-'],stdout=subprocess.PIPE)
