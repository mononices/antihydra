    masks.append(m)
# cross-correlate consecutive masks to find shift
def shift_est(a,b):
    # search small range
    best=None;bv=-1
    for dy in range(-6,7):
        for dx in range(-6,7):
            bb=np.roll(np.roll(b,dy,axis=0),dx,axis=1)
            v=(a&bb).sum()
            if v>bv: bv=v;best=(dx,dy)
    return best,bv
sh=[]
for k in range(len(masks)-1):
    s,v=shift_est(masks[k],masks[k+1])
    sh.append(s)
import collections
print(collections.Counter(sh).most_common(10))
