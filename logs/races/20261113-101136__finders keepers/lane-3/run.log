import numpy as np
f=np.load('frames_rgb.npy').astype(np.float32)
n=300
g=f.mean(axis=3)
# column profile per frame (sum over x) -> 1D signal to estimate vertical shift
prof=g.sum(axis=2)  # (n, h)
# cross-correlate consecutive frames to find vertical shift
from numpy.fft import rfft, irfft
shifts=[]
for i in range(1,n):
    a=prof[i-1]-prof[i-1].mean()
    b=prof[i]-prof[i].mean()
    c=irfft(rfft(a,len(a)*2)*np.conj(rfft(b,len(b)*2)))
    s=np.argmax(c)
    if s>len(a): s-=2*len(a)
    shifts.append(s)
print(shifts[:40])
print('unique', sorted(set(shifts)))
EOF
