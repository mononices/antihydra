        ys,xs=sl
        hh=ys.stop-ys.start; ww=xs.stop-xs.start
        size=(lab[sl]==j+1).sum()
        if size<2000: continue
        cy=(ys.start+ys.stop)/2; cx=(xs.start+xs.stop)/2
        # get color at center
        col=f[i,int(cy),int(cx)]
        rects.append((round(cx,1),round(cy,1),ww,hh,tuple(int(c) for c in col),int(size)))
    res.append(rects)
    if i<3: print(i, len(rects), rects[:6])
json.dump(res, open('rects.json','w'))
