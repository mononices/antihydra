rows=['1234567890-=','qwertyuiop[]','asdfghjkl;\'','zxcvbnm,./']
def shift(s,dir):
    out=[]
    for c in s:
        for r in rows:
            if c in r:
                i=r.index(c)+dir
                if 0<=i<len(r): out.append(r[i])
                else: out.append(c)
                break
        else: out.append(c)
    return ''.join(out)
