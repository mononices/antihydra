prev=None
shifts=[]
for i in range(190,300):
    d=mm[i].astype(np.int16)-med
    m=((d>10)&(mm[i]<110))
    if i>190:
        # estimate shift vs prev
        best=None;bv=-1
        for dy in range(-4,5):
            for dx in range(-4,5):
                bb=np.roll(np.roll(m,dy,axis=0),dx,axis=1)
                v=(prev&bb).sum()
                if v>bv: bv=v;best=(dx,dy)
        shifts.append(best)
        xoff+= best[0]; yoff=best[1]
    else:
        xoff=200; yoff=0
    ys,xs=np.nonzero(m)
    if len(xs)==0: 
        prev=m; continue
    xs2=xs+xoff
    ok=(xs2>=0)&(xs2<CW)
    acc[ys[ok],xs2[ok]]+=mm[i][ys[ok],xs[ok]]
    cnt[ys[ok],xs2[ok]]+=1
    prev=m
print('shift sum', sum(s[0] for s in shifts), 'yrange', min(s[1] for s in shifts), max(s[1] for s in shifts))
img=np.where(cnt>0, np.clip((acc/np.maximum(cnt,1)-14)*8,0,255),0).astype(np.uint8)
np.save('pano.npy',img)
from PIL import Image
