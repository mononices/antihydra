import numpy as np
from scipy import ndimage
mm=np.load('gray300.npy', mmap_mode='r')
med=np.load('median.npy').astype(np.int16)
i=240
d=mm[i].astype(np.int16)-med
m=((d>8)&(mm[i]<110))
# remove big blobs (rect edges): keep only small components
lab,nl=ndimage.label(m,structure=np.ones((3,3)))
sizes=ndimage.sum(m,lab,range(1,nl+1))
keep=np.zeros_like(m)
for j in range(nl):
    if 20<=sizes[j]<=400:
        o=ndimage.find_objects(lab==j+1)[0]
        hh=o[0].stop-o[0].start; ww=o[1].stop-o[1].start
        if hh<=70 and ww<=70:
            keep|=(lab==j+1)
print('kept',keep.sum())
# try rotations, measure row-profile sharpness
best=None
for ang in np.arange(20,70,2):
    r=ndimage.rotate(keep.astype(np.uint8)*255, -ang, reshape=True, order=1)
    prof=(r>100).sum(axis=1).astype(float)
    if prof.max()==0: continue
    sharp=(prof**2).sum()/ (prof.sum()**2+1e-9) * len(prof)
    if best is None or sharp>best[0]: best=(sharp,ang)
    print(ang, round(sharp,4))
print('best', best)
