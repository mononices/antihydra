# Track blob trajectories across frames 190-300 using nearest neighbor
import json, numpy as np
out=json.load(open('glyphs.json'))
# collect blobs per frame with size>20
tracks=[]
active=[]  # list of (last_frame, x, y, track_id)
tid=0
for i in range(190,300):
    blobs=[(x,y,s) for (x,y,s) in out[i] if s>20]
    used=set()
    for (x,y,s) in blobs:
        best=None;bd=1e9
        for k,(lf,lx,ly,ti) in enumerate(active):
            if lf<i-3: continue
            d=((x-lx)**2+(y-ly)**2)**.5
            if d<bd and d<15 and k not in used:
                bd=d;best=k
        if best is not None:
            used.add(best)
            lf,lx,ly,ti=active[best]
            active[best]=(i,x,y,ti)
            tracks.append((ti,i,x,y))
        else:
            active.append((i,x,y,tid))
            tracks.append((tid,i,x,y))
            tid+=1
# print long tracks
from collections import defaultdict
tr=defaultdict(list)
for ti,i,x,y in tracks: tr[ti].append((i,x,y))
for ti,pts in sorted(tr.items(), key=lambda kv:-len(kv[1])):
    if len(pts)>=8:
        print('track',ti,'len',len(pts),pts[:3],'...',pts[-3:])
