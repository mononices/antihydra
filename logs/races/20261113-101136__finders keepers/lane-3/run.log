import numpy as np, subprocess
from PIL import Image
n,h,w=300,1080,1920
proc=subprocess.Popen(['ffmpeg','-v','error','-i','/home/ctfplayer/ctf_files/finderskeepers.mp4','-f','rawvideo','-pix_fmt','gray','-'],stdout=subprocess.PIPE)
fsz=h*w
info=[]
for i in range(n):
    buf=proc.stdout.read(fsz)
    fr=np.frombuffer(buf,dtype=np.uint8).reshape(h,w)
    m=(fr>20)&(fr<100)
    if m.sum()>30:
        ys,xs=np.nonzero(m)
        cx,cy=xs.mean(),ys.mean()
        # PCA
        X=np.stack([xs-cx,ys-cy])
        cov=X@X.T/len(xs)
        ev,evec=np.linalg.eigh(cov)
        v=evec[:,-1]
        ang=np.degrees(np.arctan2(v[1],v[0]))
        info.append((i,int(cx),int(cy),round(ang,1),int(m.sum())))
proc.stdout.close(); proc.wait()
for t in info[:60]: print(t)
print('...')
print('total frames with faint text:',len(info))
