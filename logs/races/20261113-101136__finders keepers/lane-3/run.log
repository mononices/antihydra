import numpy as np, subprocess
# Read gray frames in chunks to limit memory
n,h,w=300,1080,1920
acc=np.zeros((h,w),dtype=np.float32)
cnt=np.zeros((h,w),dtype=np.float32)
proc=subprocess.Popen(['ffmpeg','-v','error','-i','/home/ctfplayer/ctf_files/finderskeepers.mp4','-f','rawvideo','-pix_fmt','gray','-'],stdout=subprocess.PIPE)
fsz=h*w
for i in range(n):
    buf=proc.stdout.read(fsz)
    fr=np.frombuffer(buf,dtype=np.uint8).reshape(h,w).astype(np.float32)
    # faint text: gray values between 18 and 90 (bg ~14, rects >100)
    m=(fr>18)&(fr<95)
    acc+=np.where(m,fr,0)
    cnt+=m
proc.stdout.close(); proc.wait()
np.save('acc.npy',acc); np.save('cnt.npy',cnt)
print('done', acc.max(), cnt.max())
