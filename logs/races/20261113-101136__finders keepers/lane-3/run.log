import struct
data=open('/home/ctfplayer/ctf_files/finderskeepers.mp4','rb').read()
def parse(start,end,depth=0):
    i=start
    while i < end-8:
        size=struct.unpack('>I',data[i:i+4])[0]
        typ=data[i+4:i+8]
        if size==0: size=end-i
        if size==1:
            size=struct.unpack('>Q',data[i+8:i+16])[0]
            hdr=16
        else:
            hdr=8
        print('  '*depth, i, size, typ)
        if typ in (b'moov',b'trak',b'mdia',b'minf',b'stbl',b'udta',b'meta',b'ilst'):
            sub = i+hdr
            if typ==b'meta': sub += 4
            parse(sub, i+size, depth+1)
        i+=size
parse(40, 40+4429)
