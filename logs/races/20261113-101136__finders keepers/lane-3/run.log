    sizes=ndimage.sum(m,lab,range(1,nl+1))
    keep=np.zeros((H,W),bool)
    for j in range(nl):
        if 15<=sizes[j]<=500:
            o=ndimage.find_objects(lab==j+1)[0]
            hh=o[0].stop-o[0].start; ww=o[1].stop-o[1].start
            if hh<=75 and ww<=75:
                keep|=(lab==j+1)
    masks[i]=keep
    if i%20==0: print(i, keep.sum())
np.save('masks.npy', np.array([masks[i] for i in range(185,300)]))
print('done')
