s='esnp{d0c_@yz@gl_mn0j_pm3z3_g0_o00s}'
# caesar shifts
import string
for k in range(26):
    out=''
    for ch in s:
        if ch.isalpha():
            base=ord('A') if ch.isupper() else ord('a')
            out+=chr((ord(ch)-base+k)%26+base)
        else: out+=ch
    if 'flag' in out or 'ctf' in out: print(k,out)
print('---atbash---')
def atb(ch):
    if ch.isalpha():
        base=ord('A') if ch.isupper() else ord('a')
        return chr(base+25-(ord(ch)-base))
    return ch
print(''.join(atb(c) for c in s))
"

