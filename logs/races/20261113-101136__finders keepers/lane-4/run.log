[13] create_file {"content": "import numpy as np, glob\nfrom PIL import Image\nfiles = sorted(glob.glob('/home/ctfplayer/workspace/frames/*.png'))\n# accumulate mean and std incrementally using float32\nacc = None; acc2 = None\nfor f in files:\n    a = np.asarray(Image.open(f).convert('RGB')).astype(np.float32)\n    if acc is None:\n        acc = np.zeros_like(a); acc2 = np.zeros_like(a)\n    acc += a; acc2 += a*a\nn = len(files)\nmean = acc/n\nstd = np.sqrt(np.maximum(acc2/n - mean*mean, 0))\nbg = np.array([13,12,17], np.float32)\n# static pixels: low std, mean differs from background\nstatic = (std < 3) & (np.abs(mean - bg).max(axis=2) > 6)\nprint('static px:', static.sum())\nys, xs = np.nonzero(static)\nif len(xs):\n    print('bbox', xs.min(), xs.max(), ys.min(), ys.max())\n# render mask\nimg = np.zeros(mean.shape, np.uint8)\nimg[static] = np.clip(mean[static], 0, 255).astype(np.uint8)\nImage.fromarray(img).save('/home/ctfplayer/workspace/static_mask.png')\n# stretched version\na = mean.copy()\na = (a - 8) / (220-8) * 255\na = np.clip(a, 0, 255)\n# also zero out everywhere std>3 to highlight static structure\na2 = a.copy()\na2[~static] = 0\nImage.fromarray(a2.astype(np.uint8)).save('/home/ctfplayer/workspace/static_only.png')\nnp.save('/home/ctfplayer/workspace/mean.npy', mean)\nnp.save('/home/ctfplayer/workspace/std.npy', std)\nprint('done')\n", "path": "/home/ctfplayer/workspace/an2.py"}
