[35] create_file {"path": "/home/ctfplayer/workspace/minunion.py", "content": "import numpy as np\nfrom PIL import Image\nimport glob\n\nfiles = sorted(glob.glob('/home/ctfplayer/workspace/frames200/g_*.png'))\nH, W = 1080, 1920\n# per-pixel min across frames (darkness union) restricted to dark-bg pixels\nmn = np.full((H, W), 255, dtype=np.uint8)\nfor f in files:\n    a = np.asarray(Image.open(f).convert('RGB'), dtype=np.uint8)\n    mn = np.minimum(mn, a.max(axis=2))\n# mask: only where median bg is dark (black area)\nmed = np.asarray(Image.open('/home/ctfplayer/workspace/median_bg.png').convert('L'), dtype=np.uint8)\ndarkbg = med < 60\nout = np.where(darkbg, mn, 255).astype(np.uint8)\n# text = pixels darker than 10\ntextmask = ((out < 10) & darkbg).astype(np.uint8) * 255\nImage.fromarray(textmask).save('/home/ctfplayer/workspace/text_union.png')\nys, xs = np.nonzero(textmask)\nprint('text pixels:', len(xs))\nif len(xs):\n    print('bbox', xs.min(), xs.max(), ys.min(), ys.max())\n# save contrast-boosted view\nview = ((out.astype(np.int16) - 0) * 8).clip(0, 255).astype(np.uint8)\nview[~darkbg] = 255\nImage.fromarray(view).save('/home/ctfplayer/workspace/min_view.png')\n"}
