[45] create_file {"path": "/home/ctfplayer/workspace/map_union.py", "content": "import numpy as np\nfrom PIL import Image\nimport glob\nfrom scipy import ndimage\n\nfiles = sorted(glob.glob('/home/ctfplayer/workspace/frames200/g_*.png'))\nH, W = 1080, 1920\n\n# exclude moving-streak body rows (streak mask: rows 1060-1080 when count spikes)\nexcl_rows = set()\ncounts = []\nfor f in files:\n    a = np.asarray(Image.open(f).convert('RGB'), dtype=np.int16)\n    mx = a.max(axis=2)\n    m = (mx < 10)\n    counts.append(int(m.sum()))\n\ncounts = np.array(counts)\nprint('count stats', counts.min(), counts.max())\n\n# frames with count ~1000: streak present. streak body rows: identify rows with >30 dark px\nstreak_rows = np.zeros(H, dtype=bool)\nfor f, c in zip(files, counts):\n    if c > 700:\n        a = np.asarray(Image.open(f).convert('RGB'), dtype=np.int16)\n        m = (a.max(axis=2) < 10)\n        rowsum = m.sum(axis=1)\n        rr = np.nonzero(rowsum > 20)[0]\n        for r in rr:\n            streak_rows[r] = True\nprint('streak rows:', np.nonzero(streak_rows)[0][:50], '...', np.nonzero(streak_rows)[0][-10:])\n\nacc_col = np.zeros((H, W, 3), dtype=np.uint8)\nall_glyphs = []  # (frame, y0,y1,x0,x1, size)\nfor i, f in enumerate(files):\n    a = np.asarray(Image.open(f).convert('RGB'), dtype=np.int16)\n    mx = a.max(axis=2)\n    m = (mx < 10) & (~streak_rows[:, None])\n    if m.sum() < 5:\n        continue\n    lab, n = ndimage.label(m)\n    objs = ndimage.find_objects(lab)\n    sizes = ndimage.sum(m, lab, range(1, n + 1))\n    color = plt_color = (i * 7 % 256, 255 - (i * 5 % 256), (i * 11 % 256))\n    for j, sl in enumerate(objs):\n        if sizes[j] < 12 or sizes[j] > 400:\n            continue\n        h = sl[0].stop - sl[0].start\n        w = sl[1].stop - sl[1].start\n        if h > 40 or w > 40:\n            continue\n        ys, xs = np.nonzero(lab[sl] == j + 1)\n        yy = ys + sl[0].start\n        xx = xs + sl[1].start\n        acc_col[yy, xx] = color\n        all_glyphs.append((i + 195, sl[0].start, sl[0].stop, sl[1].start, sl[1].stop, int(sizes[j])))\n\nImage.fromarray(acc_col).save('/home/ctfplayer/workspace/union_colored.png')\nimport json\njson.dump(all_glyphs, open('/home/ctfplayer/workspace/glyphs.json', 'w'))\nprint('glyph records:', len(all_glyphs))\n"}
