[48] create_file {"path": "/home/ctfplayer/workspace/crops_ocr.py", "content": "import numpy as np\nfrom PIL import Image\nimport glob, os, subprocess\n\nfiles = sorted(glob.glob('/home/ctfplayer/workspace/frames200/g_*.png'))\nos.makedirs('/home/ctfplayer/workspace/ocr_crops', exist_ok=True)\n\ndef prep(mask, y0, y1, x0, x1, name, scale=5):\n    sub = mask[y0:y1, x0:x1]\n    if sub.sum() < 10:\n        return None\n    img = np.full(sub.shape, 255, dtype=np.uint8)\n    img[sub] = 0\n    im = Image.fromarray(img).resize((sub.shape[1] * scale, sub.shape[0] * scale), Image.LANCZOS)\n    p = f'/home/ctfplayer/workspace/ocr_crops/{name}.png'\n    im.save(p)\n    return p\n\nresults = {}\nfor i, f in enumerate(files):\n    a = np.asarray(Image.open(f).convert('RGB'), dtype=np.int16)\n    mx = a.max(axis=2)\n    m = (mx < 10)\n    # block1 region and block2 region\n    for bi, (yy0, yy1, xx0, xx1) in enumerate([(0, 190, 820, 1080), (130, 320, 980, 1220)]):\n        sub = m[yy0:yy1, xx0:xx1]\n        if sub.sum() < 15:\n            continue\n        p = prep(m, yy0, yy1, xx0, xx1, f'b{bi}_f{i+195}')\n        if p:\n            try:\n                out = subprocess.run(['tesseract', p, 'stdout', '--psm', '7'],\n                                     capture_output=True, text=True, timeout=30)\n                txt = out.stdout.strip().replace('\\n', ' | ')\n            except Exception as e:\n                txt = f'ERR {e}'\n            results.setdefault(bi, []).append((i + 195, int(sub.sum()), txt))\n\nfor bi, lst in results.items():\n    print(f'===== block {bi} =====')\n    for fr, cnt, txt in lst:\n        print(fr, cnt, repr(txt))\n"}
