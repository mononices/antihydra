[07] create_file {"content": "import numpy as np\nfrom PIL import Image\nimport glob, os\n\nfiles = sorted(glob.glob('/home/ctfplayer/workspace/allframes/f_*.png'))\nprint(len(files), 'frames')\n\nacc_max = None\nacc_sum = None\nacc_min = None\nchunk = 50\nfor i in range(0, len(files), chunk):\n    batch = np.stack([np.asarray(Image.open(f).convert('RGB'), dtype=np.uint8) for f in files[i:i+chunk]])\n    if acc_max is None:\n        acc_max = batch.max(axis=0).astype(np.uint8)\n        acc_sum = batch.astype(np.uint64).sum(axis=0)\n        acc_min = batch.min(axis=0).astype(np.uint8)\n    else:\n        acc_max = np.maximum(acc_max, batch.max(axis=0))\n        acc_sum += batch.astype(np.uint64).sum(axis=0)\n        acc_min = np.minimum(acc_min, batch.min(axis=0))\n    print('processed', i + len(batch))\n\navg = (acc_sum / len(files)).astype(np.uint8)\nImage.fromarray(avg).save('/home/ctfplayer/workspace/avg.png')\nImage.fromarray(acc_max).save('/home/ctfplayer/workspace/max.png')\nImage.fromarray(acc_min).save('/home/ctfplayer/workspace/min.png')\nprint('done')\n", "path": "/home/ctfplayer/workspace/composite.py"}
