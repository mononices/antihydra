[32] create_file {"path": "/home/ctfplayer/workspace/textextract.py", "content": "import numpy as np\nfrom PIL import Image\nimport glob, os\n\nfiles = sorted(glob.glob('/home/ctfplayer/workspace/frames200/g_*.png'))\nsel = files  # 105 frames, 195-299\nH, W = 1080, 1920\n\n# temporal median background using row chunks\nmed = np.zeros((H, W, 3), dtype=np.uint8)\nblock = 60\nfor y0 in range(0, H, block):\n    stack = np.stack([np.asarray(Image.open(f).convert('RGB'), dtype=np.uint8)[y0:y0+block] for f in sel])\n    med[y0:y0+block] = np.median(stack, axis=0).astype(np.uint8)\nImage.fromarray(med).save('/home/ctfplayer/workspace/median_bg.png')\nprint('median bg saved')\n\n# text mask per frame: pixels significantly darker than median bg\noutdir = '/home/ctfplayer/workspace/textmask'\nos.makedirs(outdir, exist_ok=True)\nacc = np.zeros((H, W), dtype=np.uint32)\nfor i, f in enumerate(sel):\n    a = np.asarray(Image.open(f).convert('RGB'), dtype=np.int16)\n    diff = med.astype(np.int16) - a  # positive where darker\n    m = (diff.max(axis=2) > 4) & (med.max(axis=2) < 60)  # only where bg is dark\n    acc += m.astype(np.uint32)\n    out = np.zeros((H, W), dtype=np.uint8)\n    out[m] = 255\n    Image.fromarray(out).save(f'{outdir}/m_{i:03d}.png')\nImage.fromarray(np.clip(acc * 2, 0, 255).astype(np.uint8)).save('/home/ctfplayer/workspace/text_acc.png')\nprint('done, acc max', acc.max())\n"}
