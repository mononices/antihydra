[43] create_file {"path": "/home/ctfplayer/workspace/analyze_masks.py", "content": "import numpy as np\nfrom PIL import Image\nimport glob\nfrom scipy import ndimage\n\nfiles = sorted(glob.glob('/home/ctfplayer/workspace/frames200/g_*.png'))\nfor i in [5, 10, 20, 30, 45, 60, 75, 90, 104]:\n    a = np.asarray(Image.open(files[i]).convert('RGB'), dtype=np.int16)\n    mx = a.max(axis=2)\n    m = (mx < 10)\n    lab, n = ndimage.label(m)\n    objs = ndimage.find_objects(lab)\n    sizes = ndimage.sum(m, lab, range(1, n + 1))\n    info = []\n    for j, sl in enumerate(objs):\n        if sizes[j] < 8:\n            continue\n        h = sl[0].stop - sl[0].start\n        w = sl[1].stop - sl[1].start\n        info.append((int(sizes[j]), sl[0].start, sl[0].stop, sl[1].start, sl[1].stop, h, w))\n    print('=== frame', i + 195, 'clusters:', len(info))\n    for t in info:\n        print(t)\n"}
