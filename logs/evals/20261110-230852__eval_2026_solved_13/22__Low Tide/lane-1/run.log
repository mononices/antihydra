]\nfor v in variants:\n    for h in (\"md5\", \"sha1\", \"sha256\"):\n        d = hashlib.new(h, v.encode()).hexdigest()\n        if d.startswith(sid[:8]) or sid in d:\n            print(\"MATCH:\", h, v, d)\nprint(\"no match found\" if not any(True for _ in ()) else \"\")\n"}
