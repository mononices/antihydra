import requests, time, json
UA={'User-Agent':'StationSync-Agent/2.1'}
BASE="http://low-tide-lb.ctf.csaw.io:8080"
_last=[0.0]
def post(path, data=None, headers=None, sleep=1.6, **kw):
    dt=time.time()-_last[0]
    if dt<sleep: time.sleep(sleep-dt)
    h=dict(UA); h.update(headers or {})
    r=requests.post(BASE+path, data=data, headers=h, timeout=8, **kw)
    _last[0]=time.time()
    return r
def get(path, headers=None, sleep=1.6, **kw):
    dt=time.time()-_last[0]
    if dt<sleep: time.sleep(sleep-dt)
    h=dict(UA); h.update(headers or {})
    r=requests.get(BASE+path, headers=h, timeout=8, **kw)
    _last[0]=time.time()
    return r
EOF
