import socket, concurrent.futures
def check(ip, port=5000):
    s=socket.socket(); s.settimeout(0.7)
    try:
        s.connect((ip,port)); s.close(); return ip
    except Exception: return None
ips=[f"172.18.0.{i}" for i in range(1,255)]
