import urllib.request, urllib.parse, urllib.error, json, re
base='http://low-tide-lb.ctf.csaw.io:8080/station/checkin'
UA='StationSync-Agent/2.1'
def req(data=None, cookie=None, ua=UA, method='POST'):
    headers={'User-Agent':ua}
    if cookie: headers['Cookie']=cookie
    body=urllib.parse.urlencode(data).encode() if data is not None else None
    r=urllib.request.Request(base, data=body, headers=headers, method=method)
    try:
        resp=urllib.request.urlopen(r, timeout=5)
        return resp.status, dict(resp.headers), resp.read().decode()
    except urllib.error.HTTPError as e:
        return e.code, dict(e.headers), e.read().decode()

