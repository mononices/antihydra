#!/usr/bin/env python3
"""CJLOSS low-density subset-sum attack on Merkle-Hellman knapsack."""
from fpylll import IntegerMatrix, LLL, BKZ

pk = [int(l) for l in open('/home/ctfplayer/ctf_files/files/pubkey.txt')
      if l.strip() and not l.startswith('#')]
cts = [int(l) for l in open('/home/ctfplayer/ctf_files/files/ciphertext.txt')
       if l.strip() and not l.startswith('#')]
n = len(pk)
print("n=%d blocks=%d" % (n, len(cts)))

def solve(s, bkz_block=0):
    N = 1 << 160
    dim = n + 1
    M = IntegerMatrix(dim, dim)
    for i in range(n):
        M[i, i] = 2
        M[i, n] = N * pk[i]
    for i in range(n):
        M[n, i] = 1
    M[n, n] = N * s
    LLL.reduction(M)
    if bkz_block:
        BKZ.reduction(M, BKZ.Param(block_size=bkz_block, max_loops=8,
                                  flags=BKZ.MAX_LOOPS))
    for i in range(dim):
        r = M[i]
        if r[n] != 0:
            continue
        if all(abs(r[j]) == 1 for j in range(n)):
            for sign in (1, -1):
                x = [1 if sign * r[j] == 1 else 0 for j in range(n)]
                if sum(a * b for a, b in zip(pk, x)) == s:
                    return x
    return None

def bits_to_bytes(x):
    b = bytearray()
    for i in range(0, n, 8):
        byte = 0
        for j in range(8):
            byte = (byte << 1) | x[i + j]
        b.append(byte)
    return bytes(b)

out = []
for bi, s in enumerate(cts):
    x = solve(s)
    if x is None:
        print("block %d: LLL failed, trying BKZ..." % bi)
        x = solve(s, bkz_block=25)
    if x is None:
        print("block %d: FAILED" % bi)
        out.append(b'?' * 9)
        continue
    blk = bits_to_bytes(x)
    print("block %d: %r popcount=%d" % (bi, blk, sum(x)))
    out.append(blk)

flag = b''.join(out)
print()
print("FLAG:", flag)
open('/home/ctfplayer/workspace/flag.bin', 'wb').write(flag)
PYEOF
