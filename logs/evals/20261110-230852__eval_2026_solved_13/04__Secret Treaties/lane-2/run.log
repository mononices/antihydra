from fpylll import IntegerMatrix, LLL
pk=[int(x) for x in open('/home/ctfplayer/ctf_files/files/pubkey.txt') if not x.startswith('#')]
ct=[int(x) for x in open('/home/ctfplayer/ctf_files/files/ciphertext.txt') if not x.startswith('#')]
n=len(pk)
S=ct[0]
for mult in [2, 10, 100, 2**10, 2**20, 2**30]:
    B = IntegerMatrix(n+1, n+1)
    for i in range(n):
        B[i,i] = mult
        B[i,n] = pk[i]
    for j in range(n):
        B[n,j] = 1
    B[n,n] = S
    LLL.reduction(B)
    best=None
    for i in range(n+1):
        row=[B[i,j] for j in range(n+1)]
        if row[n]==0:
            mx=max(abs(row[j]) for j in range(n))
            if best is None or mx<best[0]: best=(mx,i)
    print("mult",mult,"best max abs",best)
