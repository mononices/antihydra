import re
txt=open('patch_dec.bin','rb').read().decode('latin1')
lines=txt.split('\n')
# Build tree: subpatch starts with '#N canvas ... name ...;' and ends with '#X restore x y pd name;'
# We'll parse into nested structure with a stack.
class Node:
    def __init__(self,header):
        self.header=header; self.items=[]; self.children=[]
root=Node('root'); stack=[root]
for l in lines:
    if l.startswith('#N canvas'):
        n=Node(l); stack[-1].children.append(n); stack.append(n)
    elif l.startswith('#X restore'):
        stack.pop()
    else:
        stack[-1].items.append(l)
def name(n):
    m=re.match(r'#N canvas [-\d]+ [-\d]+ [-\d]+ [-\d]+ (.*?) ?\d*;',n.header)
    return n.header
print("root items:")
for it in root.items: print("  ",it)
print("root children:", [c.header for c in root.children])
EOF
