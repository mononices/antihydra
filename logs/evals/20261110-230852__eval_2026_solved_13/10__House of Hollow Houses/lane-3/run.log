[16] create_file {"content": "#!/usr/bin/env python3\nimport os, re, html as H, collections\n\nd = \"/home/ctfplayer/workspace/rooms\"\npat = re.compile(r'<(span|em|strong|i|b|a|code|p|div|h\\d)([^>]*)>(.*?)</\\1>', re.S)\n\nfor fn in sorted(os.listdir(d)):\n    if not fn.endswith(\".html\"): continue\n    s = open(os.path.join(d, fn), encoding=\"utf-8\", errors=\"replace\").read()\n    out = []\n    for m in pat.finditer(s):\n        attrs = m.group(2)\n        inner = re.sub(r\"<[^>]+>\", \"\", m.group(3))\n        inner = H.unescape(inner).strip()\n        if not inner: continue\n        cls = re.search(r'class=\"([^\"]*)\"', attrs)\n        cls = cls.group(1) if cls else \"\"\n        if re.search(r'\\b(h|faintest|hidden|hh|ghost|invis)\\b', cls):\n            out.append((cls, inner))\n    if out:\n        print(\"=\"*30, fn)\n        for cls, inner in out:\n            print(f\"   [{cls}] {inner[:200]}\")\n", "path": "/home/ctfplayer/workspace/extract2.py"}
