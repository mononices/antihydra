[19] create_file {"content": "#!/usr/bin/env python3\nimport os, re, collections\nfrom bs4 import BeautifulSoup\n\nd = \"/home/ctfplayer/workspace/rooms\"\nfor fn in sorted(os.listdir(d)):\n    if not fn.endswith(\".html\") or fn == \"style.css.html\": continue\n    s = open(os.path.join(d, fn), encoding=\"utf-8\", errors=\"replace\").read()\n    soup = BeautifulSoup(s, \"lxml\")\n    hits = []\n    for tag in soup.find_all(True):\n        cls = \" \".join(tag.get(\"class\", []))\n        if re.search(r'(^|\\s)(h|faintest|hidden|hh|ghost|invis)(\\s|$)', cls):\n            txt = tag.get_text(\" \", strip=True)\n            if txt:\n                hits.append((cls, txt))\n    if hits:\n        print(\"=\"*30, fn)\n        for cls, txt in hits:\n            print(f\"   [{cls}] {txt[:250]}\")\n", "path": "/home/ctfplayer/workspace/extract3.py"}
