[39] create_file {"path": "/home/ctfplayer/workspace/lib.py", "content": "#!/usr/bin/env python3\n# Diamond Dogs helpers. Verified prompts (local run):\n#   menu tail: \"6) shred note\\n7) go home\\n> \"\n#   adopt:  \"kennel (0-7): \" then \"name: \"\n#   note:   \"note slot (0-7): \" then \"size: \" then \"contents: \"\n#   read:   \"note slot: contents: \" + payload + \"\\n\" + menu\n#   read:   \"note slot: bad slot\\n\"\nfrom pwn import *\nimport sys\n\ncontext.arch = 'amd64'\ncontext.log_level = 'error'\nHOST, PORT = 'diamond-dogs.chal.csaw.io', 1025\nMENU = b'7) go home\\n> '\n\ndef connect(local=False):\n    if local:\n        return process('./guard-dog-local2', cwd='/home/ctfplayer/workspace')\n    return remote(HOST, PORT)\n\ndef menu(p, choice, wait=MENU):\n    p.sendline(str(choice).encode())\n    return p.recvuntil(wait, timeout=5)\n\ndef adopt(p, k, name=b'x'):\n    menu(p, 1)\n    p.sendline(str(k).encode())\n    p.recvuntil(b'name: ', timeout=5)\n    p.send(name.ljust(0x18, b'\\0') + b'\\n')\n    return p.recvuntil(MENU, timeout=5)\n\ndef release(p, k):\n    menu(p, 3)\n    p.sendline(str(k).encode())\n    return p.recvuntil(MENU, timeout=5)\n\ndef command(p, k):\n    menu(p, 2)\n    p.sendline(str(k).encode())\n    return p.recvuntil(MENU, timeout=5)\n\ndef note(p, k, size, data):\n    menu(p, 4)\n    p.sendline(str(k).encode())\n    p.recvuntil(b'size: ', timeout=5)\n    p.sendline(str(size).encode())\n    p.recvuntil(b'contents: ', timeout=5)\n    p.send(data)\n    return p.recvuntil(MENU, timeout=5)\n\ndef readnote(p, k):\n    menu(p, 5)\n    p.sendline(str(k).encode())\n    return p.recvuntil(MENU, timeout=5)\n\ndef shred(p, k):\n    menu(p, 6)\n    p.sendline(str(k).encode())\n    return p.recvuntil(MENU, timeout=5)\n"}
