import struct
data=open('/home/ctfplayer/ctf_files/finderskeepers.mp4','rb').read()
print('filesize',len(data))
def walk(off,end,depth=0):
    while off+8<=end:
        size=struct.unpack('>I',data[off:off+4])[0]
        typ=data[off+4:off+8].decode('latin1')
        hdr=8
        if size==1:
            size=struct.unpack('>Q',data[off+8:off+16])[0]; hdr=16
        elif size==0:
            size=end-off
        print('  '*depth, hex(off), typ, size)
        if typ in ('moov','trak','mdia','minf','stbl','udta','meta','ilst','edts','dinf'):
            sub=off+hdr
            if typ=='meta': sub=off+hdr+4
            walk(sub, off+size, depth+1)
        off+=size
        if size<=0: break
walk(0,len(data))
