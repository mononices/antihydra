import struct
d=open('finderskeepers.mp4','rb').read()
print(len(d))
def walk(off,end,depth=0):
    while off<end:
        if end-off<8: break
        sz,typ=struct.unpack('>I4s',d[off:off+8])
        typ=typ.decode('latin1')
        hdr=8
        if sz==1:
            sz=struct.unpack('>Q',d[off+8:off+16])[0]; hdr=16
        elif sz==0:
            sz=end-off
        print('  '*depth+f'{typ} size={sz} off={off}')
        if typ in ('moov','trak','mdia','minf','stbl','udta','edts','dinf','mvex','moof','traf'):
            walk(off+hdr,off+sz,depth+1)
        off+=sz
walk(0,len(d))
EOF
