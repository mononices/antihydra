s="esnp{d0c_@yz@gl_mn0j_pm3z3_g0_o00s}"
# Hypothesis: the plaintext was typed with hands shifted on keyboard (i.e., each char is key one position off).
# 'esnp' -> 'flag'? check: f->e (left), l->s? no.
# Try: plaintext chars are the keys to the LEFT of ciphertext chars (cipher typed one to the right)
rows=["`1234567890-=","qwertyuiop[]\\","asdfghjkl;'","zxcvbnm,./"]
pos={ch:(r,c) for r,row in enumerate(rows) for c,ch in enumerate(row)}
def sh(s,dr,dc):
    out=[]
    for ch in s:
        if ch in pos:
            r,c=pos[ch]; nr,nc=r+dr,c+dc
            out.append(rows[nr][nc] if 0<=nr<4 and 0<=nc<len(rows[nr]) else ch)
        else: out.append(ch)
    return ''.join(out)
# staggered: row offsets 0,0.5,1,1.5
def sh_stag(s,d):
    out=[]
    offs=[0,0.5,1.0,1.5]
    for ch in s:
        if ch in pos:
            r,c=pos[ch]
            x=c+offs[r]
            x-=d
            # find nearest key
            best=None
            for rr,row in enumerate(rows):
                for cc,chh in enumerate(row):
                    xx=cc+offs[rr]
                    if rr==r:
                        dist=abs(xx-x)
                        if best is None or dist<best[0]: best=(dist,chh)
            out.append(best[1])
        else: out.append(ch)
    return ''.join(out)
for d in [-1,-0.5,0.5,1]:
    print(d, sh_stag(s,d))
