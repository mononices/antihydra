def trithemius(s, start, step):
    o=[]; i=0
    for c in s:
        if 'a'<=c<='z': o.append(chr((ord(c)-97 - (start+step*i))%26+97)); i+=1
        elif c.isdigit(): o.append(str((int(c) - (start+step*i))%10)); i+=1
