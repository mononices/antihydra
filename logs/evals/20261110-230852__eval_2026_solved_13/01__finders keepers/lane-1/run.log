# ---------- 2. transposition (rail fence, columnar on letter-groups) ----------
import itertools
def railfence_dec(s, rails):
    if rails<2: return s
    pat=list(range(rails))+list(range(rails-2,0,-1))
    idx=[pat[i%len(pat)] for i in range(len(s))]
    # positions per rail in order
    order=sorted(range(len(s)), key=lambda i:(idx[i],i))
    out=[None]*len(s)
    for pos,p in enumerate(order): out[p]=s[pos]
    return ''.join(out)
for r in range(2,10):
    res.append((score(railfence_dec(BODY,r)), f"railfence r={r}"))

def col_dec(s, cols):
    n=len(s); rows=(n+cols-1)//cols
    # read column-wise, write row-wise
    grid=[[''] *cols for _ in range(rows)]
    k=0
    for c in range(cols):
        for r in range(rows):
            if k<n: grid[r][c]=s[k]; k+=1
    return ''.join(''.join(row) for row in grid).rstrip()
for c in range(2,12):
    res.append((score(col_dec(BODY,c)), f"coltranspose c={c}"))

# ---------- 3. keyed alphabet (keyword substitution) ----------
def keyed_alpha_dec(ct, keyword):
    # alphabet: keyword letters (unique) + rest
    seen=[]
    for c in keyword.lower():
        if c.isalpha() and c not in seen: seen.append(c)
    for c in "abcdefghijklmnopqrstuvwxyz":
