import struct
data = open('/home/ctfplayer/ctf_files/finderskeepers.mp4','rb').read()
def walk(buf, base, depth, end):
    pos = base
    while pos < end-7:
        size = struct.unpack('>I', buf[pos:pos+4])[0]
        typ = buf[pos+4:pos+8]
        hdr = 8
        if size == 1:
            size = struct.unpack('>Q', buf[pos+8:pos+16])[0]; hdr = 16
        elif size == 0:
            size = end-pos
        t = typ.decode('latin1')
        print("  "*depth + f"{t} @{pos} size={size}")
        if t in ('moov','trak','mdia','minf','stbl','udta','edts','dinf','mvex','moof','traf','meta','ilst','----','mdra','tref'):
            sub = pos+hdr
            if t=='meta': sub += 4
            walk(buf, sub, depth+1, pos+size)
        elif t=='stsd':
            # walk sample entries
            sub = pos+hdr+8
            walk(buf, sub, depth+1, pos+size)
        elif t=='avc1':
            walk(buf, pos+hdr+78, depth+1, pos+size)
        elif t=='wave' or t=='esds':
            pass
        pos += size
        if size <= 0: break
walk(data, 0, 0, len(data))
print("file size:", len(data))
