# Round 2: positional/letter-indexed shifts, transposition, keyed alphabets.
CT = "esnp{d0c_@yz@gl_mn0j_pm3z3_g0_o00s}"
BODY = "d0c_@yz@gl_mn0j_pm3z3_g0_o00s"

LEET = str.maketrans({'0':'o','1':'i','3':'e','4':'a','5':'s','7':'t','@':'a'})
def leet(s): return s.translate(LEET)

WORDS = ["the","and","that","this","with","you","have","from","flag","keep","find",
         "ers","keepers","finders","video","hidden","secret","inside","never","gonna",
         "give","up","let","down","run","around","desert","meta","data","pastel",
         "color","frame","rect","rectangle","canva","animation","watch","look","see",
         "me","my","is","are","in","on","at","it","be","to","of","we","all","can",
         "not","but","for","out","get","one","time","was","like","just","know"]
def score(s):
    t = leet(s.lower()); sc = 0
    for w in WORDS: sc += t.count(w)*len(w)
    for bg in ["th","he","in","er","an","re","on","at","en","es","nd","ou","ng","ke","ep"]:
        sc += t.count(bg)
    return sc

# ---------- 1. positional shifts ----------
def pos_shift(text, keys, skip_nondigit=True, digits=False, symbols=False):
    out=[]; ki=0
    for ch in text:
        if 'a'<=ch<='z':
            out.append(chr((ord(ch)-97+keys[ki%len(keys)])%26+97)); ki+=1
        elif ch.isdigit() and digits:
            out.append(str((int(ch)+keys[ki%len(keys)])%10)); ki+=1
        elif not skip_nondigit and ch not in '_@':
            out.append(chr((ord(ch)-97+keys[ki%len(keys)])%26+97) if ch.isalpha() else ch); ki+=1
        else:
            out.append(ch)
    return ''.join(out)

res=[]
# key = word -> letter indices
for word in ["esnp","flag","ctf","canva","finder","finderskeepers","keepers","video",
             "hidden","metadata","xmp","secret","pastel","rectangle","animation","key"]:
    ks=[ord(c)-97 for c in word.lower() if c.isalpha()]
    for skip in (True,False):
        for dg in (False,True):
            res.append((score(pos_shift(BODY,ks,skip,dg)), f"posshift word={word} skip={skip} digits={dg}"))

# key = 1..10 constant, key = index+1, index*2 mod26, primes
for k in range(1,11):
    res.append((score(pos_shift(BODY,[k])), f"posshift const {k}"))
res.append((score(pos_shift(BODY,None) if False else pos_shift(BODY,[i%26+1 for i in range(40)])), "posshift i+1"))
res.append((score(pos_shift(BODY,[(2*i)%26 or 26 for i in range(40)])), "posshift 2i"))
