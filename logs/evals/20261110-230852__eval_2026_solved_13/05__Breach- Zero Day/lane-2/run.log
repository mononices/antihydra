import re, collections
data=open('fenwick_security.xml',encoding='utf-8',errors='replace').read()
events=re.findall(r'<Event .*?</Event>', data, re.S)
print("events:", len(events))
prov=collections.Counter(); eids=collections.Counter(); comps=collections.Counter(); chans=collections.Counter()
for e in events:
    p=re.search(r'<Provider Name="([^"]*)"', e)
    i=re.search(r'<EventID>(\d+)</EventID>', e)
    c=re.search(r'<Computer>([^<]*)</Computer>', e)
    ch=re.search(r'<Channel>([^<]*)</Channel>', e)
    prov[p.group(1) if p else '?']+=1
    eids[(p.group(1) if p else '?', i.group(1) if i else '?')]+=1
    comps[c.group(1) if c else '?']+=1
    chans[ch.group(1) if ch else '?']+=1
for k,v in prov.most_common(): print(v,k)
print('---channels'); 
for k,v in chans.most_common(): print(v,k)
print('---computers')
for k,v in comps.most_common(): print(v,k)
print('--- provider/eid')
for k,v in eids.most_common(60): print(v,k)
EOF
