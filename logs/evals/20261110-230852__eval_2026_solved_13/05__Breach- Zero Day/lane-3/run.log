strs=[l.split(' ',1)[1] if ' ' in l else '' for l in lines]
uniq=list(dict.fromkeys(strs))
pat=re.compile(r'(http|https|\.com|\.local|C:\\|HKEY|\.exe|\.dll|\.sys|\.tmp|\.pf|SOFTWARE|SYSTEM|Users|Windows)',re.I)
hits=[]
for s in uniq:
    r=s[::-1]
    if pat.search(r) and not pat.search(s):
        hits.append((s,r))
print(len(hits))
for s,r in hits: print(repr(s),'->',repr(r))
