[15] run_command cd /home/ctfplayer/ctf_files; python3 - <<'EOF'
import re
data=open('fenwick_security.xml',encoding='utf-8',errors='replace').read()
events=re.findall(r'<Event .*?</Event>',data,re.S)
# Extract timeline of interesting events: 21,24 (RDP), 1000/1001 (app error/defender), 19 (update client), 200/201 (taskscheduler), 5157 (firewall)
import html
def gv(e,name):
    m=re.search(r'<Data Name="%s">([^<]*)</Data>'%name,e)
    return m.group(1) if m else ''
def gt(e):
    m=re.search(r'<TimeCreated SystemTime="([^"]+)"',e)
    return m.group(1)
rows=[]
for e in events:
    eid=re.search(r'<EventID>(\d+)</EventID>',e).group(1)
    t=gt(e)
    if eid in ('21','24'):
        rows.append((t,eid,gv(e,'User') or gv(e,'TargetUserName'),re.search(r'<Data Name="Address">([^<]*)</Data>',e).group(1) if '<Data Name="Address">' in e else ''))
    elif eid=='1001':
        rows.append((t,eid,gv(e,'Status'), gv(e,'DeviceDescription')+ ' | '+e.replace('\n',' ')[:0]))
rows.sort()
for r in rows[:120]: print(r)
EOF
