from scapy.all import *
import collections
pkts = rdpcap('fixed.pcap')
print('count', len(pkts))
fields = {}
def add(name, val):
    fields.setdefault(name, collections.Counter())[val]+=1
for p in pkts:
    add('ttl', p[IP].ttl)
    add('ipid', p[IP].id)
    add('tos', p[IP].tos)
    add('flags', str(p[IP].flags))
    add('frag', p[IP].frag)
    add('iplen', p[IP].len)
    add('ipchk', hex(p[IP].chksum))
    add('sport', p[UDP].sport)
    add('dport', p[UDP].dport)
    add('udplen', p[UDP].len)
    add('udpchk', hex(p[UDP].chksum))
    add('payload', bytes(p[UDP].payload))
    add('ethsrc', p[Ether].src)
    add('ethdst', p[Ether].dst)
    add('ethertype', hex(p[Ether].type))
