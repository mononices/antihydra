from scapy.all import *
pkts = rdpcap('fixed.pcap')

def bits_to_str(bits):
    out=[]
    for i in range(0,len(bits)-7,8):
        v=0
        for b in bits[i:i+8]: v=(v<<1)|b
        out.append(chr(v) if 32<=v<127 else '.')
    return ''.join(out)

for name, fn in [
  ('usec LSB', lambda p: int(p.time.micro)%2),
  ('usec mod10', lambda p: int(p.time.micro)%10),
  ('usec>>1 &1', lambda p: (int(p.time.micro)>>1)&1),
]:
    bits=[fn(p) for p in pkts]
    print(name, ''.join(str(b) for b in bits)[:120])
    print('   ->', bits_to_str(bits)[:80])
" 2>/dev/null
