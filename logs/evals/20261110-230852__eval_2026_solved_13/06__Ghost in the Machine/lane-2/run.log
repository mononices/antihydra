import struct, collections
d=open('cap.pcap','rb').read()
off=24
pkts=[]
while off+16<=len(d):
    ts,tu,caplen,origlen=struct.unpack('<IIII', d[off:off+16]); off+=16
    pkt=d[off:off+caplen]; off+=caplen
    pkts.append(dict(ts=ts,tu=tu,caplen=caplen,origlen=origlen,pkt=pkt))
print('packets',len(pkts),'origlens',collections.Counter(p['origlen'] for p in pkts))
# ethernet
for p in pkts:
    e=p['pkt']
    p['etype']=struct.unpack('>H',e[12:14])[0]
    ip=e[14:]
    p['ihl']=(ip[0]&0xf)*4
    p['ver']=ip[0]>>4
    p['tos']=ip[1]
    p['totlen']=struct.unpack('>H',ip[2:4])[0]
    p['ipid']=struct.unpack('>H',ip[4:6])[0]
    p['flagsfrag']=struct.unpack('>H',ip[6:8])[0]
    p['ttl']=ip[8]; p['proto']=ip[9]
    p['ipck']=struct.unpack('>H',ip[10:12])[0]
    p['src']='.'.join(map(str,ip[12:16])); p['dst']='.'.join(map(str,ip[16:20]))
    udp=ip[p['ihl']:]
    p['sport'],p['dport'],p['ulen'],p['uck']=struct.unpack('>HHHH',udp[:8])
    p['payload']=udp[8:8+p['ulen']-8]
for f in ['ts','tu','caplen','origlen','ver','tos','totlen','ipid','flagsfrag','ttl','proto','ipck','src','dst','sport','dport','ulen','uck','payload']:
    c=collections.Counter(repr(p[f]) for p in pkts)
    print(f, len(c), c.most_common(8))
