import struct, collections, statistics
d=open('cap.pcap','rb').read()
off=24; recs=[]
while off+16<=len(d):
    ts,tu,caplen,origlen=struct.unpack('<IIII', d[off:off+16]); off+=16
    pkt=d[off:off+caplen]; off+=caplen
    recs.append(dict(ts=ts,tu=tu,pkt=pkt,ttl=pkt[22],sport=struct.unpack('>H',pkt[34:36])[0]))
for r in recs: r['t']=r['ts']*1_000_000+r['tu']
good=[r for r in recs if r['ttl']==64]
print('good count',len(good))
gaps=[good[i+1]['t']-good[i]['t'] for i in range(len(good)-1)]
print('gaps n',len(gaps),'min',min(gaps),'max',max(gaps),'mean',statistics.mean(gaps),'median',statistics.median(gaps))
# histogram in 10ms buckets
h=collections.Counter(g//5000*5 for g in gaps)
print(sorted(h.items()))
# also only-overall gaps
gaps_all=[recs[i+1]['t']-recs[i]['t'] for i in range(len(recs)-1)]
print('all gaps mean',statistics.mean(gaps_all))
# base ports run-length for good packets
seq=[r['sport'] for r in good]
runs=[]
for s in seq:
    if runs and runs[-1][0]==s: runs[-1][1]+=1
    else: runs.append([s,1])
print('num runs',len(runs))
print(runs[:60])
print('run lengths dist',collections.Counter(l for s,l in runs))
