import struct, collections
d=open('cap.pcap','rb').read()
off=24; pkts=[]
while off+16<=len(d):
    ts,tu,caplen,origlen=struct.unpack('<IIII', d[off:off+16]); off+=16
    pkt=d[off:off+caplen]; off+=caplen
    pkts.append((ts,tu,pkt))
def csum(b):
    if len(b)%2: b+=b'\0'
    s=sum(struct.unpack('>%dH'%(len(b)//2),b))
    while s>>16: s=(s&0xffff)+(s>>16)
    return (~s)&0xffff
rows=[]
for i,(ts,tu,pkt) in enumerate(pkts):
    ip=pkt[14:34]
    ck=struct.unpack('>H',ip[10:12])[0]
    calc=csum(ip[:10]+b'\0\0'+ip[12:])
    udp=pkt[34:]
    # udp checksum field
    uck=struct.unpack('>H',udp[6:8])[0]
    # pseudo header
    pseudo=ip[12:20]+b'\x00\x11'+struct.pack('>H',len(udp))
    uc=csum(pseudo+udp)
    rows.append(dict(i=i,ts=ts,tu=tu,ttl=ip[8],ck=ck,calc=calc,uck=uck,ucalc=uc,
                     sport=struct.unpack('>H',udp[0:2])[0], dport=struct.unpack('>H',udp[2:4])[0]))
bad_ip=[r for r in rows if r['ck']!=r['calc']]
print('bad ip ck',len(bad_ip), bad_ip[:5])
print('bad udp ck',len([r for r in rows if r['uck']!=r['ucalc']]))
print('ttl counts',collections.Counter(r['ttl'] for r in rows))
print('ttl vs sport low bits')
sp=[r['sport'] for r in rows]
print('sport range',min(sp),max(sp))
print('sport high bytes',collections.Counter(s>>8 for s in sp))
print('sport low bytes distinct',len(set(s&0xff for s in sp)))
print('tu distinct',len(set(r['tu'] for r in rows)))
print('tu values sample', [r['tu'] for r in rows[:40]])
print('ts range',min(r['ts'] for r in rows),max(r['ts'] for r in rows))
# correlation ttl with something
for r in rows[:20]: print(r)
