import struct, collections
data = open('fixed.pcap','rb').read()
off = 24
pkts = []
while off < len(data):
    ts_sec, ts_usec, incl, orig = struct.unpack('<IIII', data[off:off+16])
    pkt = data[off+16:off+16+incl]
    pkts.append((ts_sec, ts_usec, incl, orig, pkt))
    off += 16 + incl

fields = collections.defaultdict(collections.Counter)
for i,(ts,tu,incl,orig,pkt) in enumerate(pkts):
    fields['ts_sec'][ts]+=1
    fields['incl'][incl]+=1
    fields['orig'][orig]+=1
    fields['eth_dst'][pkt[0:6].hex()]+=1
    fields['eth_src'][pkt[6:12].hex()]+=1
    fields['eth_type'][pkt[12:14].hex()]+=1
    ip = pkt[14:34]
    fields['ip_verihl'][ip[0:1].hex()]+=1
    fields['ip_tos'][ip[1:2].hex()]+=1
    fields['ip_len'][ip[2:4].hex()]+=1
    fields['ip_id'][ip[4:6].hex()]+=1
    fields['ip_flags'][ip[6:8].hex()]+=1
    fields['ip_ttl'][ip[8:9].hex()]+=1
    fields['ip_proto'][ip[9:10].hex()]+=1
    fields['ip_csum'][ip[10:12].hex()]+=1
    fields['ip_src'][ip[12:16].hex()]+=1
    fields['ip_dst'][ip[16:20].hex()]+=1
    udp = pkt[34:42]
    fields['udp_sport'][udp[0:2].hex()]+=1
    fields['udp_dport'][udp[2:4].hex()]+=1
    fields['udp_len'][udp[4:6].hex()]+=1
    fields['udp_csum'][udp[6:8].hex()]+=1
    fields['payload'][pkt[42:].hex()]+=1

for k,v in fields.items():
    if len(v) <= 12:
        print(k, dict(v))
    else:
        print(k, f"{len(v)} distinct", v.most_common(5))
