import struct
data = open('fixed.pcap','rb').read()
off = 24
pkts = []
while off < len(data):
    ts_sec, ts_usec, incl, orig = struct.unpack('<IIII', data[off:off+16])
    pkt = data[off+16:off+16+incl]
    pkts.append((ts_sec, ts_usec, pkt))
    off += 16 + incl

honest = []
decoy = []
for i,(ts,tu,pkt) in enumerate(pkts):
    sport = struct.unpack('>H', pkt[34:36])[0]
    ttl = pkt[22]
    if ttl == 64:
        honest.append((i, sport))
    else:
        decoy.append((i, sport, ttl))
print("honest:", len(honest), "decoy:", len(decoy))

# burst structure of honest packets: same sport runs
runs = []
cur = None
for i, sport in honest:
    if cur and cur[0]==sport:
        cur[1].append(i)
    else:
        if cur: runs.append(cur)
        cur = [sport, [i]]
runs.append(cur)
print("num runs:", len(runs))
for sport, idxs in runs:
    print(f"sport=0x{sport:04x} low=0x{sport&0xff:02x} n={len(idxs)} idx={idxs[0]}..{idxs[-1]}")
