def emulate(flag):
    mem = [0]*256
    ok = True
    i = 0
    while True:
        op,a,b = prog[3*i:3*i+3]
        if op == 0x7a: mem[a] ^= b
        elif op == 0x24: mem[a] = (mem[a] + b) & 0xff
        elif op == 0xb2:
            n = b & 31
            if n: mem[a] = ((mem[a] << n) | (mem[a] >> (8-n))) & 0xff if n < 8 else None
            if n: mem[a] = ((mem[a] << (n%8)) | (mem[a] >> ((8-n%8)%8))) & 0xff
        elif op == 0x1d: mem[a] = (mem[a] * b) & 0xff
        elif op == 0x4e: mem[a] ^= mem[b]
        elif op == 0x6d: mem[a] = (mem[a] + mem[b]) & 0xff
        elif op == 0x91: mem[a] = flag[b]
        elif op == 0xa7:
            if mem[a] != b: ok = False
        elif op == 0xe0: break
        else: raise Exception("bad op %02x at %d" % (op,i))
        i += 1
    return ok
