data = open('/home/ctfplayer/ctf_files/files/masterkey','rb').read()
bc = data[0x2040:0x2000+0x7ba]
names = {0x24:'ADD_IMM', 0x6d:'ADD_REG', 0xa7:'CMP_IMM', 0x4e:'CMP_REG',
         0x1d:'MUL_IMM', 0x7a:'XOR_IMM', 0x91:'LOAD_INPUT', 0xb2:'ROL',
         0x3c:'?3c', 0xe0:'END'}
pc = 0
out=[]
while pc < len(bc):
    op = bc[pc]
    name = names.get(op, 'UNK_%02x'%op)
    if op in (0x3c,):
        out.append((pc, op, name, bc[pc+1:pc+4].hex(' ')))
        pc += 4
        continue
    if op == 0xe0:
        out.append((pc, op, name, bc[pc+1:pc+3].hex(' ')))
        pc += 3
        continue
    a = bc[pc+1]; b = bc[pc+2]
    out.append((pc, op, name, a, b))
    pc += 3
for i,(pc,op,name,*rest) in enumerate(out):
    print('%4d %04x %-10s %s' % (i, 0x2040+pc, name, rest))
EOF
