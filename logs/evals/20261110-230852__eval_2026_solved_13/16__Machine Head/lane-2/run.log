data = open('/home/ctfplayer/ctf_files/files/masterkey','rb').read()
bc = data[0x2040:0x2000+0x7ba]
# decode
ins=[]
pc=0
while pc < len(bc):
    op=bc[pc]
    if op==0xe0: ins.append((op,bc[pc+1],bc[pc+2])); pc+=3; continue
    ins.append((op,bc[pc+1],bc[pc+2])); pc+=3

# split into blocks separated by (XOR_IMM [1,60]) at start
blocks=[]
cur=None
for op,a,b in ins:
    if op==0x7a and a==1 and b==60:
        if cur: blocks.append(cur)
        cur=[]
        continue
    if cur is not None: cur.append((op,a,b))
if cur: blocks.append(cur)
print("num blocks:", len(blocks))

def rol8(v,c):
    c&=7
    return ((v<<c)|(v>>(8-c)))&0xff

params=[]
for blk in blocks:
    K0=K1=K2=T=idx=None
    for op,a,b in blk:
        if op==0x7a and a==0: K0=b
        elif op==0x24 and a==0: K1=b
        elif op==0xb2 and a==0: K2=b
        elif op==0xa7 and a==0: T=b
        elif op==0x91 and a==2: idx=b
    params.append((K0,K1,K2,T,idx))
print(params[:3])
# check indices sequential
idxs=[p[4] for p in params]
print("indices ok:", idxs==list(range(len(params))))

def f(x,K0,K1,K2):
    v = (x ^ K0) & 0xff
    v = (v + K1) & 0xff
    v = rol8(v,K2)
    v ^= 195
    v = (v*27) & 0xff
    return v

S=0
flag=[]
for i,(K0,K1,K2,T,idx) in enumerate(params):
    S ^= 60
    target = T ^ S
    found=[x for x in range(256) if f(x,K0,K1,K2)==target]
    if len(found)!=1:
        print("step",i,"ambiguous",found); break
    c=found[0]
    flag.append(c)
    S = rol8((S + c) & 0xff, 3) ^ 158
print(bytes(flag))
print(bytes(flag).decode('latin1'))
EOF
