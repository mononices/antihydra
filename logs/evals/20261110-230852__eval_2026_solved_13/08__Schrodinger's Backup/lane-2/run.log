[10] create_file {"content": "import struct, sys\nsys.path.insert(0, '/home/ctfplayer/workspace')\nimport sqlparse\n\nPAGE = 1024\n\ndef cksum(data, s1, s2, native=True):\n    # data length multiple of 8\n    assert len(data) % 8 == 0\n    if native:\n        words = struct.unpack('<%dI' % (len(data)//4), data)\n    else:\n        words = struct.unpack('>%dI' % (len(data)//4), data)\n    for i in range(0, len(words), 2):\n        s1 = (s1 + words[i] + s2) & 0xffffffff\n        s2 = (s2 + words[i+1] + s1) & 0xffffffff\n    return s1, s2\n\nwal = open('/home/ctfplayer/workspace/ev/catalog.db-wal','rb').read()\nmagic, version, pagesize, ckpt, salt1, salt2, hc1, hc2 = struct.unpack('>IIIIIIII', wal[:32])\nnative = (magic & 1) == 0   # on little-endian host: magic ...82 -> native\nprint('magic %08x native=%s' % (magic, native))\n\n# verify header checksum over first 24 bytes\ns1, s2 = cksum(wal[:24], 0, 0, native)\nprint('hdr cksum computed %08x %08x vs stored %08x %08x -> %s' % (s1, s2, hc1, hc2, (s1,s2)==(hc1,hc2)))\n\nframesz = pagesize + 24\nn = (len(wal)-32)//framesz\nvalid = []\ncs1, cs2 = hc1, hc2\nfor i in range(n):\n    off = 32 + i*framesz\n    pg, dbsize, fs1, fs2, fc1, fc2 = struct.unpack('>IIIIII', wal[off:off+24])\n    page = wal[off+24:off+24+pagesize]\n    if (fs1, fs2) != (salt1, salt2):\n        print('frame %d: SALT MISMATCH -> stop' % i)\n        break\n    t1, t2 = cksum(wal[off:off+8], cs1, cs2, native)\n    t1, t2 = cksum(page, t1, t2, native)\n    if (t1, t2) != (fc1, fc2):\n        print('frame %d: CHECKSUM MISMATCH -> stop' % i)\n        break\n    cs1, cs2 = fc1, fc2\n    valid.append((i, pg, dbsize, page))\n\nprint('valid frames:', len(valid), 'indices', valid[0][0], '..', valid[-1][0])\ncommits = [v for v in valid if v[2] != 0]\nprint('commit frames:', [(v[0], v[1], v[2]) for v in commits])\nlast_commit = commits[-1][0]\nprint('last commit frame', last_commit, '-> frames after it are uncommitted:',\n      [v[0] for v in valid if v[0] > last_commit])\n\n# Replay onto main db\npages, ps = sqlparse.load_db('/home/ctfplayer/workspace/ev/catalog.db')\nassert ps == pagesize\nstate = dict(pages)\n\ndef snapshot(state):\n    tabs = sqlparse.get_tables(state, ps)\n    res = {}\n    for name, (root, sql) in tabs.items():\n        for rowid, vals in sqlparse.btree_walk(state, root, ps):\n            res[name] = vals\n    return res\n\nbase = snapshot(state)\nprint('\\nBASELINE:', {k: (v[0], v[1] if not isinstance(v[1], bytes) else v[1].hex()) for k,v in base.items()})\n\nhistory = []\ntxn = []\nfor (i, pg, dbsize, page) in valid:\n    if i > last_commit:\n        break\n    txn.append((i, pg, page))\n    if dbsize != 0:\n        for (fi, fpg, fpage) in txn:\n            state[fpg] = fpage\n        snap = snapshot(state)\n        n_share = snap['north'][1]\n        s_share = snap['south'][1]\n        armed = snap['control'][1]\n        label = snap['control'][2]\n        pulse = snap['maintenance'][1]\n        tok = bytes(a ^ b for a, b in zip(n_share, s_share))\n        history.append((i, armed, label, pulse, tok.hex()))\n        txn = []\n\nprint('\\nCOMMITTED TRANSACTIONS (frame, armed, label, pulse, token):')\nfor h in history:\n    print(h)\nprint('\\ntotal committed txns:', len(history))\nprint('armed visits:', sum(1 for h in history if h[1]))\n\nimport json\njson.dump([{'frame': h[0], 'armed': h[1], 'label': h[2], 'pulse': h[3], 'token': h[4]} for h in history],\n          open('/home/ctfplayer/workspace/history.json','w'), indent=1)\n", "path": "/home/ctfplayer/workspace/replay.py"}
