[07] create_file {"content": "import struct, sys, hashlib\n\nPAGE = 1024\n\ndef read_varint(buf, off):\n    v = 0\n    for i in range(9):\n        b = buf[off+i]\n        if i == 8:\n            v = (v << 8) | b\n            return v, off+9\n        v = (v << 7) | (b & 0x7f)\n        if not (b & 0x80):\n            return v, off+i+1\n    raise ValueError\n\ndef parse_record(payload):\n    hlen, off = read_varint(payload, 0)\n    types = []\n    p = off\n    while p < hlen:\n        t, p = read_varint(payload, p)\n        types.append(t)\n    vals = []\n    p = hlen\n    for t in types:\n        if t == 0:\n            vals.append(None)\n        elif t >= 1 and t <= 6:\n            n = [0,1,2,3,4,6,8][t]\n            v = int.from_bytes(payload[p:p+n], 'big', signed=True)\n            vals.append(v); p += n\n        elif t == 7:\n            vals.append(struct.unpack('>d', payload[p:p+8])[0]); p += 8\n        elif t == 8:\n            vals.append(0)\n        elif t == 9:\n            vals.append(1)\n        elif t >= 12 and t % 2 == 0:\n            n = (t-12)//2\n            vals.append(payload[p:p+n]); p += n\n        elif t >= 13 and t % 2 == 1:\n            n = (t-13)//2\n            vals.append(payload[p:p+n].decode('utf-8', 'replace')); p += n\n        else:\n            raise ValueError('bad serial type %d' % t)\n    return vals\n\ndef btree_walk(pages, root, page_size=PAGE):\n    \"\"\"yield (rowid, values) for a table btree given dict pageno->bytes\"\"\"\n    out = []\n    def walk(pgno):\n        data = pages[pgno]\n        hdr = 100 if pgno == 1 else 0\n        ptype = data[hdr]\n        ncell = struct.unpack('>H', data[hdr+3:hdr+5])[0]\n        if ptype == 13:  # leaf table\n            for i in range(ncell):\n                celloff = struct.unpack('>H', data[hdr+8+2*i:hdr+10+2*i])[0]\n                plen, p = read_varint(data, celloff)\n                rowid, p = read_varint(data, p)\n                payload = data[p:p+plen]\n                if len(payload) < plen:\n                    # overflow: read next overflow page number after payload\n                    nxt = struct.unpack('>I', data[p+len(payload):p+len(payload)+4])[0]\n                    while nxt and len(payload) < plen:\n                        ov = pages[nxt]\n                        payload += ov[4:]\n                        nxt = struct.unpack('>I', ov[:4])[0]\n                out.append((rowid, parse_record(payload)))\n        elif ptype == 5:  # interior table\n            for i in range(ncell):\n                celloff = struct.unpack('>H', data[hdr+12+2*i:hdr+14+2*i])[0]\n                child = struct.unpack('>I', data[celloff:celloff+4])[0]\n                walk(child)\n            right = struct.unpack('>I', data[hdr+8:hdr+12])[0]\n            walk(right)\n        else:\n            raise ValueError('unexpected page type %d on page %d' % (ptype, pgno))\n    walk(root)\n    return out\n\ndef load_db(path):\n    data = open(path,'rb').read()\n    ps = struct.unpack('>H', data[16:18])[0]\n    if ps == 1: ps = 65536\n    npages = len(data)//ps\n    pages = {i+1: data[i*ps:(i+1)*ps] for i in range(npages)}\n    return pages, ps\n\ndef get_tables(pages, ps):\n    rows = btree_walk(pages, 1, ps)\n    tables = {}\n    for rowid, vals in rows:\n        # type, name, tbl_name, rootpage, sql\n        tables[vals[1]] = (vals[3], vals[4])\n    return tables\n", "path": "/home/ctfplayer/workspace/sqlparse.py"}
