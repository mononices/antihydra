import subprocess, os, select, time, socket
DIST='/home/ctfplayer/ctf_files/dist'
class P:
    def __init__(self, remote=None):
        if remote:
            self.p = socket.create_connection(remote, timeout=10)
            self.is_sock = True
        else:
            self.p = subprocess.Popen(['./vespers'], cwd=DIST, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
            self.is_sock = False
    def snd(self, b):
        if isinstance(b,str): b=b.encode()
        if self.is_sock: self.p.sendall(b)
        else:
            self.p.stdin.write(b); self.p.stdin.flush()
    def _read1(self, tmo):
        if self.is_sock:
            r,_,_=select.select([self.p],[],[],tmo)
            if not r: return b''
            return self.p.recv(1)
        r,_,_=select.select([self.p.stdout],[],[],tmo)
        if not r: return b''
        return self.p.stdout.read(1)
    def rcv(self, tok=b'> ', tmo=8):
        data=b''
        while tok not in data:
            c=self._read1(tmo)
            if not c: break
            data+=c
        return data
    def menu(self, choice):
        self.snd(str(choice)+'\n')
    def recruit(self, name, style, data, length=None):
        if isinstance(name,str): name=name.encode()
        if isinstance(data,str): data=data.encode()
        if length is None: length=len(data)
        assert len(name)<=0x37
        name = name + b'\x00'*(0x37-len(name))   # fixed-size read of 55 bytes
        self.menu(1); self.rcv(b'Name this chorister: ')
        self.snd(name); self.rcv(b'style')
        self.snd(str(style)+'\n'); self.rcv(b'length')
        self.snd(str(length)+'\n'); self.rcv(b'raw bytes')
        self.snd(data)
        return self.rcv(b'> ')
    def retire(self, idx):
        self.menu(2); self.rcv(b'seat? '); self.snd(str(idx)+'\n'); return self.rcv(b'> ')
    def restore(self, idx):
        self.menu(3); self.rcv(b'seat? '); self.snd(str(idx)+'\n'); return self.rcv(b'> ')
    def inscribe(self, idx, data):
        if isinstance(data,str): data=data.encode()
        self.menu(4); self.rcv(b'seat? '); self.snd(str(idx)+'\n')
        out = self.rcv(b'raw bytes')
        if b'raw bytes' not in out: return out + self.rcv(b'> ')
        self.snd(data); return self.rcv(b'> ')
    def recite(self, idx):
        self.menu(5); self.rcv(b'seat? '); self.snd(str(idx)+'\n'); return self.rcv(b'> ')
    def rename(self, idx, data):
        if isinstance(data,str): data=data.encode()
        assert len(data)<=0x37
        data = data + b'\x00'*(0x37-len(data))
        self.menu(6); self.rcv(b'seat? '); self.snd(str(idx)+'\n')
        out=self.rcv(b'raw bytes')
        if b'raw bytes' not in out: return out+self.rcv(b'> ')
        self.snd(data); return self.rcv(b'> ')
    def roster(self):
        self.menu(7); return self.rcv(b'> ')
    def perform(self):
        self.menu(8); return self.rcv(b'> ')
    def close(self):
        try:
            if self.is_sock: self.p.close()
            else: self.p.kill()
        except: pass
