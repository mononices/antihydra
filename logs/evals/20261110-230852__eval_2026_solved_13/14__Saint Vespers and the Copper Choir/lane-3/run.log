from pwn import *
context.log_level='error'
libc = ELF('/home/ctfplayer/ctf_files/dist/libc.so.6')
BIN='/home/ctfplayer/ctf_files/dist/vespers'
LDP='/home/ctfplayer/ctf_files/dist/ld-2.35.so'
PROM=b'> '

class V:
    def __init__(self, p):
        self.p=p
        self.sync()
    def sync(self):
        self.p.recvuntil(PROM)
    def recruit(self, name, style, tlen, data):
        self.p.sendline(b'1'); self.p.sendline(name); self.p.sendline(str(style).encode())
        self.p.sendline(str(tlen).encode()); self.p.send(data)
        self.sync()
    def retire(self, i):
        self.p.sendline(b'2'); self.p.sendline(str(i).encode()); self.sync()
    def restore(self, i):
        self.p.sendline(b'3'); self.p.sendline(str(i).encode()); self.sync()
    def inscribe(self, i, data):
        self.p.sendline(b'4'); self.p.sendline(str(i).encode()); self.p.send(data); self.sync()
    def recite(self, i, n=0x1000):
        self.p.sendline(b'5'); self.p.sendline(str(i).encode())
        # read until "\nTranscript (N bytes):\n" then n bytes + "\n"
        hdr=self.p.recvuntil(b'bytes):\n')
        data=self.p.recvn(n)
        self.p.recvuntil(PROM)
        return data
    def rename(self, i, data):
        self.p.sendline(b'6'); self.p.sendline(str(i).encode()); self.p.send(data); self.sync()
    def roster(self):
        self.p.sendline(b'7'); return self.p.recvuntil(PROM)
    def perform(self):
        self.p.sendline(b'8'); return self.p.recvuntil(PROM)

def start():
    return V(process(BIN, cwd='/home/ctfplayer/ctf_files/dist'))
EOF
