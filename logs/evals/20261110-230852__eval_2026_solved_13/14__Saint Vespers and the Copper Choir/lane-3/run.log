    p.sendline(b'2'); p.sendline(str(i).encode())

def restore(p, i):
    p.sendline(b'3'); p.sendline(str(i).encode())

def inscribe(p, i, data):
    p.sendline(b'4'); p.sendline(str(i).encode()); p.send(data)

def recite(p, i):
    p.sendline(b'5'); p.sendline(str(i).encode())

