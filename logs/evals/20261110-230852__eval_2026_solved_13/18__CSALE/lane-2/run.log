im=Image.open('recovered-photo-proof.png').convert('RGB')
a=np.asarray(im).astype(int)
dark=(a.sum(axis=2)<330)
sub=dark[0:64,:]
cols=sub.sum(axis=0)
# print runs with gap tolerance 1
runs=[];inrun=False
for x,v in enumerate(cols):
    if v>0 and not inrun: st=x;inrun=True
    elif v==0 and inrun: runs.append((st,x));inrun=False
if inrun: runs.append((st,len(cols)))
print(runs)
# Also produce a large single strip
img=Image.fromarray(np.where(sub,0,255).astype('uint8'))
img=img.resize((img.size[0]*8,img.size[1]*8),Image.NEAREST)
img.save('big.png')
# slices of 60 px original width, 8x scale
W=515
for i in range(0,9):
    x0=i*60; x1=min(W,x0+60)
    c=img.crop((x0*8,0,x1*8,img.size[1]))
    c.save(f's{i}.png')
print(img.size)
