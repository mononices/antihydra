) // 2\n        if bool_test(f\"length({expr}) > {mid}\", session):\n            a = mid + 1\n        else:\n            b = mid\n    length = a\n    out = []\n    for i in range(1, length + 1):\n        ch = None\n        a, b = lo, hi\n        while a < b:\n            mid = (a + b) // 2\n            if bool_test(f\"unicode(substr({expr},{i},1)) > {mid}\", session):\n                a = mid + 1\n            else:\n                b = mid\n        ch = chr(a)\n        out.append(ch)\n        sys.stdout.write(f\"\\r{label} [{i}/{length}] {''.join(out)}\")\n        sys.stdout.flush()\n    print()\n    return \"\".join(out)\n\ndef batch_bool(conds, workers=8):\n    \"\"\"Run many boolean conditions in parallel, return list of bools.\"\"\"\n    with ThreadPoolExecutor(max_workers=workers) as ex:\n        results = list(ex.map(bool_test, conds))\n    return results\n\nif __name__ == \"__main__\":\n    # sanity\n    print(\"sanity true:\", bool_test(\"1=1\"))\n    print(\"sanity false:\", bool_test(\"1=2\"))\n"}
