import math, random
from collections import Counter
txt = ""
for fn in ("alice.txt","dracula.txt","pride.txt","treasure.txt"):
    txt += open(fn, encoding='utf-8', errors='ignore').read().upper()
txt = ''.join(x for x in txt if 'A' <= x <= 'Z')
bi = Counter(txt[i:i+2] for i in range(len(txt)-1)); tot=sum(bi.values())
def sc(s): return sum(math.log10((bi.get(s[i:i+2],0)+0.1)/tot) for i in range(len(s)-1))/(len(s)-1)
def enc(pt,key):
    return ''.join(chr(65+(ord(p)-65+ord(key[i%len(key)])-65)%26) for i,p in enumerate(pt))
def d(ct,key):
    return ''.join(chr(65+(ord(c)-65-(ord(key[i%len(key)])-65))%26) for i,c in enumerate(ct))
rnd=random.Random(5)
pt = txt[50000:50139]
print("pt score:", round(sc(pt),3))
for L in (5,7,9):
    key = ''.join(rnd.choice("ABCDEFGHIJKLMNOPQRSTUVWXYZ") for _ in range(L))
    ct = enc(pt,key)
    # hillclimb
    def hc(L, restarts=6):
        best=None
        for r in range(restarts):
            key=[rnd.randrange(26) for _ in range(L)]
            cur=sc(d(ct,''.join(chr(65+x) for x in key)))
            improved=True
            while improved:
                improved=False
                for i in range(L):
                    orig=key[i]
                    for v in range(26):
                        key[i]=v
                        s=sc(d(ct,''.join(chr(65+x) for x in key)))
                        if s>cur: cur=s; orig=v; improved=True
                    key[i]=orig
            if best is None or cur>best[0]: best=(cur,key)
        return best
    s,k = hc(L)
    print(f"L={L} truekey={key} found={''.join(chr(65+x) for x in k)} score={s:.3f} pt={d(ct,''.join(chr(65+x) for x in k))[:50]}")
EOF
