io-mirror\", ''.join(out)\n    streams = [ct[i::3][::-1] for i in range(3)]\n    for perm in ((0,1,2),(2,1,0),(1,0,2),(0,2,1),(1,2,0),(2,0,1)):\n        streams2=[streams[p] for p in perm]\n        res=[]\n        idxs=[0]*3\n        order=[]\n        k=0\n        while any(idxs[j] < len(streams2[j]) for j in range(3)):\n            j = k % 3\n            if idxs[j] < len(streams2[j]):\n                order.append(streams2[j][idxs[j]]); idxs[j]+=1\n            k+=1\n        yield f\"streams-rev-{perm}\", ''.join(order)\n    cols = [ct[i::3] for i in range(3)]\n    yield \"col3-down\", ''.join(''.join(c) for c in cols)\n    yield \"col3-down-revcol\", ''.join(''.join(c[::-1]) for c in cols)\n\nresults=[]\nfor tname, tct in transforms(CT):\n    for mode in (\"vig\",\"beau\",\"vigenere-add\"):\n        for L in range(1,13):\n            s, key = hillclimb_key(tct, L, mode, restarts=4, seed=hash(tname)%97+1)\n            p = decrypt(tct, key, mode)\n            results.append((s/len(p), tname, mode, L, key, p))\nresults.sort(reverse=True)\nfor row in results[:15]:\n    s,tname,mode,L,key,p = row\n    print(f\"{s:7.4f} {tname:16s} {mode:13s} L={L:2d} key={key} {p[:60]}\")\n"}
