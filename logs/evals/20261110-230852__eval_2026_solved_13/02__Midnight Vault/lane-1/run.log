import itertools, re
ct = "SALKMSKXZYRZEJFEOTMBRRZBRXYCXPNJIIWDRYADAIWKKKBEBUDDGNCXTUUBSJXMQVIVPVBYQEVVRBXMTEFGHRVULFEJZZUTXZIVBABSKQESEWKPKGXNVGTZHIFVWLCAQDHOKIGZZRV"
freq = [0.0817,0.0149,0.0278,0.0425,0.127,0.0223,0.0202,0.0609,0.0697,0.0015,0.0077,0.0403,0.0241,
0.0675,0.0751,0.0193,0.0009,0.0599,0.0633,0.0906,0.0276,0.0098,0.0236,0.0015,0.0197,0.0007]

def solve(ct, L):
    key=[]
    for i in range(L):
        col = ct[i::L]
        best=None
        for s in range(26):
            n=len(col); ch=0.0
            cnt=[0]*26
            for c in col: cnt[(ord(c)-65-s)%26]+=1
            for a in range(26):
                e = freq[a]*n
                ch += (cnt[a]-e)**2/e
            if best is None or ch<best[0]: best=(ch,s)
        key.append(best[1])
    return key

def dec(ct,key):
    return ''.join(chr(65+(ord(c)-65-key[i%len(key)])%26) for i,c in enumerate(ct))

res=[]
for L in range(1,21):
    k=solve(ct,L)
    p=dec(ct,k)
    # chi2 of whole plaintext
    cnt=[0]*26
    for c in p: cnt[ord(c)-65]+=1
    n=len(p); ch=sum((cnt[a]-freq[a]*n)**2/(freq[a]*n) for a in range(26))
    res.append((ch,L,''.join(chr(65+x) for x in k),p))
res.sort()
for ch,L,k,p in res[:6]:
    print(L,k,round(ch,1))
    print("   ",p[:80])
EOF
