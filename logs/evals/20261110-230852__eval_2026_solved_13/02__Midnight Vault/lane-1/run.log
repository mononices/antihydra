import hashlib, zlib, itertools
CT = "SALKMSKXZYRZEJFEOTMBRRZBRXYCXPNJIIWDRYADAIWKKKBEBUDDGNCXTUUBSJXMQVIVPVBYQEVVRBXMTEFGHRVULFEJZZUTXZIVBABSKQESEWKPKGXNVGTZHIFVWLCAQDHOKIGZZRV"
target = "7f1a0d"
algs = ["md5","sha1","sha224","sha256","sha384","sha512","blake2b","blake2s","sha3_256","sha3_512"]
def check(s, label):
    b = s.encode()
    hits=[]
    for a in algs:
        h = hashlib.new(a, b).hexdigest()
        if h.startswith(target) or target in h[:16]:
            hits.append((a,h[:12]))
    c = zlib.crc32(b)
    if format(c,'08x').startswith(target) or target in format(c,'08x'):
        hits.append(("crc32",format(c,'08x')))
    for a,v in hits:
        print("HIT", label, a, v, s[:50])
    return hits
# all caesar shifts
for sh in range(26):
    p = ''.join(chr(65+(ord(c)-65-sh)%26) for c in CT)
    check(p, f"caesar{sh}")
    check(p.lower(), f"caesar{sh}lower")
# atbash
atb = ''.join(chr(65+(25-(ord(c)-65))%26) for c in CT)
check(atb, "atbash")
# reversed
check(CT[::-1], "ct_rev")
# with spaces every 5? no. numeric digits as-is
check("041971","041971")
print("done caesar/atbash sweep")
EOF
