 3-char block\n    v = ''\n    for i in range(0, len(CT), 3):\n        v += CT[i:i+3][::-1]\n    variants['rev3blocks'] = v\n    # reverse whole then rev3blocks\n    v2 = ''\n    R = CT[::-1]\n    for i in range(0, len(R), 3):\n        v2 += R[i:i+3][::-1]\n    variants['rev_then_rev3'] = v2\n    # three interleaved streams reversed individually, recombined\n    streams = [CT[i::3][::-1] for i in range(3)]\n    out = []\n    for i in range(len(CT)):\n        out.append(streams[i % 3][i // 3])\n    variants['interleave_rev'] = ''.join(out)\n    # take every 3rd letter concatenated\n    variants['every3_a'] = CT[0::3] + CT[1::3] + CT[2::3]\n    variants['every3_b'] = CT[2::3] + CT[1::3] + CT[0::3]\n\n    results = []\n    for name, c in variants.items():\n        print(f\"=== {name} ===\")\n        s, key, pt = hillclimb(c, max_restarts=30)\n        results.append((s, name, key, pt))\n    results.sort(reverse=True)\n    print(\"\\n\\n######## BEST ########\")\n    for s, name, key, pt in results[:3]:\n        print(name, s)\n        print(pt)\n", "path": "/home/ctfplayer/workspace/hill.py"}
