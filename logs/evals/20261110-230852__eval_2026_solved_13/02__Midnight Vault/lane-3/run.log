import itertools, math
ct="SALKMSKXZYRZEJFEOTMBRRZBRXYCXPNJIIWDRYADAIWKKKBEBUDDGNCXTUUBSJXMQVIVPVBYQEVVRBXMTEFGHRVULFEJZZUTXZIVBABSKQESEWKPKGXNVGTZHIFVWLCAQDHOKIGZZRV"
ENG="ETAOINSHRDLCUMWFGYPBVKJXQZ"
def score(s):
    # simple english score using quadgram-ish: just letter freq + common words
    sc=0
    for i,ch in enumerate(s):
        sc += (26-ENG.index(ch)) if ch in ENG else 0
    return sc

def col_trans_decrypt(ct, ncols, perm):
    n=len(ct)
    nrows = math.ceil(n/ncols)
    # number of full cells
    # column lengths: first (n mod ncols) columns have nrows, rest nrows-1
    rem = n % ncols
    if rem==0: rem=ncols
    collen=[nrows if i<rem else nrows-1 for i in range(ncols)]
    # read columns in order perm
    cols=[None]*ncols
    idx=0
    for c in perm:
        cols[c]=ct[idx:idx+collen[c]]
        idx+=collen[c]
    out=[]
    for r in range(nrows):
        for c in range(ncols):
            if r<len(cols[c]):
                out.append(cols[c][r])
    return ''.join(out)

best=[]
for ncols in range(2,12):
    for perm in itertools.permutations(range(ncols)):
        pt=col_trans_decrypt(ct,ncols,perm)
        s=score(pt)
        best.append((s,ncols,perm,pt))
best.sort(reverse=True)
for s,nc,p,pt in best[:10]:
    print(nc,p,pt[:90])
EOF
