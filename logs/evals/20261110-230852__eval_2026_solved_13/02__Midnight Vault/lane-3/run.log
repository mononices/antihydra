ct="SALKMSKXZYRZEJFEOTMBRRZBRXYCXPNJIIWDRYADAIWKKKBEBUDDGNCXTUUBSJXMQVIVPVBYQEVVRBXMTEFGHRVULFEJZZUTXZIVBABSKQESEWKPKGXNVGTZHIFVWLCAQDHOKIGZZRV"
def revtrio(s):
    return ''.join(s[i:i+3][::-1] for i in range(0,len(s),3))
def caesar(s,k):
    return ''.join(chr((ord(c)-65+k)%26+65) for c in s)
def atbash(s):
    return ''.join(chr(90-(ord(c)-65)) for c in s)
def rev(s): return s[::-1]

cands={}
base=ct
for name,fn in [("id",lambda x:x),("revtrio",revtrio),("rev",rev),("revtrio_rev",lambda x:revtrio(rev(x))),("rev_revtrio",lambda x:rev(revtrio(x)))]:
    t=fn(base)
    for k in range(26):
        cands[f"{name}_caesar{k}"]=caesar(t,k)
        cands[f"{name}_atbash_caesar{k}"]=caesar(atbash(t),k)

# score by counting common trigrams
trigrams=["THE","AND","ING","ION","ENT","FOR","HER","TER","HAT","THA","ERE","ATE","HIS","CON","RES","VER","ALL","OUL","ULD","PER","NOT","ARE","BUT","WAS","ONE","OUR","OUT","YOU","HAD","HAV","WIT","WHE","WHI","WIL","WIT","ITH","TIO","EAR"]
def score(s):
    return sum(s.count(t) for t in trigrams)
res=sorted(cands.items(), key=lambda x:-score(x[1]))
for name,s in res[:15]:
    print(score(s), name, s[:80])
