import numpy as np, wave
from scipy import signal
w=wave.open('audio.wav'); fs=w.getframerate()
n=w.getnframes(); d=np.frombuffer(w.readframes(n),dtype=np.int16).reshape(-1,2)[:,0].astype(float)
start=int(22.55*fs); end=int(24.40*fs)
seg=d[start:end]
f,t,S=signal.spectrogram(seg, fs, nperseg=1024, noverlap=896, window='hann')
Sdb=10*np.log10(S+1e-12)
# freq rows 700..3900 step ~100 -> use index selection
fmask=(f>=700)&(f<=3900)
fm=f[fmask]; Sm=Sdb[fmask]
# group freq bins into 32 rows
rows=32
idx=np.linspace(0,len(fm),rows+1).astype(int)
grid=[]
for i in range(rows-1,-1,-1):
    band=Sm[idx[i]:idx[i+1]]
    row=band.max(axis=0)  # max over freq band
    grid.append(row)
G=np.array(grid)
# threshold: use percentile
thr=np.percentile(G,55)
B=G>thr
# downsample time: pick ~100 cols
cols=110
tidx=np.linspace(0,B.shape[1],cols+1).astype(int)
out=[]
for r in range(B.shape[0]):
    line=''
    for c in range(cols):
        blk=B[r,tidx[c]:tidx[c+1]]
        line+='#' if blk.mean()>0.4 else ' '
    out.append(line)
print('\n'.join(out))
"
