import numpy as np, wave
w=wave.open('a.wav'); n=w.getnframes()
d=np.frombuffer(w.readframes(n),dtype='<i2').reshape(-1,2).astype(np.float64)
fs=44100
L=d[:,0]; R=d[:,1]
seg=L[int(22.4*fs):int(24.2*fs)]
# find envelope to see bursts
env=np.abs(seg)
wlen=int(0.01*fs)
e=env[:len(env)//wlen*wlen].reshape(-1,wlen).mean(axis=1)
thr=e.max()*0.15
on=e>thr
# find burst boundaries
idx=np.where(np.diff(on.astype(int))!=0)[0]
print('burst bounds', idx/wlen*0.01+22.4)
print('max env', e.max())
# overall FFT of segment
S=np.abs(np.fft.rfft(seg*np.hanning(len(seg))))
f=np.fft.rfftfreq(len(seg),1/fs)
# find peaks
from scipy.signal import find_peaks
p,_=find_peaks(S,height=S.max()*0.05,distance=50)
print([(round(f[i],1), round(S[i]/S.max(),3)) for i in p])
