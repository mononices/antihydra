import numpy as np, wave
from scipy.signal import spectrogram
w=wave.open('a.wav'); n=w.getnframes()
d=np.frombuffer(w.readframes(n),dtype='<i2').reshape(-1,2).astype(np.float64)
L=d[:,0]; fs=44100
a=int(22.30*fs); b=int(24.3*fs)
seg=L[a:b]
f,t,S=spectrogram(seg,fs=fs,nperseg=512,noverlap=448,mode='magnitude')
tones=[850,1300,1750,2200,2650,3100,3550]
# find nearest freq bin
def bin_of(fq): return np.argmin(np.abs(f-fq))
rows=np.array([S[bin_of(tq)-1:bin_of(tq)+2,:].max(axis=0) for tq in tones])
# normalize per row
mx=rows.max(axis=1,keepdims=True)
R=rows/mx
# print a matrix: for each time col, pattern
thr=0.25
pat=(R>thr).astype(int)
# compact: group columns
lines=[]
prev=None
for i in range(pat.shape[1]):
    col=''.join('#' if v else '.' for v in pat[:,i])
    lines.append(col)
# print unique time pattern runs
from itertools import groupby
runs=[(k,len(list(g))) for k,g in groupby(lines)]
for k,l in runs:
    print(f"{l:3d} {k}")
