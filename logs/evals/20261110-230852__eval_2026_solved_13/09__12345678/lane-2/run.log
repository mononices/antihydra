# fine stft
f,t,S=stft(seg,fs=fs,nperseg=512,noverlap=384)
S=np.abs(S)
for i in range(S.shape[1]):
    col=S[:,i]
    if col.max()<8: continue
    # local peaks
    pk=[]
    for k in range(2,len(col)-2):
        if col[k]>col[k-1] and col[k]>=col[k+1] and col[k]>col.max()*0.08:
            pk.append((round(f[k]),round(float(col[k]),1)))
    print(f"{t0+t[i]:.4f} {pk}")
