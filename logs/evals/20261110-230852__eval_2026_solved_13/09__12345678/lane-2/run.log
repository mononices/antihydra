import matplotlib.pyplot as plt
from scipy.signal import spectrogram
w=wave.open('a.wav'); n=w.getnframes()
d=np.frombuffer(w.readframes(n),dtype='<i2').reshape(-1,2).astype(np.float64)
L=d[:,0]; R=d[:,1]; fs=44100

def spec(x, name, fmin, fmax, nperseg=4096, noverlap=None, tmax=None, db_lo=-110):
    if noverlap is None: noverlap=nperseg*3//4
    if tmax: x=x[:int(tmax*fs)]
    f,t,S=spectrogram(x,fs=fs,nperseg=nperseg,noverlap=noverlap,mode='magnitude')
    S=20*np.log10(S+1e-12)
    m=(f>=fmin)&(f<=fmax)
    fig,ax=plt.subplots(figsize=(24,6))
    ax.pcolormesh(t,f[m],S[m],shading='auto',cmap='inferno',vmin=db_lo,vmax=db_lo+70)
    ax.set_ylim(fmin,fmax)
    plt.tight_layout(); plt.savefig(name,dpi=100); plt.close()

spec((L+R)/2,'hf.png',15000,22050,nperseg=2048)
spec(L,'hfL.png',18000,22050,nperseg=1024)
spec(R,'hfR.png',18000,22050,nperseg=1024)
spec(L+R,'seg25.png',2000,20000,nperseg=2048) if False else None
