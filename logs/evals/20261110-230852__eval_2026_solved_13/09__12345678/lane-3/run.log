for f in tones:
    ref = np.exp(-2j*np.pi*f*t/sr)*np.hanning(w)
    e=[]
    for i in range(0,n-w,hop):
        e.append(abs(np.dot(seg[i:i+w], ref)))
    envs.append(np.array(e))
E=np.array(envs)
En = E/E.max(axis=1,keepdims=True)
# Resample to 40 ms per column (1764 samples)
col = int(0.04*sr/hop)  # frames per column
T = En.shape[1]//col
M = En[:, :T*col].reshape(7, T, col).mean(axis=2)
B = (M>0.25).astype(int)
print('matrix', B.shape)
np.save('B7.npy', B)
# render as image: rows = freq, cols = time; make each cell 20x20 px
import matplotlib; matplotlib.use('Agg')
import matplotlib.pyplot as plt
plt.figure(figsize=(T*0.35, 7*0.35))
plt.imshow(B, aspect='auto', origin='lower', cmap='gray_r', interpolation='nearest')
plt.yticks(range(7))
plt.savefig('B7.png', dpi=100, bbox_inches='tight')
# print as ascii art, top row first
for r in range(6,-1,-1):
    print(''.join('#' if B[r,c] else '.' for c in range(T)))
