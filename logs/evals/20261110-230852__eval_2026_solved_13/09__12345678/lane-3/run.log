import numpy as np
R = np.load('R.npy')
sr=44100
freqs7 = [881.3, 1320.6, 1759.6, 2200.0, 2640.85, 3081.2, 3518.86]
# time slots: from burst analysis, slots ~ every 0.04s? Actually runs were ~0.013s with gaps.
# Let's use a fine spectrogram and detect per-slot activity
seg = R[int(22.6*sr):int(24.3*sr)]
w=512; hop=64
freqs=np.fft.rfftfreq(w,1/sr)
S=[]
for i in range(0,len(seg)-w,hop):
    S.append(np.abs(np.fft.rfft(seg[i:i+w]*np.hanning(w))))
S=np.array(S)
cols = [np.argmin(np.abs(freqs-f)) for f in freqs7]
E = S[:,cols]  # time x 7
# normalize each column
En = E / E.max(axis=0, keepdims=True)
# overall activity
act = En.max(axis=1)
th=0.25
active = act>th
# find runs
runs=[]; i=0
while i<len(active):
    if active[i]:
        j=i
        while j<len(active) and active[j]: j+=1
        runs.append((i,j)); i=j
    else: i+=1
print('slots:', len(runs))
for a,b in runs:
    mid = (a+b)//2
    bits = ''.join('1' if En[mid,k]>0.3 else '0' for k in range(7))
    t0=22.6+a*hop/sr
    print(f'{t0:.3f} {bits}')
