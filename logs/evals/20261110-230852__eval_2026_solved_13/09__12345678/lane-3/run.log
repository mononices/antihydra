import numpy as np
R = np.load('R.npy')
sr=44100
f0=440.0
tones=[f0*k for k in range(2,9)]
print('tones', tones)
# bandpass via Goertzel-like: correlate with complex exponential over sliding window
seg = R[int(22.6*sr):int(24.3*sr)]
n=len(seg)
w=1024
hop=64
t=np.arange(w)
envs=[]
for f in tones:
    ref = np.exp(-2j*np.pi*f*t/sr)*np.hanning(w)
    e=[]
    for i in range(0,n-w,hop):
        e.append(abs(np.dot(seg[i:i+w], ref)))
    envs.append(np.array(e))
