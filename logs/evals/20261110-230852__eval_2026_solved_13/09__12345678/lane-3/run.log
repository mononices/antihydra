import numpy as np
L = np.load('L.npy'); R = np.load('R.npy')
sr=44100
# Find bursts in L: envelope over 441 samples (10ms)
def bursts(x, thresh=200, minlen=3):
    b=441
    m=len(x)//b
    e=np.abs(x[:m*b]).reshape(m,b).max(axis=1)
    act = e>thresh
    # find runs
    runs=[]
    i=0
    while i<m:
        if act[i]:
            j=i
            while j<m and act[j]: j+=1
            if j-i>=minlen: runs.append((i*b, j*b))
            i=j
        else: i+=1
    return runs
runsL = bursts(L)
print('L bursts:', len(runsL))
for s,e in runsL:
    print(f'{s/sr:8.3f} - {e/sr:8.3f}  dur {((e-s)/sr):.3f}')
EOF
