L = np.load('L.npy'); R = np.load('R.npy')
sr=44100
# The grid region: find precise start/end. Use R channel.
seg = R[int(22.5*sr):int(24.3*sr)]
w=512; hop=64
freqs=np.fft.rfftfreq(w,1/sr)
S=[]
for i in range(0,len(seg)-w,hop):
    S.append(np.abs(np.fft.rfft(seg[i:i+w]*np.hanning(w))))
S=np.array(S).T  # freq x time
