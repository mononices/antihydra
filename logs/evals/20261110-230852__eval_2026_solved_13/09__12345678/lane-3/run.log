import numpy as np
R = np.load('R.npy')
sr=44100
seg = R[int(22.5*sr):int(24.0*sr)]
# spectrogram with small windows
win = 2048
hop = 512
n = len(seg)
nf = win//2+1
frames = []
for i in range(0, n-win, hop):
    x = seg[i:i+win]*np.hanning(win)
    F = np.abs(np.fft.rfft(x))
    frames.append(F)
S = np.array(frames)
freqs = np.fft.rfftfreq(win, 1/sr)
# find peak frequencies per frame in 0-5000
mask = freqs < 5000
Sm = S[:, mask]
fm = freqs[mask]
for t in range(0, len(Sm), 20):
    row = Sm[t]
    # find local maxima above threshold
    idx = np.where(row > row.max()*0.3)[0]
    peaks = []
    for i in idx:
        if 0<i<len(row)-1 and row[i]>=row[i-1] and row[i]>=row[i+1]:
            peaks.append(round(fm[i]))
    print(f'{22.5 + t*hop/sr:.3f}s', sorted(set(peaks)))
EOF
