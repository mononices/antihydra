def fwd(ch,w,off): return w[(A.index(ch)+off+26)%26]
def ref(ch): return W['REF'][A.index(ch)]
def enc(seed,r1,r2,r3):
    c=seed
    c=fwd(c,W['I'],r1%26); c=fwd(c,W['II'],r2%26); c=fwd(c,W['III'],r3%26)
