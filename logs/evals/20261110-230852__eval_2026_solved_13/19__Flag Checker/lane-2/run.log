import requests, os, base64, binascii, collections
u='http://flagchecker.chal.csaw.io:5000/check'
UA='Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36'
s=requests.Session(); s.headers.update({'User-Agent':UA})
cnt=collections.Counter(); hits=[]
N=600
for i in range(N):
    b=os.urandom(16)
    v=base64.b64encode(b).decode()
    r=s.post(u, data={'flag':v}, timeout=10)
    cnt[(r.status_code, r.text.strip()[:40])]+=1
    if r.status_code!=400: hits.append((v, r.status_code, r.text.strip()[:60]))
print('base64-16:', cnt, hits[:5])
cnt=collections.Counter(); hits=[]
for i in range(N):
    b=os.urandom(32)
    v=base64.b64encode(b).decode()
    r=s.post(u, data={'flag':v}, timeout=10)
    cnt[(r.status_code, r.text.strip()[:40])]+=1
    if r.status_code!=400: hits.append((v, r.status_code, r.text.strip()[:60]))
print('base64-32:', cnt, hits[:5])
cnt=collections.Counter(); hits=[]
for i in range(300):
    b=os.urandom(16)
    v=b.hex()
    r=s.post(u, data={'flag':v}, timeout=10)
    cnt[(r.status_code, r.text.strip()[:40])]+=1
    if r.status_code!=400: hits.append((v, r.status_code, r.text.strip()[:60]))
print('hex-16:', cnt, hits[:5])
EOF
