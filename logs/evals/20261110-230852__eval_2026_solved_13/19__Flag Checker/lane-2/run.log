raw(b'flag=%ff%fe', 'application/x-www-form-urlencoded', 'invalid-utf8-form')
raw(b'flag=' + b'%'*10, 'application/x-www-form-urlencoded', 'bad-percent')
raw(b'{"a":'*2000 + b'1' + b'}'*2000, 'application/json', 'deep-json')
