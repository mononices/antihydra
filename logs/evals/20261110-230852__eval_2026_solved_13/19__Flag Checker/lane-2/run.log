cands += ['csaw{\n}', 'csaw{\t}', 'csaw{ }', 'csaw{{}}', 'csaw{}}', '{{csaw{test}}}', 'csaw{test}}', '{csaw{test}}']
cands += ['csaw{'+'A'*32+'}', 'csaw{'+'a'*32+'!}', 'csaw{'+'a'*32+' }']
for c in cands:
    r=s.post(u, data={'flag':c}, timeout=10)
    if r.status_code!=400:
        print('HIT', r.status_code, repr(c), r.text.strip()[:80])
print('done', len(cands))
EOF
