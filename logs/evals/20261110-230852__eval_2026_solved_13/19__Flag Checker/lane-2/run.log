s=requests.Session(); s.headers.update({'User-Agent':UA})
words='''check check_flag flagchecker checkflag verify validate submit answer guess result api/v1/check api/check api/flag api/verify v1/check v2/check checker checkers flag flags getflag get_flag secret secrets admin debug test health healthz status info metrics docs swagger swagger.json openapi.json api-docs redoc console shell exec eval source src app.py main.py server.py application.py wsgi.py config.py settings.py requirements.txt Dockerfile docker-compose.yml .env env .git/HEAD .git/config backup backup.zip backup.tar.gz source.zip app.zip static static/js static/css templates index index.html home login logout register user users profile account dashboard panel cgi-bin/ .well-known/security.txt crossdomain.xml robots.txt humans.txt readme README.md readme.md LICENSE CHANGELOG.md'''.split()
