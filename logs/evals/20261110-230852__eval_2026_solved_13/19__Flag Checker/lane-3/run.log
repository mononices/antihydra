import requests, random, string
UA='Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36'
url='http://flagchecker.chal.csaw.io:5000/check'
s=requests.Session(); s.headers.update({'User-Agent':UA})
def t(tag, v, **kw):
    try:
        r=s.post(url, data={'flag':v}, timeout=10, **kw)
        txt=r.text.strip()
        if 'Invalid input' not in txt:
            print(f"HIT {tag:30} {r.status_code} {txt[:100]}")
            return True
    except Exception as e:
        print(tag,'ERR',e)
    return False

hits=0
# bare lengths
for n in list(range(0,80))+[100,128,200,256]:
    for ch,tag in [('a','a'),('A','A'),('0','0'),('f','hex'),('Z','Z'),('_','_'),('-','-')]:
        if t(f'bare {tag} n={n}', ch*n): hits+=1
# hex strings
for n in [8,16,24,32,40,48,64,80,96,128]:
    v=''.join(random.choice('0123456789abcdef') for _ in range(n))
    if t(f'hexrand n={n}', v): hits+=1
    v=''.join(random.choice('0123456789ABCDEF') for _ in range(n))
    if t(f'HEXrand n={n}', v): hits+=1
# base64-ish
for n in [16,24,32,44,64,88]:
    v=''.join(random.choice(string.ascii_letters+string.digits) for _ in range(n))
    if t(f'alnum n={n}', v): hits+=1
    v=''.join(random.choice(string.ascii_letters+string.digits)+'+/=' for _ in range(n))
    if t(f'b64ish n={n}', v): hits+=1
# uuid
import uuid
if t('uuid', str(uuid.uuid4())): hits+=1
print('hits', hits)
EOF
