UA=b"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
def send(req, tag):
    try:
        s=socket.create_connection((host,port),10); s.settimeout(10)
        s.sendall(req)
        data=b''
        while True:
            try:
                c=s.recv(4096)
            except socket.timeout:
                break
            if not c: break
            data+=c
        print(f"--- {tag}\n{data.decode(errors='replace')[:600]}")
    except Exception as e:
        print(tag,'ERR',e)
    finally:
        try: s.close()
        except: pass

# HTTP/1.0
