def sample(v, n=30):
    ts=[]
    for _ in range(n):
        t0=time.perf_counter()
        r=s.post(url, data={'flag':v}, timeout=10)
        ts.append((time.perf_counter()-t0)*1000)
    return statistics.median(ts), min(ts), max(ts)

# baseline distribution
for v in ['a','csaw{','csaw{a}','csaw{c}','csaw{csaw{','csaw{csaw{a}']:
    med,mn,mx = sample(v)
    print(f"{v[:20]:22} med={med:7.2f} min={mn:7.2f} max={mx:7.2f}")
EOF
