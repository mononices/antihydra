import requests, hashlib, hmac, base64, time, json
UA='Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36'
url='http://flagchecker.chal.csaw.io:5000/check'
s=requests.Session(); s.headers.update({'User-Agent':UA})

# Hypothesis: checker expects an HMAC/signature or a specific encoded token, not a plain flag.
# Try sending values that look like a signed token.
cands = []
secret='csaw'
msg='test'
for algo in [hashlib.md5, hashlib.sha1, hashlib.sha256]:
    for key in ['', 'csaw', 'flag', 'secret', 'key']:
        h=hmac.new(key.encode(), msg.encode(), algo).hexdigest()
        cands.append(h)
        cands.append(h[:16])
        cands.append(h[:32])
        cands.append(h[:40])
        cands.append(h[:64])
        cands.append(base64.b64encode(bytes.fromhex(h)).decode())
        cands.append(base64.b64encode(bytes.fromhex(h)).decode().rstrip('='))
        cands.append(base64.urlsafe_b64encode(bytes.fromhex(h)).decode().rstrip('='))
# also try JWT-ish
cands.append('eyJhbGciOiJub25lIn0.eyJmbGFnIjoidGVzdCJ9.')
cands.append('eyJhbGciOiJIUzI1NiJ9.eyJmbGFnIjoiY3Nhd3t0ZXN0fSJ9.x')
seen=set()
hits=0
for v in cands:
    if v in seen: continue
    seen.add(v)
    r=s.post(url, data={'flag':v}, timeout=10)
    if 'Invalid input' not in r.text:
        print('HIT', v[:40], r.status_code, r.text[:120]); hits+=1
print('tested', len(seen), 'hits', hits)
EOF
