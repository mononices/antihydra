import requests, string
UA='Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120 Safari/537.36'
url='http://flagchecker.chal.csaw.io:5000/check'
s=requests.Session()
def t(v):
    r=s.post(url, data={'flag':v}, headers={'User-Agent':UA}, timeout=10)
    return r.status_code, r.text.strip()

cands = []
hexs='a'*32
hexs2='0123456789abcdef'*2
for n in [8,16,20,24,28,32,36,40,48,64]:
    cands.append(('hex'+str(n), 'csaw{'+('a'*n)+'}'))
cands += [
 ('hex32-real','csaw{'+hexs+'}'),
 ('hex32-real2','csaw{'+hexs2+'}'),
 ('upper','csaw{'+'A'*32+'}'),
 ('mixed','csaw{'+'aA1_'*8+'}'),
 ('underscore','csaw{'+'a_'*16+'}'),
 ('hyphen','csaw{'+'a-'*16+'}'),
 ('space','csaw{ '+'a'*30+'}'),
 ('newline','csaw{'+'a'*30+'\n}'),
 ('quote',"csaw{a'b}"),
 ('dquote','csaw{a"b}'),
 ('semi','csaw{a;b}'),
 ('dollar','csaw{$a}'),
 ('backtick','csaw{`a`}'),
 ('brace','csaw{a}b}'),
 ('nested','csaw{csaw{a}}'),
 ('prefix-only','csaw'),
 ('no-brace','csaw a'),
 ('long','csaw{'+'a'*200+'}'),
 ('unicode','csaw{àáâã}'),
 ('empty',''),
 ('spaces','   '),
]
for name,v in cands:
    try:
        sc,txt = t(v)
        print(f"{name:14} {sc} {txt[:80]}")
    except Exception as e:
        print(name,'ERR',e)
EOF
