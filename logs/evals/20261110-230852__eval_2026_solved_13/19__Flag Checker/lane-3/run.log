UA='Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120 Safari/537.36'
url='http://flagchecker.chal.csaw.io:5000/check'
s=requests.Session()
s.headers.update({'User-Agent':UA})
names = """flag Flag FLAG guess Guess input Input value Value data Data text Text answer Answer
password passwd pass secret key token code user username name query q search s f x v
flag_input flaginput flagInput user_flag userflag the_flag theflag flagcheck flag_check
check checker check_flag checker_flag submission submitted submit payload content body
message msg str string val arg args param parameter params field fields form
flag1 flag2 f1 fl4g fla9 csaw csaw_flag csawflag ctf ctf_flag ctfFlag
result output out response resp request req json raw
""".split()
extra = ['flag[]','flag[0]','flags[]','input[]','data[]','flag_value','flagvalue','flag-value','flagValue','FLAG','Flag','flag_','_flag','flag.','flag-']
names += extra
found=[]
for n in names:
    for mode in ('form','json'):
        try:
            if mode=='form':
                r=s.post(url, data={n:'csaw{test}'}, timeout=10)
            else:
                r=s.post(url, json={n:'csaw{test}'}, timeout=10)
        except Exception as e:
            print(n,mode,'ERR',e); continue
        txt=r.text.strip()
        if 'Invalid input' not in txt:
            print('HIT', mode, n, r.status_code, txt[:200])
            found.append((mode,n,txt))
print('done', len(found))
EOF
