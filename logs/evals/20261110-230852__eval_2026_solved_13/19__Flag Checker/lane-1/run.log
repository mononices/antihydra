        headers={"User-Agent":UA,"Content-Type":"application/x-www-form-urlencoded"}, method="POST")
    t0=time.perf_counter()
    try:
        resp=urllib.request.urlopen(r, timeout=10); resp.read()
    except urllib.error.HTTPError as e: e.read()
    return (time.perf_counter()-t0)*1000

# variance of identical request
ts=[post("flag=csaw{test}") for _ in range(300)]
ts.sort()
print("same request 300x: min=%.3f p25=%.3f med=%.3f p75=%.3f max=%.3f stdev=%.3f" % (
    ts[0], ts[75], ts[150], ts[225], ts[-1], statistics.stdev(ts)))
# distribution buckets
buckets=collections.Counter(round(t,1) for t in ts)
print("histogram:", sorted(buckets.items())[:15])
EOF
