import urllib.request, urllib.error, urllib.parse, collections
H="flagchecker.chal.csaw.io:5000"
UA="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 Chrome/120.0.0.0 Safari/537.36"
def post(body):
    r=urllib.request.Request(f"http://{H}/check", data=body.encode(),
        headers={"User-Agent":UA,"Content-Type":"application/x-www-form-urlencoded"}, method="POST")
    try:
        resp=urllib.request.urlopen(r, timeout=10)
        return resp.status, resp.read()[:200].decode(errors="replace")
    except urllib.error.HTTPError as e:
        return e.code, e.read()[:200].decode(errors="replace").replace("\n"," ")
    except Exception as e:
        return 0, str(e)[:80]

buckets=collections.defaultdict(list)
chars = {"A":"A", "a":"a", "0":"0", "underscore":"_", "dash":"-", "alnum":"aA0", "x":"x", "bang":"!"}
for cname,c in chars.items():
    for n in range(0,61):
        f = "csaw{" + c*(n if cname!="alnum" else n*1) + "}"
        s,b = post("flag="+urllib.parse.quote(f))
        buckets[(s,b[:40])].append(f"{cname}x{n}")
for k,v in buckets.items():
    print(k, "<-", len(v), "requests", v[:8])
print()
# bare inner content sweep
buckets2=collections.defaultdict(list)
for n in range(0,61):
    s,b=post("flag="+"a"*n)
    buckets2[(s,b[:40])].append(f"bare_a_x{n}")
for k,v in buckets2.items():
    print(k, "<-", len(v), v[:5])
EOF
