import socket, itertools
def raw(req, host="172.18.0.3", port=5000):
    s=socket.create_connection((host,port),timeout=8)
    s.sendall(req.encode())
    d=b""
    s.settimeout(4)
    try:
        while True:
            c=s.recv(4096)
            if not c: break
            d+=c
    except: pass
    s.close()
    return d

UA="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 Chrome/120.0.0.0 Safari/537.36"
def mkpost(body, extra=""):
    return (f"POST /check HTTP/1.1\r\nHost: flagchecker.chal.csaw.io:5000\r\nUser-Agent: {UA}\r\n"
            f"Content-Type: application/x-www-form-urlencoded\r\nContent-Length: {len(body)}\r\n"
            f"{extra}Connection: close\r\n\r\n{body}")

resp={}
for name, body, extra in [
    ("test", "flag=csaw{test}", ""),
    ("aaaa", "flag=csaw{aaaaaaaaaaaaaaaa}", ""),
    ("empty", "flag=", ""),
    ("noparam", "", ""),
    ("xff", "flag=csaw{test}", "X-Forwarded-For: 127.0.0.1\r\nX-Real-IP: 127.0.0.1\r\nTrue-Client-IP: 127.0.0.1\r\n"),
    ("hostlocal", "flag=csaw{test}", ""),  # will override below
]:
    if name=="hostlocal":
        req=(f"POST /check HTTP/1.1\r\nHost: localhost:5000\r\nUser-Agent: {UA}\r\n"
             f"Content-Type: application/x-www-form-urlencoded\r\nContent-Length: {len(body)}\r\nConnection: close\r\n\r\n{body}")
    else:
        req=mkpost(body, extra)
    d=raw(req)
    resp[name]=d
    print(f"--- {name} ({len(d)} bytes) ---")
    print(d.decode(errors="replace")[:400])
print("\n=== byte diffs vs 'test' ===")
base=resp["test"]
for k,v in resp.items():
    if k=="test": continue
    diffs=[(i,base[i:i+1],v[i:i+1]) for i in range(min(len(base),len(v))) if base[i]!=v[i]]
    print(k, "len_diff:", len(v)-len(base), "first_diffs:", diffs[:5])
EOF
