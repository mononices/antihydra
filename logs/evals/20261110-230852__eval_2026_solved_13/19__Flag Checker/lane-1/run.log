import urllib.request, urllib.error, json, itertools
B="http://flagchecker.chal.csaw.io:5000/check"
def post(body, ct="application/x-www-form-urlencoded"):
    req=urllib.request.Request(B, data=body.encode(), headers={"User-Agent":"Mozilla/5.0","Content-Type":ct})
    try:
        r=urllib.request.urlopen(req, timeout=10)
        return r.status, r.read().decode()
    except urllib.error.HTTPError as e:
        return e.code, e.read().decode()
    except Exception as e:
        return 0, str(e)

resp={}
for n in range(0,70):
    s,b=post("flag="+"A"*n)
    resp.setdefault(b,[]).append(("A*%d"%n,s))
for k,v in resp.items():
    print(repr(k), "<-", v[:6], "count:", len(v))
# special formats
tests = ["csaw{a}", "csaw{aaaaaaaa}", "csaw{"+"a"*40+"}", "csaw{a_b_c}", "csaw{1234}",
         "CSAW{a}", "csaw{a}", "flag{a}", "csaw{test_flag}", "csaw{aaaaaaaaaaaaaaaaaaaa}"]
for t in tests:
    print(repr(t), post("flag="+urllib.parse.quote(t)))
EOF
