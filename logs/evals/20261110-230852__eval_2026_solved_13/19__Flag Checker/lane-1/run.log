import urllib.request, urllib.error, urllib.parse, itertools, json
H="flagchecker.chal.csaw.io"
P=5000
UA="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
def req(method, path, body=None, ct=None, extra=None):
    h={"User-Agent":UA, "Accept":"*/*", "Accept-Language":"en-US,en;q=0.9",
       "Origin":f"http://{H}:{P}", "Referer":f"http://{H}:{P}/"}
    if ct: h["Content-Type"]=ct
    if extra: h.update(extra)
    data=body.encode() if isinstance(body,str) else body
    r=urllib.request.Request(f"http://{H}:{P}{path}", data=data, headers=h, method=method)
    try:
        resp=urllib.request.urlopen(r, timeout=10)
        return resp.status, resp.read()[:200].decode(errors="replace")
    except urllib.error.HTTPError as e:
        return e.code, e.read()[:200].decode(errors="replace")
    except Exception as e:
        return 0, str(e)[:100]

flag="csaw{test}"
print("== placement tests ==")
print("query  :", req("POST","/check?flag="+urllib.parse.quote(flag), ""))
print("header :", req("POST","/check","", extra={"X-Flag":flag,"Flag":flag}))
print("cookie :", req("POST","/check","", extra={"Cookie":"flag="+flag}))
print("raw txt:", req("POST","/check", flag, "text/plain"))
print("json fl:", req("POST","/check", json.dumps({"flag":flag}), "application/json"))
print("form   :", req("POST","/check", "flag="+urllib.parse.quote(flag), "application/x-www-form-urlencoded"))
print("encoded:", req("POST","/check", "flag=csaw%7Btest%7D", "application/x-www-form-urlencoded"))
print("dup    :", req("POST","/check", "flag=csaw%7Btest%7D&flag=x", "application/x-www-form-urlencoded"))
print("int    :", req("POST","/check", "flag=12345678", "application/x-www-form-urlencoded"))
print("hex32  :", req("POST","/check", "flag=csaw{%s}"%("a"*32), "application/x-www-form-urlencoded"))
print("noct   :", req("POST","/check", "flag="+urllib.parse.quote(flag)))
print()
print("== endpoint fuzz (GET) ==")
words=["flag","flags","check","checkflag","check_flag","verify","submit","checker","api","api/check","api/flag",
       "status","health","debug","admin","source","code","app","app.py","main.py","server.py","static","uploads",
       "login","user","me","info","config","env","robots.txt","favicon.ico",".well-known/flag","index","index.html",
       "flagchecker","getflag","the-flag","realflag","trueflag","correct","correct_flag","answer","secret"]
for w in words:
    s,b=req("GET","/"+w)
    if s!=404: print(f"GET /{w} -> {s} {b[:80]!r}")
    s,b=req("POST","/"+w, "flag="+urllib.parse.quote(flag), "application/x-www-form-urlencoded")
    if s!=404: print(f"POST /{w} -> {s} {b[:80]!r}")
EOF
