import base64, json, urllib.request

def send(data):
    req = urllib.request.Request('http://crypto.chal.csaw.io:21022/send',
        data=json.dumps({'data':data}).encode(), headers={'Content-Type':'application/json'})
    return json.loads(urllib.request.urlopen(req).read())

def ct(d):
    return base64.b64decode(send(d)['ciphertext'])

# determinism
a1 = ct('A'*16); a2 = ct('A'*16)
print('deterministic:', a1==a2)
print('a1', a1.hex())
print('a2', a2.hex())

b = ct('B'*16)
print('b ', b.hex())
x = bytes(p^q for p,q in zip(a1,b))
print('xor a1^b:', x.hex())
print('expected plaintext xor:', (b'A'*16).hex(), '^', (b'B'*16).hex())
print('pt xor:', bytes(p^q for p,q in zip(b'A'*16,b'B'*16)).hex())
