import json, urllib.request, urllib.error

def post(path, obj, raw=None):
    data = raw if raw is not None else json.dumps(obj).encode()
    req = urllib.request.Request('http://crypto.chal.csaw.io:21022'+path, data=data,
        headers={'Content-Type':'application/json'})
    try:
        r = urllib.request.urlopen(req)
        return r.status, r.read()[:300]
    except urllib.error.HTTPError as e:
        return e.code, e.read()[:300]

tests = [
 ('/send', None, b'notjson'),
 ('/send', None, b'{}'),
 ('/send', {'data':123}, None),
 ('/send', {'data':None}, None),
 ('/send', {'data':['a','b']}, None),
 ('/send', {'data':{'x':1}}, None),
 ('/send', {'data':True}, None),
 ('/send', {'x':'abc'}, None),
 ('/send', {'data':'abc','extra':1}, None),
]
for t in tests:
    print(t[0], t[1] if t[1] is not None else t[2], '->', post(*t))
EOF
