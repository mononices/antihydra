from oracle import plen
import random, string, sys

CHARSET = string.ascii_letters + string.digits + '_{}!?-.'  # likely flag chars
# We'll expand to full printable if needed
FULL = ''.join(sorted(set(string.printable[:-2]) - set('"\\')))

random.seed(11)
PREFIX = ''.join(random.choice(string.ascii_letters+string.digits) for _ in range(48))

def find_next(known, charset=FULL, tries=1):
    """Find next char of secret by minimizing compression of known + c"""
    results = []
    for c in charset:
        L = plen(known + c)
        results.append((L, c))
    results.sort()
    return results

if __name__ == '__main__':
    known = 'c'
    print('start:', known)
    for step in range(60):
        res = find_next(known)
        best = res[0]
        print(f'step {step}: best={best[1]!r} len={best[0]}  (2nd: {res[1][1]!r} {res[1][0]}, 3rd: {res[2][1]!r} {res[2][0]})')
        known += best[1]
        print('  known so far:', known)
        if '}' in known: break
    print('FINAL:', known)
