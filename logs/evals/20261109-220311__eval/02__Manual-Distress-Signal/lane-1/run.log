import socket, json, base64, re

HOST, PORT = 'crypto.chal.csaw.io', 21022

def post(obj, timeout=15):
    body = json.dumps(obj)
    s = socket.create_connection((HOST, PORT), timeout=timeout)
    s.settimeout(timeout)
    r = f'POST /send HTTP/1.1\r\nHost: {HOST}\r\nContent-Type: application/json\r\nContent-Length: {len(body)}\r\nConnection: close\r\n\r\n' + body
    s.sendall(r.encode())
    data = b''
    try:
        while True:
            c = s.recv(8192)
            if not c: break
            data += c
    except Exception: pass
    s.close()
    return data.decode('utf-8','replace')

def plen(payload):
    """Return TLS record payload length (total - 5 header)"""
    d = post({'data': payload})
    m = re.search(r'"ciphertext":"([^"]+)"', d)
    if not m: return None
    b = base64.b64decode(m.group(1))
    return len(b) - 5

def tlen(payload):
    d = post({'data': payload})
    m = re.search(r'"ciphertext":"([^"]+)"', d)
    if not m: return None
    b = base64.b64decode(m.group(1))
    return len(b)
