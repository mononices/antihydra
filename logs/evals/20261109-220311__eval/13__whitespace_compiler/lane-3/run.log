import subprocess, sys
path='/home/ctfplayer/ctf_files/dist/whitespace_compiler'
data=open(path,'rb').read()
# parse section headers
out=subprocess.run(['readelf','-S','-W',path],capture_output=True,text=True).stdout
secs=[]
for line in out.splitlines():
    line=line.strip()
    if line.startswith('[') and ']' in line:
        parts=line.split(']',1)[1].split()
        if len(parts)>=4:
            name=parts[0]; addr=int(parts[2],16); off=int(parts[3],16); size=int(parts[4],16)
            secs.append((name,addr,off,size))
def v2o(v):
    for name,addr,off,size in secs:
        if addr<=v<addr+size and addr!=0:
            return off+(v-addr)
    return None
def dump(v,n=200):
    o=v2o(v)
    if o is None: return None
    return data[o:o+n]
if __name__=='__main__':
    for a in sys.argv[1:]:
        v=int(a,16)
        print(hex(v), dump(v))
EOF
