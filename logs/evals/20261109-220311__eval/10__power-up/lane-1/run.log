out = subprocess.run(['objdump','-d','--no-show-raw-insn','-M','intel','chal'],capture_output=True,text=True).stdout
# map plt.sec addresses to names
import re
addr2name={}
for m in re.finditer(r'^  ([0-9a-f]+):\tjmp    QWORD PTR \[rip\+0x[0-9a-f]+\]        # ([0-9a-f]+) <([A-Za-z_0-9@.]+)>', out, re.M):
    addr2name[m.group(1)] = m.group(3)
for m in re.finditer(r'^0000000000(401[0-9a-f]{3}) <\.(plt\.sec)?>', out, re.M):
    pass
# simpler: find blocks
blocks = re.split(r'\n(?=0000000000)', out)
for b in blocks:
    m = re.match(r'0000000000(40[0-9a-f]+) <([^>]+)>', b)
    if not m: continue
    addr, name = m.group(1), m.group(2)
    if '<.plt.sec>' in name:
        pass
    if '.plt.sec' in name:
        for mm in re.finditer(r'^  ([0-9a-f]+):\tjmp    QWORD PTR \[rip\+0x[0-9a-f]+\]        # ([0-9a-f]+) <([^>]+)>', b, re.M):
            print(mm.group(1), mm.group(3))
EOF
