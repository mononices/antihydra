from math import gcd
import sympy

n1 = 
n2 = 
d1 = 
d2 = 
e = 65537

p = gcd(n1, n2)
q1 = n1 // p
q2 = n2 // p

for name, n, d, q in [("key1", n1, d1, q1), ("key2", n2, d2, q2)]:
    phi = (p-1)*(q-1)
    lam = phi // gcd(p-1, q-1)
    print(name, "e*d %% phi ==1:", (e*d) % phi == 1, " e*d %% lambda ==1:", (e*d) % lam == 1)
    print(name, "d bits:", d.bit_length(), "phi bits:", phi.bit_length())
    # maybe d itself encodes something
    b = d.to_bytes((d.bit_length()+7)//8, 'big')
    print(name, "d as bytes:", b[:60])
EOF
