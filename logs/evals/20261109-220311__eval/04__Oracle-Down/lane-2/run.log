def one(data):
    s=socket.create_connection((HOST,PORT), timeout=10); s.settimeout(5)
    buf=b''
    try:
        while b'> ' not in buf: buf+=s.recv(4096)
    except socket.timeout: pass
    s.sendall(data.hex().encode()+b'\n')
    time.sleep(0.08)
    out=b''
    try:
        while True:
            c=s.recv(65536)
            if not c: break
            out+=c
    except socket.timeout: pass
    s.close()
    return buf+out

