import socket, time
HOST='crypto.chal.csaw.io'; PORT=21004
def raw(lines, wait=0.5):
    s=socket.create_connection((HOST,PORT), timeout=10); s.settimeout(5)
    buf=b''
    try:
        while b'> ' not in buf: buf+=s.recv(4096)
    except socket.timeout: pass
    for ln in lines:
        s.sendall(ln+b'\n'); time.sleep(0.15)
    time.sleep(wait)
    out=b''
    try:
        while True:
            c=s.recv(65536)
            if not c: break
            out+=c
    except socket.timeout: pass
    s.close()
    return buf+out

