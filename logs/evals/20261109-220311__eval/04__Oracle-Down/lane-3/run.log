import hashlib
H = "4ee48433a6a3ad49b5783b530ab792d46c7af620b96832f372cd87d94dc3c7b2f8a4febf4d43f07a23a43f205e23e163683ddf73cbe3203bf62dd67c1537610e2bebd55f6976a6da99abb421d32738ce87518670fce29f1f9adccbe022fd7dc9"
d = bytes.fromhex(H)
# try simple transformations: XOR halves, etc.
a = d[:48]; b = d[48:]
x = bytes(p^q for p,q in zip(a,b))
print("xor halves:", x.hex())
print("a==b?", a==b)
# check if first 48 is key and second 48 is hmac of something?
import hmac
print("hmac-md5(a,b):", hmac.new(a,b,hashlib.md5).hexdigest())
print("hmac-sha256(a,b)[:48]:", hmac.new(a,b,hashlib.sha256).digest()[:48].hex())
# check if the last 48 bytes could be an encryption of something with first 48 as key
# AES-256 ECB? first 32 key, next 16 iv, remaining 48 ciphertext
from Crypto.Cipher import AES
for klen, ivlen in [(16,16),(32,16),(16,0),(32,0)]:
    key = d[:klen]; rest = d[klen:]
    if ivlen:
        iv = rest[:ivlen]; ct = rest[ivlen:]
    else:
        iv = b"\x00"*16; ct = rest
    if len(ct) % 16 != 0: continue
    try:
        c = AES.new(key, AES.MODE_CBC, iv)
        pt = c.decrypt(ct)
        print(f"AES{klen*8}-CBC ivlen={ivlen}:", pt.hex(), repr(pt))
    except Exception as e:
        print("err", e)
