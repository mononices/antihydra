import hashlib, hmac, itertools
H = "4ee48433a6a3ad49b5783b530ab792d46c7af620b96832f372cd87d94dc3c7b2f8a4febf4d43f07a23a43f205e23e163683ddf73cbe3203bf62dd67c1537610e2bebd55f6976a6da99abb421d32738ce87518670fce29f1f9adccbe022fd7dc9"
d = bytes.fromhex(H)
print("bytes:", d.hex())
# try split points and hash functions
hashes = {
 'md5': lambda b: hashlib.md5(b).digest(),
 'sha1': lambda b: hashlib.sha1(b).digest(),
 'sha256': lambda b: hashlib.sha256(b).digest(),
 'sha512': lambda b: hashlib.sha512(b).digest(),
 'sha384': lambda b: hashlib.sha384(b).digest(),
 'sha224': lambda b: hashlib.sha224(b).digest(),
 'blake2b': lambda b: hashlib.blake2b(b).digest(),
 'blake2s': lambda b: hashlib.blake2s(b).digest(),
 'sha3_256': lambda b: hashlib.sha3_256(b).digest(),
 'sha3_512': lambda b: hashlib.sha3_512(b).digest(),
}
for n in range(1, 96):
    for hn, hf in hashes.items():
        try:
            dig = hf(d[:n])
        except Exception:
            continue
        if dig == d[n:]:
            print("MATCH", hn, "prefix len", n)
        if d[:n] == dig:
            print("MATCH-suffix-hash", hn, "suffix len", 96-n)
# also try hash of whole == part
for hn, hf in hashes.items():
    dig = hf(d)
    if dig in d:
        print("hash of whole inside:", hn)
print("done")
