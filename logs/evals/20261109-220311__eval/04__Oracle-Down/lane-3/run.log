for name, data in cases.items():
    ts = []
    msgs = set()
    for i in range(15):
        r, tc, tp = send(data.hex().encode())
        ts.append(tp)
        msgs.add(msg(r)[:40])
    print(f"{name:8s} median={statistics.median(ts)*1000:7.1f}ms min={min(ts)*1000:7.1f} max={max(ts)*1000:7.1f} msgs={msgs}")
