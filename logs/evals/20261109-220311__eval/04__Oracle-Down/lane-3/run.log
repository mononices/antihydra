H = "4ee48433a6a3ad49b5783b530ab792d46c7af620b96832f372cd87d94dc3c7b2f8a4febf4d43f07a23a43f205e23e163683ddf73cbe3203bf62dd67c1537610e2bebd55f6976a6da99abb421d32738ce87518670fce29f1f9adccbe022fd7dc9"
HB = bytes.fromhex(H)

def send(data, wait=3.0):
    t0=time.time()
    s = socket.create_connection(("crypto.chal.csaw.io", 21004), timeout=10)
    s.settimeout(wait)
    buf = b""
    try:
        while True:
            chunk = s.recv(4096)
            if not chunk: break
            buf += chunk
            if b"> " in buf: break
    except socket.timeout:
        pass
    t1=time.time()
    s.sendall(data + b"\n")
    out = b""
    try:
        while True:
            chunk = s.recv(4096)
            if not chunk: break
            out += chunk
            if b"> " in out: break
    except socket.timeout:
        pass
    t2=time.time()
    s.close()
    return (buf + out).decode(errors="replace"), t1-t0, t2-t1

def msg(r):
    idx = r.find("> ")
    return r[idx+2:].replace("\r\n"," ").strip()

# careful timing: 15 samples per case, report median
cases = {"orig": HB, "zeros": bytes(96), "ff": b"\xff"*96}
