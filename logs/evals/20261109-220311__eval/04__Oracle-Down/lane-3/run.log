import socket, time

H = "4ee48433a6a3ad49b5783b530ab792d46c7af620b96832f372cd87d94dc3c7b2f8a4febf4d43f07a23a43f205e23e163683ddf73cbe3203bf62dd67c1537610e2bebd55f6976a6da99abb421d32738ce87518670fce29f1f9adccbe022fd7dc9"
HB = bytes.fromhex(H)

class Conn:
    def __init__(self):
        self.s = socket.create_connection(("crypto.chal.csaw.io", 21004), timeout=10)
        self.s.settimeout(5)
        buf=b""
        while b"> " not in buf:
            buf += self.s.recv(4096)
    def send(self, data):
        t0=time.time()
        self.s.sendall(data + b"\n")
        out=b""
        self.s.settimeout(3.0)
        try:
            while b"> " not in out:
                c=self.s.recv(4096)
                if not c: break
                out+=c
        except socket.timeout:
            pass
        t1=time.time()
        return out.decode(errors="replace"), t1-t0
    def close(self):
        try: self.s.close()
        except: pass

def verdict(out):
    if "Attempting" in out: return "VALID"
    if "Invalid" in out: return "invalid"
    return "OTHER:" + out[:60]

c = Conn()
# Try single byte changes: for each position, try all 256 values, but only
# report those that give a non-"invalid" response.  That's 96*256 = 24576
# requests -- too many.  Instead try replacing each byte with 0xff and with
# 0x00^orig (i.e., complement).
for pos in range(96):
    for val in [0xff]:
        b = bytearray(HB); b[pos] = val
        out, dt = c.send(bytes(b).hex().encode())
        v = verdict(out)
        if v != "invalid":
            print(f"pos {pos:3d} -> {val:#04x} : {v} dt={dt*1000:.0f}ms", flush=True)
    b = bytearray(HB); b[pos] ^= 0xff
    out, dt = c.send(bytes(b).hex().encode())
    v = verdict(out)
    if v != "invalid":
        print(f"pos {pos:3d} -> complement : {v} dt={dt*1000:.0f}ms", flush=True)
c.close()
print("done")
