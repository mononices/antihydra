from pwn import *
import struct
context.log_level='error'
p=process('/home/ctfplayer/workspace/chal')
def menu(n):
    p.recvuntil(b'6. Detonate Bomb\n'); p.send(str(n).encode()+b'\n')
def build(pos,size):
    menu(1); p.recvuntil(b'position: '); p.send(str(pos).encode()+b'\n')
    p.recvuntil(b'capacity of: '); p.send(str(size).encode()+b'\n')
    return p.recvline()
def launch(pos):
    menu(2); p.recvuntil(b'position: '); p.send(str(pos).encode()+b'\n')
    return p.recvline()
def dump(tag):
    hb=None
    for line in open('/proc/%d/maps'%p.pid):
        if '[heap]' in line: hb=int(line.split('-')[0],16); break
    mem=open('/proc/%d/mem'%p.pid,'rb',0); mem.seek(hb); data=mem.read(0x1800)
    out=[]; off=0
    while off<0x1800:
        sz=struct.unpack('<Q',data[off+8:off+16])[0]&~7
        if 0<sz<0x100000:
            out.append('+%#x:%#x'%(off,sz)); off+=sz
        else: off+=0x10
    print(tag,' '.join(out))
