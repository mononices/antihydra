def recover(leak, low):
    # leak = X ^ (X<<12 | low),  X = heap page number (hb>>12)
    X=0
    for i in range(11,-1,-1):          # nibbles, MSB first
        shift=i*4
        qn = ((X<<12)>>shift)&0xf if i>=3 else 0
        if i==9: qn=(low>>8)&0xf
        if i==10: qn=(low>>4)&0xf
        if i==11: qn=low&0xf
        xn=((leak>>shift)&0xf)^qn
        X|=xn<<shift
    return X<<12
