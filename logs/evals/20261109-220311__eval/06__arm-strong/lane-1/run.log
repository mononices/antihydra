import re
lines = open('full_disasm.txt').read().split('\n')
epi = re.compile(r'ldp\tx29, x30, \[sp(\], #\d+|, #\d+\], #\d+|, #\d+\])')
results=[]
for i,l in enumerate(lines):
    m = re.search(r'(4[0-9a-f]{5}):\tf9[0-9a-f]{6}\tldr\tx0, \[sp, #(\d+)\]', l)
    if not m: continue
    addr, off = m.group(1), int(m.group(2))
    # scan forward until epilogue (max 15 instrs), ensure x0 untouched
    ok=False; desc=[]
    for j in range(i+1, min(i+16, len(lines))):
        t = lines[j]
        if re.search(r'\t(w0|x0|w[0-9]+, w0)', t) and 'ldr' not in t.split('\t')[-1][:4]:
            desc.append(t.strip()); 
            if re.search(r'\tmov\t(w0|x0),|add\t(w0|x0),|ldr\t(w0|x0),', t):
                ok=False; break
        if epi.search(t):
            # check next is ret
            if 'ret' in lines[j+1]:
                ok=True; desc.append(t.strip())
            break
        if 'bl\t' in t or 'blr' in t: 
            desc.append('CALL:'+t.strip()); break
    if ok:
        results.append((addr, off, ' ; '.join(desc)))
for r in results[:25]: print(r)
print(len(results))
