import re
lines = open('full_disasm.txt').read().split('\n')
epi = re.compile(r'ldp\tx29, x30, \[sp')
results=[]
for i,l in enumerate(lines):
    m = re.search(r'^\s*(4[0-9a-f]{5}):\t[0-9a-f]{8} \tldr\tx0, \[sp, #(\d+)\]$', l)
    if not m: continue
    addr, off = m.group(1), int(m.group(2))
    ok=False; desc=[]
    for j in range(i+1, min(i+16, len(lines))):
        t = lines[j]
        if 'bl\t' in t or 'blr' in t: 
            desc.append('CALL'); break
        if re.search(r'\t(cbnz|cbz|b\.|tb)', t): desc.append('BR'); break
        if epi.search(t):
            if 'ret' in lines[j+1]:
                ok=True; desc.append(t.strip().split('\t')[-1])
            break
    if ok: results.append((addr, off, ' ; '.join(desc)))
for r in results[:40]: print(r)
print("total:", len(results))
EOF
