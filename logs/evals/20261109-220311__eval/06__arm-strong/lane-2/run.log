from capstone import *
data=open('chal','rb').read()
# .text: vaddr 0x4002c0 offset 0x2c0 size 0x5464c
base=0x400000
text_off=0x2c0
text_size=0x5464c
code=data[text_off:text_off+text_size]
md=Cs(CS_ARCH_ARM64, CS_MODE_ARM)
md.detail=False
insns=list(md.disasm(code, base+text_off))
print("insns",len(insns))
# build index
import re
def find(seq_regex, maxn=10):
    out=[]
    for i in range(len(insns)):
        s=insns[i]
        if re.fullmatch(seq_regex, s.mnemonic+' '+s.op_str):
            # check next insn is ret
            if i+1<len(insns) and insns[i+1].mnemonic=='ret':
                out.append(s.address)
    return out[:maxn]
for pat in [r'ldp x0, x1, \[sp\], #0x10', r'ldp x1, x2, \[sp\], #0x10', r'ldp x2, x3, \[sp\], #0x10',
