            r'mov x8, x[0-9]+', r'ldp x8, x9, \[sp\], #0x10', r'ldp x0, x19, \[sp\], #0x10',
            r'ldp x19, x20, \[sp\], #0x10']:
    print(pat, [hex(a) for a in find(pat)])
