[36] create_file {"content": "#!/usr/bin/env python3\n\"\"\"Search gadgets.txt (custom finder output) for useful patterns.\"\"\"\nimport re, sys\n\ngadgets = []\nfor line in open('gadgets_custom.txt'):\n    line = line.rstrip('\\n')\n    if ' : ' in line:\n        a, t = line.split(' : ', 1)\n        gadgets.append((int(a, 16), t.strip()))\n\ndef find(pat, limit=15):\n    rx = re.compile(pat)\n    out = []\n    for a, t in gadgets:\n        if rx.match(t):\n            out.append((a, t))\n    return out[:limit]\n\npats = sys.argv[1:]\nfor p in pats:\n    print('### %s' % p)\n    for a, t in find(p):\n        print('  %#x : %s' % (a, t))\n", "path": "/home/ctfplayer/workspace/search.py"}
