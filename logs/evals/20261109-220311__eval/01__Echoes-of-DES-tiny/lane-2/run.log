import sys
from tables import *
d=open('/home/ctfplayer/ctf_files/dist/scrambled','rb').read()
body=d[1:4441]

def apply_table(data, table, outbits):
    # table entries are 1-based bit indices into input MSB-first per block
    inbits=len(table)
    ibytes=inbits//8
    assert inbits%8==0
    blocks=len(data)//ibytes
    out=bytearray()
    for b in range(blocks):
        chunk=data[b*ibytes:(b+1)*ibytes]
        val=int.from_bytes(chunk,'big')
        outval=0
        for pos in table:
            # extract bit at position pos (1=MSB)
            bit=(val>>(inbits-pos))&1
            outval=(outval<<1)|bit
        out+=outval.to_bytes(outbits//8,'big')
    return bytes(out)

def invert_table(table):
    n=len(table)
    inv=[0]*n
    for i,p in enumerate(table):
        inv[p-1]=i+1
    return inv

def stats(x,label):
    z=x.count(b'\x00'*8) if False else sum(1 for i in range(0,len(x)//8*8,8) if x[i:i+8]==b'\x00'*8)
    pr=sum(32<=c<127 or c in (9,10,13) for c in x)/len(x)
    ent=len(set(x))
    print(f'{label}: zeroblocks={z} printable={pr:.3f} uniq={ent} head={x[:24].hex()}')

for name,tbl in [('IP',IP),('FP',FP),('invIP',invert_table(IP)),('invFP',invert_table(FP))]:
    for fn,label in [(apply_table,'apply')]:
        x=fn(body,tbl,64)
        stats(x,f'{label}_{name}')
