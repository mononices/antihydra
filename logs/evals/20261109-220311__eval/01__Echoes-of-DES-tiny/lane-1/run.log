    bits=bytes_to_bits(key)
    pc1=permute(bits,PC1)
    C=pc1[:28]; D=pc1[28:]
    rks=[]
    for s in SHIFTS:
        C=rotl(C,s); D=rotl(D,s)
        rks.append(permute(C+D,PC2))
    return rks

