    e=permute(r,E)
    x=[a^b for a,b in zip(e,k)]
    out=[]
    for i in range(8):
        b=x[6*i:6*i+6]
        row=(b[0]<<1)|b[5]
        col=(b[1]<<3)|(b[2]<<2)|(b[3]<<1)|b[4]
        v=SBOX[i][row][col]
        out.extend([(v>>3)&1,(v>>2)&1,(v>>1)&1,v&1])
    p=permute(out,P)
    return p

def des_encrypt(key,block):
    bits=bytes_to_bits(block)
    ip=permute(bits,IP)
    L=ip[:32]; R=ip[32:]
    rks=key_schedule(key)
    for i in range(16):
        f=feistel(R,rks[i])
        L=[a^b for a,b in zip(L,f)]
        if i<15: L,R=R,L
    pre=FP(L+R)
    return bits_to_bytes(pre)

def des_decrypt(key,block):
    bits=bytes_to_bits(block)
    ip=permute(bits,IP)
    L=ip[:32]; R=ip[32:]
    rks=key_schedule(key)
    for i in range(16):
        f=feistel(R,rks[15-i])
        L=[a^b for a,b in zip(L,f)]
        if i<15: L,R=R,L
    pre=FP(L+R)
    return bits_to_bytes(pre)

# verify
for _ in range(5):
    k=bytes(random.randrange(256) for _ in range(8))
    b=bytes(random.randrange(256) for _ in range(8))
    e=des_encrypt(k,b)
    assert e==DES.new(k,DES.MODE_ECB).encrypt(b), (k.hex(),e.hex(),DES.new(k,DES.MODE_ECB).encrypt(b).hex())
    d=des_decrypt(k,e)
    assert d==b
print('pure-python DES verified')
