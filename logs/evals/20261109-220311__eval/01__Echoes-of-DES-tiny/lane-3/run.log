import sdes
data=open('/home/ctfplayer/ctf_files/dist/scrambled','rb').read()

def make_map(key,order,sh2,swap,outorder,inv=False):
    m=bytearray(256)
    for b in range(256):
        k1,k2=sdes.subkeys(key,sh2)
        if inv:
            k1,k2=k2,k1
        bits=sdes.perm(sdes.tobits(b,8),sdes.IP); l,r=bits[:4],bits[4:]
        if swap: l,r=r,l
        l,r=r,[a^c for a,c in zip(l,sdes.F(r,k1,order))]
        l,r=r,[a^c for a,c in zip(l,sdes.F(r,k2,order))]
        if swap: l,r=r,l
        m[b]=sdes.frombits(sdes.perm((l+r) if outorder==0 else (r+l),sdes.IPINV))
    return bytes(m)

def score(pt):
    pr=sum(1 for b in pt if 32<=b<127 or b in (9,10,13,0))
    # english-ish bonus for letters/space
    letters=sum(1 for b in pt if b in b' etaoinshrdluETAIOSHRDLU(){}_=:#\'"')
    return pr + letters

res=[]
for order in (0,1):
  for sh2 in (1,2):
    for swap in (0,1):
      for outorder in (0,1):
        for inv in (0,1):
          for key in range(1024):
            m=make_map(key,order,sh2,swap,outorder,inv)
            pt=bytes(m[b] for b in data[:400])
            res.append((score(pt),order,sh2,swap,outorder,inv,key))
res.sort(reverse=True)
for r in res[:10]:
    print(r)
