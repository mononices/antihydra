import base64
code = r'''P10=[3,5,2,7,4,10,1,9,8,6]
P8=[6,3,7,4,8,5,10,9]
P4=[2,4,3,1]
IP=[2,6,3,1,4,8,5,7]
IPINV=[4,1,3,5,7,2,8,6]
EP=[4,1,2,3,2,3,4,1]
S0=[[1,0,3,2],[3,2,1,0],[0,2,1,3],[3,1,3,2]]
S1=[[0,1,2,3],[2,0,1,3],[3,0,1,0],[2,1,0,3]]

def perm(bits,table): return [bits[i-1] for i in table]
def tobits(x,n): return [(x>>(n-1-i))&1 for i in range(n)]
def frombits(b): 
    v=0
    for x in b: v=(v<<1)|x
    return v
def ls(bits,n): return bits[n:]+bits[:n]
def rowcol(b4,order=0):
    if order==0: return ((b4[0]<<1)|b4[3],(b4[1]<<1)|b4[2])
    return ((b4[1]<<1)|b4[2],(b4[0]<<1)|b4[3])
def sbox(b4,box,order=0):
    r,c=rowcol(b4,order); return tobits(box[r][c],2)
def subkeys(key10,sh2=2):
    k=perm(tobits(key10,10),P10); l,r=k[:5],k[5:]
    l,r=ls(l,1),ls(r,1); k1=perm(l+r,P8)
    l,r=ls(l,sh2),ls(r,sh2); k2=perm(l+r,P8)
    return k1,k2
def F(r4,sk,order=0):
    e=perm(r4,EP); x=[a^b for a,b in zip(e,sk)]
    s0=sbox(x[:4],S0,order); s1=sbox(x[4:],S1,order)
    return perm(s0+s1,P4)
def enc_block(pt,key10,order=0,rounds=2):
    k1,k2=subkeys(key10)
    b=perm(tobits(pt,8),IP); l,r=b[:4],b[4:]
    l,r=r,[a^b for a,b in zip(l,F(r,k1,order))]
    l,r=r,[a^b for a,b in zip(l,F(r,k2,order))]
    if rounds==1: pass
    return frombits(perm(l+r,IPINV))
def dec_block(ct,key10,order=0):
    k1,k2=subkeys(key10)
    b=perm(tobits(ct,8),IP); l,r=b[:4],b[4:]
    l,r=r,[a^b for a,b in zip(l,F(r,k2,order))]
    l,r=r,[a^b for a,b in zip(l,F(r,k1,order))]
    return frombits(perm(l+r,IPINV))
'''
open('/tmp/x','w').write(code)
import base64
print(base64.b64encode(code.encode()).decode())
PY
