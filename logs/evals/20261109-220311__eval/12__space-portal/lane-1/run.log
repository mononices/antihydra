[31] create_file {"content": "#!/usr/bin/env python3\n# space-portal solver (remote)\n# Header: [0]=type [1]=subtype [2]=0 [3:5]=seq(BE) [5:7]=len(BE) [7]=rand()%256\n# [8:24]=md5(hdr[0:8]+payload); payload = [0:8] DES-ECB(key=md5(name+code), 8B) + [8:16]\n# Auth bug: if strlen(name)+strlen(code) == len -> memcmp skipped -> any 24B accepted\nimport os, hashlib\nfrom pwn import *\nfrom Crypto.Cipher import DES\n\ncontext.log_level = 'info'\nHOST, PORT = 'rev.chal.csaw.io', 21000\nNAME = b'A' * 24\nCODE = b'B' * 24\nUSER = NAME + CODE\nKEY = hashlib.md5(USER).digest()[:8]\nseq = 0\n\ndef make_pkt(subtype, payload, typ=1):\n    global seq\n    assert len(payload) % 8 == 0\n    hdr = bytearray(8)\n    hdr[0] = typ; hdr[1] = subtype; hdr[2] = 0\n    hdr[3] = (seq >> 8) & 0xff; hdr[4] = seq & 0xff\n    hdr[5] = (len(payload) >> 8) & 0xff; hdr[6] = len(payload) & 0xff\n    hdr[7] = os.urandom(1)[0]\n    d = hashlib.md5(bytes(hdr) + payload).digest()\n    return bytes(hdr) + d + payload[:8] + payload[8:16]\n\ndef recv_pkt(io):\n    hdr = io.recvn(24)\n    ln = (hdr[5] << 8) | hdr[6]\n    payload = io.recvn(ln) if ln else b''\n    return hdr, payload\n\nio = remote(HOST, PORT)\nio.recvuntil(b'name: ')\nio.sendline(NAME)\nio.recvuntil(b'code: ')\nio.sendline(CODE)\n\nio.recvuntil(b'Authenticating')\nio.send(make_pkt(5, USER[:24]))\nio.recvuntil(b'authenticated')\nseq += 1\nlog.success('authenticated (memcmp skipped, key = ' + KEY.hex() + ')')\n\nio.recvuntil(b'Leaking signature')\nhdr, leak = recv_pkt(io)\nlog.info('leak hdr ' + hdr.hex())\nsig = bytes((b + 1) & 0xff for b in leak)\nlog.success('signature: ' + sig.hex())\n\nio.recvuntil(b'Validating')\nio.send(make_pkt(0x4c, sig.ljust(16, b'\\x00')))\nio.recvuntil(b'valid')\nseq += 1\n\nio.recvuntil(b'Sending coordinate')\npayload = DES.new(KEY, DES.MODE_ECB).encrypt(b'\\x00' * 16)\nio.send(make_pkt(0x42, payload, typ=2))\nhdr, flag = recv_pkt(io)\nlog.success('flag packet: ' + hdr.hex() + ' | ' + flag.hex())\nprint(flag)\n",