import numpy as np
from PIL import Image
import glob
from scipy import ndimage
import json
files=sorted(glob.glob('allframes/f*.png'))
palette={'pink':(230,170,172),'blue':(150,190,206),'green':(153,205,180),'lblue':(162,198,227),'purple':(207,168,234)}
tracks=[]  # each: dict(color, frames:[], positions:[], size)
def comp(f):
    a=np.array(Image.open(f),dtype=np.int16)
    out=[]
    for name,(r,g,b) in palette.items():
        m=(np.abs(a[...,0]-r)<12)&(np.abs(a[...,1]-g)<12)&(np.abs(a[...,2]-b)<12)
        lab,n=ndimage.label(m)
        for j,s in enumerate(ndimage.sum(m,lab,range(1,n+1))):
            if s>1500:
                ys,xs=np.where(lab==j+1)
                out.append((name,int(xs.mean()),int(ys.mean()),int(s),int(xs.min()),int(ys.min()),int(xs.max()),int(ys.max())))
    return out
prev=None
for i,f in enumerate(files):
    cs=comp(f)
    if prev is None:
        for c in cs:
            tracks.append({'color':c[0],'frames':[i],'pos':[(c[1],c[2])],'size':c[3]})
        prev=cs
        continue
    # match by color+size+distance
    used=[False]*len(prev)
    newcs=[]
    for c in cs:
        best=None;bd=1e9
        for k,p in enumerate(prev):
            if used[k] or p[0]!=c[0]: continue
            d=abs(p[1]-c[1])+abs(p[2]-c[2])+abs(p[3]-c[3])//50
            if d<bd: bd=d; best=k
        if best is not None and bd<150:
