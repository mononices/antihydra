import numpy as np
from PIL import Image
from scipy import ndimage
BG = np.array([13,12,17])
a = np.array(Image.open('frames/f0001.png')).astype(int)
d = np.abs(a - BG).sum(axis=2)
m = d > 30
lab, nl = ndimage.label(m)
objs = ndimage.find_objects(lab)
comps = []
for i, sl in enumerate(objs):
    if sl is None: continue
    size = (lab[sl] == i+1).sum()
    if size > 500:
        comps.append((size, sl, i+1))
comps.sort(reverse=True)
print('num big comps:', len(comps))
for size, sl, li in comps:
    y0,y1 = sl[0].start, sl[0].stop; x0,x1 = sl[1].start, sl[1].stop
    sub = (lab[sl]==li)
    print(f'  comp {li}: bbox=({x0},{y0})-({x1},{y1}) size={size} w={x1-x0} h={y1-y0} fill={size/((x1-x0)*(y1-y0)):.2f}')
# render the largest few as ascii
def render(sub, step=8):
    h, w = sub.shape
    out=[]
    for y in range(0, h, step*2):
        row=''
        for x in range(0, w, step):
            blk = sub[y:y+step*2, x:x+step]
            row += '#' if blk.mean()>0.5 else ('+' if blk.mean()>0.2 else ' ')
        out.append(row)
    return '\n'.join(out)
for k in range(min(4, len(comps))):
    size, sl, li = comps[k]
    print(f'=== comp {li} (size {size}) ===')
    print(render(lab[sl]==li))
EOF
