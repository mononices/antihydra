from PIL import Image
import numpy as np
BG = np.array([13,12,17])
def ascii_render(n, step=40):
    a = np.array(Image.open(f'frames/f{n:04d}.png')).astype(int)
    d = np.abs(a - BG).sum(axis=2)
    mask = (d > 30)
    h, w = mask.shape
    print(f'--- frame {n} (fg mask, {mask.sum()} px) ---')
    for y in range(0, h, step*2):
        row = ''
        for x in range(0, w, step):
            blk = mask[y:y+step*2, x:x+step]
            row += '#' if blk.mean() > 0.5 else ('+' if blk.mean() > 0.15 else ('.' if blk.any() else ' '))
        print(row)
for n in [1, 150]:
    ascii_render(n)
