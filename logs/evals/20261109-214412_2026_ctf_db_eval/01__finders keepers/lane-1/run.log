import struct
d=open('finderskeepers.mp4','rb').read()
print(len(d))
def walk(buf, off, end, depth=0):
    while off < end-8:
        size = struct.unpack('>I', buf[off:off+4])[0]
        typ = buf[off+4:off+8]
        if size == 0:
            size = end-off
        if size < 8:
            print(' '*depth, 'bad size', size, typ, off)
            return
        print(' '*depth, off, typ, size)
        if typ in (b'moov', b'trak', b'mdia', b'minf', b'stbl', b'udta', b'meta', b'ilst', b'edts', b'dinf'):
            sub = off+8
            if typ == b'meta':
                sub += 4
            walk(buf, sub, off+size, depth+2)
        else:
            # print first bytes for small boxes
            if size < 200:
                print(' '*depth, '   data:', buf[off+8:off+size][:120])
        off += size
    return
# top level
off=0
while off < len(d)-8:
    size=struct.unpack('>I', d[off:off+4])[0]
    typ=d[off+4:off+8]
    print('TOP', off, typ, size)
    if typ in (b'moov',):
        walk(d, off+8, off+size, 2)
    off += size
    if size<=0: break
EOF
