            used[best]=True
            # find matching track
            for t in tracks:
                if t['frames'][-1]==i-1 and t['color']==prev[best][0] and abs(t['pos'][-1][0]-prev[best][1])<4 and abs(t['pos'][-1][1]-prev[best][2])<4:
                    t['frames'].append(i); t['pos'].append((c[1],c[2]))
                    break
        else:
            newcs.append(c)
    for c in newcs:
        tracks.append({'color':c[0],'frames':[i],'pos':[(c[1],c[2])],'size':c[3]})
    prev=cs
lens=[len(t['frames']) for t in tracks]
print('num tracks', len(tracks))
import collections
print('lifetime histogram', collections.Counter(lens))
print('colors', collections.Counter(t['color'] for t in tracks))
json.dump(tracks, open('tracks.json','w'))
