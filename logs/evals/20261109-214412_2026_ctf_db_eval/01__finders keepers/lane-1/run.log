import numpy as np
from PIL import Image
import glob
files=sorted(glob.glob('allframes/f*.png'))
# global color histogram distance between consecutive frames (chi2 on 8x8x8 bins)
def hist(a):
    h=np.zeros((8,8,8))
    for c in range(3):
        pass
    idx=(a[...,0]//32)*64+(a[...,1]//32)*8+(a[...,2]//32)
    np.add.at(h.reshape(-1), idx//32//64*0+idx, 1) if False else None
    flat=np.bincount(idx.flatten(), minlength=512).astype(float)
    return flat
hs=[]
for f in files:
    a=np.array(Image.open(f),dtype=np.int32)
    idx=(a[...,0]//32)*64+(a[...,1]//32)*8+(a[...,2]//32)
    hs.append(np.bincount(idx.ravel(),minlength=512))
hs=np.array(hs,dtype=float)
d=[]
for i in range(1,len(hs)):
    x,y=hs[i-1],hs[i]
    chi=((x-y)**2/np.maximum(x+y,1)).sum()
    d.append(chi)
d=np.array(d)
print('chi2 consecutive: mean %.1f max %.1f'%(d.mean(),d.max()))
top=np.argsort(d)[::-1][:30]+1
print('largest changes at frames:', sorted(top))
# rolling mean window
w=30
rm=np.convolve(d, np.ones(w)/w, mode='valid')
print('rolling mean min %.1f max %.1f'%(rm.min(), rm.max()))
best=np.argsort(rm)[:10]+w//2
print('calmest windows centered at', sorted(best))
worst=np.argsort(rm)[::-1][:10]+w//2
print('busiest windows centered at', sorted(worst))
