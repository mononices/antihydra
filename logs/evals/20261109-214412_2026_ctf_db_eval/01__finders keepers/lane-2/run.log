import struct
data=open('/home/ctfplayer/ctf_files/finderskeepers.mp4','rb').read()
def boxes(data, off, end, depth=0):
    while off < end:
        if off+8 > end: 
            print(' '*depth, 'trailing', end-off, data[off:off+32])
            break
        size, typ = struct.unpack('>I4s', data[off:off+8])
        hdr=8
        if size==1:
            size=struct.unpack('>Q', data[off+8:off+16])[0]; hdr=16
        elif size==0:
            size=end-off
        print(' '*depth, typ.decode('latin1'), 'size', size, 'off', off)
        if typ in (b'moov',b'trak',b'mdia',b'minf',b'stbl',b'udta',b'edts',b'dinf'):
            boxes(data, off+hdr, off+size, depth+2)
        off += size
boxes(data,0,len(data))
