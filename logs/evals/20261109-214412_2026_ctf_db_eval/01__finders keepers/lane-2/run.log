import struct
data=open('/home/ctfplayer/ctf_files/finderskeepers.mp4','rb').read()

def find_box(data, path, off=0, end=None):
    if end is None: end=len(data)
    cur=off
    while cur<end:
        size,typ=struct.unpack('>I4s',data[cur:cur+8])
        hdr=8
        if size==1:
            size=struct.unpack('>Q',data[cur+8:cur+16])[0]; hdr=16
        elif size==0:
            size=end-cur
        if typ==path[0]:
            if len(path)==1: return cur, cur+size, hdr
            return find_box(data,path[1:],cur+hdr,cur+size)
        cur+=size
    return None

for name in [b'stsz',b'stco',b'stsc',b'stts',b'ctts',b'stss',b'elst']:
    r=find_box(data,[b'moov',b'trak',b'mdia',b'minf',b'stbl',name])
    if r is None:
        r=find_box(data,[b'moov',b'trak',b'edts',name])
    print(name, r)
    if r:
        off,end,hdr=r
        body=data[off+hdr:end]
        print(' len body',len(body))
        if name in (b'stsz',):
            ver,flags,ss,cnt=struct.unpack('>III I',body[:16]) if False else (None,None,None,None)
            ver_flags, sample_size, count = struct.unpack('>III', body[:12])
            print(' ver_flags',ver_flags,'sample_size',sample_size,'count',count)
            sizes=struct.unpack('>%dI'%count, body[12:12+4*count])
            print(' first sizes',sizes[:10], 'sum',sum(sizes), 'min',min(sizes),'max',max(sizes))
            import collections
            print(' unique sizes count',len(set(sizes)))
        if name in (b'stco',):
            ver_flags,count=struct.unpack('>II',body[:8])
            offs=struct.unpack('>%dI'%count, body[8:8+4*count])
            print(' count',count,'offsets',offs[:20])
        if name in (b'stsc',):
            ver_flags,count=struct.unpack('>II',body[:8])
            print(' count',count)
            for i in range(count):
                print('  ',struct.unpack('>III',body[8+12*i:20+12*i]))
        if name in (b'stts',):
            ver_flags,count=struct.unpack('>II',body[:8])
            print(' count',count)
            for i in range(count):
                print('  ',struct.unpack('>II',body[8+8*i:16+8*i]))
        if name in (b'ctts',):
            ver_flags,count=struct.unpack('>II',body[:8])
