import base64, itertools, string
ct = base64.b64decode('ZXNucHtkMGNfQHl6QGdsX21uMGpfcG0zejNfZzBfbzAwc30=').decode()
print("ct:", ct)
def vig(s,key,dec=True):
    out=[]
    ki=0
    for c in s:
        if c.isalpha():
            k=ord(key[ki%len(key)].lower())-97; ki+=1
            base=ord('a') if c.islower() else ord('A')
            v=(ord(c)-base + (-k if dec else k))%26
            out.append(chr(base+v))
        else:
            out.append(c)
    return ''.join(out)
keys=['finderskeepers','finders','keepers','finder','keeper','canva','jc','csaw','flag','hidden','message','xmp','video']
for k in keys:
    print(k, vig(ct,k,True), '|', vig(ct,k,False))
