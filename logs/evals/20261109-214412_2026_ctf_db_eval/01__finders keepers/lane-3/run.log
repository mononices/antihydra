[75] create_file {"content": "from PIL import Image\nimport numpy as np, sys\n\nfn = sys.argv[1]\nbox = [int(v) for v in sys.argv[2:6]]\nds = int(sys.argv[6]) if len(sys.argv) > 6 else 2\na = np.array(Image.open(fn).convert('L'))\ncrop = a[box[1]:box[3], box[0]:box[2]].astype(np.int16)\n# find connected bright background (card) and put text where dark inside card\nfrom scipy import ndimage\ncard = crop > 120\nlab, n = ndimage.label(card)\nsizes = ndimage.sum(card, lab, range(1, n + 1))\nmain = int(np.argmax(sizes)) + 1\ncardmask = lab == main\n# fill holes: text is inside the card\nfilled = ndimage.binary_fill_holes(cardmask)\ntext = filled & ~cardmask\nprint(f\"# {fn} {box} card px={cardmask.sum()} text px={text.sum()}\")\nys, xs = np.where(text)\nif len(xs) == 0:\n    sys.exit()\ny0, y1, x0, x1 = ys.min(), ys.max(), xs.min(), xs.max()\nsub = text[y0:y1+1, x0:x1+1]\nH, W = sub.shape\nprint(f\"# text bbox in crop: x {x0}-{x1} y {y0}-{y1} shape {sub.shape}\")\nfor yy in range(0, H, ds):\n    row = ''\n    for xx in range(0, W, ds):\n        blk = sub[yy:yy+ds, xx:xx+ds]\n        row += '#' if blk.mean() > 0.4 else ('+' if blk.any() else '.')\n    print(row)\nnp.save('sub.npy', sub)\n", "path": "/home/ctfplayer/workspace/textmask.py"}
