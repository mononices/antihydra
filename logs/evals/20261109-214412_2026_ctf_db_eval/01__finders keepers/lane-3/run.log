[58] create_file {"content": "import subprocess, glob, re\nfrom PIL import Image, ImageOps, ImageFilter\nimport numpy as np\n\nfs = sorted(glob.glob('all/*.png'))[::5]\nallhits = {}\nfor f in fs:\n    im = Image.open(f).convert('L')\n    a = np.array(im).astype(np.float32)\n    # adaptive threshold: subtract heavily blurred version\n    blur = np.array(im.filter(ImageFilter.GaussianBlur(25))).astype(np.float32)\n    diff = a - blur\n    m = (diff > 12) * 255\n    out = Image.fromarray(m.astype(np.uint8))\n    out = out.resize((im.width*2, im.height*2), Image.LANCZOS)\n    out.save('tmp.png')\n    r = subprocess.run(['tesseract', 'tmp.png', '-', '--psm', '11'], capture_output=True, text=True)\n    txt = ' '.join(r.stdout.split())\n    words = re.findall(r'[A-Za-z0-9{}_@!]{3,}', txt)\n    if words:\n        allhits[f] = words\nfor f, w in allhits.items():\n    print(f, w)\nprint('frames with hits:', len(allhits), 'of', len(fs))\n", "path": "/home/ctfplayer/workspace/ocr_adapt.py"}
