[55] create_file {"content": "from PIL import Image\nimport numpy as np, glob\n\nfs = sorted(glob.glob('all/*.png'))\nprev = None\nstats = []\nfor f in fs:\n    a = np.array(Image.open(f).convert('L')).astype(np.float32)\n    m = a.mean()\n    s = a.std()\n    if prev is not None:\n        d = np.abs(a - prev)\n        stats.append((f, m, s, d.mean(), (d > 30).mean()))\n    else:\n        stats.append((f, m, s, 0, 0))\n    prev = a\n\nimport statistics\nmeans = [x[1] for x in stats]\ndmeans = [x[3] for x in stats]\nprint(\"mean of means\", np.mean(means), \"std\", np.std(means))\nmu, sd = np.mean(dmeans), np.std(dmeans)\nfor f, m, s, dm, frac in stats:\n    z = (dm - mu) / (sd + 1e-9)\n    if abs(z) > 2.0:\n        print(f, f\"mean={m:.1f} std={s:.1f} dmean={dm:.2f} frac={frac:.3f} z={z:.2f}\")\nprint(\"DONE; max dmean\", max(dmeans))\n", "path": "/home/ctfplayer/workspace/anom.py"}
