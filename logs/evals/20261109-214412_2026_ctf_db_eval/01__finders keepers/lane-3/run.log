[22] create_file {"content": "from PIL import Image, ImageChops\nimport numpy as np\nimport glob\n\nfs = sorted(glob.glob('all/*.png'))\nprint(len(fs))\nprev = np.array(Image.open(fs[0]).convert('L')).astype(np.int16)\nminv = prev.copy()\nmaxv = prev.copy()\nsumv = prev.astype(np.float64).copy()\nalldiff = np.zeros_like(prev)\nfor f in fs[1:]:\n    a = np.array(Image.open(f).convert('L')).astype(np.int16)\n    d = np.abs(a - prev).astype(np.uint8)\n    alldiff = np.maximum(alldiff, d)\n    np.maximum(maxv, a, out=maxv)\n    np.minimum(minv, a, out=minv)\n    sumv += a\n    prev = a\n\nImage.fromarray(alldiff).save('alldiff.png')\nImage.fromarray(np.abs(alldiff).astype(np.uint8)).save('alldiff2.png')\nImage.fromarray(np.clip(sumv/len(fs), 0, 255).astype(np.uint8)).save('mean.png')\nImage.fromarray((maxv-minv).astype(np.uint8)).save('range.png')\nprint('diff max', alldiff.max(), 'nonzero pixels', (alldiff>0).sum())\nys, xs = np.where(alldiff > 0)\nif len(xs):\n    print('bbox', xs.min(), xs.max(), ys.min(), ys.max())\n", "path": "/home/ctfplayer/workspace/temporal.py"}
