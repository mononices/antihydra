import itertools
s='esnp{d0c_@yz@gl_mn0j_pm3z3_g0_o00s}'
# QWERTY rows
rows=['`1234567890-=','qwertyuiop[]\\',"asdfghjkl;'",'zxcvbnm,./']
pos={}
for r,row in enumerate(rows):
    for i,c in enumerate(row):
        pos[c]=(r,i)
def shift(s,dr,di):
    out=[]
    for c in s:
        if c in pos:
            r,i=pos[c]
            r2,i2=r+dr,i+di
            if 0<=r2<len(rows) and 0<=i2<len(rows[r2]):
                out.append(rows[r2][i2])
            else: out.append(c)
        else: out.append(c)
    return ''.join(out)
for dr in (-1,0,1):
    for di in (-2,-1,0,1,2):
        if dr==0 and di==0: continue
        print(dr,di,shift(s,dr,di))
EOF
