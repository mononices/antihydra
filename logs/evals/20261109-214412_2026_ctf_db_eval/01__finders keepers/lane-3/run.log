import struct
data=open('/home/ctfplayer/ctf_files/finderskeepers.mp4','rb').read()
print(len(data))
def walk(buf, off, end, depth=0):
    while off+8<=end:
        size,typ = struct.unpack('>I4s', buf[off:off+8])
        typ=typ.decode('latin1')
        hdr=8
        if size==1:
            size=struct.unpack('>Q',buf[off+8:off+16])[0]; hdr=16
        elif size==0:
            size=end-off
        print('  '*depth, typ, size, hex(off))
        if typ in ('moov','trak','mdia','minf','stbl','dinf','edts','udta','meta','ilst','\xa9xyz','mvex','moof','traf'):
            walk(buf, off+hdr, off+size, depth+1)
        off+=size
walk(data,0,len(data))
EOF
