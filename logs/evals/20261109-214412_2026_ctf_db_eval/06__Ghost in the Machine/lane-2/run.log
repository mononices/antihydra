import struct, collections
data = open('/home/ctfplayer/ctf_files/files/capture.pcap','rb').read()
off = 24
pkts = []
while off < len(data):
    ts, tus, incl, orig = struct.unpack('<IIII', data[off:off+16]); off += 16
    pkt = data[off:off+incl]; off += incl
    pkts.append((ts,tus,pkt))

def ipchk(hdr):
    s = 0
    for i in range(0,len(hdr),2):
        s += (hdr[i]<<8)|hdr[i+1]
    while s>>16: s = (s&0xffff)+(s>>16)
    return (~s)&0xffff

rows=[]
for i,(ts,tus,pkt) in enumerate(pkts):
    ip = pkt[14:34]; udp = pkt[34:42]
    ver_ihl, tos, totlen, ipid, frag, ttl, proto, csum, src, dst = struct.unpack('>BBHHHBBH4s4s', ip)
    sport, dport, ulen, ucsum = struct.unpack('>HHHH', udp)
    rows.append(dict(i=i, ts=ts, tus=tus, ttl=ttl, csum=csum, sport=sport, valid=(ipchk(ip)==0), t=ts*1000000+tus))

truth=[r for r in rows if r['ttl']==64 and r['valid']]

# key from order of first appearance of source ports
seen=[]
for r in truth:
    if r['sport'] not in seen: seen.append(r['sport'])
key = ''.join(chr(s-40000) for s in seen)
print('port order:', seen)
print('derived key:', repr(key))

deltas=[b['t']-a['t'] for a,b in zip(truth, truth[1:])]
bits=[1 if d>100000 else 0 for d in deltas]
by=[]
for i in range(0,len(bits)//8*8,8):
    by.append(int(''.join(map(str,bits[i:i+8])),2))
ct=bytes(by)
print('ct hex:', ct.hex())
kb=key.encode()
pt=bytes(c ^ kb[i%len(kb)] for i,c in enumerate(ct))
print('plaintext:', pt)
EOF
