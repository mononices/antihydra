import struct, collections
data = open('/home/ctfplayer/ctf_files/files/capture.pcap','rb').read()
off = 24
pkts = []
while off < len(data):
    ts, tus, incl, orig = struct.unpack('<IIII', data[off:off+16]); off += 16
    pkt = data[off:off+incl]; off += incl
    pkts.append((ts,tus,incl,orig,pkt))

def ipchk(hdr):
    s = 0
    for i in range(0,len(hdr),2):
        s += (hdr[i]<<8)|hdr[i+1]
    while s>>16: s = (s&0xffff)+(s>>16)
    return (~s)&0xffff

rows=[]
for i,(ts,tus,incl,orig,pkt) in enumerate(pkts):
    eth = pkt[:14]
    ip = pkt[14:34]
    udp = pkt[34:42]
    pay = pkt[42:]
    ver_ihl, tos, totlen, ipid, frag, ttl, proto, csum, src, dst = struct.unpack('>BBHHHBBH4s4s', ip)
    sport, dport, ulen, ucsum = struct.unpack('>HHHH', udp)
    calc = ipchk(ip)
    rows.append(dict(i=i, ts=ts, tus=tus, eth=eth.hex(), tos=tos, totlen=totlen, ipid=ipid, frag=frag, ttl=ttl, proto=proto, csum=csum, calc=calc, src=src.hex(), dst=dst.hex(), sport=sport, dport=dport, ulen=ulen, ucsum=ucsum, pay=pay))

# unique values per field
for f in ['ts','tos','totlen','ipid','frag','ttl','proto','csum','src','dst','sport','dport','ulen','ucsum','pay','eth']:
    c = collections.Counter(r[f] for r in rows)
    print(f, 'unique:', len(c), 'top:', c.most_common(8))

# checksum validity
bad = [r for r in rows if r['csum'] != r['calc']]
print('bad ip checksum count', len(bad))
print('first bad indices', [r['i'] for r in bad[:20]])
# print first 30 rows
for r in rows[:30]:
    print(r['i'], r['tus'], hex(r['ipid']), r['ttl'], hex(r['csum']), hex(r['calc']), hex(r['sport']), hex(r['dport']), r['pay'])
