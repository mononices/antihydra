[08] create_file {"content": "import pickle, collections\npkts = pickle.load(open('/home/ctfplayer/workspace/pkts.pkl','rb'))\nsig = [p for p in pkts if p['ttl']==113]\nnoise = [p for p in pkts if p['ttl']==64]\n\nprint(\"=== SIGNAL (ttl=113) ===\")\nfor p in sig[:40]:\n    print(f\"n={p['n']:3d} sec={p['t']} usec={p['u']:6d} sport={p['sport']} ipid={p['ipid']} ick={p['ick']}\")\n\nprint(\"\\nnoise ports:\", sorted(set(p['sport'] for p in noise)))\nprint(\"sig ports sorted:\", sorted(p['sport'] for p in sig))\nprint(\"sig port min/max:\", min(p['sport'] for p in sig), max(p['sport'] for p in sig))\nprint(\"sig ick values:\", sorted(set(p['ick'] for p in sig))[:10], \"... distinct:\", len(set(p['ick'] for p in sig)))\nprint(\"noise ick:\", set(p['ick'] for p in noise))\nprint(\"sig ipid:\", set(p['ipid'] for p in sig))\n# usec stats\nsu = [p['u'] for p in sig]; nu = [p['u'] for p in noise]\nprint(\"\\nsig usec min/max:\", min(su), max(su))\nprint(\"noise usec min/max:\", min(nu), max(nu))\nprint(\"sig usec mod 256 first 30:\", [u%256 for u in su][:30])\nprint(\"sig usec//1000 first 30:\", [u//1000 for u in su][:30])\n", "path": "/home/ctfplayer/workspace/explore2.py"}
