[04] create_file {"content": "import struct, collections, sys\n\ndata = open('/home/ctfplayer/ctf_files/files/capture.pcap','rb').read()\nmagic = data[:4]\ngh = struct.unpack('<IHHiIII', data[:24])\nprint('global hdr', gh)\noff = 24\npkts = []\ni = 0\nwhile off < len(data):\n    ts_sec, ts_usec, incl, orig = struct.unpack('<IIII', data[off:off+16])\n    pkt = data[off+16:off+16+incl]\n    off += 16 + incl\n    i += 1\n    eth = pkt[:14]\n    ip = pkt[14:34]\n    udp = pkt[34:42]\n    payload = pkt[42:]\n    ihl = (ip[0] & 0xf) * 4\n    totlen = struct.unpack('>H', ip[2:4])[0]\n    ipid = struct.unpack('>H', ip[4:6])[0]\n    flags_frag = struct.unpack('>H', ip[6:8])[0]\n    ttl = ip[8]\n    proto = ip[9]\n    cksum = struct.unpack('>H', ip[10:12])[0]\n    src = '.'.join(str(b) for b in ip[12:16])\n    dst = '.'.join(str(b) for b in ip[16:20])\n    sport, dport, ulen, uck = struct.unpack('>HHHH', udp[:8])\n    pkts.append(dict(n=i, t=ts_sec, u=ts_usec, eth=eth.hex(), ihl=ihl, totlen=totlen,\n                     ipid=ipid, ff=flags_frag, ttl=ttl, proto=proto, ick=cksum,\n                     src=src, dst=dst, sport=sport, dport=dport, ulen=ulen, uck=uck,\n                     payload=payload, raw=pkt))\n\nprint('num packets', len(pkts))\nfor f in ['eth','ihl','totlen','ipid','ff','ttl','proto','ick','src','dst','sport','dport','ulen','uck']:\n    vals = collections.Counter(p[f] for p in pkts)\n    print(f, len(vals), dict(list(vals.items())[:8]))\nprint('payloads', collections.Counter(p['payload'] for p in pkts))\nimport pickle\npickle.dump(pkts, open('/home/ctfplayer/workspace/pkts.pkl','wb'))\n", "path": "/home/ctfplayer/workspace/parse.py"}
