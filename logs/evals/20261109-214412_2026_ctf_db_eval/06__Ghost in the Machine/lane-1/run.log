[10] create_file {"content": "import pickle\npkts = pickle.load(open('/home/ctfplayer/workspace/pkts.pkl','rb'))\n\ndef ipcksum(hdr):\n    s = 0\n    for i in range(0, len(hdr), 2):\n        s += (hdr[i]<<8) | hdr[i+1]\n    while s >> 16: s = (s & 0xffff) + (s >> 16)\n    return (~s) & 0xffff\n\nbad = []\nfor p in pkts:\n    raw = bytes.fromhex(p['eth']) if False else None\n# recompute from stored raw\nimport struct\ndata = open('/home/ctfplayer/ctf_files/files/capture.pcap','rb').read()\noff=24; i=0\nrecs=[]\nwhile off < len(data):\n    ts_sec, ts_usec, incl, orig = struct.unpack('<IIII', data[off:off+16])\n    pkt = data[off+16:off+16+incl]; off += 16+incl; i+=1\n    ip = pkt[14:34]\n    stored = struct.unpack('>H', ip[10:12])[0]\n    zeroed = ip[:10] + b'\\x00\\x00' + ip[12:]\n    calc = ipcksum(zeroed)\n    recs.append((i, ts_sec, ts_usec, stored, calc, stored==calc, pkt))\n\nprint('checksum bad count:', sum(1 for r in recs if not r[5]))\nfor r in recs:\n    if not r[5]:\n        print('BAD cksum pkt', r[0], 'stored', hex(r[3]), 'calc', hex(r[4]))\n\nsig = [r for r in recs if r[5] and r[2] is not None]\n# signal = ttl 113\nsig = [r for r in recs if r[5] and (r[6][14+8] == 113)]\nprint('sig count', len(sig))\n\n# time deltas between consecutive signal packets\nprev=None\nprint('\\n--- deltas (usec) between consecutive signal pkts, in file order ---')\nds=[]\nfor r in sig:\n    t = r[1]*1000000 + r[2]\n    if prev is not None:\n        ds.append(t-prev)\n    prev = t\nprint(ds[:60])\nprint('min/max delta', min(ds), max(ds))\nprint('deltas mod 256:', [d%256 for d in ds][:40])\nprint('deltas//1000:', [d//1000 for d in ds][:40])\n", "path": "/home/ctfplayer/workspace/cksum.py"}
