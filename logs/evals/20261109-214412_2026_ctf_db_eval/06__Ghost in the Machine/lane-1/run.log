[12] create_file {"content": "import pickle\npkts = pickle.load(open('/home/ctfplayer/workspace/pkts.pkl','rb'))\nsig = [p for p in pkts if p['ttl']==113]\nsig_sorted = sorted(sig, key=lambda p:(p['t'],p['u']))\n\ndef show(vals, label):\n    print(label)\n    print(''.join(chr(v) if 32<=v<127 else '.' for v in vals))\n    print()\n\n# try port mod 256 in time order\nshow([p['sport']%256 for p in sig_sorted], 'port%256 time-ordered:')\n# port - 50000\nshow([p['sport']-50000 for p in sig_sorted if p['sport']-50000 < 256], 'port-50000 (subset):')\n# usec mod 256\nshow([p['u']%256 for p in sig_sorted], 'usec%256 time-ordered:')\n# usec//1000\nprint('usec//1000 range:', min(p['u']//1000 for p in sig_sorted), max(p['u']//1000 for p in sig_sorted))\nprint('distinct usec//1000:', len(set(p['u']//1000 for p in sig_sorted)))\n# distribution of port values\nports = sorted(p['sport'] for p in sig_sorted)\nprint('ports sorted:', ports)\nprint('port diffs:', [ports[i+1]-ports[i] for i in range(len(ports)-1)])\n", "path": "/home/ctfplayer/workspace/enc.py"}
