[06] create_file {"content": "import pickle, collections\npkts = pickle.load(open('/home/ctfplayer/workspace/pkts.pkl','rb'))\n\n# timestamps\nsecs = collections.Counter(p['t'] for p in pkts)\nprint('ts_sec distinct:', len(secs), sorted(secs.items())[:10])\nusecs = collections.Counter(p['u'] for p in pkts)\nprint('ts_usec distinct:', len(usecs))\nprint(sorted(usecs.items())[:20])\n\n# sports full\nsp = collections.Counter(p['sport'] for p in pkts)\nprint('\\nsport distinct:', len(sp))\ncommon = sp.most_common(10)\nprint('most common:', common)\nsingles = [s for s,c in sp.items() if c==1]\nprint('num singleton sports:', len(singles))\n\n# ttl groups\nprint('\\nTTL=113 packets: indices', [p['n'] for p in pkts if p['ttl']==113][:40])\nprint('count ttl113:', sum(1 for p in pkts if p['ttl']==113))\nprint('ttl113 sports:', collections.Counter(p['sport'] for p in pkts if p['ttl']==113).most_common(5))\nprint('ttl64 sports:', collections.Counter(p['sport'] for p in pkts if p['ttl']==64).most_common(5))\nprint('ttl113 usecs:', [p['u'] for p in pkts if p['ttl']==113][:20])\nprint('ttl113 secs:', collections.Counter(p['t'] for p in pkts if p['ttl']==113))\n", "path": "/home/ctfplayer/workspace/explore.py"}
