[09] create_file {"path": "/home/ctfplayer/workspace/debug.py", "content": "#!/usr/bin/env python3\n\"\"\"Debug: self-test the CJLOSS lattice on a known plaintext, dump basis shapes.\"\"\"\nfrom fpylll import IntegerMatrix, LLL, BKZ\nimport math, random\n\npub = [int(l) for l in open('/home/ctfplayer/ctf_files/files/pubkey.txt')\n       if l.strip() and not l.startswith('#')]\ncts = [int(l) for l in open('/home/ctfplayer/ctf_files/files/ciphertext.txt')\n       if l.strip() and not l.startswith('#')]\nn = len(pub)\n\ndef cjloss(c, N):\n    m = IntegerMatrix(n + 2, n + 2)\n    for i in range(n):\n        m[i, i] = 1\n        m[i, n + 1] = N * pub[i]\n    for i in range(n):\n        m[n, i] = 1\n    m[n, n] = 2\n    m[n, n + 1] = 2 * N * c\n    return m\n\ndef reduce_and_report(M, label, bkz=0):\n    LLL.reduction(M)\n    if bkz:\n        BKZ.reduction(M, BKZ.Param(block_size=bkz))\n    print(f'--- {label} ---')\n    for r, row in enumerate(M):\n        vals = [row[i] for i in range(n + 2)]\n        nz = sum(1 for v in vals[:n] if v != 0)\n        print(f'row{r}: |last|={vals[n+1]} s={vals[n]} nz={nz} '\n              f'first5={vals[:5]} norm2={sum(v*v for v in vals)}')\n    return M\n\n# self-test: known x\nrandom.seed(1)\nx = [random.randint(0, 1) for _ in range(n)]\nc0 = sum(b * p for b, p in zip(x, pub))\nprint('known x sum of', sum(x), 'elements; c0 bits', c0.bit_length())\nprint('actual ct bits:', [c.bit_length() for c in cts])\n\nM = cjloss(c0, math.ceil(math.sqrt(n) / 2))\nreduce_and_report(M, 'selftest CJLOSS LLL')\n"}
