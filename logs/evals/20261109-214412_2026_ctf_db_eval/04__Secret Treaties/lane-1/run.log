[13] create_file {"path": "/home/ctfplayer/workspace/attack2.py", "content": "#!/usr/bin/env python3\n\"\"\"End-to-end check + real blocks with BKZ and random index shuffles.\"\"\"\nfrom fpylll import IntegerMatrix, LLL, BKZ\nimport math, random, sys\n\npub = [int(l) for l in open('/home/ctfplayer/ctf_files/files/pubkey.txt')\n       if l.strip() and not l.startswith('#')]\ncts = [int(l) for l in open('/home/ctfplayer/ctf_files/files/ciphertext.txt')\n       if l.strip() and not l.startswith('#')]\nn = len(pub)\n\ndef build(pub_order, c, N):\n    m = IntegerMatrix(n + 2, n + 2)\n    for i, p in enumerate(pub_order):\n        m[i, i] = 1\n        m[i, n + 1] = N * p\n    for i in range(n):\n        m[n, i] = 1\n    m[n, n] = 2\n    m[n, n + 1] = 2 * N * c\n    return m\n\ndef solve_one(pub_order, c, bkz):\n    N = math.ceil(math.sqrt(n) / 2)\n    M = build(pub_order, c, N)\n    LLL.reduction(M)\n    if bkz:\n        BKZ.reduction(M, BKZ.Param(block_size=bkz, max_loops=8))\n    for row in M:\n        last = row[n + 1]\n        if last != 0:\n            continue\n        s = row[n]\n        if s == 0:\n            continue\n        x = [row[i] for i in range(n)]\n        if all(v in (1, -1) for v in x):\n            sign = 1 if s > 0 else -1\n            bits = [(sign * v + 1) // 2 for v in x]\n            if sum(b * p for b, p in zip(bits, pub)) == c:\n                return bits\n    return None\n\ndef decode(bits):\n    return bytes(int(''.join(map(str, bits[i:i + 8])), 2) for i in range(0, 72, 8))\n\n# 1) end-to-end self-test through the same code path\nrandom.seed(7)\nxt = [random.randint(0, 1) for _ in range(n)]\nc0 = sum(b * p for b, p in zip(xt, pub))\nr = solve_one(pub, c0, 0)\nprint('selftest e2e:', 'OK' if r == xt else ('OK-perm' if r else 'FAIL'))\n\n# 2) real blocks: LLL, then BKZ with shuffles\nfor idx, c in enumerate(cts):\n    got = solve_one(pub, c, 0)\n    tries = []\n    if got is None:\n        for bs in (20, 30):\n            tries.append(f'bkz{bs}')\n            got = solve_one(pub, c, bs)\n            if got: break\n    if got is None:\n        for attempt in range(15):\n            perm = list(range(n)); random.shuffle(perm)\n            po = [pub[i] for i in perm]\n            got = solve_one(po, c, 20)\n            if got:\n                # map back through permutation\n                inv = [0]*n\n                for j, i in enumerate(perm): inv[i] = j\n                got = [got[inv[i]] for i in range(n)]\n                tries.append(f'shuffle{attempt}')\n                break\n    if got is None:\n        print(f'block {idx}: FAILED ({tries})')\n        continue\n    assert sum(b*p for b, p in zip(got, pub)) == c\n    print(f'block {idx}: {decode(got)!r}  [{\",\".join(tries) or \"LLL\"}]', flush=True)\n    sys.stdout.flush()\n"}
