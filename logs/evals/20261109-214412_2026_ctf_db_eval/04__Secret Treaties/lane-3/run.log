import z3, time
pk=[int(l) for l in open('/home/ctfplayer/ctf_files/files/pubkey.txt') if l.strip() and not l.startswith('#')]
cts=[int(l) for l in open('/home/ctfplayer/ctf_files/files/ciphertext.txt') if l.strip() and not l.startswith('#')]
def solve(t, prefix=b'', lo=0x20, hi=0x7e, timeout_ms=300000):
    s=z3.Solver(); s.set('timeout', timeout_ms)
    by=[z3.BitVec(f'b{i}',8) for i in range(9)]
    for b in by: s.add(z3.UGE(b,lo), z3.ULE(b,hi))
    for k,c in enumerate(prefix): s.add(by[k]==c)
    terms=[a*z3.ZeroExt(64,(by[i//8] >> (7-(i%8))) & 1) for i,a in enumerate(pk)]
    s.add(z3.Sum(terms)==t)
    r=s.check()
    if r==z3.sat:
        m=s.model(); return bytes(m.eval(b,model_completion=True).as_long() for b in by)
    return str(r)
out=b''
KNOWN={0:b'csaw{LLL_'}
for i,t in enumerate(cts):
    t0=time.time()
    p=solve(t, prefix=KNOWN.get(i,b''), timeout_ms=240000)
    print(i,p, round(time.time()-t0,1), flush=True)
    if isinstance(p,bytes):
        out+=p
        # next block guess: extend prefix? keep printable, rely on natural uniqueness
print(out)
EOF
