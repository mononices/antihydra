import z3, sys, time
a = [int(l) for l in open('/home/ctfplayer/ctf_files/files/pubkey.txt') if not l.strip().startswith('#')]
cts = [int(l) for l in open('/home/ctfplayer/ctf_files/files/ciphertext.txt') if not l.strip().startswith('#')]
n = len(a)
idx = int(sys.argv[1])
S = cts[idx]
x = [z3.Int(f'x{i}') for i in range(n)]
s = z3.Solver()
for xi in x:
    s.add(xi >= 0, xi <= 1)
# printable ASCII bytes
for j in range(9):
    byte = z3.Sum([x[j*8+k] * (1 << (7-k)) for k in range(8)])
    s.add(byte >= 32, byte <= 126)
if idx == 0:
    for j,c in enumerate(b'csaw{'):
        for k in range(8):
            s.add(x[j*8+k] == ((c >> (7-k)) & 1))
s.add(z3.Sum([x[i]*a[i] for i in range(n)]) == S)
t=time.time()
r = s.check()
print("check:", r, time.time()-t)
if r == z3.sat:
    m = s.model()
    bits = [m.evaluate(xi).as_long() for xi in x]
    blk = bytes(int(''.join(str(bits[j*8+k]) for k in range(8)), 2) for j in range(9))
    print(blk)
EOF
