import z3, time, sys
a = [int(l) for l in open('/home/ctfplayer/ctf_files/files/pubkey.txt') if not l.strip().startswith('#')]
cts = [int(l) for l in open('/home/ctfplayer/ctf_files/files/ciphertext.txt') if not l.strip().startswith('#')]
n = len(a)
idx = int(sys.argv[1]); S = cts[idx]
b = [z3.Bool(f'b{i}') for i in range(n)]
s = z3.Solver()
s.add(z3.PbEq([(b[i], a[i]) for i in range(n)], S))
# ASCII constraints
for j in range(9):
    byte = z3.Sum([z3.If(b[j*8+k], 1<<(7-k), 0) for k in range(8)])
    s.add(byte >= 0x20, byte <= 0x7e)
if idx == 0:
    for j,c in enumerate(b'csaw{'):
        for k in range(8):
            s.add(b[j*8+k] == z3.BoolVal(bool((c >> (7-k)) & 1)))
t = time.time()
r = s.check()
print("res:", r, round(time.time()-t,2))
if r == z3.sat:
    m = s.model()
    bits = [1 if z3.is_true(m.evaluate(bi)) else 0 for bi in b]
    print(bytes(int(''.join(map(str,bits[j*8:j*8+8])),2) for j in range(9)))
EOF
