from sage.all import *

a = [int(l) for l in open('/home/ctfplayer/ctf_files/files/pubkey.txt') if not l.strip().startswith('#')]
cts = [int(l) for l in open('/home/ctfplayer/ctf_files/files/ciphertext.txt') if not l.strip().startswith('#')]
n = len(a)
print("n =", n, "blocks =", len(cts))
print("max bits", max(a).bit_length(), "min bits", min(a).bit_length())

def try_cjloss(S, N=1):
    B = Matrix(ZZ, n+1, n+1)
    for i in range(n):
        B[i,i] = 2
        B[i,n] = N*a[i]
    for j in range(n):
        B[n,j] = 1
    B[n,n] = N*S
    L = B.LLL()
    sols = []
    for row in L:
        if row[n] == 0:
            v = row[:n]
            if all(abs(x)==1 for x in v):
                x = [1 if t==-1 else 0 for t in v]  # 2x-1 = v => x=(v+1)/2 ; v=-1 -> x=0
                x2 = [1 if t==1 else 0 for t in v]
                for cand in (x,x2):
                    if sum(cand[i]*a[i] for i in range(n)) == S:
                        sols.append(cand)
    return sols

def try_simple(S):
    B = Matrix(ZZ, n+1, n+1)
    for i in range(n):
        B[i,i] = 1
        B[i,n] = a[i]
    B[n,n] = S
    L = B.LLL()
    sols = []
    for row in L:
        if row[n]==0:
            v = row[:n]
            if all(t in (0,1) for t in v) and sum(v[i]*a[i] for i in range(n))==S:
                sols.append(list(v))
    return sols

for S in cts[:2]:
    print("S bits", S.bit_length())
    print(" cjloss:", len(try_cjloss(S)))
    print(" simple:", len(try_simple(S)))
EOF
