import z3, sys
a = [int(l) for l in open('/home/ctfplayer/ctf_files/files/pubkey.txt') if not l.strip().startswith('#')]
cts = [int(l) for l in open('/home/ctfplayer/ctf_files/files/ciphertext.txt') if not l.strip().startswith('#')]
n = len(a)
msg = b''
for idx, S in enumerate(cts):
    x = [z3.Int(f'x{idx}_{i}') for i in range(n)]
    s = z3.Solver()
    for xi in x:
        s.add(z3.Or(xi == 0, xi == 1))
    s.add(z3.Sum([x[i]*a[i] for i in range(n)]) == S)
    if s.check() != z3.sat:
        print("unsat block", idx); sys.exit(1)
    m = s.model()
    bits = [m.evaluate(xi).as_long() for xi in x]
    blk = bytes(int(''.join(str(bits[j*8+k]) for k in range(8)), 2) for j in range(9))
    print(idx, blk)
    msg += blk
print(msg)
EOF
