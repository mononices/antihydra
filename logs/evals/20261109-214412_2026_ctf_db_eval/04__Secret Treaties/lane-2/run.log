def build(S,N):
    B = Matrix(ZZ, n+1, n+1)
    for i in range(n):
        B[i,i] = 2
        B[i,n] = N*a[i]
    for j in range(n):
        B[n,j] = 1
    B[n,n] = N*S
    return B
def extract(L,S):
    out=[]
    for row in L:
        if row[n]==0:
            v=row[:n]
            if all(abs(t)==1 for t in v):
                x=[1 if t==1 else 0 for t in v]
                if sum(x[i]*a[i] for i in range(n))==S:
                    out.append(x)
    return out
for N in [1,2,3,5,10,100]:
    L=build(S,N).LLL()
    print("N",N,"LLL",len(extract(L,S)),end=' ')
    try:
        L2=build(S,N).BKZ(block_size=20)
        print("BKZ20",len(extract(L2,S)))
    except Exception as e:
        print("err",e)
