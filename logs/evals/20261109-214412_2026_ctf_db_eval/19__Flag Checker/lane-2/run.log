[15] create_file {"path": "/home/ctfplayer/workspace/probe.py", "content": "import requests, sys, time, json\n\nURL = \"http://flagchecker.chal.csaw.io:5000/check\"\nUA = \"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120 Safari/537.36\"\n\ndef show(label, r):\n    print(f\"{label:60s} {r.status_code} {r.text[:80]!r} hdr_acao={r.headers.get('Access-Control-Allow-Origin')}\")\n\ns = requests.Session()\ns.headers.update({\"User-Agent\": UA})\n\n# 1) length sweep\nprint(\"== length sweep ==\")\nfor n in range(0, 130):\n    f = \"csaw{\" + \"a\"*n + \"}\"\n    r = s.post(URL, data={\"flag\": f})\n    if r.status_code != 400 or r.text != '{\"error\":\"Invalid input\"}\\n':\n        show(f\"len {n}\", r)\n\n# 2) query param\nprint(\"== query ==\")\nfor f in [\"csaw{test}\", \"a\"*10]:\n    r = s.post(URL + \"?flag=\" + requests.utils.quote(f))\n    show(\"query \" + f, r)\n\n# 3) json variants\nprint(\"== json ==\")\nfor key in [\"flag\", \"guess\", \"input\", \"value\", \"answer\"]:\n    r = s.post(URL, json={key: \"csaw{test}\"})\n    show(\"json \" + key, r)\n\n# 4) timing on prefix\nprint(\"== timing ==\")\nimport statistics\ndef timeit(f, n=5):\n    ts=[]\n    for _ in range(n):\n        t=time.perf_counter(); r=s.post(URL, data={\"flag\": f}); ts.append(time.perf_counter()-t)\n    return statistics.median(ts), r.status_code\nfor f in [\"csaw{a\", \"csaw{z\", \"csaw{\"+\"a\"*30, \"csaw{\"+\"z\"*30, \"x\"*50]:\n    t, code = timeit(f)\n    print(f\"{f[:40]:45s} {code} {t*1000:.1f} ms\")\n"}
