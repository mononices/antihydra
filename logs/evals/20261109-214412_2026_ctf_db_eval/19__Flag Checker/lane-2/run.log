import requests, concurrent.futures
URL="http://flagchecker.chal.csaw.io:5000/check"
UA="Mozilla/5.0"
names = """flag guess input value answer submission user_input flag_input key data text password csaw code
token csrf csrf_token _token nonce secret pass passwd pwd user username name q query s search str string
content body payload message msg field f val v flagvalue flag_value testflag candidate attempt solution
answer_input flagbox flagcheck flag_check check_flag checker_flag the_flag real_flag actual_flag
flag1 flag2 flag0 fl4g FLAG Flag""".split()
def probe(n):
    try:
        r = requests.post(URL, data={n: "csaw{test}"}, headers={"User-Agent": UA}, timeout=10)
        return n, r.status_code, r.text[:60]
    except Exception as e:
        return n, "ERR", str(e)[:60]
with concurrent.futures.ThreadPoolExecutor(max_workers=10) as ex:
    for n, code, txt in ex.map(probe, names):
