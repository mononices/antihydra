[19] create_file {"content": "import socket\n\nHOST, PORT = \"flagchecker.chal.csaw.io\", 5000\nUA = \"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120 Safari/537.36\"\n\ndef req(raw):\n    s = socket.create_connection((HOST, PORT), timeout=10)\n    s.sendall(raw.encode(\"latin-1\"))\n    data = b\"\"\n    while True:\n        try:\n            c = s.recv(65536)\n        except socket.timeout:\n            break\n        if not c:\n            break\n        data += c\n    s.close()\n    return data.decode(\"latin-1\")\n\ndef post(body, ctype=\"application/x-www-form-urlencoded\", extra=\"\"):\n    raw = (f\"POST /check HTTP/1.1\\r\\nHost: {HOST}:{PORT}\\r\\nUser-Agent: {UA}\\r\\n\"\n           f\"Content-Type: {ctype}\\r\\nContent-Length: {len(body)}\\r\\n{extra}\"\n           f\"Connection: close\\r\\n\\r\\n{body}\")\n    return req(raw)\n\ntests = {\n    \"urlenc normal\": post(\"flag=csaw%7Btest%7D\"),\n    \"urlenc plus\": post(\"flag=csaw%7Bte+st%7D\"),\n    \"urlenc semicolon\": post(\"flag=csaw%7Bte;st%7D\"),\n    \"urlenc dup\": post(\"flag=csaw%7Ba%7D&flag=csaw%7Btest%7D\"),\n    \"urlenc extra\": post(\"x=1&flag=csaw%7Btest%7D\"),\n    \"urlenc noeq\": post(\"flag\"),\n    \"urlenc emptyval\": post(\"flag=\"),\n    \"urlenc utf8\": post(\"flag=csaw%7B%C3%A9%7D\"),\n    \"urlenc badpct\": post(\"flag=csaw%7B%zz%7D\"),\n    \"urlenc nul\": post(\"flag=csaw%7Bte%00st%7D\"),\n    \"urlenc space\": post(\"flag=csaw%7Bte%20st%7D\"),\n    \"urlenc bracket\": post(\"flag%5B%5D=csaw%7Btest%7D\"),\n    \"multipart normal\": post(\"--B\\r\\nContent-Disposition: form-data; name=\\\"flag\\\"\\r\\n\\r\\ncsaw{test}\\r\\n--B--\\r\\n\", \"multipart/form-data; boundary=B\"),\n    \"multipart file\": post(\"--B\\r\\nContent-Disposition: form-data; name=\\\"flag\\\"; filename=\\\"a\\\"\\r\\n\\r\\ncsaw{test}\\r\\n--B--\\r\\n\", \"multipart/form-data; boundary=B\"),\n    \"json normal\": post('{\"flag\":\"csaw{test}\"}', \"application/json\"),\n    \"text/plain\": post(\"csaw{test}\", \"text/plain\"),\n    \"no ctype\": post(\"flag=csaw%7Btest%7D\", \"\"),\n    \"chunked\": req(f\"POST /check HTTP/1.1\\r\\nHost: {HOST}:{PORT}\\r\\nUser-Agent: {UA}\\r\\nContent-Type: application/x-www-form-urlencoded\\r\\nTransfer-Encoding: chunked\\r\\nConnection: close\\r\\n\\r\\n12\\r\\nflag=csaw%7Btest%7D\\r\\n0\\r\\n\\r\\n\"),\n    \"get /\": req(f\"GET / HTTP/1.1\\r\\nHost: {HOST}:{PORT}\\r\\nUser-Agent: {UA}\\r\\nConnection: close\\r\\n\\r\\n\"),\n}\n\nfor k, v in tests.items():\n    first = v.split(\"\\r\\n\\r\\n\", 1)\n    status = v.split(\"\\r\\n\")[0]\n    body = first[1] if len(first) > 1 else \"\"\n    print(f\"--- {k}: {status} | {body[:120]!r}\")\n", "path": "/home/ctfplayer/workspace/raw.py"}
