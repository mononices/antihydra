import requests, concurrent.futures
URL="http://flagchecker.chal.csaw.io:5000/check"
UA="Mozilla/5.0"
def probe(n):
    f = "csaw{" + "a"*n + "}"
    try:
        r = requests.post(URL, data={"flag": f}, headers={"User-Agent": UA}, timeout=10)
        return n, r.status_code, r.text[:60]
    except Exception as e:
        return n, "ERR", str(e)[:60]
with concurrent.futures.ThreadPoolExecutor(max_workers=20) as ex:
    for n, code, txt in ex.map(probe, list(range(0,600,1))):
        if code != 400:
            print(n, code, txt)
print("done")
EOF
