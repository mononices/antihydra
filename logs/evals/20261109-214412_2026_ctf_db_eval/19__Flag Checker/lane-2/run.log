import requests, time
URL="http://flagchecker.chal.csaw.io:5000/check"
def t(ua, flag="csaw{test}", body=None, ctype=None, n=1):
    h={"User-Agent":ua}
    if ctype: h["Content-Type"]=ctype
    ts=[]
    r=None
    for _ in range(n):
        s=time.perf_counter()
        try:
            if body is not None:
                r=requests.post(URL, data=body, headers=h, timeout=20)
            else:
                r=requests.post(URL, data={"flag":flag}, headers=h, timeout=20)
        except Exception as e:
            return ("EXC",str(e)[:60],0)
        ts.append((time.perf_counter()-s)*1000)
    return (r.status_code, r.text.strip()[:60], ts)
