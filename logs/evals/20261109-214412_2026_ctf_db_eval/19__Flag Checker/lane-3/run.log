import requests, itertools, string
URL='http://flagchecker.chal.csaw.io:5000/check'
H={'User-Agent':'Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36'}
def t(v, **kw):
    try:
        r=requests.post(URL, data={'flag':v}, headers=H, timeout=10, **kw)
        return r.status_code, r.text.strip()
    except Exception as e:
        return 'ERR', str(e)[:60]
# lengths
for k in range(0, 121, 1):
    v = 'csaw{' + 'a'*k + '}'
    st, tx = t(v)
    if st != 400:
        print('LEN', k, len(v), st, tx)
print('length scan done')
alphabet_sets = {
 'hex': '0123456789abcdef',
 'b64': string.ascii_letters+string.digits+'-_',
 'alnum': string.ascii_letters+string.digits,
 'lower': string.ascii_lowercase,
 'upper': string.ascii_uppercase,
}
for name, al in alphabet_sets.items():
    for k in [8,16,20,24,26,28,30,32,36,40,42,43,44,48,52,56,60,64]:
        v = 'csaw{' + (al*4)[:k] + '}'
        st, tx = t(v)
        if st != 400:
            print(name, k, st, tx)
print('alphabet scan done')
# other wrappers
for w in ['flag{', 'CSAW{', 'csaw(', 'csaw[', 'csaw_', 'csaw-', 'flag:', 'csaw{0x', 'csaw{csaw_']:
    v = w + 'a'*30 + ('}' if w.endswith('{') else '')
    st, tx = t(v)
    if st != 400: print('wrap', w, st, tx)
print('wrap done')
EOF
