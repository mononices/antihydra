import requests, time, statistics
URL='http://flagchecker.chal.csaw.io:5000/check'
H={'User-Agent':'Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36'}
def t(f, n=5):
    ts=[]
    for _ in range(n):
        s=time.perf_counter()
        r=requests.post(URL, data={'flag':f}, headers=H, timeout=10)
        ts.append(time.perf_counter()-s)
    return min(ts), statistics.median(ts), r.status_code, r.text.strip()
for f in ['test','csaw{test}','csaw{'+'a'*10+'}','csaw{'+'a'*40+'}','csaw{'+'a'*80+'}','x'*200]:
    print(repr(f[:20]), len(f), t(f))
EOF
