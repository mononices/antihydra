n: close\\r\\n\\r\\n'\n    for i in range(0, len(body), 4):\n        ch=body[i:i+4]\n        req += f'{len(ch):x}\\r\\n'.encode()+ch+b'\\r\\n'\n    req += b'0\\r\\n\\r\\n'\n    s.sendall(req)\n    data=b''\n    s.settimeout(5)\n    try:\n        while True:\n            c=s.recv(65536)\n            if not c: break\n            data+=c\n    except Exception: pass\n    s.close()\n    return data\nprint('chunked:', chunked(b'flag=test')[-120:])", "path": "/home/ctfplayer/workspace/p8.py"}
