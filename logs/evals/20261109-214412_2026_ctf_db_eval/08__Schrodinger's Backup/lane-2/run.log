[06] create_file {"path": "/home/ctfplayer/workspace/evidence/parse.py", "content": "import struct, sys\n\nPSZ = 1024\n\ndef varint(buf, off):\n    v = 0\n    for i in range(9):\n        b = buf[off+i]\n        if i == 8:\n            v = (v << 8) | b\n            return v, off+9\n        v = (v << 7) | (b & 0x7f)\n        if not (b & 0x80):\n            return v, off+i+1\n    raise ValueError\n\ndef parse_record(payload):\n    hsize, off = varint(payload, 0)\n    types = []\n    p = off\n    while p < hsize:\n        t, p = varint(payload, p)\n        types.append(t)\n    vals = []\n    body = hsize\n    for t in types:\n        if t == 0:\n            vals.append(None)\n        elif t == 1:\n            vals.append(struct.unpack('>b', payload[body:body+1])[0]); body += 1\n        elif t == 2:\n            vals.append(struct.unpack('>h', payload[body:body+2])[0]); body += 2\n        elif t == 3:\n            v = int.from_bytes(payload[body:body+3], 'big', signed=True); body += 3\n            vals.append(v)\n        elif t == 4:\n            vals.append(struct.unpack('>i', payload[body:body+4])[0]); body += 4\n        elif t == 5:\n            v = int.from_bytes(payload[body:body+6], 'big', signed=True); body += 6\n            vals.append(v)\n        elif t == 6:\n            vals.append(struct.unpack('>q', payload[body:body+8])[0]); body += 8\n        elif t == 7:\n            vals.append(struct.unpack('>d', payload[body:body+8])[0]); body += 8\n        elif t == 8:\n            vals.append(0)\n        elif t == 9:\n            vals.append(1)\n        elif t >= 12 and t % 2 == 0:\n            n = (t-12)//2\n            vals.append(payload[body:body+n]); body += n\n        elif t >= 13:\n            n = (t-13)//2\n            vals.append(payload[body:body+n].decode('utf-8', 'replace')); body += n\n        else:\n            raise ValueError('serial type %d' % t)\n    return vals\n\ndef parse_page(page):\n    flags = page[0]\n    if flags != 0x0d:\n        raise ValueError('not a leaf table page: %02x' % flags)\n    ncell = struct.unpack('>H', page[3:5])[0]\n    rows = []\n    for i in range(ncell):\n        celloff = struct.unpack('>H', page[8+2*i:10+2*i])[0]\n        plen, p = varint(page, celloff)\n        rowid, p = varint(page, p)\n        payload = page[p:p+plen]\n        rows.append((rowid, parse_record(payload)))\n    return rows\n\ndef load_db(path):\n    data = open(path, 'rb').read()\n    npages = len(data)//PSZ\n    return [None] + [data[i*PSZ:(i+1)*PSZ] for i in range(npages)]\n\ndef parse_wal(path):\n    data = open(path, 'rb').read()\n    magic, ver, psz, ckpt, s1, s2, c1, c2 = struct.unpack('>IIIIIIII', data[:32])\n    frames = []\n    off = 32\n    idx = 0\n    while off + 24 + psz <= len(data):\n        pgno, commit, fs1, fs2, fc1, fc2 = struct.unpack('>IIIIII', data[off:off+24])\n        page = data[off+24:off+24+psz]\n        frames.append(dict(idx=idx, pgno=pgno, commit=commit, salt=(fs1, fs2), page=page))\n        off += 24+psz\n        idx += 1\n    return dict(psz=psz, salt=(s1, s2), frames=frames)\n\nif __name__ == '__main__':\n    pages = load_db('catalog.db')\n    wal = parse_wal('catalog.db-wal')\n    print('db pages', len(pages)-1)\n    for p in range(1, len(pages)):\n        try:\n            print('db page', p, parse_page(pages[p]))\n        except Exception as e:\n            print('db page', p, 'err', e)\n    print('wal salt', wal['salt'])\n    # valid frames: same salt as header, until salt mismatch\n    valid = []\n    for f in wal['frames']:\n        if f['salt'] != wal['salt']:\n            break\n        valid.append(f)\n    print('valid frames', len(valid), 'of', len(wal['frames']))\n    state = list(pages)\n    history = []\n    pending = []\n    for f in valid:\n        pending.append(f)\n        if f['commit']:\n            for pf in pending:\n                state[pf['pgno']] = pf['page']\n            pending = []\n            tables = {}\n            for p in (2,3,4,5):\n                try:\n                    tables[p] = parse_page(state[p])\n                except Exception as e:\n                    tables[p] = 'ERR %s' % e\n            print('commit after frame', f['idx'], 'commit size', f['commit'])\n            for p in (2,3,4,5):\n                print('   page', p, tables[p])\n            history.append(tables)\n    print('pending (unfinished):', [(f['idx'], f['pgno']) for f in pending])\n    print('num commits', len(history))\n"}
