[08] create_file {"content": "import struct, hashlib, json, itertools, sys\nfrom parse import load_db, parse_wal, parse_page\n\npages = load_db('catalog.db')\nwal = parse_wal('catalog.db-wal')\n\n# valid frames: salt must match WAL header salt\nvalid = []\nfor f in wal['frames']:\n    if f['salt'] != wal['salt']:\n        break\n    valid.append(f)\nprint('valid frames:', len(valid), 'total:', len(wal['frames']))\n\nstate = list(pages)\npending = []\ncommits = []\nfor f in valid:\n    pending.append(f)\n    if f['commit']:\n        for pf in pending:\n            state[pf['pgno']] = pf['page']\n        pending = []\n        ctrl = parse_page(state[2])[0][1]\n        north = parse_page(state[3])[0][1][1]\n        south = parse_page(state[4])[0][1][1]\n        maint = parse_page(state[5])[0][1][1]\n        commits.append(dict(frame=f['idx'], armed=ctrl[1], label=ctrl[2], north=north, south=south, pulse=maint))\nprint('unfinished pending frames:', [(f['idx'], f['pgno']) for f in pending])\n\ndef token(n, s):\n    return bytes(a ^ b for a, b in zip(n, s))\n\nhistory = []\nfor c in commits:\n    t = token(c['north'], c['south'])\n    rec = c['armed'] == 1\n    print('commit@%-3d armed=%d label=%-9s pulse=%-3d token=%s %s' % (\n        c['frame'], c['armed'], c['label'], c['pulse'], t.hex()[:16], 'RECORD' if rec else ''))\n    if rec:\n        history.append(t)\nprint('recorded tokens:', len(history))\n\nDOMAIN = b\"csaw-2026/schrodingers-backup/v1\\x00\"\ncap = json.load(open('capsule.json'))\nnonce = bytes.fromhex(cap['nonce'])\nct = bytes.fromhex(cap['ciphertext'])\n\ndef try_history(tokens, label):\n    key = hashlib.sha256(DOMAIN + b''.join(tokens)).digest()\n    try:\n        from cryptography.hazmat.primitives.ciphers.aead import AESGCM\n        pt = AESGCM(key).decrypt(nonce, ct, DOMAIN)\n        print('SUCCESS', label, pt)\n        return pt\n    except Exception as e:\n        return None\n\ntry_history(history, 'full history')\n\n# variants\n# 1) baseline included (main db state)\nbase_n = pages[3][:0]\ndef page_share(pg):\n    return parse_page(pg)[0][1][1]\nbase_tok = token(page_share(pages[3]), page_share(pages[4]))\ntry_history([base_tok] + history, 'baseline+history')\n\n# 2) without the first commit\ntry_history(history[1:], 'history[1:]')\n# 3) only commits where something changed (dedupe consecutive)\ndedup = []\nfor t in history:\n    if not dedup or dedup[-1] != t:\n        dedup.append(t)\ntry_history(dedup, 'dedup consecutive')\n# 4) all commits tokens regardless of armed\nallt = [token(c['north'], c['south']) for c in commits]\ntry_history(allt, 'all commits')\n# 5) unique tokens in order\nuniq = list(dict.fromkeys(history))\ntry_history(uniq, 'unique')\n", "path": "/home/ctfplayer/workspace/evidence/solve.py"}
