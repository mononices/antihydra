[05] create_file {"path": "/home/ctfplayer/workspace/parse_wal.py", "content": "#!/usr/bin/env python3\n\"\"\"Parse the SQLite WAL: header, frames, salts, checksums, commit markers.\"\"\"\nimport struct, sys\n\nWAL = \"/home/ctfplayer/workspace/ev/catalog.db-wal\"\n\ndata = open(WAL, \"rb\").read()\nprint(\"wal size\", len(data))\n\nmagic, ver, pgsz, ckpt, salt1, salt2, ck1, ck2 = struct.unpack(\">8I\", data[:32])\nprint(f\"magic={magic:#x} ver={ver} pgsz={pgsz} ckpt_seq={ckpt} salt=({salt1:#x},{salt2:#x}) cksum=({ck1:#x},{ck2:#x})\")\n\ndef wal_checksum(data, s0, s1):\n    # big-endian words (magic 0x377f0682)\n    for i in range(0, len(data), 8):\n        x0, x1 = struct.unpack(\">2I\", data[i:i+8])\n        s0 = (s0 + x0 + s1) & 0xffffffff\n        s1 = (s1 + x1 + s0) & 0xffffffff\n    return s0, s1\n\n# verify header checksum over first 24 bytes\nh0, h1 = wal_checksum(data[:24], 0, 0)\nprint(f\"header checksum computed=({h0:#x},{h1:#x}) stored=({ck1:#x},{ck2:#x}) match={h0==ck1 and h1==ck2}\")\n\nframe_hdr = 24\nframes = []\noff = 32\nidx = 0\ns0, s1 = ck1, ck2\nwhile off + frame_hdr + pgsz <= len(data):\n    pgno, dbsize, fs1, fs2, fc1, fc2 = struct.unpack(\">6I\", data[off:off+frame_hdr])\n    page = data[off+frame_hdr: off+frame_hdr+pgsz]\n    # frame checksum covers first 8 bytes of frame header + page data, continuing chain\n    cs0, cs1 = wal_checksum(data[off:off+8] + page, s0, s1)\n    ok = (cs0 == fc1 and cs1 == fc2)\n    frames.append(dict(i=idx, off=off, pgno=pgno, dbsize=dbsize, salt=(fs1, fs2),\n                       ck=(fc1, fc2), ck_ok=ok, page=page))\n    s0, s1 = cs0, cs1\n    off += frame_hdr + pgsz\n    idx += 1\n\nprint(f\"parsed {len(frames)} frames, trailing bytes={len(data)-off}\")\nfor f in frames:\n    print(f\"frame {f['i']:3d} off={f['off']:6d} pgno={f['pgno']} dbsize={f['dbsize']:5d} \"\n          f\"salt=({f['salt'][0]:#010x},{f['salt'][1]:#010x}) salt_ok={f['salt']==(salt1,salt2)} ck_ok={f['ck_ok']}\")\n"}
