[07] create_file {"content": "#!/usr/bin/env python3\n\"\"\"Try both checksum byte orders on the WAL header + frame chain.\"\"\"\nimport struct\n\nWAL = \"/home/ctfplayer/workspace/ev/catalog.db-wal\"\ndata = open(WAL, \"rb\").read()\npgsz = 1024\n\ndef cksum(data, s0, s1, little):\n    fmt = \"<2I\" if little else \">2I\"\n    for i in range(0, len(data), 8):\n        x0, x1 = struct.unpack(fmt, data[i:i+8])\n        s0 = (s0 + x0 + s1) & 0xffffffff\n        s1 = (s1 + x1 + s0) & 0xffffffff\n    return s0, s1\n\nfor little in (True, False):\n    h0, h1 = cksum(data[:24], 0, 0, little)\n    stored = struct.unpack(\">2I\", data[24:32])\n    print(f\"little={little} header computed=({h0:#x},{h1:#x}) stored=({stored[0]:#x},{stored[1]:#x}) match={h0==stored[0] and h1==stored[1]}\")\n\n# frame chain check with little-endian\nfor little in (True, False):\n    s0, s1 = struct.unpack(\">2I\", data[24:32])\n    ok_count = 0\n    off, i = 32, 0\n    while off + 24 + pgsz <= len(data):\n        pgno, dbsize, fs1, fs2, fc1, fc2 = struct.unpack(\">6I\", data[off:off+24])\n        page = data[off+24:off+24+pgsz]\n        cs0, cs1 = cksum(data[off:off+8] + page, s0, s1, little)\n        ok = (cs0 == fc1 and cs1 == fc2)\n        if ok: ok_count += 1\n        else:\n            print(f\"  little={little} first bad frame {i} pgno={pgno} computed=({cs0:#x},{cs1:#x}) stored=({fc1:#x},{fc2:#x})\")\n            break\n        s0, s1 = cs0, cs1\n        off += 24 + pgsz\n        i += 1\n    print(f\"little={little}: {ok_count} consecutive good frames\")\n"}
