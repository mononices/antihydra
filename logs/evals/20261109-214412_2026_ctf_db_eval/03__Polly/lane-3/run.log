\n    return transform\n\ndef transformation(operator, state):\n    result = 0\n    s = state\n    while s:\n        b = (s & -s).bit_length() - 1\n        result ^= operator[b]\n        s &= s - 1\n    return result & MASK64\n\ndef square_operator(operator):\n    return [transformation(operator, column) for column in operator]\n\ndef build_jumps(num, shifts):\n    t = make_transform(num, shifts)\n    jumps = [[t(1 << bit) for bit in range(64)]]\n    for _ in range(63):\n        jumps.append(square_operator(jumps[-1]))\n    return jumps\n\ndef state_at(x, seed, jumps):\n    state = seed & MASK64\n    for bit in range(64):\n        if x & (1 << bit):\n            state = transformation(jumps[bit], state)\n    return state\n\n# ---------------- protocol ----------------\nclass Conn:\n    def __init__(self, host, port):\n        self.s = socket.create_connection((host, port), timeout=30)\n        self.buf = b\"\"\n    def recv_until(self, marker):\n        while marker not in self.buf:\n            chunk = self.s.recv(65536)\n            if not chunk:\n                raise EOFError(\"connection closed; tail=\" + repr(self.buf[-800:]))\n            self.buf += chunk\n        idx = self.buf.index(marker) + len(marker)\n        out, self.buf = self.buf[:idx], self.buf[idx:]\n        return out\n    def send_line(self, data: bytes):\n        self.s.sendall(data + b\"\\n\")\n    def query(self, x, plaintext):\n        self.recv_until(b\"which seed modifier would you like to use?\")\n        self.send_line(str(x).encode())\n        self.recv_until(b\"enter a string to be encrypted: \")\n        self.send_line(plaintext)\n        resp = self.recv_until(b\"Your nonce byte is: \")\n        resp += self.recv_until(b\"\\n\")\n        m = re.search(rb\"Your ciphertext is: ([0-9a-f]+)\", resp)\n        n = re.search(rb\"Your nonce byte is: ([0-9a-f]+)\", resp)\n        assert m and n, resp\n        return bytes.fromhex(m.group(1).decode()), int(n.group(1), 16)\n\ndef main():\n    c = Conn(HOST, PORT)\n    banner = c.recv_until(b\"which seed modifier would you like to use?\")\n    print(banner.decode(errors=\"replace\"))\n    m = re.search(rb\"encrypted flag is ([0-9a-f]+), the nonce is ([0-9a-f]+)\", banner)\n    flag_ct = bytes.fromhex(m.group(1).decode())\n    nonce = bytes.fromhex(m.group(2).decode())\n    print(\"flag_ct len:\", len(flag_ct), \"nonce:\", nonce.hex())\n\n    base_nonce = nonce[:9]\n    target = int.from_bytes(nonce[9:12], \"big\")\n    print(\"base_nonce:\", base_nonce.hex(), \"target(24-bit state):\", hex(target))\n\n    material = shake_256(base_nonce).digest(5)\n    available = list(range(1, 64))\n    shifts = []\n    for byte in material[1:]:\n        idx = byte % len(available)\n        shifts.append(available.pop(idx))\n    num = material[0] & 1\n    print(\"shifts:\", shifts, \"num:\", num)\n\n    jumps = build_jumps(num, shifts)\n\n    # Query x = 2^i for i = 0..15; each gives low byte of T^(2^i)(seed) = JUMPS[i](seed)\n    NQ = 16\n    obs = []\n    for i in range(NQ):\n        ct, nb = c.query(1 << i, b\"A\" * len(flag_ct))\n        obs.append((1 << i, nb))\n        print(f\"query x=2^{i}: nonce byte = {nb:02x}\")\n\n    # Equations: for each query, for each output bit b in 0..7:\n    #   bit b of JUMPS[i](seed) = sum_j seed_j * <e_b, JUMPS[i](e_j)> = rhs\n    # JUMPS[i] is given as operator list: JUMPS[i][j] = image of e_j.\n    rows = []\n    for (x, nb) in obs:\n        i = x.bit_length() - 1\n        op = jumps[i]\n        for b in range(8):\n            coeff = 0\n            for j in range(64):\n                if (op[j] >> b) & 1:\n                    coeff |= 1 << j\n            rhs = (nb >> b) & 1\n            rows.append((coeff, rhs))\n\n    r = rank_gf2(rows)\n    print(\"rank of system:\", r, \"of 64 unknowns\")\n    seed = solve_gf2(rows, 64)\n    if seed is None:\n        print(\"INCONSISTENT SYSTEM\")\n        return\n    print(\"recovered seed:\", hex(seed))\n\n    # Verify seed against all observations\n    ok = all((state_at(x, seed, jumps) & 0xFF) == nb for x, nb in obs)\n    print(\"verify all observations:\", ok)\n    if not ok:\n        print(\"seed wrong, aborting\")\n        return\n\n    # Now find x such that state_at(x, seed) & 0xFFFFFF == target.\n    # state_at(x, seed) = XOR over set bits of x of JUMPS[i](seed) = linear in x.\n    # Precompute v_i = JUMPS[i](seed) for i in 0..63.\n    v = [transformation(jumps[i], seed) for i in range(64)]\n    # For each of the 24 low bits b, equation: sum_i x_i * v_i[b] = target_b\n    rows2 = []\n    for b in range(24):\n        coeff = 0\n        for i in range(64):\n            if (v[i] >> b) & 1:\n                coeff |= 1 << i\n        rhs = (target >> b) & 1\n        rows2.append((coeff, rhs))\n    print(\"rank of x-system:\", rank_gf2(rows2), \"of 64\")\n    x_sol = solve_gf2(rows2, 64)\n    if x_sol is None:\n        print(\"no solution for x; trying extended search\")\n        return\n    print(\"solution x:\", hex(x_sol))\n    chk = state_at(x_sol, seed, jumps)\n    print(\"state_at(x_sol) =\", hex(chk), \"low24 =\", hex(chk & 0xFFFFFF), \"target =\", hex(target))\n    assert (chk & 0xFFFFFF) == target\n\n    # Query with that x using known plaintext -> keystream -> decrypt flag\n    pt = b\"\\x00\" * len(flag_ct)\n    ct2, nb2 = c.query(x_sol, pt)\n    print(\"nonce byte at x_sol:\", hex(nb2), \"expected:\", hex(target & 0xFF))\n    keystream = ct2  # plaintext is zeros\n    flag = bytes(a ^ b for a, b in zip(flag_ct, keystream))\n    print(\"FLAG:\", flag)\n    return flag\n\nif __name__ == \"__main__\":\n    main()\n"}
