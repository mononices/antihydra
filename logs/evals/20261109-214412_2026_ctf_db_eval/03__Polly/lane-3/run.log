import socket, sys

HOST, PORT = "polly.chal.csaw.io", 5000

def recv_until(s, marker, timeout=10):
    s.settimeout(timeout)
    data = b""
    while marker not in data:
        chunk = s.recv(4096)
        if not chunk:
            break
        data += chunk
    return data

def main():
    s = socket.create_connection((HOST, PORT))
    banner = recv_until(s, b"??\n")
    print("BANNER:", banner.decode(errors="replace"))
    # ask for x=0 with a known plaintext
    s.sendall(b"0\n")
    resp = recv_until(s, b"encrypted: ")
    print("RESP1:", resp.decode(errors="replace"))
    pt = b"A"*64
    s.sendall(pt + b"\n")
    resp2 = recv_until(s, b"byte is: ")
    # read the rest of that line
    s.settimeout(5)
    try:
        resp2 += s.recv(4096)
    except Exception as e:
        pass
    print("RESP2:", resp2.decode(errors="replace"))
    s.close()

main()
EOF
