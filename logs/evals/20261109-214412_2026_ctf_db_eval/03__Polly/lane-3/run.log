# Verify: is T invertible? And is the low-24-bit map well-defined on low-24 bits of input?
# For shifts with left-shifts, low bits of output depend only on low bits of input? 
# state ^= (state << s): low 24 bits of result depend on low 24-s bits of state... yes only low bits.
# state ^= state >> s: low 24 bits of result depend on bits 0..23+s of state -> high bits leak in!
# So low-24 output depends on high input bits. Not triangular. But we can still solve the linear system on 64 vars.
import random
MASK64=(1<<64)-1
def make_transform(num, shifts):
    def transform(state):
        if num % 2 == 0:
            state ^= (state << shifts[0]) & MASK64
            state ^= state >> shifts[1]
            state ^= (state << shifts[2]) & MASK64
            state ^= state >> shifts[3]
        else:
            state ^= (state >> shifts[0])
            state ^= (state << shifts[1]) & MASK64
            state ^= (state >> shifts[2])
            state ^= (state << shifts[3]) & MASK64
        return state & MASK64
    return transform

random.seed(0)
shifts = random.sample(range(1,64),4)
num = 0
t = make_transform(num, shifts)
# check invertibility: build matrix and rank
cols = [t(1<<b) for b in range(64)]
# gaussian elimination
rows = cols[:]  # column b is image of e_b
basis = []
rank = 0
for v in rows:
    x = v
    for b in basis:
        x = min(x, x ^ b)
    # simple: use linear basis
    y = v
    for b in basis:
        y = min(y, y ^ b)
    if y:
        basis.append(y)
        basis.sort(reverse=True)
        rank += 1
print("rank of T =", rank)
