import socket, time, re
HOST, PORT = "polly.chal.csaw.io", 5000
s = socket.create_connection((HOST, PORT), timeout=20)
s.settimeout(2)
def rd():
    out=b""
    try:
        while True:
            d=s.recv(65536)
            if not d: break
            out+=d
    except Exception:
        pass
    return out
banner = rd().decode(errors="replace")
print("BANNER:", banner)
m = re.search(r"nonce is ([0-9a-f]+)", banner)
bnonce = bytes.fromhex(m.group(1))
print("base_nonce:", bnonce.hex(), "len", len(bnonce))
# check whether option value affects the nonce byte at all: same x with option 1 vs 2
for opt in [b"1", b"2"]:
    s.sendall(opt + b"\n")
    time.sleep(0.2); rd()
    s.sendall(b"Z\n")
    time.sleep(0.2)
    r = rd().decode(errors="replace")
    print("OPT", opt, "->", r.strip())
s.close()
EOF
