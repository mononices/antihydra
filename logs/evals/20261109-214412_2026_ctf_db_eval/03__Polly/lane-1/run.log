# Check rank of the map seed -> (low24(T^x(seed)) for x=1..N) for various base_nonces
import os
from rows import build_params, _transform, _transformation, _square_operator, MASK64
from hashlib import shake_256

def rank_of_system(base_nonce, nqueries):
    shifts, num = build_params(base_nonce)
    first_jump = [_transform(1 << bit, num, shifts) for bit in range(64)]
    jumps = [first_jump]
    for _ in range(63):
        jumps.append(_square_operator(jumps[-1]))
    def state_at(x, seed):
        state = seed & MASK64
        for bit in range(64):
            if x & (1 << bit):
                state = _transformation(jumps[bit], state)
        return state
    rows = []
    for x in range(1, nqueries+1):
        cc = [state_at(x, 1 << j) & 0xFFFFFF for j in range(64)]
        for k in range(8):
            rows.append(sum(((cc[j] >> k) & 1) << j for j in range(64)))
    # gaussian elimination to find rank
    piv = {}
    for r in rows:
        cur = r
        while cur:
            bit = (cur & -cur).bit_length() - 1
            if bit in piv:
                cur ^= piv[bit]
            else:
                piv[bit] = cur
                break
    return len(piv)

for trial in range(10):
    bn = os.urandom(9)
    r20 = rank_of_system(bn, 20)
    r40 = rank_of_system(bn, 40)
    print("nonce=%s rank(20q)=%d rank(40q)=%d" % (bn.hex(), r20, r40))
