import socket, time, re
s = socket.create_connection(("polly.chal.csaw.io", 5000), timeout=20)
s.settimeout(10)

def recv_until(marker, timeout=15):
    buf = b""
    end = time.time() + timeout
    while marker not in buf:
        d = s.recv(4096)
        if not d: raise RuntimeError("EOF")
        buf += d
        if time.time() > end: raise RuntimeError("timeout %r" % buf[-100:])
    return buf

buf = recv_until(b"which seed")
m = re.search(rb"encrypted flag is ([0-9a-f]+), the nonce is ([0-9a-f]+)", buf)
