[26] create_file {"path": "/home/ctfplayer/workspace/rows.py", "content": "\"\"\"Build the GF(2) matrix for state_at(x, .) restricted to low 24 bits,\ngiven base_nonce (recovered from the banner).\n\nFor each x, cols[x] = [c_0..c_63] (24-bit ints) such that\n    out = state_at(x, seed) & 0xFFFFFF = XOR_{j: seed_j = 1} c_j\ni.e. c_j = state_at(x, 1 << j) & 0xFFFFFF.\n\"\"\"\n\nMASK64 = (1 << 64) - 1\n\n\ndef _transform(state, num, shifts):\n    if num % 2 == 0:\n        state ^= (state << shifts[0]) & MASK64\n        state ^= state >> shifts[1]\n        state ^= (state << shifts[2]) & MASK64\n        state ^= state >> shifts[3]\n    else:\n        state ^= state >> shifts[0]\n        state ^= (state << shifts[1]) & MASK64\n        state ^= state >> shifts[2]\n        state ^= (state << shifts[3]) & MASK64\n    return state & MASK64\n\n\ndef _transformation(operator, state):\n    result = 0\n    for bit in range(64):\n        if state & (1 << bit):\n            result ^= operator[bit]\n    return result & MASK64\n\n\ndef _square_operator(operator):\n    return [_transformation(operator, column) for column in operator]\n\n\ndef build_params(base_nonce):\n    from hashlib import shake_256\n    material = shake_256(base_nonce).digest(5)\n    available_shifts = list(range(1, 64))\n    shifts = []\n    for byte in material[1:]:\n        index = byte % len(available_shifts)\n        shifts.append(available_shifts.pop(index))\n    num = material[0] & 1\n    return shifts, num\n\n\ndef build_cols(base_nonce, xs=range(1, 200)):\n    shifts, num = build_params(base_nonce)\n    first_jump = [_transform(1 << bit, num, shifts) for bit in range(64)]\n    jumps = [first_jump]\n    for _ in range(63):\n        jumps.append(_square_operator(jumps[-1]))\n\n    def state_at(x, seed):\n        state = seed & MASK64\n        for bit in range(64):\n            if x & (1 << bit):\n                state = _transformation(jumps[bit], state)\n        return state\n\n    cols = {}\n    for x in xs:\n        cols[x] = [state_at(x, 1 << j) & 0xFFFFFF for j in range(64)]\n    return cols\n\n\ndef build_rows(base_nonce, xs=range(1, 200)):\n    \"\"\"Legacy helper: bit j of rows[x] = LSB of column j.\"\"\"\n    cols = build_cols(base_nonce, xs)\n    return {x: sum(((c[0] >> 0) & 1) << j for j, c in enumerate(cc))\n            for x, cc in cols.items()}\n"}
