from rows import _transform, _transformation, _square_operator, MASK64
from hashlib import shake_256

d = json.load(open("server_big.json"))
bn = bytes.fromhex(d["nonce"][:18])
outs = {int(k): v for k, v in d["outs"].items()}

material = shake_256(bn).digest(5)
available_shifts = list(range(1, 64)); shifts=[]
for byte in material[1:]:
    index = byte % len(available_shifts); shifts.append(available_shifts.pop(index))
num = material[0] & 1
print("shifts:", shifts, "num:", num)

first_jump = [_transform(1 << bit, num, shifts) for bit in range(64)]
jumps = [first_jump]
for _ in range(63):
    jumps.append(_square_operator(jumps[-1]))
def state_at(xx, s):
    st = s & MASK64
    for bit in range(64):
        if xx & (1 << bit):
            st = _transformation(jumps[bit], st)
    return st

# Build the GF(2) system over seed bits: for each x, 8 equations
rows, rhs = [], []
for x in sorted(outs):
    cc = [state_at(x, 1 << j) & 0xFFFFFF for j in range(64)]
    out = outs[x]
    for k in range(8):
        rows.append(sum(((cc[j] >> k) & 1) << j for j in range(64)))
        rhs.append((out >> k) & 1)

piv = {}
for r, b in zip(rows, rhs):
    cur, curb = r, b
    while cur:
        bit = (cur & -cur).bit_length() - 1
        if bit in piv:
            pr, pb = piv[bit]
            cur ^= pr; curb ^= pb
        else:
            piv[bit] = (cur, curb); break
    else:
        if curb:
            print("INCONSISTENT")
            break
print("rank:", len(piv))
free = [j for j in range(64) if j not in piv]
print("free bits:", free)

# enumerate all solutions (up to 2^free)
x0 = 0
for bit in sorted(piv.keys(), reverse=True):
    r, b = piv[bit]
    if b ^ (bin(r & x0).count("1") & 1):
        x0 |= 1 << bit
print("particular:", hex(x0))
kern = []
for f in free:
    v = 1 << f
    for bit in sorted(piv.keys(), reverse=True):
        r, b = piv[bit]
        if bin(r & v).count("1") & 1:
            v |= 1 << bit
    kern.append(v)
print("kernel dim:", len(kern))
json.dump({"x0": x0, "kern": kern}, open("seed_sols.json","w"))
