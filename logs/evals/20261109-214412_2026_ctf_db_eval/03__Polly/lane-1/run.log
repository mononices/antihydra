    jumps.append(_square_operator(jumps[-1]))
def state_at(xx, s):
    st = s & MASK64
    for bit in range(64):
        if xx & (1 << bit):
            st = _transformation(jumps[bit], st)
    return st

# columns of the map x -> low24(state_at(x, seed))
colv = [state_at(1 << bit, seed) & 0xFFFFFF for bit in range(64)]
rows, rhs = [], []
for k in range(24):
    rows.append(sum(((colv[j] >> k) & 1) << j for j in range(64)))
    rhs.append((target_state >> k) & 1)

# find ALL solutions (kernel may be nontrivial)
piv = {}
for r, b in zip(rows, rhs):
    cur, curb = r, b
    while cur:
        bit = (cur & -cur).bit_length() - 1
        if bit in piv:
            pr, pb = piv[bit]
            cur ^= pr; curb ^= pb
        else:
            piv[bit] = (cur, curb); break
    else:
        if curb: raise ValueError("inconsistent")
print("rank:", len(piv))
free = [j for j in range(64) if j not in piv]
