src = open('solver.py').read()
old_start = src.index('def gf2_solve')
old_end = src.index('def collect_and_solve')
new_fn = '''def gf2_solve(rows, rhs, ncols):
    """Solve GF(2) system rows*x = rhs. rows = list of ints, bit i = coeff of var i.
    Returns x (int) with ncols bits set."""
    piv = {}  # pivot bit -> (row, rhsbit); pivot row's lowest set bit == pivot bit
    for r, b in zip(rows, rhs):
        cur, curb = r, b
        while cur:
            low = cur & -cur
            bit = low.bit_length() - 1
            if bit in piv:
                pr, pb = piv[bit]
                cur ^= pr
                curb ^= pb
            else:
                piv[bit] = (cur, curb)
                cur = 0
        if curb:
            raise ValueError("inconsistent system")
    if len(piv) < ncols:
        raise ValueError("underdetermined: %d/%d pivots" % (len(piv), ncols))
    x = 0
    for bit in sorted(piv.keys(), reverse=True):
        r, b = piv[bit]
        val = b ^ (bin(r & x).count("1") & 1)
        if val:
            x |= 1 << bit
    return x


'''
src = src[:old_start] + new_fn + src[old_end:]

