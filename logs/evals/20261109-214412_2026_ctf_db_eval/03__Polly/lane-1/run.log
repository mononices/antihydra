print("nonce:", m.group(2).decode())

# deterministic sweep over many x values (powers of two + small ints + random-ish fixed set)
xs = list(range(1, 65)) + [1<<i for i in range(64)] + [(1<<(63-i))-1 for i in range(8)]
outs = {}
for x in xs[:400]:
    s.sendall(b"%d\n" % x)
    recv_until(b"enter a string")
    s.sendall(b"A\n")
    data = recv_until(b"nonce byte is")
    mb = re.search(rb"nonce byte is: ([0-9a-f]{2})", data)
    outs[x] = int(mb.group(1), 16)
s.close()
import json; json.dump({"nonce": m.group(2).decode(), "flag_ct": m.group(1).decode(),
                        "outs": {str(k): v for k,v in outs.items()}}, open("server_big.json","w"))
print("collected", len(outs))
