import socket, time, re
s = socket.create_connection(("polly.chal.csaw.io", 5000), timeout=20)
s.settimeout(10)

def recv_until(marker, timeout=15):
    buf = b""
    end = time.time() + timeout
    while marker not in buf:
        if time.time() > end:
            raise RuntimeError("timeout, got %r" % buf[-200:])
        d = s.recv(4096)
        if not d:
            raise RuntimeError("EOF")
        buf += d
    return buf

buf = recv_until(b"which seed")
m = re.search(rb"encrypted flag is ([0-9a-f]+), the nonce is ([0-9a-f]+)", buf)
print("flag ct:", m.group(1).decode())
print("nonce:", m.group(2).decode())

outs = []
for x in range(1, 26):
    s.sendall(b"%d\n" % x)
    recv_until(b"enter a string")
    s.sendall(b"A\n")
    data = recv_until(b"nonce byte is")
    mb = re.search(rb"nonce byte is: ([0-9a-f]{2})", data)
    outs.append(int(mb.group(1), 16))
print("outs:", [hex(o) for o in outs])
s.close()

import json
json.dump({"nonce": m.group(2).decode(), "flag_ct": m.group(1).decode(), "outs": outs},
          open("server_data.json","w"))
print("saved")
