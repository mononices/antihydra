g)\nprint(\"true seed:\", seed_true)\n\ntable = build_rows(base_nonce)\nrows, rhs = [], []\nx = 1\nwhile len(rows) < 160:\n    out = state_at(x, seed_true) & 0xFFFFFF\n    for bit in range(8):\n        rows.append(table[x])\n        rhs.append((out >> bit) & 1)\n    x += 1\nseed = gf2_solve(rows, rhs, 64)\nprint(\"recovered:\", seed, \"match:\", seed == seed_true)\n\nif seed == seed_true:\n    rec = ChaCha20.new(key=key, nonce=nonce).decrypt(ct)\n    print(\"decrypted:\", rec)\n"}
