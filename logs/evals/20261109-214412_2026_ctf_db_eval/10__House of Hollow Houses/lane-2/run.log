import re, os, glob, hashlib
files = sorted(glob.glob("house/*.html"))
rows=[]
for fn in files:
    txt = open(fn, encoding="utf-8", errors="replace").read()
    name = os.path.basename(fn)[:-5]
    body = txt.split("</head>",1)[1] if "</head>" in txt else txt
    h1 = re.search(r'<h1[^>]*>(.*?)</h1>', txt, re.S)
    sub = re.search(r'<span class="sub"[^>]*>(.*?)</span>', txt, re.S)
    glyph = re.search(r'<span class="glyph[^"]*"[^>]*>(.*?)</span>', txt, re.S)
    tags = sorted(set(re.findall(r'<(pre|code|table|form|input|iframe|script|svg|img|canvas|template|details|object|embed)\b', txt)))
    classes = sorted(set(re.findall(r'class="([^"]+)"', txt)))
    rows.append((name, len(txt), tags, classes, h1.group(1) if h1 else None, sub.group(1) if sub else None))
for r in rows:
    print(f"{r[0]:15} {r[1]:6} tags={r[2]} h1={r[4]!r} sub={r[5]!r}")
