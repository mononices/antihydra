import re, glob, os, collections
glyphs=[]
for fn in sorted(glob.glob('house/*.html')):
    name=os.path.basename(fn)[:-5]
    txt=open(fn,encoding='utf-8',errors='replace').read()
    m=re.search(r'<span class="glyph[^"]*">([\s\S]*?)</span>',txt)
    if m:
        syms=[chr(int(x,16)) for x in re.findall(r'&#x([0-9a-fA-F]+);',m.group(1))]
        if not syms:
            syms=[c for c in m.group(1) if ord(c)>0x2000]
        glyphs.append((name,syms))
print(len(glyphs))
allg=[g for _,s in glyphs for g in s]
print("alphabet size:", len(set(allg)))
cnt=collections.Counter(allg)
