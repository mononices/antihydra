import re, os, glob, base64, html

files = sorted(glob.glob("house/*.html"))
for fn in files:
    txt = open(fn, encoding="utf-8", errors="replace").read()
    name = os.path.basename(fn)[:-5]
    out = []
    # base64-ish blobs in <code> or pre
    for m in re.finditer(r'<code[^>]*>\s*([A-Za-z0-9+/=\s]{20,})\s*</code>', txt):
        blob = re.sub(r'\s+','',m.group(1))
        try:
            dec = base64.b64decode(blob).decode('utf-8','replace')
            out.append(f"CODE-B64[{blob}] -> {dec}")
        except Exception as e:
            out.append(f"CODE[{blob}] undecodable")
    # comments
    for m in re.finditer(r'<!--(.*?)-->', txt, re.S):
        c = m.group(1).strip()
        if c: out.append(f"COMMENT: {c[:300]}")
    # meta / hidden inputs
    for m in re.finditer(r'<meta[^>]*>', txt):
        if 'charset' not in m.group(0) and 'viewport' not in m.group(0):
            out.append("META: "+m.group(0))
    # class h / hh contents
    hs = re.findall(r'<span class="(?:h|hh)"[^>]*>(.*?)</span>', txt, re.S)
    if hs: out.append("HIDDEN-SPANS: "+repr(hs))
    if out:
        print("="*20, name, "="*20)
        for o in out: print("   ", o)
EOF
