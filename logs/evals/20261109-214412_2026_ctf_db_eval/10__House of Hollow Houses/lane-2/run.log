[17] run_command cd /home/ctfplayer/workspace && cat > uniq.py <<'EOF'
import re, glob, os, collections, html as H
pages={}
for fn in sorted(glob.glob('house/*.html')):
    name=os.path.basename(fn)[:-5]
    txt=open(fn,encoding='utf-8',errors='replace').read()
    body=txt.split('</head>',1)[1] if '</head>' in txt else txt
    # strip tags
    t=re.sub(r'<style[\s\S]*?</style>','',body)
    t=re.sub(r'<script[\s\S]*?</script>','',t)
    t=re.sub(r'<[^>]+>','\x00',t)
    t=H.unescape(t)
    t=re.sub(r'[ \t]+',' ',t)
    pages[name]=t
# split into lines/blocks
blocks=collections.Counter()
where=collections.defaultdict(list)
for name,t in pages.items():
    for b in t.split('\x00'):
        b=b.strip()
        if len(b)>25:
            blocks[b]+=1
            where[b].append(name)
uniq=[b for b,c in blocks.items() if c==1]
print("total blocks", len(blocks), "unique", len(uniq))
for b in sorted(uniq, key=lambda x: where[x][0]):
    print(f"[{where[b][0]}] {b[:400]}")
EOF
