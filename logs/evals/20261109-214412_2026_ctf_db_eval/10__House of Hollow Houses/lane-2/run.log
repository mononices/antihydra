import re, os, urllib.request, urllib.parse, time, sys

BASE = "http://house-of-hollow-houses.chal.csaw.io:8000"
OUT = "/home/ctfplayer/workspace/house"
os.makedirs(OUT, exist_ok=True)

seen = {}   # path -> status
queue = ["/"]
def norm(u):
    u = urllib.parse.urljoin(BASE+"/", u)
    if not u.startswith(BASE): return None
    p = u[len(BASE):]
    if not p.startswith("/"): p = "/"+p
    return p

while queue:
    p = queue.pop(0)
    if p in seen: continue
    url = BASE + p
    try:
        req = urllib.request.Request(url, headers={"User-Agent":"Mozilla/5.0"})
        with urllib.request.urlopen(req, timeout=15) as r:
            data = r.read()
            status = r.status
    except urllib.error.HTTPError as e:
        seen[p] = e.code
        continue
    except Exception as e:
        seen[p] = "ERR"
        continue
    seen[p] = status
    fn = os.path.join(OUT, urllib.parse.quote(p.strip("/") or "index", safe="") + ".html")
    open(fn,"wb").write(data)
    txt = data.decode("utf-8","replace")
    for m in re.finditer(r'href="([^"#]+)"', txt):
        np = norm(m.group(1))
        if np and np not in seen and np not in queue:
            queue.append(np)

print(len(seen))
import json
json.dump(seen, open(OUT+"/_status.json","w"), indent=0, sort_keys=True)
for k,v in sorted(seen.items()): print(v,k)
EOF
