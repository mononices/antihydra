[09] create_file {"path": "/home/ctfplayer/workspace/extract.py", "content": "#!/usr/bin/env python3\n\"\"\"Extract hidden acrostics (first letters of paragraphs) and other patterns from each page.\"\"\"\nimport re, os, glob, html\n\nOUT = \"/home/ctfplayer/workspace/pages\"\n\ndef paragraphs(body):\n    # main content only\n    m = re.search(r'<main>(.*?)</main>', body, re.S)\n    if not m:\n        return []\n    main = m.group(1)\n    ps = re.findall(r'<p[^>]*>(.*?)</p>', main, re.S)\n    return ps\n\ndef first_letters(ps):\n    s = \"\"\n    for p in ps:\n        # strip tags\n        t = re.sub(r'<[^>]+>', '', p)\n        t = html.unescape(t)\n        t = t.strip()\n        if t:\n            s += t[0]\n    return s\n\nfor fn in sorted(glob.glob(os.path.join(OUT, \"*.html\"))):\n    body = open(fn).read()\n    name = os.path.basename(fn).replace(\".html\", \"\")\n    ps = paragraphs(body)\n    fl = first_letters(ps)\n    if fl:\n        print(f\"{name}: {fl}\")\n"}
