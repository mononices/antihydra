[04] create_file {"path": "/home/ctfplayer/workspace/crawl.py", "content": "#!/usr/bin/env python3\n\"\"\"Crawl the house of hollow houses, save all pages, extract links.\"\"\"\nimport re, os, sys, urllib.request, urllib.parse, collections\n\nBASE = \"http://house-of-hollow-houses.chal.csaw.io:8000/\"\nOUT = \"/home/ctfplayer/workspace/pages\"\nos.makedirs(OUT, exist_ok=True)\n\ndef fetch(url):\n    req = urllib.request.Request(url, headers={\"User-Agent\": \"Mozilla/5.0\"})\n    try:\n        with urllib.request.urlopen(req, timeout=15) as r:\n            return r.status, r.read().decode(\"utf-8\", \"replace\")\n    except urllib.error.HTTPError as e:\n        return e.code, e.read().decode(\"utf-8\", \"replace\")\n    except Exception as e:\n        return -1, str(e)\n\ndef norm(u):\n    p = urllib.parse.urlparse(u)\n    path = p.path\n    if not path.startswith(\"/\"):\n        path = \"/\" + path\n    if not path.endswith(\"/\"):\n        path += \"/\"\n    return path\n\nseen = set()\nq = collections.deque([norm(BASE)])\nlink_re = re.compile(r'href=\"([^\"]+)\"')\ncomment_re = re.compile(r'<!--(.*?)-->', re.S)\n\nwhile q:\n    path = q.popleft()\n    if path in seen:\n        continue\n    seen.add(path)\n    status, body = fetch(BASE.rstrip(\"/\") + path)\n    fn = os.path.join(OUT, path.strip(\"/\").replace(\"/\", \"_\") or \"index\")\n    with open(fn + \".html\", \"w\") as f:\n        f.write(f\"=== {path} [{status}] ===\\n\" + body)\n    if status != 200:\n        print(f\"[{status}] {path}\")\n        continue\n    print(f\"[200] {path} ({len(body)} bytes)\")\n    for m in link_re.finditer(body):\n        href = m.group(1)\n        if href.startswith(\"http\") or href.startswith(\"data:\") or href.startswith(\"#\"):\n            continue\n        if href.startswith(\"/\"):\n            q.append(norm(href))\n        else:\n            q.append(norm(path + href))\n\nprint(f\"\\nTotal pages crawled: {len(seen)}\")\nwith open(os.path.join(OUT, \"list.txt\"), \"w\") as f:\n    f.write(\"\\n\".join(sorted(seen)))\n"}
