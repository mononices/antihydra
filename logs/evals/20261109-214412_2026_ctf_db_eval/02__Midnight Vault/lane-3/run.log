def build_cube(alphabet, fill='row_major'):
    # alphabet: list of 27 symbols
    cube={}
    for i,ch in enumerate(alphabet):
        if fill=='row_major':
            layer=i//9; rem=i%9; row=rem//3; col=rem%3
        elif fill=='col_major':
            layer=i//9; rem=i%9; col=rem//3; row=rem%3
        elif fill=='layer_col':
            layer=i%3; rem=i//3; row=rem//3; col=rem%3
        cube[ch]=(layer,row,col)
    inv={v:k for k,v in cube.items()}
    return cube,inv

def trifid_dec(ct, cube, inv, period, coord_order=(0,1,2), stream_order=(0,1,2), regroup_order=(0,1,2)):
    nums=[]
    for ch in ct:
        t=cube[ch]
        nums.extend(t[k] for k in coord_order)
    out=[]
    step=period*3
    for i in range(0,len(nums),step):
        chunk=nums[i:i+step]
        n=len(chunk)//3
        streams=[chunk[k::3] for k in range(3)]
        seq=[]
        for k in stream_order:
            seq.extend(streams[k])
        for j in range(n):
            t=(seq[j], seq[n+j], seq[2*n+j])
            t2=tuple(t[k] for k in regroup_order)
            out.append(inv.get(t2,'?'))
    return ''.join(out)

