    c=Counter(s)
    return sum(v*(v-1) for v in c.values())/(len(s)*(len(s)-1))

# Trifid implementation
def trifid_encrypt(plain, key='', period=5, alphabet='ABCDEFGHIJKLMNOPQRSTUVWXYZ.'):
    # build cube from keyed alphabet
    seen=[]
    for ch in key.upper()+alphabet:
        if ch not in seen: seen.append(ch)
    # standard trifid: 3 layers of 3x3
    cube={}
    for i,ch in enumerate(seen[:27]):
        cube[ch]=(i//9, (i%9)//3, i%3)
    nums=[]
    for ch in plain.upper():
        if ch in cube:
            nums.extend(cube[ch])
    out=[]
    # process in chunks of period*3
    step=period*3
    for i in range(0,len(nums),step):
        chunk=nums[i:i+step]
        # read columns: first all first coords, etc.
        n=len(chunk)//3
        a=chunk[:n]; b=chunk[n:2*n]; c=chunk[2*n:]
        tri=[]
        for j in range(n):
            tri.extend([a[j],b[j],c[j]])
        for j in range(0,len(tri),3):
            t=tuple(tri[j:j+3])
            for ch,co in cube.items():
                if co==t:
                    out.append(ch); break
    return ''.join(out)

def trifid_decrypt(ctext, key='', period=5, alphabet='ABCDEFGHIJKLMNOPQRSTUVWXYZ.'):
    seen=[]
    for ch in key.upper()+alphabet:
        if ch not in seen: seen.append(ch)
    cube={}
    for i,ch in enumerate(seen[:27]):
        cube[ch]=(i//9, (i%9)//3, i%3)
    nums=[]
    for ch in ctext.upper():
        if ch in cube:
            nums.extend(cube[ch])
    out=[]
    step=period*3
    for i in range(0,len(nums),step):
        chunk=nums[i:i+step]
        n=len(chunk)//3
        a=chunk[:n]; b=chunk[n:2*n]; c=chunk[2*n:]
        tri=[]
        for j in range(n):
            tri.extend([a[j],b[j],c[j]])
        for j in range(0,len(tri),3):
            t=tuple(tri[j:j+3])
            for ch,co in cube.items():
                if co==t:
                    out.append(ch); break
    return ''.join(out)

# Note: encryption and decryption are the same operation for trifid (it's an involution? no, but our function does the same reading)
for period in [5,3,4,6,7,8,139]:
    p=trifid_decrypt(ct, period=period)
    print(period, '%.4f'%ic(p), p[:80])
