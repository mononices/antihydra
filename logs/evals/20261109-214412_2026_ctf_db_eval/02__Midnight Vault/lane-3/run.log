ct='SALKMSKXZYRZEJFEOTMBRRZBRXYCXPNJIIWDRYADAIWKKKBEBUDDGNCXTUUBSJXMQVIVPVBYQEVVRBXMTEFGHRVULFEJZZUTXZIVBABSKQESEWKPKGXNVGTZHIFVWLCAQDHOKIGZZRV'

def make_cube(key, alphabet):
    seen=[]
    for ch in (key+alphabet).upper():
        if ch not in seen: seen.append(ch)
    seen=seen[:27]
    cube={}
    for i,ch in enumerate(seen):
        cube[ch]=(i//9,(i%9)//3,i%3)
    inv={v:k for k,v in cube.items()}
    return cube,inv

import itertools
from collections import Counter
def ic(s):
    s=[c for c in s if c.isalpha()]
    if len(s)<2: return 0
    c=Counter(s)
    return sum(v*(v-1) for v in c.values())/(len(s)*(len(s)-1))

def trifid_dec(ctext, cube, inv, period, coord_perm=(0,1,2), read_perm=(0,1,2)):
    nums=[]
    for ch in ctext.upper():
        if ch in cube: nums.extend(cube[ch])
    out=[]
    step=period*3
    for i in range(0,len(nums),step):
        chunk=nums[i:i+step]
        n=len(chunk)//3
        streams=[chunk[k::3] for k in range(3)]  # x,y,z streams as written
        # reorder streams according to read_perm
        seq=[]
        for k in range(3):
            seq.extend(streams[read_perm[k]])
        for j in range(n):
            t=(seq[j], seq[n+j], seq[2*n+j])
            t=tuple(t[coord_perm[k]] for k in range(3))
            out.append(inv.get(t,'?'))
    return ''.join(out)

