# Let's test the hypothesis that ct is a Trifid cipher output with period 5 (default) and various keys.
# But first, let's validate our Trifid implementation against a known test vector.
# Wikipedia Trifid example: key "FELIX MARIE DELASTELLE", plaintext "DEFEND THE EAST WALL OF THE CASTLE", period 5
# Expected ciphertext: "EKEHKEKGWBBHAVGQFXPBDSLGJVBQ" or similar.
# Let me implement carefully and check.
def make_cube(key, alphabet='ABCDEFGHIJKLMNOPQRSTUVWXYZ.'):
    seen=[]
    for ch in (key+alphabet).upper():
        if ch not in seen: seen.append(ch)
    seen=seen[:27]
    cube={}
    for i,ch in enumerate(seen):
        cube[ch]=(i//9,(i%9)//3,i%3)
    inv={v:k for k,v in cube.items()}
    return cube,inv

def trifid_encrypt(plain, cube, inv, period=5):
    nums=[]
    for ch in plain.upper():
        if ch in cube: nums.extend(cube[ch])
    out=[]
    step=period*3
    for i in range(0,len(nums),step):
        chunk=nums[i:i+step]
        n=len(chunk)//3
        x=chunk[0::3]; y=chunk[1::3]; z=chunk[2::3]
        seq=x+y+z
        for j in range(0,len(seq),3):
            out.append(inv[tuple(seq[j:j+3])])
    return ''.join(out)

def trifid_decrypt(ctext, cube, inv, period=5):
    nums=[]
    for ch in ctext.upper():
        if ch in cube: nums.extend(cube[ch])
    out=[]
    step=period*3
    for i in range(0,len(nums),step):
        chunk=nums[i:i+step]
        n=len(chunk)//3
        x=chunk[:n]; y=chunk[n:2*n]; z=chunk[2*n:]
        for j in range(n):
            out.append(inv[(x[j],y[j],z[j])])
    return ''.join(out)

cube,inv=make_cube('FELIX MARIEDELASTELLE')
