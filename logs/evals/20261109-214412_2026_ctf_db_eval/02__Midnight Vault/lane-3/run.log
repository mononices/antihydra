    return out

# Let me implement Porta properly.
# Porta table: for key letter pairs (AB), (CD), ... (YZ)
# Encryption: plaintext letter in first half maps to second half and vice versa.
# The table rows:
# Key A/B: nopqrstuvwxyzabcdefghijklm -> actually let me use standard definition.
def porta(ct,key):
    # Standard Porta cipher
    # Build table: 13 rows, each row is a substitution alphabet
    # Row i (key pair i): first half letters a-m map to n-z shifted by i; second half map to a-m shifted by i
    out=''
    k=[ord(c)-65 for c in key]
    for i,ch in enumerate(ct):
        p=ord(ch)-65
        kk=k[i%len(k)]//2
        if p<13:
            out+=chr(((p+kk)%13)+13+65)
        else:
            out+=chr(((p-13+kk)%13)+65)
    return out

