# Try Bifid with 5x5 (I/J merged) and 6x6
import itertools
from collections import Counter
def ic(s):
    s=[c for c in s if c.isalpha()]
    if len(s)<2: return 0
    c=Counter(s)
    return sum(v*(v-1) for v in c.values())/(len(s)*(len(s)-1))

def bifid_dec(ct, square, period=5):
    # square: list of symbols in row-major order, side determined by len
    side=len(square)
    pos={ch:(i//side,i%side) for i,ch in enumerate(square)}
    nums=[]
    for ch in ct:
        if ch in pos:
            nums.extend(pos[ch])
    out=[]
    step=period*2
    for i in range(0,len(nums),step):
        chunk=nums[i:i+step]
        n=len(chunk)//2
        x=chunk[:n]; y=chunk[n:]
        for j in range(n):
            out.append(square[x[j]*side+y[j]])
    return ''.join(out)

def keyed_square25(key):
    seen=[]
    for ch in (key+'ABCDEFGHIKLMNOPQRSTUVWXYZ').upper():
        if ch not in seen and ch!='J': seen.append(ch)
    return seen

def keyed_square26(key):
    seen=[]
    for ch in (key+'ABCDEFGHIJKLMNOPQRSTUVWXYZ').upper():
        if ch not in seen: seen.append(ch)
    return seen

