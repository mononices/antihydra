# Try CRC-24 variants on the ciphertext to see if checksum matches 7f1a0d
ct='SALKMSKXZYRZEJFEOTMBRRZBRXYCXPNJIIWDRYADAIWKKKBEBUDDGNCXTUUBSJXMQVIVPVBYQEVVRBXMTEFGHRVULFEJZZUTXZIVBABSKQESEWKPKGXNVGTZHIFVWLCAQDHOKIGZZRV'
data=ct.encode()
target=0x7f1a0d

def crc24(data, poly, init, refin=False, refout=False, xorout=0):
    crc=init
    for b in data:
        crc ^= b<<16
        for _ in range(8):
            crc<<=1
            if crc & 0x1000000:
                crc ^= poly
    return (crc ^ xorout) & 0xFFFFFF

# Standard CRC-24 variants
variants={
 'OPENPGP':(0x864CFB,0xB704CE,False),
 'BLE':(0x00065B,0x555555,True),
 'OS9':(0x800063,0xFFFFFF,False),
 'INTERLAKEN':(0x328B63,0xFFFFFF,False),
 'FLEXRAY-A':(0x5D6DCB,0xFEDCBA,False),
 'FLEXRAY-B':(0x5D6DCB,0xABCDEF,False),
}
for nm,(poly,init,r) in variants.items():
    v=crc24(data,poly,init)
    print(nm, hex(v), v==target)
# also try crc24 with reflected input
def crc24_ref(data,poly,init):
    crc=init
    for b in data:
        crc ^= b
        for _ in range(8):
            if crc & 1:
                crc = (crc>>1) ^ poly
            else:
                crc >>=1
    return crc & 0xFFFFFF
for nm,(poly,init,r) in variants.items():
    v=crc24_ref(data,poly,init)
    print('ref',nm, hex(v), v==target)
