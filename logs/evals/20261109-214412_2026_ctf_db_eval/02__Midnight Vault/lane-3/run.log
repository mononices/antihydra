# Fractionated Morse: plaintext -> morse with x separators, then triples mapped to letters via keyed alphabet.
# Try decryption with standard alphabet and keyed alphabets.
ct='SALKMSKXZYRZEJFEOTMBRRZBRXYCXPNJIIWDRYADAIWKKKBEBUDDGNCXTUUBSJXMQVIVPVBYQEVVRBXMTEFGHRVULFEJZZUTXZIVBABSKQESEWKPKGXNVGTZHIFVWLCAQDHOKIGZZRV'

import itertools
# canonical triple order
symbols='.-x'
triples=[''.join(t) for t in itertools.product(symbols, repeat=3)]
print(triples)

def decrypt_fm(ct, key):
    # build alphabet: key + rest of alphabet
    seen=[]
    for ch in (key+'ABCDEFGHIJKLMNOPQRSTUVWXYZ'):
        if ch not in seen: seen.append(ch)
    # Map ciphertext letters to triples
    m={}
    for i,ch in enumerate(seen[:27]):
        m[ch]=triples[i]
    seq=''.join(m[c] for c in ct if c in m)
    # Now split into morse words: 'xx' separates words, 'x' letters
    # We need to segment: replace 'x' with separators properly.
    # Standard: letters separated by single x, words by xx.
    # Decode: split on 'xx' for words, then 'x' for letters, '.'/'-' for morse.
    # But triples may split separators across boundaries; we just have the symbol string.
    out=[]
    for word in seq.split('xx'):
        letters=[]
        for letter in word.split('x'):
            if letter:
                letters.append(MORSE.get(letter,'?'))
        out.append(''.join(letters))
    return ' '.join(out)

