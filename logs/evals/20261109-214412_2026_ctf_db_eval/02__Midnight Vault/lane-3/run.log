# Playfair with standard square and keyed squares
def make_square(key):
    seen=[]
    for ch in (key+'ABCDEFGHIKLMNOPQRSTUVWXYZ').upper():
        if ch not in seen and ch!='J': seen.append(ch)
    return seen
def playfair_dec(ct,key):
    sq=make_square(key)
    pos={ch:(i//5,i%5) for i,ch in enumerate(sq)}
    out=''
    for i in range(0,len(ct)-1,2):
        a=ct[i]; b=ct[i+1]
        if a=='J': a='I'
        if b=='J': b='I'
        ra,ca=pos[a]; rb,cb=pos[b]
        if ra==rb:
            out+=sq[ra*5+(ca-1)%5]+sq[rb*5+(cb-1)%5]
        elif ca==cb:
            out+=sq[((ra-1)%5)*5+ca]+sq[((rb-1)%5)*5+cb]
        else:
            out+=sq[ra*5+cb]+sq[rb*5+ca]
    return out

for key in ['','LOCK','STONE','GRANITE','MIDNIGHT','VAULT','BRAILLE','REGISTRY','MIRROR','TRIOS','FROST','IRON']:
    p=playfair_dec(ct,key)
    print(key, p[:80])
