[41] create_file {"path": "/home/ctfplayer/workspace/trifid_general.py", "content": "import string, itertools\nfrom quad import CT, A, score\n\n\ndef build_cube(alpha, layout):\n    cube = {}\n    for i, ch in enumerate(alpha):\n        if layout == 'layer':\n            L, rem = divmod(i, 9)\n            r, c = divmod(rem, 3)\n            coord = (L, r, c)\n        elif layout == 'row':\n            r, rem = divmod(i, 9)\n            L, c = divmod(rem, 3)\n            coord = (L, r, c)\n        elif layout == 'col':\n            c, rem = divmod(i, 9)\n            L, r = divmod(rem, 3)\n            coord = (L, r, c)\n        else:\n            raise ValueError(layout)\n        cube[ch] = coord\n    inv = {v: k for k, v in cube.items()}\n    return cube, inv\n\n\ndef trifid_dec(ct, alpha, layout='layer', perm=(0, 1, 2), period=None, stream_rev=False):\n    cube, inv = build_cube(alpha, layout)\n    n = len(ct)\n    if period is None or period <= 0:\n        period = n\n    out = []\n    for start in range(0, n, period):\n        block = ct[start:start + period]\n        m = len(block)\n        nums = []\n        for ch in block:\n            if ch not in cube:\n                return None\n            nums.extend(cube[ch])\n        streams = [nums[0:m], nums[m:2 * m], nums[2 * m:3 * m]]\n        streams = [streams[perm[i]] for i in range(3)]\n        for i in range(m):\n            out.append(inv.get((streams[0][i], streams[1][i], streams[2][i]), '?'))\n    s = ''.join(out)\n    if stream_rev:\n        s = s[::-1]\n    return s\n\n\ndef trifid_enc(pt, alpha, layout='layer', perm=(0, 1, 2), period=None):\n    cube, inv = build_cube(alpha, layout)\n    n = len(pt)\n    if period is None or period <= 0:\n        period = n\n    out = []\n    for start in range(0, n, period):\n        block = pt[start:start + period]\n        coords = []\n        for ch in block:\n            if ch not in cube:\n                return None\n            coords.append(cube[ch])\n        streams = [[c[i] for c in coords] for i in range(3)]\n        streams = [streams[perm[i]] for i in range(3)]\n        nums = streams[0] + streams[1] + streams[2]\n        for i in range(0, len(nums), 3):\n            out.append(inv.get(tuple(nums[i:i + 3]), '?'))\n    return ''.join(out)\n\n\ndef keyed_alpha(key, base=A):\n    seen = []\n    for ch in key.upper():\n        if ch in base and ch not in seen:\n            seen.append(ch)\n    for ch in base:\n        if ch not in seen:\n            seen.append(ch)\n    return ''.join(seen)\n\n\ndef mirror_trios(s, k=3):\n    return ''.join(s[i:i + k][::-1] for i in range(0, len(s), k))\n\n\ndef atbash(s):\n    return ''.join(A[25 - A.index(c)] for c in s)\n\n\nPRE = {\n    'id': lambda s: s,\n    'rev': lambda s: s[::-1],\n    'mt3': lambda s: mirror_trios(s, 3),\n    'mt3_rev': lambda s: mirror_trios(s, 3)[::-1],\n    'atbash': atbash,\n    'atbash_rev': lambda s: atbash(s)[::-1],\n}\n\nKEYS = ['', 'STONE', 'GRANITE', 'REMEMBER', 'THELOCK', 'REMEMBERTHELOCK', 'STONEREMEMBERTHELOCK',\n        'MIDNIGHT', 'VAULT', 'MIRROR', 'TRIO', 'MIRROREDTRIOS', 'THELINE', 'KEY', 'BRAILLE',\n        'REGISTRY', 'DIVIDED', 'SNOW', 'GHOST', 'LEDGER', 'GRANITESAFE', 'FROST', 'IRON',\n        'AKEYDIVIDED', 'BRAILLEOPENSTHEOLDREGIS']\n\nif __name__ == '__main__':\n    alphas = {}\n    for k in KEYS:\n        for pad in ['.', '_', ' ', '#', '0', '/']:\n            base = keyed_alpha(k) if k else A\n            alphas[f'{k}|{pad}'] = base + pad\n            alphas[f'{k}|{pad}|rev'] = (base + pad)[::-1]\n\n    results = []\n    for aname, alpha in alphas.items():\n        if len(alpha) != 27 or len(set(alpha)) != 27:\n            continue\n        for layout in ['layer', 'row', 'col']:\n            for perm in itertools.permutations(range(3)):\n                for pname, pf in PRE.items():\n                    c = pf(CT)\n                    for period in [None, 5, 7, 9, 11, 13]:\n                        pt = trifid_dec(c, alpha, layout, perm, period)\n                        if pt is None:\n                            continue\n                        results.append((score(pt), aname, layout, perm, pname, period, pt))\n    results.sort(reverse=True)\n    for r in results[:25]:\n        print(round(r[0], 1), r[1], r[2], r[3], r[4], r[5], r[6][:80])\n"}
