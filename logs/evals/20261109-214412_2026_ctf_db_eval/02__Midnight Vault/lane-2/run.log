[59] create_file {"content": "import string, itertools\nfrom quad import CT, A, score\n\ndef clean(s):\n    return ''.join(c for c in s.upper() if c in A)\n\ndef mt(s, k=3):\n    return ''.join(s[i:i+k][::-1] for i in range(0, len(s), k))\n\ndef atb(s):\n    return ''.join(A[25 - A.index(c)] for c in s)\n\nTEXTS = {\n 'insc': \"WHAT IS REMEMBERED IS NEVER WRITTEN ONLY ONCE. THE LINE WAS COPIED IN MIRRORED TRIOS.\",\n 'brief': \"The crew hit the wrong safehouse and found a ghost ledger hidden in the snow. Three lockboxes were built to protect a vault on the black market circuit. Each hides a fragment of the final key. None of them alone will open the job. The first remembers. The second preserves. The third endures.\",\n 'note': \"A KEY DIVIDED BRAILLE OPENS THE OLD REGISTRY\",\n 'braille': \"STONE REMEMBER THE LOCK\",\n 'markings': \"CHECKSUM FAIL NOT KEY LOCK 04 19 71\",\n 'granite': \"GRANITE SAFE\",\n}\n\ndef dec(ct, key, mode):\n    out = []\n    for i, c in enumerate(ct):\n        k = A.index(key[i % len(key)])\n        v = A.index(c)\n        if mode == 'vig': out.append(A[(v - k) % 26])\n        elif mode == 'beau': out.append(A[(k - v) % 26])\n        elif mode == 'vbeau': out.append(A[(v + k) % 26])\n    return ''.join(out)\n\ndef autokey_dec(ct, primer, mode='vig'):\n    out = []\n    key = list(primer)\n    for i, c in enumerate(ct):\n        k = A.index(key[i])\n        v = A.index(c)\n        if mode == 'vig':\n            p = A[(v - k) % 26]\n        elif mode == 'beau':\n            p = A[(k - v) % 26]\n        else:\n            p = A[(v + k) % 26]\n        out.append(p)\n        key.append(p)\n    return ''.join(out)\n\nresults = []\nfor tname, t in TEXTS.items():\n    base = clean(t)\n    for tform, tf in [('id', lambda s: s), ('rev', lambda s: s[::-1]), ('mt3', lambda s: mt(s, 3)),\n                      ('atb', atb), ('mt3rev', lambda s: mt(s, 3)[::-1])]:\n        key = tf(base)\n        for mode in ['vig', 'beau', 'vbeau']:\n            pt = dec(CT, key, mode)\n            results.append((score(pt), f'rk:{tname}:{tform}:{mode}', pt))\n\nfor primer in ['STONE', 'GRANITE', 'THELOCK', 'STONEREMEMBERTHELOCK', 'AKEYDIVIDED', 'LOCK',\n               'MIDNIGHT', 'VAULT', 'BRAILLE', 'REGISTRY', 'KEY', 'REMEMBER']:\n    for mode in ['vig', 'beau', 'vbeau']:\n        pt = autokey_dec(CT, primer, mode)\n        results.append((score(pt), f'ak:{primer}:{mode}', pt))\n\nresults.sort(key=lambda x: x[0], reverse=True)\nfor s, name, pt in results[:20]:\n    print(round(s, 1), name, pt[:100])\n", "path": "/home/ctfplayer/workspace/sweep5.py"}
