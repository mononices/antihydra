[29] create_file {"content": "import string, itertools\nfrom quad import CT, A, score\n\ndef keyed_alpha(key, base=A):\n    seen = []\n    for ch in key.upper():\n        if ch in base and ch not in seen:\n            seen.append(ch)\n    for ch in base:\n        if ch not in seen:\n            seen.append(ch)\n    return ''.join(seen)\n\ndef trifid_dec(ct, alpha, period=None):\n    cube = {}\n    for i, ch in enumerate(alpha):\n        L, rem = divmod(i, 9)\n        r, c = divmod(rem, 3)\n        cube[ch] = (L, r, c)\n    inv = {v: k for k, v in cube.items()}\n    n = len(ct)\n    if period is None or period <= 0:\n        period = n\n    out = []\n    for start in range(0, n, period):\n        block = ct[start:start+period]\n        m = len(block)\n        nums = []\n        for ch in block:\n            if ch not in cube:\n                return None\n            nums.extend(cube[ch])\n        Ls = nums[0:m]; Rs = nums[m:2*m]; Cs = nums[2*m:3*m]\n        for i in range(m):\n            out.append(inv.get((Ls[i], Rs[i], Cs[i]), '?'))\n    return ''.join(out)\n\ndef trifid_enc(pt, alpha, period=None):\n    cube = {}\n    for i, ch in enumerate(alpha):\n        L, rem = divmod(i, 9)\n        r, c = divmod(rem, 3)\n        cube[ch] = (L, r, c)\n    inv = {v: k for k, v in cube.items()}\n    n = len(pt)\n    if period is None or period <= 0:\n        period = n\n    out = []\n    for start in range(0, n, period):\n        block = pt[start:start+period]\n        Ls, Rs, Cs = [], [], []\n        for ch in block:\n            if ch not in cube:\n                return None\n            a, b, c = cube[ch]\n            Ls.append(a); Rs.append(b); Cs.append(c)\n        nums = Ls + Rs + Cs\n        for i in range(0, len(nums), 3):\n            out.append(inv.get(tuple(nums[i:i+3]), '?'))\n    return ''.join(out)\n\ndef atbash(s):\n    return ''.join(chr(ord('Z') - (ord(c) - ord('A'))) if c in A else c for c in s)\n\ndef rev_trios(s, k=3):\n    return ''.join(s[i:i+k][::-1] for i in range(0, len(s), k))\n\npre = {\n    'id': lambda s: s,\n    'rev': lambda s: s[::-1],\n    'atbash': atbash,\n    'atbash_rev': lambda s: atbash(s)[::-1],\n    'rev_atbash': lambda s: atbash(s[::-1]),\n    'rt3': lambda s: rev_trios(s, 3),\n    'rt3_rev': lambda s: rev_trios(s, 3)[::-1],\n    'rt5': lambda s: rev_trios(s, 5),\n    'rt7': lambda s: rev_trios(s, 7),\n}\n\nkeys = ['', 'STONE', 'GRANITE', 'REMEMBER', 'THELOCK', 'REMEMBERTHELOCK', 'STONEREMEMBERTHELOCK',\n        'MIDNIGHT', 'VAULT', 'MIRROR', 'TRIO', 'MIRROREDTRIOS', 'THELINE', 'KEY', 'BRAILLE',\n        'REGISTRY', 'DIVIDED', 'SNOW', 'GHOST', 'LEDGER', 'GRANITESAFE', 'FROST', 'IRON']\n\nalphas = {}\nfor k in keys:\n    for pad in ['.', '_', ' ', '#', '0']:\n        base = keyed_alpha(k) if k else A\n        alphas[f'{k}|{pad}'] = base + pad\n        alphas[f'{k}|{pad}|rev'] = (base + pad)[::-1]\n\nresults = []\nfor aname, alpha in alphas.items():\n    if len(alpha) != 27 or len(set(alpha)) != 27:\n        continue\n    for pname, pf in pre.items():\n        c = pf(CT)\n        for period in [None, 3, 5, 7, 9, 11, 13]:\n            pt = trifid_dec(c, alpha, period)\n            if pt is None:\n                continue\n            results.append((score(pt), aname, pname, period, pt))\n\nresults.sort(reverse=True)\nfor r in results[:20]:\n    print(round(r[0],1), r[1], r[2], r[3], r[4][:90])\n", "path": "/home/ctfplayer/workspace/sweep3.py"}
