[32] create_file {"content": "import string, itertools\nfrom quad import CT, A, score\n\ndef mirror_trios(s, k=3):\n    return ''.join(s[i:i+k][::-1] for i in range(0, len(s), k))\n\ndef dec(ct, key, mode):\n    out = []\n    for i, c in enumerate(ct):\n        k = A.index(key[i % len(key)])\n        v = A.index(c)\n        if mode == 'vig': out.append(A[(v - k) % 26])\n        elif mode == 'beau': out.append(A[(k - v) % 26])\n        elif mode == 'vbeau': out.append(A[(v + k) % 26])\n    return ''.join(out)\n\ndef atbash(s):\n    return ''.join(A[25 - A.index(c)] for c in s)\n\nbases = {\n 'insc': 'WHATISREMEMBEREDISNEVERWRITTENONLYONCE',\n 'insc_full': 'WHATISREMEMBEREDISNEVERWRITTENONLYONCETHELINEWASCOPIEDINMIRROREDTRIOS',\n 'insc2': 'THELINEWASCOPIEDINMIRROREDTRIOS',\n 'braille': 'STONEREMEMBERTHELOCK',\n 'keydiv': 'AKEYDIVIDEDBRAILLEOPENSTHEOLDREGIS',\n 'keydiv2': 'AKEYDIVIDED',\n 'regis': 'BRAILLEOPENSTHEOLDREGIS',\n 'granite': 'GRANITE',\n 'lock': 'LOCK',\n 'gronsfeld': ''.join(A[int(d)] for d in '041971'),\n 'gronsfeld2': ''.join(A[int(d)] for d in '0419'),\n 'gronsfeld3': ''.join(A[int(d)] for d in '471971'),\n 'gronsfeld4': ''.join(A[int(d)] for d in '0471'),\n}\n\ntransforms = {\n 'id': lambda s: s,\n 'rev': lambda s: s[::-1],\n 'mt3': lambda s: mirror_trios(s, 3),\n 'mt3_rev': lambda s: mirror_trios(s, 3)[::-1],\n 'atbash': atbash,\n}\n\nresults = []\nfor bname, base in bases.items():\n    for tname, tf in transforms.items():\n        key = tf(base)\n        for mode in ['vig', 'beau', 'vbeau']:\n            for pre_name, pre in [('id', lambda s: s), ('rev', lambda s: s[::-1]),\n                                  ('mt3', lambda s: mirror_trios(s, 3)),\n                                  ('atbash', atbash)]:\n                ct = pre(CT)\n                pt = dec(ct, key, mode)\n                results.append((score(pt), bname, tname, mode, pre_name, pt))\n\nresults.sort(reverse=True)\nfor r in results[:20]:\n    print(round(r[0], 1), r[1], r[2], r[3], r[4], r[5][:100])\n", "path": "/home/ctfplayer/workspace/sweep4.py"}
