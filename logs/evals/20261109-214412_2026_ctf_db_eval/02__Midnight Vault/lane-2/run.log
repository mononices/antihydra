[27] create_file {"content": "import string, itertools\nfrom quad import CT, A, score, dec_vig, dec_beau, dec_vbeau\n\nwords = ['STONE','GRANITE','REMEMBER','THELOCK','LOCK','REMEMBERTHELOCK','STONEREMEMBERTHELOCK',\n         'MIDNIGHT','VAULT','MIRROR','TRIO','MIRROREDTRIOS','THELINE','KEY','BRAILLE','REGISTRY',\n         'DIVIDED','SNOW','GHOST','LEDGER','SAFEHOUSE','FIRST','WHATSREMEMBERED','ISNEVERWRITTEN',\n         'ONLYONCE','COPIED','MIRROR','MIRRORED','TRIOS','LINE','ONCE','NEVER','WRITTEN','COPIED',\n         'WHATSREMEMBEREDISNEVERWRITTEN','WHATSREMEMBEREDISNEVERWRITTENONLYONCE','THELINE',\n         'THELINEWASCOPIEDINMIRROREDTRIOS','GRANITESAFE','FROSTVAULT','IRONSAFEGUARD','MIDNIGHTVAULT',\n         'THEMIDNIGHTVAULT','OLDREGISTRY','REGIS','REGIST','REMEMBERTHELOCK','STONE REMEMBER THE LOCK']\n\nresults = []\nfor w in words:\n    w = w.replace(' ', '')\n    if not w:\n        continue\n    for fn, name in [(dec_vig, 'vig'), (dec_beau, 'beau'), (dec_vbeau, 'vbeau')]:\n        pt = fn(CT, w)\n        results.append((score(pt), name, w, pt))\n\nresults.sort(reverse=True)\nfor s, name, w, pt in results[:15]:\n    print(round(s, 1), name, w, pt[:100])\n", "path": "/home/ctfplayer/workspace/sweep2.py"}
