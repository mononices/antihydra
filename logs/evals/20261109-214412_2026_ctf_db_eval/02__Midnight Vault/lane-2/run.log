CT="SALKMSKXZYRZEJFEOTMBRRZBRXYCXPNJIIWDRYADAIWKKKBEBUDDGNCXTUUBSJXMQVIVPVBYQEVVRBXMTEFGHRVULFEJZZUTXZIVBABSKQESEWKPKGXNVGTZHIFVWLCAQDHOKIGZZRV"
A='ABCDEFGHIJKLMNOPQRSTUVWXYZ'
# Try transposition: since repeated substring none, likely substitution-ish
# Check if it's a simple substitution: IC 0.0386 low for English (0.066) but high for random (0.0385)
# Try: maybe the plaintext is a known phrase. Try columnar transposition with key lengths, then check IC of result (transposition preserves IC).
import itertools
def col_dec(ct, key):
    n=len(ct); k=len(key)
    order=sorted(range(k), key=lambda i: key[i])
    # standard columnar transposition decrypt
    nrows=(n+k-1)//k
    # compute column lengths
    full=n%k
    lens=[nrows if i<full else nrows-1 for i in range(k)] if full else [nrows]*k
    # Actually standard: fill columns in order
    cols={}
    pos=0
    for idx in order:
        L=lens[idx]
        cols[idx]=ct[pos:pos+L]
        pos+=L
    out=[]
    for r in range(nrows):
        for i in range(k):
            if r < len(cols[i]):
                out.append(cols[i][r])
    return ''.join(out)

keys=['STONE','GRANITE','REMEMBER','LOCK','THELOCK','MIDNIGHT','VAULT','MIRROR','TRIO','BRAILLE','KEY','REGISTRY','DIVIDED','SNOW','GHOST','LEDGER','FROST','IRON','STONEREMEMBERTHELOCK']
from collections import Counter
def ic(s):
    m=len(s); cc=Counter(s)
    return sum(v*(v-1) for v in cc.values())/(m*(m-1))
for k in keys:
    for rev in [False, True]:
        kk=k[::-1] if rev else k
        out=col_dec(CT,kk)
        print(kk, round(ic(out),4), out[:60])
