[04] create_file {"path": "/home/ctfplayer/workspace/trifid.py", "content": "import itertools, string\n\nCT = \"SALKMSKXZYRZEJFEOTMBRRZBRXYCXPNJIIWDRYADAIWKKKBEBUDDGNCXTUUBSJXMQVIVPVBYQEVVRBXMTEFGHRVULFEJZZUTXZIVBABSKQESEWKPKGXNVGTZHIFVWLCAQDHOKIGZZRV\"\n\ndef make_cube(alpha):\n    # alpha: 27 chars, layer-major 3x3\n    cube = {}\n    for i, ch in enumerate(alpha):\n        L, rem = divmod(i, 9)\n        r, c = divmod(rem, 3)\n        cube[ch] = (L, r, c)\n    inv = {v: k for k, v in cube.items()}\n    return cube, inv\n\ndef trifid_decrypt(ct, alpha, mirror=False):\n    cube, inv = make_cube(alpha)\n    coords = []\n    for ch in ct:\n        if ch not in cube:\n            return None\n        coords.extend(cube[ch])\n    if mirror:\n        # reverse each trio of coordinates before reading back? variant\n        pass\n    out = []\n    for i in range(0, len(coords), 3):\n        t = tuple(coords[i:i+3])\n        out.append(inv.get(t, '?'))\n    return ''.join(out)\n\ndef trifid_encrypt(pt, alpha):\n    cube, inv = make_cube(alpha)\n    coords = []\n    for ch in pt:\n        if ch not in cube:\n            return None\n        coords.extend(cube[ch])\n    out = []\n    for i in range(0, len(coords), 3):\n        t = tuple(coords[i:i+3])\n        out.append(inv.get(t, '?'))\n    return ''.join(out)\n\nalphas = {}\nalphas['std27'] = string.ascii_uppercase + '.'\nalphas['std26_'] = string.ascii_uppercase + '_'\nalphas['rev27'] = (string.ascii_uppercase + '.')[::-1]\n\n# keyed alphabets\ndef keyed_alpha(key, base=string.ascii_uppercase):\n    seen = []\n    for ch in key.upper():\n        if ch in base and ch not in seen:\n            seen.append(ch)\n    for ch in base:\n        if ch not in seen:\n            seen.append(ch)\n    return ''.join(seen)\n\nfor key in ['STONE','GRANITE','REMEMBER','LOCK','MIDNIGHT','VAULT','STONEREMEMBERTHELOCK','THELOCK','MIRROR','TRIO','MIRROREDTRIOS','THELINE']:\n    k = keyed_alpha(key)\n    alphas['key_'+key] = k + '.'\n    alphas['key_'+key+'_nop'] = k\n\nfor name, alpha in alphas.items():\n    if len(alpha) != 27:\n        continue\n    for mirror in [False, True]:\n        pt = trifid_decrypt(CT, alpha, mirror)\n        if pt and '?' not in pt:\n            print(name, mirror, pt[:80])\n"}
