[57] create_file {"content": "import string, itertools\nfrom collections import Counter\nfrom quad import CT, A, score\n\nn = len(CT)\n\ndef ks(ct, pt):\n    return ''.join(A[(A.index(c) - A.index(p)) % 26] for c, p in zip(ct, pt))\n\ndef period_score(s):\n    \"\"\"best period p<=20 by fraction of positions where s[i]==s[i%p]\"\"\"\n    best = []\n    for p in range(1, 21):\n        ok = sum(1 for i in range(len(s)) if s[i] == s[i % p])\n        best.append((ok / len(s), p))\n    best.sort(reverse=True)\n    return best[:3]\n\ncands = {\n 'insc': 'WHATISREMEMBEREDISNEVERWRITTENONLYONCE',\n 'insc2': 'THELINEWASCOPIEDINMIRROREDTRIOS',\n 'braille': 'STONEREMEMBERTHELOCK',\n 'keydiv': 'AKEYDIVIDEDBRAILLEOPENSTHEOLDREGIS',\n 'brief': 'THECREWHITTHEWRONGSAFEHOUSEANDFOUNDAGHOSTLEDGERHIDDENINTHESNOW',\n 'lockbox': 'THREELOCKBOXESWEREBUILTTOPROTECTAVAULTONTHEBLACKMARKETCIRCUIT',\n 'frag': 'EACHHIDESAFRAGMENTOFTHEFINALKEY',\n 'first': 'THEFIRSTREMEMBERS',\n 'second': 'THESECONDPRESERVES',\n 'third': 'THETHIRDENDURES',\n 'note': 'AKEYDIVIDEDBRAILLEOPENSTHEOLDREGIS',\n 'granite': 'GRANITESAFE',\n 'ans1': 'THEGRANITEFRAGMENTIS',\n 'ans2': 'THEFIRSTFRAGMENTIS',\n 'ans3': 'STONE',\n}\n\nfor name, base in cands.items():\n    for rep_name, pt in [('rep', (base * (n // len(base) + 1))[:n]),\n                         ('revrep', (base[::-1] * (n // len(base) + 1))[:n])]:\n        k = ks(CT, pt)\n        print(name, rep_name, period_score(k), k[:60])\n", "path": "/home/ctfplayer/workspace/ks_test.py"}
