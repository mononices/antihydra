[06] create_file {"content": "import string\n\nCT = \"SALKMSKXZYRZEJFEOTMBRRZBRXYCXPNJIIWDRYADAIWKKKBEBUDDGNCXTUUBSJXMQVIVPVBYQEVVRBXMTEFGHRVULFEJZZUTXZIVBABSKQESEWKPKGXNVGTZHIFVWLCAQDHOKIGZZRV\"\n\ndef make_cube(alpha):\n    cube = {}\n    for i, ch in enumerate(alpha):\n        L, rem = divmod(i, 9)\n        r, c = divmod(rem, 3)\n        cube[ch] = (L, r, c)\n    inv = {v: k for k, v in cube.items()}\n    return cube, inv\n\ndef trifid_decrypt(ct, alpha, rev=False):\n    cube, inv = make_cube(alpha)\n    nums = []\n    for ch in ct:\n        if ch not in cube:\n            return None\n        nums.extend(cube[ch])\n    n = len(ct)\n    L = nums[0:n]\n    R = nums[n:2*n]\n    C = nums[2*n:3*n]\n    out = []\n    for i in range(n):\n        out.append(inv.get((L[i], R[i], C[i]), '?'))\n    if rev:\n        out = out[::-1]\n    return ''.join(out)\n\ndef trifid_encrypt(pt, alpha):\n    cube, inv = make_cube(alpha)\n    L, R, C = [], [], []\n    for ch in pt:\n        if ch not in cube:\n            return None\n        a, b, c = cube[ch]\n        L.append(a); R.append(b); C.append(c)\n    nums = L + R + C\n    out = []\n    for i in range(0, len(nums), 3):\n        out.append(inv.get(tuple(nums[i:i+3]), '?'))\n    return ''.join(out)\n\ndef keyed_alpha(key, base=string.ascii_uppercase):\n    seen = []\n    for ch in key.upper():\n        if ch in base and ch not in seen:\n            seen.append(ch)\n    for ch in base:\n        if ch not in seen:\n            seen.append(ch)\n    return ''.join(seen)\n\nalphas = {}\nbase27 = string.ascii_uppercase + '.'\nalphas['std27'] = base27\nalphas['std26_'] = string.ascii_uppercase + '_'\nalphas['rev27'] = base27[::-1]\nfor key in ['STONE','GRANITE','REMEMBER','LOCK','MIDNIGHT','VAULT','STONEREMEMBERTHELOCK','THELOCK','MIRROR','TRIO','MIRROREDTRIOS','THELINE','FROST','IRON','RECOVERY']:\n    k = keyed_alpha(key)\n    alphas['key_'+key] = k + '.'\n    alphas['key_'+key+'_nop'] = k\n\n# sanity check: encrypt a known phrase and decrypt\nfor name, alpha in alphas.items():\n    if len(alpha) != 27: continue\n    for rev in [False, True]:\n        pt = trifid_decrypt(CT, alpha, rev)\n        if pt and '?' not in pt:\n            print(name, rev, pt[:100])\n", "path": "/home/ctfplayer/workspace/trifid2.py"}
