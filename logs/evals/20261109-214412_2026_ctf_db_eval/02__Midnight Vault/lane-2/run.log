[61] create_file {"content": "import string, itertools, sys\nfrom quad import CT, A, score\n\ndef dec(ct, key, mode, alpha=A):\n    out = []\n    for i, c in enumerate(ct):\n        k = alpha.index(key[i % len(key)])\n        v = alpha.index(c)\n        if mode == 'vig': out.append(alpha[(v - k) % 26])\n        elif mode == 'beau': out.append(alpha[(k - v) % 26])\n        elif mode == 'vbeau': out.append(alpha[(v + k) % 26])\n    return ''.join(out)\n\ndef keyed_alpha(key, base=A):\n    seen = []\n    for ch in key.upper():\n        if ch in base and ch not in seen:\n            seen.append(ch)\n    for ch in base:\n        if ch not in seen:\n            seen.append(ch)\n    return ''.join(seen)\n\ndef mt(s, k=3):\n    return ''.join(s[i:i+k][::-1] for i in range(0, len(s), k))\n\nif __name__ == '__main__':\n    from english_words import get_english_words_set\n    words = get_english_words_set(['web2'], lower=False)\n    words = sorted({w.upper() for w in words if w.isalpha() and 2 <= len(w) <= 20})\n    print(\"words:\", len(words), file=sys.stderr)\n    best = []\n    for w in words:\n        for mode in ['vig', 'beau', 'vbeau']:\n            pt = dec(CT, w, mode)\n            best.append((score(pt), w, mode, pt))\n    best.sort(key=lambda x: x[0], reverse=True)\n    for b in best[:25]:\n        print(round(b[0], 1), b[1], b[2], b[3][:100])\n", "path": "/home/ctfplayer/workspace/dict_attack.py"}
