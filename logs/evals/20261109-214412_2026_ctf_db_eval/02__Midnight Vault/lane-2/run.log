[24] create_file {"content": "import string, itertools, math, re\nfrom collections import Counter\n\nCT = \"SALKMSKXZYRZEJFEOTMBRRZBRXYCXPNJIIWDRYADAIWKKKBEBUDDGNCXTUUBSJXMQVIVPVBYQEVVRBXMTEFGHRVULFEJZZUTXZIVBABSKQESEWKPKGXNVGTZHIFVWLCAQDHOKIGZZRV\"\nA = string.ascii_uppercase\n\n# build quadgram model from gutenberg text\ntext = open('pg.txt', encoding='utf-8', errors='ignore').read().upper()\ntext = re.sub(r'[^A-Z]', '', text)\nq = Counter(text[i:i+4] for i in range(len(text)-3))\ntotal = sum(q.values())\nlogq = {k: math.log10(v/total) for k, v in q.items()}\nfloor = math.log10(0.01/total)\n\ndef score(s):\n    return sum(logq.get(s[i:i+4], floor) for i in range(len(s)-3))\n\ndef dec_vig(ct, key):\n    return ''.join(A[(A.index(c) - A.index(key[i % len(key)])) % 26] for i, c in enumerate(ct))\n\ndef dec_beau(ct, key):\n    return ''.join(A[(A.index(key[i % len(key)]) - A.index(c)) % 26] for i, c in enumerate(ct))\n\ndef dec_vbeau(ct, key):\n    return ''.join(A[(A.index(c) + A.index(key[i % len(key)])) % 26] for i, c in enumerate(ct))\n\nif __name__ == '__main__':\n    print(\"baseline\", score(CT))\n    # test on a known plaintext sample\n    sample = \"THEVAULTTEAMNEEDSTHERECOVEREDPLAINTEXTFRAGMENTTOWAKETHEOLDREGISTRY\"\n    print(\"sample\", score(sample))\n", "path": "/home/ctfplayer/workspace/quad.py"}
