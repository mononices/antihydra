[11] create_file {"content": "import string, itertools\nfrom collections import Counter\n\nCT = \"SALKMSKXZYRZEJFEOTMBRRZBRXYCXPNJIIWDRYADAIWKKKBEBUDDGNCXTUUBSJXMQVIVPVBYQEVVRBXMTEFGHRVULFEJZZUTXZIVBABSKQESEWKPKGXNVGTZHIFVWLCAQDHOKIGZZRV\"\nA = string.ascii_uppercase\n\ndef ic(s):\n    n = len(s)\n    c = Counter(s)\n    return sum(v*(v-1) for v in c.values())/(n*(n-1)) if n > 1 else 0\n\ndef vig_dec(ct, key, a=A):\n    out = []\n    for i, ch in enumerate(ct):\n        k = A.index(key[i % len(key)])\n        out.append(A[(A.index(ch) - k) % 26])\n    return ''.join(out)\n\ndef beau_dec(ct, key):\n    out = []\n    for i, ch in enumerate(ct):\n        k = A.index(key[i % len(key)])\n        out.append(A[(k - A.index(ch)) % 26])\n    return ''.join(out)\n\ndef vbeau_dec(ct, key):\n    out = []\n    for i, ch in enumerate(ct):\n        k = A.index(key[i % len(key)])\n        out.append(A[(A.index(ch) + k) % 26])\n    return ''.join(out)\n\nkeys = ['STONE','GRANITE','REMEMBER','THELOCK','LOCK','STONEREMEMBERTHELOCK','REMEMBERTHELOCK',\n        'MIDNIGHT','VAULT','MIRROR','TRIO','MIRROREDTRIOS','THELINE','KEY','BRAILLE','REGISTRY',\n        'DIVIDED','SNOW','GHOST','LEDGER','SAFEHOUSE','FIRST','WHATSREMEMBERED']\n\n# numeric shifts\nprint(\"=== numeric shifts ===\")\nfor shifts in [(4,19,71),(4,19,19),(4,19,71,4,19),(19,71,4),(71,19,4)]:\n    out = ''.join(A[(A.index(ch)-shifts[i%len(shifts)])%26] for i,ch in enumerate(CT))\n    print(shifts, out[:70], round(ic(out),4))\n\nprint(\"=== vigenere ===\")\nfor k in keys:\n    for fn, name in [(vig_dec,'vig'),(beau_dec,'beau'),(vbeau_dec,'vbeau')]:\n        out = fn(CT, k)\n        print(name, k, round(ic(out),4), out[:60])\n", "path": "/home/ctfplayer/workspace/sweep1.py"}
