# ---- TRIFID (27 letters) ----
def trifid_dec(ct, period, key, mirror=False):
    # key: 27-char alphabet; map letter->(a,b,c) trits
    pos={}
    for i,ch in enumerate(key): pos[ch]=(i//9,(i//3)%3,i%3)
    inv={v:k for k,v in pos.items()}
    out=[]
    for start in range(0,len(ct),period):
        grp=[pos.get(ch,(0,0,0)) for ch in ct[start:start+period]]
