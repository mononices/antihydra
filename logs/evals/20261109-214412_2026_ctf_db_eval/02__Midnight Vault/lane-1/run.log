0.02758,0.00978,0.02360,0.00150,0.01974,0.00074]

def chisq(col, mode, k):
    cnt=Counter((ord(ch)-65)%26 for ch in col)
    n=len(col); tot=0.0
    for i in range(26):
        if mode==0: p=(i-k)%26
        elif mode==1: p=(k-i)%26
        else: p=(i+k)%26
        obs=cnt.get(p,0); exp=FREQ[i]*n
        tot+=(obs-exp)**2/exp
    return tot

def decrypt(ct,key,mode):
    out=[]
    L=len(key)
    for i,ch in enumerate(ct):
        c=ord(ch)-65; k=key[i%L]
        if mode==0: p=(c-k)%26
        elif mode==1: p=(k-c)%26
        else: p=(c+k)%26
        out.append(chr(65+p))
    return ''.join(out)

best=[]
for mode in (0,1,2):
    for L in range(1,21):
        cols=[ct[i::L] for i in range(L)]
        key=[]; tot=0.0
        for col in cols:
            sc=sorted((chisq(col,mode,k),k) for k in range(26))
            key.append(sc[0][1]); tot+=sc[0][0]
        pt=decrypt(ct,key,mode)
        best.append((tot/len(ct),L,mode,''.join(chr(65+k) for k in key),pt))
best.sort()
