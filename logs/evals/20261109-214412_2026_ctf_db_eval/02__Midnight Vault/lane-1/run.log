COMMON|={"SEEN","REALLY","GUY","REMEMBER","REGISTRY","BRIGUY","GRANITE","FROST","IRON","VAULT","MIDNIGHT"}
def wbonus(s):
    return sum(min(len(w),8)*3 for w in re.findall(r"[A-Z]{2,}",s) if w in COMMON)
def total(s): return qscore(s)+wbonus(s)

# ---- BIFID (25 letters, I/J merged) ----
def bifid_dec(ct, period, sq, mirror=False):
    # sq: dict letter->(r,c) using 5x5 square, alphabet ABCDEFGHIKLMNOPQRSTUVWXYZ
    inv={(r,c):l for l,(r,c) in sq.items()}
    coords=[]
    for ch in ct:
        if ch=='J': ch='I'
        coords.append(sq[ch])
    out=[]
    for start in range(0,len(ct),period):
        grp=coords[start:start+period]
        rs=[a for a,b in grp]; cs=[b for a,b in grp]
        seq=rs+cs if not mirror else cs+rs
        for i in range(0,len(seq),2):
            if i+1<len(seq):
                out.append(inv[(seq[i],seq[i+1])])
            else:
                out.append('?')
    return ''.join(out)

