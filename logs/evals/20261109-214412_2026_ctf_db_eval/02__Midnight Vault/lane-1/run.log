        else:
            t1=[g[0] for g in grp]; t2=[g[1] for g in grp]; t3=[g[2] for g in grp]
        seq=t1+t2+t3
        for i in range(0,len(seq)-2,3):
            out.append(inv[(seq[i],seq[i+1],seq[i+2])])
    return ''.join(out)

