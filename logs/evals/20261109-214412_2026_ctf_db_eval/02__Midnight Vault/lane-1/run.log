import sys
from collections import Counter

ct="SALKMSKXZYRZEJFEOTMBRRZBRXYCXPNJIIWDRYADAIWKKKBEBUDDGNCXTUUBSJXMQVIVPVBYQEVVRBXMTEFGHRVULFEJZZUTXZIVBABSKQESEWKPKGXNVGTZHIFVWLCAQDHOKIGZZRV"
FREQ=[0.08167,0.01492,0.02782,0.04253,0.12702,0.02228,0.02015,0.06094,0.06966,0.00153,
0.00772,0.04025,0.02406,0.06749,0.07507,0.01929,0.00095,0.05987,0.06327,0.09056,
0.02758,0.00978,0.02360,0.00150,0.01974,0.00074]

def chisq(col, mode, k):
    # decrypt char: mode 0: p=c-k ; 1: p=k-c ; 2: p=c+k ; 3: p=k+c+1?? use 3: p=c+k+? skip
    from collections import Counter
    cnt=Counter((ord(ch)-65)%26 for ch in col)
    n=len(col)
    tot=0.0
    for i in range(26):
        if mode==0: p=(i-k)%26
        elif mode==1: p=(k-i)%26
        elif mode==2: p=(i+k)%26
        obs=cnt.get(p,0)
        exp=FREQ[i]*n
        tot+=(obs-exp)**2/exp
    return tot

def decrypt(ct,key,mode):
    out=[]
    L=len(key)
    for i,ch in enumerate(ct):
        c=ord(ch)-65; k=key[i%L]
        if mode==0: p=(c-k)%26
        elif mode==1: p=(k-c)%26
        else: p=(c+k)%26
        out.append(chr(65+p))
    return ''.join(out)

best=[]
for mode in (0,1,2):
    for L in range(1,21):
        cols=[ct[i::L] for i in range(L)]
        key=[]; tot=0
        for col in cols:
            scores=[(chisq(col,mode,k),k) for k in range(26)]
            scores.sort()
            key.append(scores[0][1]); tot+=scores[0][0]
        key=''.join(chr(65+k) for k in key)
        pt=decrypt(ct,key,mode)
        best.append((tot/len(ct),L,key,pt))
best.sort()
for b in best[:8]:
    print("%.3f L=%d key=%s"%b[:3])
    print("   ",b[3])
EOF
