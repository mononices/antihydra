(subtask-1) [10] create_file {"path": "/home/ctfplayer/workspace/h2.py", "content": "import random, math\nfrom collections import Counter, defaultdict\n\nCT = \"SALKMSKXZYRZEJFEOTMBRRZBRXYCXPNJIIWDRYADAIWKKKBEBUDDGNCXTUUBSJXMQVIVPVBYQEVVRBXMTEFGHRVULFEJZZUTXZIVBABSKQESEWKPKGXNVGTZHIFVWLCAQDHOKIGZZRV\"\nFREQ=[0.08167,0.01492,0.02782,0.04253,0.12702,0.02228,0.02015,0.06094,0.06966,0.00153,\n0.00772,0.04025,0.02406,0.06749,0.07507,0.01929,0.00095,0.05987,0.06327,0.09056,\n0.02758,0.00978,0.02360,0.00150,0.01974,0.00074]\n\n# ---------- dictionaries ----------\nCOMMON = [w.strip().upper() for w in open('common20k.txt') if w.strip()]\nCOMMON_SET = set(COMMON)\nRANK = {w: i for i, w in enumerate(COMMON)}\nALLW = set(w.strip().upper() for w in open('words.txt') if w.strip())\n\n# ---------- quadgram model from wordlists ----------\nqcount = defaultdict(float)\ndef add_word(w, weight):\n    s = '^' + w + '$'\n    for i in range(len(s) - 3):\n        qcount[s[i:i+4]] += weight\nfor i, w in enumerate(COMMON):\n    add_word(w, max(1.0, (len(COMMON) - i) / 50.0))\nfor w in ALLW:\n    if 3 <= len(w) <= 15:\n        add_word(w, 0.3)\ntot = sum(qcount.values())\nQLOG = {k: math.log(v / tot) for k, v in qcount.items()}\nFLOOR = math.log(0.01 / tot)\n\ndef qscore(s):\n    s = '^' + s + '$'\n    return sum(QLOG.get(s[i:i+4], FLOOR) for i in range(len(s) - 3)) / len(s)\n\n# ---------- segmentation judge ----------\nMAXW = 18\ndef segment_score(s):\n    # DP: best score to segment s into common words; score = sum of len^2, small penalty per word\n    n = len(s)\n    best = [-1e9] * (n + 1); best[0] = 0; back = [None] * (n + 1)\n    for i in range(n):\n        if best[i] == -1e9: continue\n        for L in range(2, MAXW + 1):\n            j = i + L\n            if j > n: break\n            w = s[i:j]\n            if w in COMMON_SET:\n                sc = best[i] + L * L - 1\n                if sc > best[j]:\n                    best[j] = sc; back[j] = i\n    if best[n] == -1e9: return -1e9, ''\n    # reconstruct\n    out = []; i = n\n    while i > 0:\n        j = back[i]; out.append(s[j:i]); i = j\n    out.reverse()\n    return best[n] / (n * n), ' '.join(out)\n\n# ---------- ciphers ----------\ndef decrypt(ct, key, mode):\n    out = []; L = len(key)\n    for i, ch in enumerate(ct):\n        c = ord(ch) - 65; k = key[i % L]\n        if mode == 0: p = (c - k) % 26\n        elif mode == 1: p = (k - c) % 26\n        else: p = (c + k) % 26\n        out.append(chr(65 + p))\n    return ''.join(out)\n\ndef chi_key(ct, mode, L):\n    cols = [ct[i::L] for i in range(L)]\n    key = []; tot = 0.0\n    for col in cols:\n        cnt = Counter((ord(ch) - 65) % 26 for ch in col)\n        n = len(col); bb = (1e18, 0)\n        for k in range(26):\n            t = 0.0\n            for i in range(26):\n                if mode == 0: p = (i - k) % 26\n                elif mode == 1: p = (k - i) % 26\n                else: p = (i + k) % 26\n                obs = cnt.get(p, 0); exp = FREQ[i] * n\n                t += (obs - exp) ** 2 / exp\n            if t < bb[0]: bb = (t, k)\n        key.append(bb[1]); tot += bb[0]\n    return key, tot / len(ct)\n\ndef hillclimb(ct, mode, L, restarts=8, iters=40):\n    bestg = (-1e18, None)\n    for r in range(restarts):\n        if r == 0:\n            key, _ = chi_key(ct, mode, L)\n        else:\n            key = [random.randrange(26) for _ in range(L)]\n        cur = qscore(decrypt(ct, key, mode))\n        improved = True\n        while improved:\n            improved = False\n            for pos in range(L):\n                for k in range(26):\n                    if k == key[pos]: continue\n                    nk = key[:]; nk[pos] = k\n                    sc = qscore(decrypt(ct, nk, mode))\n                    if sc > cur:\n                        cur = sc; key = nk; improved = True\n        bestg = max(bestg, (cur, key))\n    return bestg\n\n# ---------- transposition variants ----------\ndef rail_pat(n, rails):\n    pat = []; r = 0; d = 1\n    for i in range(n):\n        pat.append(r); r += d\n        if rails > 1 and r == rails - 1: d = -1\n        if rails > 1 and r == 0: d = 1\n    return pat\ndef rail_enc(s, rails):\n    pat = rail_pat(len(s), rails)\n    return ''.join(s[i] for i in sorted(range(len(s)), key=lambda i: pat[i]))\ndef rail_dec(s, rails):\n    pat = rail_pat(len(s), rails)\n    order = sorted(range(len(s)), key=lambda i: pat[i])\n    out = [''] * len(s)\n    for k, i in enumerate(order): out[i] = s[k]\n    return ''.join(out)\ndef colar_enc(s, key):\n    n = len(key)\n    rows = [s[i:i+n] for i in range(0, len(s), n)]\n    order = sorted(range(n), key=lambda k: key[k])\n    return ''.join(row[c] for c in order for row in rows if c < len(row))\ndef colar_dec(s, key):\n    n = len(key); nrows = (len(s) + n - 1) // n\n    order = sorted(range(n), key=lambda k: key[k])\n    cols = {}; idx = 0\n    for c in order:\n        ln = len([r for r in range(nrows) if r * n + c < len(s)])\n        cols[c] = s[idx:idx+ln]; idx += ln\n    out = ''\n    for r in range(nrows):\n        for c in range(n):\n            if r * n + c < len(s) and r < len(cols[c]): out += cols[c][r]\n    return out\n\nV = {'identity': CT, 'reverse': CT[::-1]}\ntri = ''.join(CT[i:i+3][::-1] for i in range(0, len(CT), 3))\nV['trios_rev'] = tri\nV['trios_rev_wholerev'] = tri[::-1]\nV['trios_rot1'] = ''.join(CT[i+1:i+3] + CT[i:i+1] for i in range(0, len(CT), 3))\nV['trios_rot2'] = ''.join(CT[i+2:i+3] + CT[i:i+2] for i in range(0, len(CT), 3))\nV['trios_swap_ends'] = ''.join(CT[i+2] + CT[i+1] + CT[i] if i + 2 < len(CT) else CT[i:] for i in range(0, len(CT), 3))\nfor r in range(2, 6):\n    V[f'railE{r}'] = rail_enc(CT, r); V[f'railD{r}'] = rail_dec(CT, r)\nfor key in ['LOCK', 'SEEN', 'GRANITE', 'IRON', 'GUY', 'STONE', 'VAULT', 'MIDNIGHT', 'TEMPLE', 'REMEMBER', 'GUYSEEN', 'SEENREMEMBERTHEGUY']:\n    V[f'colE_{key}'] = colar_enc(CT, key); V[f'colD_{key}'] = colar_dec(CT, key)\nfor off in range(3):\n    V[f'ilv3_{of