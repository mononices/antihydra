import itertools, sys
from collections import Counter

CT="SALKMSKXZYRZEJFEOTMBRRZBRXYCXPNJIIWDRYADAIWKKKBEBUDDGNCXTUUBSJXMQVIVPVBYQEVVRBXMTEFGHRVULFEJZZUTXZIVBABSKQESEWKPKGXNVGTZHIFVWLCAQDHOKIGZZRV"
N=len(CT)

WORDS=set(w.strip().upper() for w in open('words.txt') if w.strip().isalpha())
COMMON=set()
for line in open('common20k.txt'):
    w=line.strip().upper()
    if w.isalpha(): COMMON.add(w)
COMMON|={"THE","AND","WAS","ONLY","WRITTEN","NEVER","REMEMBERED","LINE","COPIED","MIRRORED","TRIOS","WHAT","IS","REMEMBERED","ONCE","SEEN","GUY","KEY","OLD","REGISTRY","OPENS","VAULT","FRAGMENT","GRANITE","FROST","IRON"}

def quadload(path):
    try:
        q={}
        import gzip,os
        if path.endswith('.gz'):
            f=gzip.open(path,'rt',errors='ignore')
        else: f=open(path,errors='ignore')
        for line in f:
            p=line.split()
            if len(p)==2 and len(p[0])==4:
                q[p[0]]=float(p[1])
        if not q: return None
        mx=max(q.values())
        import math
        return {k:math.log10(v/mx) for k,v in q.items()}
    except Exception as e:
        return None
Q=quadload('english_quadgrams.txt.gz')
FLOOR=-8.0
def qscore(s):
    if Q is None: return 0
    t=0.0
    for i in range(len(s)-3):
        t+=Q.get(s[i:i+4],FLOOR)
    return t

def ic(s):
    c=Counter(s); n=len(s)
    return sum(v*(v-1) for v in c.values())/(n*(n-1)) if n>1 else 0

def vig(ct,key,mode):
    out=[];L=len(key)
    for i,ch in enumerate(ct):
        c=ord(ch)-65;k=key[i%L]
        if mode==0: p=(c-k)%26
        elif mode==1: p=(k-c)%26
        else: p=(c+k)%26
        out.append(p)
    return bytes(out).decode()

def fit(x):  # x: bytes
    s=x.decode()
    t=qscore(s)
    for w in re.findall(r"[A-Z]{2,}",s):
        if w in COMMON: t+=8
    return t
import re

def fmt(x):
    s=x.decode()
    words=[]
    i=0
    while i<len(s):
        best=None
        for L in range(12,1,-1):
            if s[i:i+L] in COMMON:
                best=L;break
        if best:
            words.append(s[i:i+best]); i+=best
        else:
            if words and not words[-1].endswith('_'): words[-1]+='_'
            words.append(s[i]); i+=1
    return ' '.join(words)

def solve_block(ct):
    res=[]
    for L in range(1,16):
        cols=[ct[i::L] for i in range(L)]
        cand=[]
        for col in cols:
            sc=[]
            for k in range(26):
                for mode in (0,1,2):
                    d=bytes(((c-k)%26) if mode==0 else ((k-c)%26) else 0 for c in col) if False else bytes(((c-k)%26) if mode==0 else ((k-c)%26) if mode==1 else ((c+k)%26) for c in col)
                    sc.append((qscore(d.decode())+sum(4 for w in re.findall(r"[A-Z]{3,}",d.decode()) if w in COMMON),k,mode))
            sc.sort(reverse=True)
            cand.append(sc[:5])
        beams=[(0.0,[])]
        for j in range(L):
            nb=[]
            for s0,ks in beams:
                for v in cand[j]:
                    nb.append((s0+v[0], ks+[v]))
            nb.sort(reverse=True)
            beams=nb[:40]
        for s0,ks in beams[:3]:
            key=[(k,m) for k,m in ks]
            pt=vig(ct,[k for k,_ in key],[m for _,m in key][0] if len({m for _,m in key})==1 else 0)
            # mixed modes: decode per position
            out=[]
            for i,ch in enumerate(ct):
                k,m=key[i%L]
                c=ord(ch)-65
                p=(c-k)%26 if m==0 else (k-c)%26 if m==1 else (c+k)%26
                out.append(p)
            ptb=bytes(out)
            res.append((fit(ptb),L,key,ptb))
    res.sort(reverse=True)
    return res

def main():
    transforms={'ID':lambda s:s,'REV':lambda s:s[::-1]}
    for b in (2,3,4,5):
        transforms[f'REV{b}']=lambda s,b=b: ''.join(s[i:i+b][::-1] for i in range(0,len(s),b))
        transforms[f'RF{b}']=lambda s,b=b: s[0::b]+s[1::b][:0] if False else ''.join(s[i::b] for i in range(b))
        transforms[f'RF{b}I']=lambda s,b=b: ''.join(s[i::b] for i in range(b))
        transforms[f'RF{b}D']=lambda s,b=b: ''.join(s[b-1::-b])+ ''.join(''.join(s[i::b][::-1]) for i in range(1,b)) if False else ''.join(''.join(s[i::b][::-1]) for i in range(b))
    for b in (2,3,4,5):
        # rail fence decode: rails=b, zigzag
        def rf_dec(s,b=b):
            pat=[];r=0;dr=1
            for i in range(len(s)):
                pat.append(r); r+=dr
                if r==b-1: dr=-1
                if r==0: dr=1
            idx={r:[] for r in range(b)}
            for i,r in enumerate(pat): idx[r].append(i)
            pos=sorted((r,i) for r in range(b) for i in idx[r])
            # ciphertext read row-wise -> place
            out=[None]*len(s); k=0
            rows=[[pat[i] for i in range(len(s)) if pat[i]==r] for r in range(b)]
            ci=0
            for r in range(b):
                for i in rows[r]:
                    out[i]=s[ci]; ci+=1
            return ''.join(out)
        transforms[f'RAIL{b}']=rf_dec
        transforms[f'RAIL{b}E']=lambda s,b=b: rf_dec(s[::-1],b)
    best=[]
    for name,tf in transforms.items():
        t=tf(CT)
        r=solve_block(t.encode())
        for s0,L,key,ptb in r[:2]:
            best.append((s0,f"{name}",L,key,ptb))
    best.sort(reverse=True)
    for s0,name,L,key,ptb in best[:12]:
        print(f"{s0:9.1f} {name:8s} L={L} key={key}")
        print("   ",ptb.decode())

main()
