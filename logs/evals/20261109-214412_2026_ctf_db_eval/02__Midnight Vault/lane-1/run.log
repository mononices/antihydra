        if t<best[0]: best=(t,k)\n        key.append(best[1]); tot+=best[0]\n    return ''.join(chr(65+k) for k in key), tot/len(ct)\n\ndef decrypt(ct,key,mode):\n    out=[]; L=len(key)\n    for i,ch in enumerate(ct):\n        c=ord(ch)-65; k=key[i%L]\n        if mode==0: p=(c-k)%26\n        elif mode==1: p=(k-c)%26\n        else: p=(c+k)%26\n        out.append(chr(65+p))\n    return ''.join(out)\n\ndef word_cov(s):\n    # fraction of letters covered by dictionary words of len>=3 found greedily\n    s2=s\n    total=0; covered=0\n    i=0\n    # simple: count letters inside any dictionary word occurrence (len>=3)\n    mask=[False]*len(s)\n    for L in range(12,2,-1):\n        for j in range(0,len(s)-L+1):\n            if s[j:j+L] in WORDS:\n                for t in range(j,j+L): mask[t]=True\n    cov=sum(mask)\n    return cov/len(s)\n\ndef evaluate(name, s):\n    cov=word_cov(s)\n    chi=quad_score(s)\n    return cov,chi,s\n\nresults=[]\ndef try_ct(name, c):\n    for mode in (0,1,2):\n        for L in range(1,21):\n            key,sc=chi_key_solve(c,mode,L)\n            pt=decrypt(c,key,mode)\n            cov=word_cov(pt)\n            if cov>0.30:\n                results.append((cov,sc,name,mode,L,key,pt))\n\n# ---- transposition variants ----\nvariants={}\nvariants['identity']=CT\nvariants['reverse']=CT[::-1]\n# mirrored trios: each group of 3 reversed\ntri=''.join(CT[i:i+3][::-1] for i in range(0,len(CT),3))\nvariants['trios_reversed']=tri\n# swap ends of each trio (a b c -> c b a) same as reversed; alt: a b c -> c a b? try rotations\nvariants['trios_rot1']=''.join(CT[i+1:i+3]+CT[i:i+1] for i in range(0,len(CT),3))\nvariants['trios_rot2']=''.join(CT[i+2:i+3]+CT[i:i+2] for i in range(0,len(CT),3))\n# blocks of 3 reversed whole-string grouping from end\nvariants['trios_rev_fromend']=''.join(CT[max(0,len(CT)-i-3):len(CT)-i][::-1] for i in range(0,len(CT),3))\n# rail fence 2-5 rails, both directions\ndef railfence(s,rails,offset=0):\n    pat=[]\n    r=0; d=1\n    for i in range(len(s)):\n        pat.append(r); r+=d\n        if r==rails-1: d=-1\n        if r==0: d=1\n    # encrypt: read row by row\n    return ''.join(s[i] for i in sorted(range(len(s)),key=lambda i:pat[i]))\ndef rail_decrypt(s,rails):\n    pat=[]\n    r=0; d=1\n    for i in range(len(s)):\n        pat.append(r); r+=d\n        if r==rails-1: d=-1\n        if r==0: d=1\n    order=sorted(range(len(s)),key=lambda i:pat[i])\n    out=['']*len(s)\n    for k,i in enumerate(order): out[i]=s[k]\n    return ''.join(out)\nfor r in range(2,6):\n    variants[f'rail_enc_{r}']=railfence(CT,r)\n    variants[f'rail_dec_{r}']=rail_decrypt(CT,r)\n# columnar transposition with short keys\ndef colar_enc(s,key):\n    n=len(key); cols=['']*n\n    # write row-wise, read column order by key alpha\n    rows=[s[i:i+n] for i in range(0,len(s),n)]\n    order=sorted(range(n),key=lambda k:key[k])\n    out=''\n    for c in order:\n        for row in rows:\n            if c<len(row): out+=row[c]\n    return out\ndef colar_dec(s,key):\n    n=len(key); nrows=(len(s)+n-1)//n\n    order=sorted(range(n),key=lambda k:key[k])\n    cols={}\n    idx=0\n    for c in order:\n        ln=min(n,len(s)-c) if False else nrows\n        # standard: fill columns in key order with column lengths\n        col_len=len([r for r in range(nrows) if r*n+c<len(s)])\n        cols[c]=s[idx:idx+col_len]; idx+=col_len\n    out=''\n    for r in range(nrows):\n        for c in range(n):\n            if r*n+c<len(s) and r<len(cols[c]): out+=cols[c][r]\n    return out\nfor key in ['LOCK','SEEN','GRANITE','IRON','GUY','STONE','VAULT','MIDNIGHT','TEMPLE','REMEMBER']:\n    variants[f'colar_enc_{key}']=colar_enc(CT,key)\n    variants[f'colar_dec_{key}']=colar_dec(CT,key)\n# every-3rd interleaves (period-3 column reads)\nfor off in range(3):\n    variants[f'interleave3_{off}']=CT[off::3]+CT[(off+1)%3::3]+CT[(off+2)%3::3]\n# reversed trios then reversed whole\nvariants['trios_rev_then_rev']=tri[::-1]\nvariants['rev_then_trios']=CT[::-1]\nvariants['rev_trios_rev']=''.join(CT[i:i+3][::-1] for i in range(0,len(CT),3))[::-1]\n\nfor name,c in variants.items():\n    try_ct(name,c)\n\nresults.sort(reverse=True)\nprint(\"candidates with word coverage > 0.30:\", len(results))\nfor r in results[:15]:\n    cov,sc,name,mode,L,key,pt=r\n    print(f\"cov={cov:.2f} chi={sc:.2f} {name} mode={mode} L={L} key={key}\")\n    print(\"   \",pt)\nif not results:\n    print(\"NONE passed 0.30 coverage. Top by chi among all:\")\n    allr=[]\n    for name,c in variants.items():\n        for mode in (0,1,2):\n            for L in range(1,21):\n                key,sc=chi_key_solve(c,mode,L)\n                pt=decrypt(c,key,mode)\n                allr.append((sc,name,mode,L,key,pt,word_cov(pt)))\n    allr.sort()\n    for a in allr[:10]:\n        print(f\"chi={a[0]:.2f} {a[1]} mode={a[2]} L={a[3]} key={a[4]} cov={a[6]:.2f}\")\n        print(\"   \",a[5])\n"}
