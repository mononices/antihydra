from PIL import Image
import numpy as np
im = Image.open('the_signal.png').convert('RGB')
a = np.array(im)
bg = np.array([16,18,28])
mask = np.any(a!=bg, axis=2)
def show(y0,y1,x0,x1,sy=1,sx=1):
    for y in range(y0,y1,sy):
        line=''
        for x in range(x0,x1,sx):
            b = mask[y:y+sy, x:x+sx]
            line += '#' if b.mean()>0.5 else ('+' if b.mean()>0.1 else ' ')
        print(line)
print("=== top text ===")
show(40,52,35,105)
