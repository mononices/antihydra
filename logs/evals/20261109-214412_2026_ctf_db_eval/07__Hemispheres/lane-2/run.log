from PIL import Image
import numpy as np
im = Image.open('the_signal.png').convert('RGB')
a = np.array(im)
# Save a scaled-up version and also check row/col patterns
# Print some rows where non-background pixels exist
bg = np.array([16,18,28])
mask = np.any(a!=bg, axis=2)
ys, xs = np.where(mask)
print('non-bg bbox', xs.min(), xs.max(), ys.min(), ys.max(), 'count', mask.sum())
# ascii art downsample
h,w,_ = a.shape
step_y, step_x = 8, 4
for y in range(0,h,step_y):
    line=''
    for x in range(0,w,step_x):
        block = mask[y:y+step_y, x:x+step_x]
        line += '#' if block.mean()>0.2 else ('.' if block.any() else ' ')
    print(line)
EOF
