from PIL import Image
import numpy as np
im = Image.open('the_signal.png').convert('RGB')
a = np.array(im)
bg = np.array([16,18,28])
mask = np.any(a!=bg, axis=2)
ys, xs = np.where(mask)
# cluster rows with content
rows = np.where(mask.any(axis=1))[0]
# group contiguous
groups=[]
start=rows[0]; prev=rows[0]
for y in rows[1:]:
    if y-prev>3:
        groups.append((start,prev)); start=y
    prev=y
groups.append((start,prev))
print(groups)
for g in groups:
    sub = mask[g[0]:g[1]+1]
    xs2 = np.where(sub.any(axis=0))[0]
    print(g, 'x range', xs2.min(), xs2.max())
EOF
