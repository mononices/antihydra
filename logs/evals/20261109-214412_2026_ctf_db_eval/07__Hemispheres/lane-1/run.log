import zlib, struct
d = open('the_signal.png','rb').read()
# gather IDAT
off=8; idat=b''
while off < len(d):
    ln = struct.unpack('>I', d[off:off+4])[0]; typ=d[off+4:off+8]
    if typ==b'IDAT': idat += d[off+8:off+8+ln]
    off += 12+ln
raw = zlib.decompress(idat)
w,h=720,400
stride = w*3
# unfilter
import numpy as np
px = np.zeros((h, stride), dtype=np.int32)
pos=0
prev = np.zeros(stride, dtype=np.int32)
for y in range(h):
    f = raw[pos]; pos+=1
    line = np.frombuffer(raw[pos:pos+stride], dtype=np.uint8).astype(np.int32).copy(); pos+=stride
    if f==0: cur=line
    elif f==1:
        cur=line
        for i in range(3,stride): cur[i]=(cur[i]+cur[i-3])&0xff
    elif f==2:
        cur=(line+prev)&0xff
    elif f==3:
        cur=line
        for i in range(stride):
            a = cur[i-3] if i>=3 else 0
            cur[i]=(cur[i]+((a+prev[i])>>1))&0xff
    elif f==4:
        cur=line
        for i in range(stride):
            a = cur[i-3] if i>=3 else 0
            b = prev[i]
            c = prev[i-3] if i>=3 else 0
            p=a+b-c
            pa,pb,pc=abs(p-a),abs(p-b),abs(p-c)
            pr = a if (pa<=pb and pa<=pc) else (b if pb<=pc else c)
            cur[i]=(cur[i]+pr)&0xff
    px[y]=cur
    prev=cur
np.save('pixels.npy', px.astype(np.uint8))
print("decoded", px.shape)
# LSB planes
bits = np.unpackbits(px.astype(np.uint8).reshape(-1))
for k in range(8):
    plane = bits[k::8][:512]
    print(k, plane.tobytes()[:64].hex(), bytes(plane[:32].tobytes()))
EOF
