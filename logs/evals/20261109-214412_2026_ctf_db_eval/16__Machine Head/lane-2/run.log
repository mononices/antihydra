[04] create_file {"path": "/home/ctfplayer/workspace/solve.py", "content": "#!/usr/bin/env python3\nimport sys\n\nBIN = \"/home/ctfplayer/ctf_files/files/masterkey\"\ndata = open(BIN, \"rb\").read()\n\n# .rodata vaddr == file offset 0x2000 here\nSTART = 0x2040\n# find end: scan until opcode 0xe0\nprog = data[START:]\n# decode triples until 0xe0\ncode = []\ni = 0\nwhile True:\n    op = prog[i]\n    a = prog[i+1]\n    b = prog[i+2]\n    code.append((op, a, b))\n    if op == 0xe0:\n        break\n    i += 3\n\nprint(\"num instrs:\", len(code))\n\ndef run(flag, trace=False):\n    mem = bytearray(8)  # [rsp] qword zeroed\n    ok = 1\n    for idx, (op, a, b) in enumerate(code):\n        if op == 0x7a:      # xor mem[a], imm b\n            mem[a] ^= b\n        elif op == 0x24:    # add mem[a], imm b\n            mem[a] = (mem[a] + b) & 0xff\n        elif op == 0x1d:    # imul mem[a], imm b\n            mem[a] = (mem[a] * b) & 0xff\n        elif op == 0x91:    # mem[a] = flag[b]\n            mem[a] = flag[b]\n        elif op == 0x6d:    # mem[a] += mem[b]\n            mem[a] = (mem[a] + mem[b]) & 0xff\n        elif op == 0x4e:    # mem[a] ^= mem[b]\n            mem[a] ^= mem[b]\n        elif op == 0xa7:    # check mem[a] == b\n            if mem[a] != b:\n                ok = 0\n                if trace: print(\"check failed at instr\", idx, \"mem[%d]=%02x want %02x\" % (a, mem[a], b))\n        elif op == 0xb2:    # rol mem[a], b\n            v = mem[a]\n            b &= 7\n            mem[a] = ((v << b) | (v >> (8-b))) & 0xff if b else v\n        elif op == 0xe0:\n            pass\n        else:\n            raise Exception(\"bad op %02x at %d\" % (op, idx))\n    return ok, mem\n\n# print decoded program grouped\nfor idx, (op, a, b) in enumerate(code):\n    print(\"%3d: %02x %02x %02x\" % (idx, op, a, b))\n"}
