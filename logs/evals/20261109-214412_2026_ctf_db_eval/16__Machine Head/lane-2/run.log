[07] create_file {"content": "#!/usr/bin/env python3\nBIN = \"/home/ctfplayer/ctf_files/files/masterkey\"\ndata = open(BIN, \"rb\").read()\nprog = data[0x2040:]\n\ncode = []\ni = 0\nwhile True:\n    op, a, b = prog[i], prog[i+1], prog[i+2]\n    code.append((op, a, b))\n    if op == 0xe0:\n        break\n    i += 3\n\ndef rol(v, n):\n    n &= 7\n    return ((v << n) | (v >> (8-n))) & 0xff if n else v & 0xff\n\ndef emulate(flag, verbose=False):\n    mem = bytearray(8)\n    ok = True\n    for idx, (op, a, b) in enumerate(code):\n        if op == 0x7a:\n            mem[a] ^= b\n        elif op == 0x24:\n            mem[a] = (mem[a] + b) & 0xff\n        elif op == 0x1d:\n            mem[a] = (mem[a] * b) & 0xff\n        elif op == 0x91:\n            mem[a] = flag[b] if b < len(flag) else 0\n        elif op == 0x6d:\n            mem[a] = (mem[a] + mem[b]) & 0xff\n        elif op == 0x4e:\n            mem[a] ^= mem[b]\n        elif op == 0xa7:\n            if mem[a] != b:\n                if verbose:\n                    print(\"FAIL instr %d: mem[%d]=%02x want %02x\" % (idx, a, mem[a], b))\n                return False, mem\n        elif op == 0xb2:\n            mem[a] = rol(mem[a], b)\n        elif op == 0xe0:\n            pass\n        else:\n            raise Exception(\"bad op %02x at %d\" % (op, idx))\n    return True, mem\n\n# The program is straight-line: blocks of 12 instrs per char + final e0.\n# Each block: transforms flag[i] into mem[0], xors with mem[1], checks,\n# then updates mem[1] with flag[i].\n# Brute force each char in order by emulating incrementally.\n\nflag = []\n# Find block boundaries: instructions 0..11 are the preamble/mix for char 0,\n# then each subsequent char begins at instr 13 (91 00 i). Let's verify:\n# blocks start at 0, 13, 25, 37, ... i.e. first at 0, then +12 each.\nstarts = [0]\ns = 13\nwhile s < len(code)-1:\n    starts.append(s)\n    s += 12\nprint(\"blocks:\", len(starts), \"last start:\", starts[-1], \"total instrs:\", len(code))\n# verify each block starts with 91 00 <i>\nfor k, s in enumerate(starts):\n    assert code[s][0] == 0x91 and code[s][1] == 0 and code[s][2] == k, (k, s, code[s])\n\n# Emulate prefix for each candidate char and check the a7 in the block.\nmem = bytearray(8)\nn = 0\nfor k, s in enumerate(starts):\n    found = None\n    for c in range(256):\n        m = bytearray(mem)\n        ok = True\n        end = s + 12 if k+1 < len(starts) else len(code)\n        for idx in range(s, end):\n            op, a, b = code[idx]\n            if op == 0x7a: m[a] ^= b\n            elif op == 0x24: m[a] = (m[a] + b) & 0xff\n            elif op == 0x1d: m[a] = (m[a] * b) & 0xff\n            elif op == 0x91:\n                m[a] = c if b == k else 0\n            elif op == 0x6d: m[a] = (m[a] + m[b]) & 0xff\n            elif op == 0x4e: m[a] ^= m[b]\n            elif op == 0xa7:\n                if m[a] != b: ok = False; break\n            elif op == 0xb2: m[a] = rol(m[a], b)\n            elif op == 0xe0: pass\n        if ok:\n            if found is not None:\n                print(\"AMBIGUOUS at\", k, found, c)\n            found = c\n            mem = m\n    if found is None:\n        print(\"no solution at\", k)\n        break\n    flag.append(found)\n    print(k, found, chr(found) if 32 <= found < 127 else '?', mem.hex())\n\nprint(\"FLAG:\", bytes(flag))\nprint(bytes(flag).decode(errors='replace'))\n", "path": "/home/ctfplayer/workspace/solve2.py"}
[08] create_file {"content": "#!/usr/bin/env python3\nBIN = \"/home/ctfplayer/ctf_files/files/masterkey\"\ndata = open(BIN, \"rb\").read()\nprog = data[0x2040:]\n\ncode = []\ni = 0\nwhile True:\n    op, a, b = prog[i], prog[i+1], prog[i+2]\n    code.append((op, a, b))\n    if op == 0xe0:\n        break\n    i += 3\n\ndef rol(v, n):\n    n &= 7\n    return ((v << n) | (v >> (8-n))) & 0xff if n else v & 0xff\n\nNCH = 53\nstarts = [1 + 12*k for k in range(NCH)]\nassert code[-1][0] == 0xe0\nfor k, s in enumerate(starts):\n    assert code[s] == (0x91, 0x00, k), (k, s, code[s])\nprint(\"structure OK:\", len(code), \"instrs,\", NCH, \"chars\")\n\ndef step(m, op, a, b, c, k):\n    if op == 0x7a: m[a] ^= b\n    elif op == 0x24: m[a] = (m[a] + b) & 0xff\n    elif op == 0x1d: m[a] = (m[a] * b) & 0xff\n    elif op == 0x91: m[a] = c if b == k else 0\n    elif op == 0x6d: m[a] = (m[a] + m[b]) & 0xff\n    elif op == 0x4e: m[a] ^= m[b]\n    elif op == 0xa7:\n        if m[a] != b: return False\n    elif op == 0xb2: m[a] = rol(m[a], b)\n    elif op == 0xe0: pass\n    else: raise Exception(\"bad op %02x\" % op)\n    return True\n\n# preamble\nmem = bytearray(8)\nop, a, b = code[0]\nassert op == 0x7a\nmem[a] ^= b\n\nflag = []\nfor k, s in enumerate(starts):\n    found = None\n    for c in range(256):\n        m = bytearray(mem)\n        ok = True\n        for idx in range(s, s+12):\n            op, a, b = code[idx]\n            if not step(m, op, a, b, c, k):\n                ok = False\n                break\n        if ok:\n            if found is not None:\n                print(\"AMBIGUOUS at\", k, found, c)\n            found = c\n            mem = m\n    if found is None:\n        print(\"no solution at\", k)\n        break\n    flag.append(found)\n    print(k, found, chr(found) if 32 <= found < 127 else '?', mem.hex())\n\nprint(\"FLAG:\", bytes(flag))\nprint(bytes(flag).decode(errors='replace'))\n", "path": "/home/ctfplayer/workspace/solve3.py"}
