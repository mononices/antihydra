[09] create_file {"content": "#!/usr/bin/env python3\nprog = open('/home/ctfplayer/workspace/program.bin','rb').read()\ninsns = [(prog[i], prog[i+1], prog[i+2]) for i in range(0, len(prog), 3)]\n\ndef rol8(x, n):\n    n &= 7\n    if n == 0: return x & 0xff\n    return ((x << n) | (x >> (8 - n))) & 0xff\n\ndef emulate(flag, trace=False):\n    \"\"\"Run the VM. Returns (ok, checks).\"\"\"\n    mem = [0]*8   # byte-addressed [rsp+k]\n    r8 = 1        # ok flag\n    checks = []\n    for pc, (op, a, b) in enumerate(insns):\n        if op == 0x7a:    # xor imm into mem[a]\n            mem[a] ^= b\n        elif op == 0x91:  # load flag[b] into mem[a]\n            if b >= len(flag): return None, checks\n            mem[a] = flag[b]\n        elif op == 0x24:  # add imm\n            mem[a] = (mem[a] + b) & 0xff\n        elif op == 0xb2:  # rol imm\n            mem[a] = rol8(mem[a], b)\n        elif op == 0x1d:  # mul imm\n            mem[a] = (mem[a] * b) & 0xff\n        elif op == 0x4e:  # xor reg\n            mem[a] ^= mem[b]\n        elif op == 0x6d:  # add reg\n            mem[a] = (mem[a] + mem[b]) & 0xff\n        elif op == 0xa7:  # check mem[a] == b\n            checks.append((pc, mem[a], b))\n            if mem[a] != b:\n                r8 = 0\n        elif op == 0x9e:  # halt success\n            return bool(r8), checks\n        elif op == 0xe0:  # halt\n            return bool(r8), checks\n        else:\n            raise SystemExit(\"unknown op %02x at %d\" % (op, pc))\n    return bool(r8), checks\n\n# Reference check: run with a dummy flag but capture expected targets\n# Show structure of first 13 instructions per block\nfor i, ins in enumerate(insns[:30]):\n    print(i, ins, hex(ins[0]), hex(ins[1]), hex(ins[2]))", "path": "/home/ctfplayer/workspace/emu.py"}
