data = open('masterkey','rb').read()
# .rodata file offset == vaddr for this file (0x2000 region)
start = 0x2040
# find end: scan until 0xe0 opcode (halt) or non-opcode
ops = {0x7a:'xor_imm',0x24:'add_imm',0x1d:'mul_imm',0x4e:'xor_mem',0x6d:'add_mem',0x91:'load_input',0xb2:'rol_imm',0xa7:'check',0xe0:'halt_ok'}
i = start
prog = []
while i < len(data):
    op,a,b = data[i],data[i+1],data[i+2]
    if op not in ops:
        print(f"stop at file off {i:#x} (vaddr {i:#x}): unknown op {op:#x} a={a:#x} b={b:#x}")
        break
    prog.append((op,a,b))
    i += 3
    if op == 0xe0:
        print(f"halt at vaddr {i-3:#x}, total instrs {len(prog)}")
        break
print("n instr:", len(prog))
import collections
print(collections.Counter(op for op,_,_ in prog))
# memory index / input index ranges
print("max mem idx:", max(b if op in (0x7a,0x24,0x1d,0xb2,0xa7) else (b if op in (0x4e,0x6d,0x91) else 0) for op,a,b in prog))
print("ops used:", [hex(o) for o in sorted(set(op for op,_,_ in prog))])
