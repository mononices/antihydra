import math, collections
d=open('version-helper','rb').read()
def ent(b):
    c=collections.Counter(b); n=len(b)
    return -sum(v/n*math.log2(v/n) for v in c.values())
print('len',len(d),'entropy',ent(d))
print([round(ent(d[i:i+1024]),2) for i in range(0,len(d),4096)])
# repeated 8-byte blocks?
blocks=collections.Counter(d[i:i+8] for i in range(0,len(d)-8))
print('dup 8-byte blocks:', sum(1 for v in blocks.values() if v>1))
# index of coincidence for key lengths
for kl in range(1,41):
    tot=0; cnt=0
    for off in range(kl):
        s=d[off::kl]
        c=collections.Counter(s); n=len(s)
        if n>1:
            tot+= sum(v*(v-1) for v in c.values())/(n*(n-1)); cnt+=1
    print(kl, round(tot/cnt,5))
EOF
