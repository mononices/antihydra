import pefile
for f in ['vcheck/version.dll','vcheck/vcheck.exe']:
    pe = pefile.PE(f)
    data = open(f,'rb').read()
    print('====', f)
    for s in pe.sections:
        name = s.Name.rstrip(b'\0').decode()
        if name in ('.rdata','.data'):
            off = s.PointerToRawData; size = min(s.SizeOfRawData, s.Misc_VirtualSize)
            chunk = data[off:off+size]
            # print ascii strings >=5
            import re
            for m in re.finditer(rb'[ -~]{5,}', chunk):
                print(f'  {name}+{m.start():#x}: {m.group()[:120]}')
EOF
