import numpy as np, wave
w=wave.open('chal.wav'); n=w.getnframes(); sr=w.getframerate()
d=np.frombuffer(w.readframes(n),dtype=np.int16).reshape(-1,2)
L=d[:,0].astype(np.float64); R=d[:,1].astype(np.float64)
# cross-correlate specific windows: left tone region vs right tone region
def xc(a,b,maxlag=1000):
    a=a-a.mean(); b=b-b.mean()
    c=np.correlate(b,a,'full')
    lags=np.arange(-len(a)+1,len(a))
    m=np.abs(lags)<=maxlag
    i=np.argmax(np.abs(c[m]))
    return lags[m][i], c[m][i]/np.sqrt((a**2).sum()*(b**2).sum())
# tone at 3.5-4.3 in L, right channel same time
a=int(3.5*sr); b=int(4.3*sr)
print('L vs R same window', xc(L[a:b],R[a:b],500))
print('L vs R global', xc(L[::10],R[::10],100))
EOF
