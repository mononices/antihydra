def hps(seg):
    X=np.abs(np.fft.rfft(seg*np.hanning(len(seg))))
    # limit to 100-2000 Hz fundamentals
    best=None
    for f0 in np.arange(80,1200,0.5):
        s=0
        for k in range(1,9):
            fk=f0*k
            if fk>=sr/2: break
            i=int(round(fk/(sr/N)))
            s+=X[max(0,i-1):i+2].max()
        if best is None or s>best[1]: best=(f0,s)
    return best[0]
res=[]
for i in range(0,len(x)-N,H):
    t=i/sr
    seg=x[i:i+N]
    e=np.sqrt((seg**2).mean())
    if e>20:
        f0=hps(seg)
    else:
        f0=0
    res.append((t,e,f0))
# print compact: group by f0
prev=None
for t,e,f0 in res:
    key = round(f0) if e>20 else 0
    if key!=prev:
        print(f"{t:7.2f} e={e:8.1f} f0={f0:7.1f}")
        prev=key
