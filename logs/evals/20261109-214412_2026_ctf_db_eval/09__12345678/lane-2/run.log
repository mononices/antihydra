import numpy as np, wave
w=wave.open('chal.wav'); n=w.getnframes(); sr=w.getframerate()
d=np.frombuffer(w.readframes(n),dtype=np.int16).reshape(-1,2)
r=d[:,1].astype(np.float64)
# STFT, look for constant tones over time
N=4096; H=2048
frames=[]
for i in range(0,len(r)-N,H):
    seg=r[i:i+N]*np.hanning(N)
    frames.append(np.abs(np.fft.rfft(seg)))
F=np.array(frames)
f=np.fft.rfftfreq(N,1/sr)
# find frequencies that are consistently strong
med=np.median(F,axis=0)
idx=np.argsort(med)[-30:][::-1]
print([(round(f[i],1),round(med[i],0)) for i in idx])
# temporal variation of top freq
top=np.argmax(med)
print('top freq',f[top])
print(np.round(F[:,top]/1e3,1))
EOF
