import numpy as np, wave
w=wave.open('chal.wav'); n=w.getnframes(); sr=w.getframerate()
d=np.frombuffer(w.readframes(n),dtype=np.int16).reshape(-1,2)
L=d[:,0].astype(np.float64); R=d[:,1].astype(np.float64)
# cross-correlate R with L
from numpy.fft import rfft, irfft
N=len(L)
size=1<<int(np.ceil(np.log2(2*N)))
c=irfft(rfft(R,size)*np.conj(rfft(L,size)),size)
c=np.concatenate([c[-N+1:],c[:N]])
lags=np.arange(-N+1,N)
i=np.argmax(np.abs(c))
print('best lag',lags[i], 'value',c[i], 'norm', np.sqrt((L**2).sum()*(R**2).sum()))
# top peaks
idx=np.argsort(np.abs(c))[-10:][::-1]
print([(int(lags[j]), int(c[j])) for j in idx])
EOF
