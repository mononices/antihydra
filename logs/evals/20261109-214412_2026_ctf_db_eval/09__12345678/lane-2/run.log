L=d[:,0].astype(np.float64); R=d[:,1].astype(np.float64)
def ascii_spec(x, t0=0, t1=None, fmax=8000, cols=160, rows=40, N=2048):
    a=int(t0*sr); b=int(t1*sr) if t1 else len(x)
    seg=x[a:b]
    hop=max(1,(b-a)//cols)
    frames=[]
    for i in range(0,len(seg)-N,hop):
        frames.append(np.abs(np.fft.rfft(seg[i:i+N]*np.hanning(N))))
    F=np.array(frames).T
    f=np.fft.rfftfreq(N,1/sr)
    m=f<=fmax
    F=F[m]
    # downsample rows
    idx=np.linspace(0,F.shape[0]-1,rows).astype(int)
    Fd=F[idx]
    # log scale
    Fd=np.log1p(Fd)
    Fd=Fd/ (Fd.max()+1e-9)
    chars=' .:-=+*#%@'
    for r in range(rows-1,-1,-1):
        line=''.join(chars[min(9,int(v*9.999))] for v in Fd[r])
        print(f"{int(f[idx[r]]):5d} |{line}")
ascii_spec(L, 0, None, 8000, 160, 40)
