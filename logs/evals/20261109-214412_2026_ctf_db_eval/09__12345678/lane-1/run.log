import wave, numpy as np
w = wave.open('chal.wav')
data = np.frombuffer(w.readframes(w.getnframes()), dtype=np.int16).reshape(-1,2)
Lb, Rb = data[:,0], data[:,1]
# LSB analysis per channel
for name, ch in [('L',Lb),('R',Rb)]:
    bits = (ch & 1).astype(np.uint8)
    # pack bits into bytes (MSB first)
    nb = len(bits)//8*8
    b = np.packbits(bits[:nb])
    print(name, 'LSB bytes head:', b[:32].tobytes().hex())
    print(name, 'LSB as text:', b[:64].tobytes())
    # entropy check
    vals = np.bincount(b, minlength=256)
    p = vals[vals>0]/vals.sum()
    print(name, 'LSB byte entropy:', -(p*np.log2(p)).sum())
