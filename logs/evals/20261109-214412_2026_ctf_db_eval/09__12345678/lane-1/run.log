        if S[i]>S[i-1] and S[i]>S[i+1] and S[i]>thresh:
            # parabolic interp
            peaks.append((f[i], S[i]))
    peaks.sort(key=lambda x:-x[1])
    print(f"t={t0}s: " + ", ".join(f"{p[0]:.0f}Hz" for p in peaks[:8]))
