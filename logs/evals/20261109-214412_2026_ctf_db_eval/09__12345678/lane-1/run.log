import wave, numpy as np
w = wave.open('chal.wav')
data = np.frombuffer(w.readframes(w.getnframes()), dtype=np.int16).reshape(-1,2)
L = data[:,0].astype(float); sr=44100
# The 22.7-24.1s rapid burst train: extract tone per 110ms burst
import re
# boundaries: bursts at 22.69+n*0.12 up to 24.0
t0s = np.arange(22.69, 24.05, 0.12)
rows=[697,770,852,941]; cols=[1209,1336,1477,1633]
keys=[['1','2','3','A'],['4','5','6','B'],['7','8','9','C'],['*','0','#','D']]
for t0 in t0s:
    a, b = int(t0*sr), int((t0+0.11)*sr)
    seg = L[a:b]*np.hanning(b-a)
    S = np.abs(np.fft.rfft(seg)); f = np.fft.rfftfreq(len(seg),1/sr)
    # energy in each DTMF band
    def e(fr): 
        m=(f>fr-40)&(f<fr+40); return S[m].sum()
    r = max(rows, key=e); c = max(cols, key=e)
    tot = sum(e(x) for x in rows+cols)
    # also top raw peak
    i = S.argmax()
    ok = (e(r)+e(c))/tot if tot>0 else 0
    print(f"t={t0:6.2f} DTMF={keys[rows.index(r)][cols.index(c)]} conf={ok:.2f} toppeak={f[i]:.0f}Hz")
