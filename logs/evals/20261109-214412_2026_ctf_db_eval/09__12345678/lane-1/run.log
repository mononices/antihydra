import wave, numpy as np
w = wave.open('chal.wav')
data = np.frombuffer(w.readframes(w.getnframes()), dtype=np.int16).reshape(-1,2)
L, R = data[:,0].astype(float), data[:,1].astype(float)
sr=44100
rows=[697,770,852,941]; cols=[1209,1336,1477,1633]
keys=[['1','2','3','A'],['4','5','6','B'],['7','8','9','C'],['*','0','#','D']]
def dtmf_decode(ch, label):
    win = int(0.02*sr)
    out=[]
    for i in range(0, len(ch)-win, win):
        seg = ch[i:i+win]
        mags = {}
        for fr in rows+cols:
            t = np.arange(win)/sr
            mags[fr] = abs(np.dot(seg, np.exp(-2j*np.pi*fr*t)))/win
        rmax = max(mags[r] for r in rows); cmax = max(mags[c] for c in cols)
        rb = rows.index(max(rows, key=lambda r: mags[r])); cb = cols.index(max(cols, key=lambda c: mags[c]))
        tot = sum(mags.values())
        if rmax > tot*0.15 and cmax > tot*0.15 and rmax*2> 100:
            out.append(keys[rb][cb])
        else:
            out.append('.')
    # collapse runs
    s=''.join(out)
    res=''
    import re
    for m in re.finditer(r'(.)\1{3,}', s):
        res += m.group(1)
    return s[:200], res
for name,ch in [('L',L),('R',R)]:
    full, collapsed = dtmf_decode(ch, name)
    print(name, 'collapsed:', collapsed[:300])
EOF
