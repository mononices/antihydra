k+1]\n            dk = 0.5*(a-c)/(a-2*b+c)\n            fk = (k+dk)*sr/n\n        else:\n            fk = freqs[k]\n        tones.append((fk, spec[k]/spec.max()))\n    tones.sort(key=lambda x:-x[1])\n    print(f\"{st:.3f}-{en:.3f}: \" + \" \".join(f\"{fr:.1f}Hz({amp:.2f})\" for fr,amp in tones[:8]))\n"}
