import wave, numpy as np
from scipy import signal as sig
w = wave.open('chal.wav')
data = np.frombuffer(w.readframes(w.getnframes()), dtype=np.int16).reshape(-1,2)
L, R = data[:,0].astype(float), data[:,1].astype(float)
sr=44100
# coherence L vs R in quiet part
f, Cxy = sig.coherence(L[:20*sr], R[:20*sr], sr, nperseg=8192)
m = (f>14000)
print("coherence 14-22k mean:", Cxy[m].mean(), "max:", Cxy[m].max(), "at", f[m][Cxy[m].argmax()])
# check if R quiet part correlates with L at any delay
segL = L[:5*sr]; segR = R[:5*sr]
c = sig.correlate(segR, segL, mode='same')
print("xcorr max:", c.max(), "at lag idx", c.argmax(), "(center =", len(c)//2, ")")
# R quiet part autocorrelation - is there a repeating pattern?
c2 = sig.correlate(R[:10*sr], R[:10*sr], mode='same')
c2 /= c2.max()
peaks = sig.find_peaks(c2, height=0.1)[0]
print("R autocorr peaks (lag samples):", peaks[:20], "lags in ms:", ((peaks-len(c2)//2)/sr*1000).round(1)[:20])
EOF
