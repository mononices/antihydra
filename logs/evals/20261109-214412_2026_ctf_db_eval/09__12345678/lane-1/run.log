import wave, numpy as np
w = wave.open('chal.wav')
data = np.frombuffer(w.readframes(w.getnframes()), dtype=np.int16).reshape(-1,2)
L = data[:,0].astype(float); sr=44100
# bandpass 600-4000, envelope with 1ms resolution
from scipy.signal import butter, filtfilt
b,a = butter(4, [600/(sr/2), 4200/(sr/2)], btype='band')
x = filtfilt(b,a,L)
env = np.abs(x)
win = 44  # 1ms
env = np.convolve(env, np.ones(win)/win, 'same')
thr = env.max()*0.15
on = env > thr
# find bursts
bursts=[]
i=0
while i < len(on):
    if on[i]:
        j=i
        while j<len(on) and on[j]: j+=1
        if (j-i) > 3:  # >3ms
            bursts.append((i/sr, j/sr))
        i=j
    else: i+=1
print("num bursts:", len(bursts))
tones = [440*k for k in range(1,11)]
for t0,t1 in bursts:
    a,bb = int(t0*sr), int(t1*sr)
    seg = L[a:bb]
    if len(seg)<100: continue
    S = np.abs(np.fft.rfft(seg*np.hanning(len(seg)), 8192)); f=np.fft.rfftfreq(8192,1/sr)
    e = [S[(f>tt-60)&(f<tt+60)].sum() for tt in tones]
    mx = max(e)
    bits = ''.join('1' if v>mx*0.5 else '0' for v in e)
    print(f"t={t0:7.3f}-{t1:7.3f} ({(t1-t0)*1000:5.1f}ms) bits={bits}  " + " ".join(f"{v/mx:.2f}" for v in e))
