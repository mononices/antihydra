# burst train with exact start times: 22.6902 + n*0.02006
start = 22.6902
per = 0.02006
N = 1<<18
tones = [440*k for k in range(2,9)]
print("slot-by-slot decode (threshold 0.4 of max):")
for n in range(71):
    t0 = start + n*per
    a = int(t0*sr); b = a+int(0.018*sr)
    seg = L[a:b]
    if len(seg)<100: break
    S = np.abs(np.fft.rfft(seg*np.hanning(len(seg)),N)); f=np.fft.rfftfreq(N,1/sr)
    en = [S[(f>tt-50)&(f<tt+50)].sum() for tt in tones]
    mx = max(en)
    bits = ''.join('1' if v>mx*0.4 else '0' for v in en)
    # ascii attempts
    v_msb = int(bits,2); v_lsb = int(bits[::-1],2)
