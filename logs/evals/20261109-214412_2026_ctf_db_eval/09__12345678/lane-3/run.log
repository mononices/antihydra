import numpy as np, wave
w=wave.open('chal.wav'); n=w.getnframes()
d=np.frombuffer(w.readframes(n),dtype='<i2').reshape(-1,2)
mono = d[:,0].astype(np.float64)
sr=44100
frame=512
E=np.sqrt(np.convolve(mono**2, np.ones(frame)/frame, mode='same'))
# threshold
th = 100
active = E>th
# find segments
idx = np.flatnonzero(np.diff(active.astype(int))!=0)+1
segs=[]
prev=0
state=active[0]
for i in idx:
    segs.append((prev,i,state)); prev=i; state=active[i]
segs.append((prev,len(active),state))
# merge segments shorter than 0.01s
out=[]
for s,e,st in segs:
    dur=(e-s)/sr
    if out and st==out[-1][2] and (s-out[-1][1])/sr<0.02:
        out[-1]=(out[-1][0],e,st)
    else:
        out.append((s,e,st))
print("total segments", len(out))
for s,e,st in out[:80]:
    dur=(e-s)/sr
    if st:
        x=mono[s:e]
        # dominant frequency via FFT of whole segment window
        X=np.abs(np.fft.rfft(x*np.hanning(len(x))))
        f=np.fft.rfftfreq(len(x),1/sr)
        top=f[np.argsort(X)[-4:]][::-1]
        print(f"ON {s/sr:8.3f}-{e/sr:8.3f} dur={dur:6.3f} rms={E[s:e].max():8.0f} freqs={np.round(top,1)}")
    else:
        if dur>0.05:
            print(f"off {s/sr:8.3f}-{e/sr:8.3f} dur={dur:6.3f}")
EOF
