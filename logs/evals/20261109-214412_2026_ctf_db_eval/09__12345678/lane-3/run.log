    X=np.abs(np.fft.rfft(x[i:i+N]*np.hanning(N)))
    res.append(X[mask].max())
res=np.array(res)
print('ultrasonic energy stats', res.min(), res.max(), res.mean())
# find regions
thr=res.mean()*3
idx=np.where(res>thr)[0]
print('num hot frames',len(idx))
if len(idx):
    # group
    groups=[]
    cur=[idx[0]]
    for a,b in zip(idx, idx[1:]):
        if b-a<=2: cur.append(b)
        else: groups.append(cur); cur=[b]
    groups.append(cur)
    for g in groups[:40]:
        print(f'{g[0]*hop/sr:8.3f} - {g[-1]*hop/sr:8.3f} dur {(g[-1]-g[0])*hop/sr:6.3f} peak {res[g].max():.1f}')
