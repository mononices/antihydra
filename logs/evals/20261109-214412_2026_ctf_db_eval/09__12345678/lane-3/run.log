import numpy as np, soundfile as sf
x, sr = sf.read('chal.wav', dtype='int16')
x = x.astype(np.float64)
L, R = x[:,0], x[:,1]
print('sr', sr, 'len', len(L))
tail = L[int(22.6*sr):]
print('tail len', len(tail), 'rms', np.sqrt(np.mean(tail**2)))
# per 10ms: rms and peak freq via goertzel over a set of candidate freqs
win=int(0.01*sr)
hop=int(0.01*sr)
N=len(tail)//hop
frames=[tail[i*hop:(i+1)*hop] for i in range(N)]
def peakfreq(fr, fmin=200, fmax=3000):
    fr=fr-fr.mean()
    n=len(fr)
    X=np.abs(np.fft.rfft(fr*np.hanning(n), n=8192))
    f=np.fft.rfftfreq(8192, 1/sr)
    m=(f>=fmin)&(f<=fmax)
    Xm=X.copy(); Xm[~m]=0
    i=np.argmax(Xm)
    return f[i], Xm[i]
rows=[]
for i,fr in enumerate(frames):
    rms=np.sqrt(np.mean(fr**2))
    f_,v=peakfreq(fr)
    rows.append((i*hop/sr+22.6, rms, f_, v))
# print compact: rms and peak freq, every 10 ms for first 3 s of tail
for r in rows[:300]:
    print(f'{r[0]:7.3f} rms={r[1]:7.1f} pk={r[2]:7.1f} val={r[3]:8.0f}')
