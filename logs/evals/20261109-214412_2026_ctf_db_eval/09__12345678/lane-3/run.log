import numpy as np, wave
w=wave.open('chal.wav'); n=w.getnframes(); sr=44100
d=np.frombuffer(w.readframes(n),dtype='<i2').reshape(-1,2)
# Look for repeating structure / DTMF / morse
x=d[:,0].astype(np.float64)
# detect tones using goertzel over short windows
def g(x,f,sr):
    n=np.arange(len(x))
    return abs(np.sum(x*np.exp(-2j*np.pi*f*n/sr)))
# check DTMF frequencies
rows=[697,770,852,941]; cols=[1209,1336,1477,1633]
win=int(0.04*sr)
hop=win//2
res=[]
for i in range(0,len(x)-win,hop):
    w_=x[i:i+win]
    e=np.sqrt(np.mean(w_**2))
    if e<50: 
        res.append(('sil',0,0)); continue
    best=None
    for r in rows:
        for c in cols:
            v=g(w_,r,sr)+g(w_,c,sr)
            pass
    allf=rows+cols
    vals=[g(w_,f,sr) for f in allf]
    vals=np.array(vals)/ (np.sum(np.abs(w_))+1e-9)
    j=np.argmax(vals)
    res.append((allf[j], vals[j], e))
res2=[r for r in res if r[2]>50]
from collections import Counter
print(Counter([r[0] for r in res2]).most_common(20))
EOF
