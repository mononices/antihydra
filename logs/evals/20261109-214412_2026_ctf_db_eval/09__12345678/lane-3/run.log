import numpy as np, wave
w=wave.open('chal.wav'); n=w.getnframes(); sr=44100
d=np.frombuffer(w.readframes(n),dtype='<i2').reshape(-1,2)
x=d[:,0].astype(np.float64)
# detect active segments with 5ms envelope
win=int(0.005*sr)
E=np.sqrt(np.mean(x[:len(x)//win*win].reshape(-1,win)**2,axis=1))
thr=30
act=E>thr
idx=np.flatnonzero(np.diff(act.astype(int))!=0)+1
segs=[]; prev=0; st=act[0]
for i in idx:
    segs.append((prev,i,st)); prev=i; st=act[i]
segs.append((prev,len(act),st))
# merge gaps < 50 ms
merged=[]
for s,e,s_ in segs:
    if merged and (s-merged[-1][1])<0.05*sr/win and s_==False:
        pass
    merged.append([s,e,s_])
# simpler: keep on-segments with duration>20ms
on=[(s*win,e*win) for s,e,st in segs if st and (e-s)*win/sr>0.02]
print('num on segments', len(on))
notes=[]
for s,e in on:
    seg=x[s:e]
    # autocorrelation fundamental
    seg=seg-seg.mean()
    ac=np.correlate(seg,seg,'full')[len(seg)-1:]
    ac/=ac[0]+1e-9
    # find first peak after 0.002s
    lo=int(sr/2000); hi=min(len(ac), int(sr/60))
    if hi<=lo: continue
    pk=lo+np.argmax(ac[lo:hi])
    f0=sr/pk
    notes.append((s/sr,e/sr,f0,ac[pk]))
for t in notes:
    print(f'{t[0]:7.3f}-{t[1]:7.3f} dur={(t[1]-t[0])*1000:6.1f}ms f0={t[2]:8.1f} ac={t[3]:.3f}')
EOF
