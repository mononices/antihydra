data = open('session.bin','rb').read()
print("len", len(data))
# decode 0x81 XX as literal char, 0x80 XX as maybe escape
out = []
i = 0
cur = []
while i < len(data):
    b = data[i]
    if b == 0x81:
        cur.append(chr(data[i+1]) if 32 <= data[i+1] < 127 else f'<{data[i+1]:02x}>')
        i += 2
    elif b == 0x80:
        cur.append(f'[80 {data[i+1]:02x}]')
        i += 2
    else:
        cur.append(f'{b:02x}')
        i += 1
print(''.join(cur))
EOF
