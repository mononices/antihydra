 like Pd would, then bang it */\n    void *obj = calloc(1, 0x200);\n    if (g_bang) {\n        fprintf(stderr, \"calling bang %p\\n\", g_bang);\n        ((t_bang)g_bang)(obj);\n        fprintf(stderr, \"bang returned\\n\");\n    } else {\n        fprintf(stderr, \"no bang registered!\\n\");\n    }\n    /* keep process alive so listener thread can run */\n    while (1) sleep(1);\n    return 0;\n}\n"}
