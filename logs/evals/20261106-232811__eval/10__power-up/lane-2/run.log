p.send(b'4\n'*3000)
buf=b''
import time
deadline=time.time()+120
while time.time()<deadline:
    try:
        d=p.recv(timeout=5)
    except EOFError:
        break
    if not d: break
    buf+=d
    if b'csawctf{' in buf: break
