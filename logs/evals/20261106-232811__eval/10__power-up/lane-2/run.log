i=buf.find(b'full of energy')
print("win idx", i)
if b'csawctf{' in buf:
    j=buf.find(b'csawctf{'); k=buf.find(b'}',j)
    print("FLAG:", buf[j:k+1].decode())
else:
    print("tail:", buf[-300:])
EOF
