import base64, json, urllib.request

def send(d):
    req = urllib.request.Request('http://crypto.chal.csaw.io:21022/send',
        data=json.dumps({'data': d}).encode(), headers={'Content-Type':'application/json'})
    r = json.loads(urllib.request.urlopen(req, timeout=15).read())
    return base64.b64decode(r['ciphertext'])

def pt_len(d): return int.from_bytes(send(d)[3:5],'big')-16

# 'c' alone -> 60 (drop of 1 vs baseline 61 for other chars).
