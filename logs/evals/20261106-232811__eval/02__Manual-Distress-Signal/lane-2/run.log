import urllib.request, json, sys

URL = "http://ctf.local:21022"
def dec(s):
    return ''.join(chr((ord(c)-32+7)%95+32) if 32<=ord(c)<=126 else c for c in s)
def enc(s):
    return ''.join(chr((ord(c)-32-7)%95+32) if 32<=ord(c)<=126 else c for c in s)

def send(data, raw=False):
    body = json.dumps({"data": data}).encode()
    req = urllib.request.Request(URL+"/send", data=body, headers={"Content-Type":"application/json"})
    try:
        r = urllib.request.urlopen(req, timeout=10)
        st = r.status
        txt = r.read().decode('utf-8','replace')
    except urllib.error.HTTPError as e:
        st = e.code
        txt = e.read().decode('utf-8','replace')
    return st, (txt if raw else dec(txt))

if __name__ == "__main__":
    for d in sys.argv[1:]:
        print(repr(d), "->", send(d))
EOF
