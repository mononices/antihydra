import sys, string, json, time
sys.path.insert(0,'.')
from oracle import send, blen

ALPHA = string.ascii_lowercase + string.digits + "_{}-!@#$%^&*()+=[]:;,.<>?/|~`' " + string.ascii_uppercase + '"\\'

def probe(prefix):
    res = {}
    for ch in ALPHA:
        for attempt in range(3):
            try:
                res[ch] = blen(prefix + ch)
                break
            except Exception as e:
                time.sleep(0.3)
        else:
            res[ch] = None
    return res

def step(prefix):
    res = probe(prefix)
    vals = [v for v in res.values() if v is not None]
    mn = min(vals)
    cands = [ch for ch,v in res.items() if v == mn]
    return mn, cands, res

if __name__ == "__main__":
    prefix = sys.argv[1] if len(sys.argv)>1 else "csawctf{"
    maxlen = 100
    for i in range(maxlen):
        mn, cands, res = step(prefix)
        print(f"[{len(prefix)}] prefix={prefix!r} min={mn} cands={cands!r}", flush=True)
        if len(cands) == 1:
            prefix += cands[0]
            if cands[0] == '}':
                print("DONE:", prefix)
                break
        else:
            print("AMBIGUOUS, stopping. dist:", {k:v for k,v in sorted(res.items(), key=lambda kv: (kv[1] is None, kv[1]))[:10]})
            break
PY
