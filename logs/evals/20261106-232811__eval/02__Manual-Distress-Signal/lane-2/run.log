import urllib.request, json, base64, sys, time
URL="http://crypto.chal.csaw.io:21022/send"
def send(data, timeout=10):
    req = urllib.request.Request(URL, data=json.dumps({"data":data}).encode(), headers={"Content-Type":"application/json"})
    r = urllib.request.urlopen(req, timeout=timeout)
    return json.loads(r.read())
def blen(d):
    j = send(d)
    return len(base64.b64decode(j["ciphertext"]))-5
def dec7(s): return ''.join(chr(ord(c)+7) if ord(c)<0x7f else c for c in s)
EOF
