import socket
host,port='crypto.chal.csaw.io',21004
def probe(payload, timeout=15):
    s=socket.create_connection((host,port),timeout=timeout)
    s.settimeout(timeout)
    s.recv(4096)
    s.sendall(payload if isinstance(payload,bytes) else payload.encode())
    data=b''
    try:
        while True:
            chunk=s.recv(4096)
            if not chunk: break
            data+=chunk
    except Exception:
        pass
    s.close()
    return data
ct=open('ct.txt').read().strip()
b=bytes.fromhex(ct)
def mod(i, x):
    bb=bytearray(b); bb[i]^=x; return bb.hex().encode()
tests={
 'orig': ct.encode(),
 'flip_first': mod(0,1),
 'flip_15': mod(15,1),
 'flip_16': mod(16,1),
 'flip_last': mod(95,1),
 'flip_last2': mod(94,1),
 'trunc_lastbyte': b[:-1].hex().encode(),
 'trunc_lastblock': b[:-16].hex().encode(),
 'dup_append': (b+b[-16:]).hex().encode(),
 'quit': b'quit',
 'empty': b'',
 'oddhex': b'abc',
 'upper': ct.upper().encode(),
}
for k,p in tests.items():
    d=probe(p)
    print('==',k, d[:100])
