import socket, time, threading

D = open('/home/ctfplayer/ctf_files/dist/intercepted_transmission.txt').read().strip()

def reader(sock, label, out, stop):
    sock.settimeout(1.0)
    while not stop.is_set():
        try:
            d = sock.recv(4096)
            if d:
                out.append((label, d))
            else:
                out.append((label, b"<CLOSED>"))
                stop.set()
        except socket.timeout:
            continue
        except Exception as e:
            out.append((label, repr(e).encode()))
            stop.set()

stop = threading.Event()
outs = []
A = socket.create_connection(("crypto.chal.csaw.io", 21004), timeout=15)
B = socket.create_connection(("crypto.chal.csaw.io", 21004), timeout=15)
tA = threading.Thread(target=reader, args=(A, "A", outs, stop), daemon=True)
tB = threading.Thread(target=reader, args=(B, "B", outs, stop), daemon=True)
tA.start(); tB.start()
time.sleep(2)
A.sendall(D.encode() + b"\n")
time.sleep(8)
stop.set(); time.sleep(1)
for label, d in outs:
    print(label, ":", d[:300])
A.close(); B.close()
EOF
