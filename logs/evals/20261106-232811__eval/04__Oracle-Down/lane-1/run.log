         bytes(string.ascii_letters + string.digits + '_-{}!?. ', 'ascii'),
         bytes(string.digits + 'abcdefABCDEF', 'ascii')]
n = int.from_bytes(bytes(b), 'big')
found = []
for i, pool in enumerate(pools):
    chunk = 256 // len(pool)
    for off in range(0, 384 - 40, 8):
        v = 1
        for bytepos in range(44):
