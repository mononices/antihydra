            if not chunk: break
            data += chunk
        except socket.timeout:
            break
    s.sendall(payload + b'\n')
    t0 = time.time()
    while time.time() - t0 < wait:
        try:
            chunk = s.recv(4096)
            if not chunk:
                data += b'[CLOSED]'
                break
            data += chunk
        except socket.timeout:
            continue
    s.close()
    return data

def classify(r):
    if b'No connection found' in r: return 'VALID-NOCONN'
    if b'Invalid communication' in r: return 'INVALID'
