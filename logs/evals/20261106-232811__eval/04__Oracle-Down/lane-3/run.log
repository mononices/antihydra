import socket, time

HOST='crypto.chal.csaw.io'; PORT=21004

def talk(lines, maxwait=3.0):
    s = socket.create_connection((HOST, PORT), timeout=10)
    s.settimeout(0.3)
    buf = b''
    t0 = time.time()
    while time.time()-t0 < 2:
        try:
            c = s.recv(4096)
            if not c: break
            buf += c
            if buf.endswith(b'> '): break
        except socket.timeout: break
    for ln in lines:
        s.sendall(ln + b'\n')
        t1 = time.time()
        while time.time()-t1 < maxwait:
            try:
                c = s.recv(4096)
                if not c: break
                buf += c
                if buf.endswith(b'> '): break
            except socket.timeout: continue
    s.close()
    return buf

words = ['help','menu','status','connect','send','transmit','receive','listen','encrypt','decrypt','key','flag','admin','debug','info','?','quit','QUIT','Quit','exit','EXIT','list','show','get','read','write','open','close','ping','hello','test','version','whoami','ls','cat','1','0','true','false','yes','no','null','{}','[]','{"a":1}','a:b','host:port','127.0.0.1:1','localhost:1','connect 127.0.0.1:1','send 127.0.0.1:1','{"host":"127.0.0.1","port":1}']
for w in words:
    r = talk([w.encode()], maxwait=1.5)
    # strip banner
    idx = r.find(b'> ')
    out = r[idx+2:] if idx>=0 else r
    out = out.replace(b"This is Starline's secure comm-link. Please transfer valid communication here (or 'quit' to exit):\r\n> \r\n", b'')
    print(f'{w!r:40s} -> {out[:150]!r}')
EOF
