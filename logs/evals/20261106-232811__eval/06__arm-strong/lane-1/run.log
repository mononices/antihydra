for i in range(1,15):
    p = f"AAAA-%{i}$p-".encode()
    r = subprocess.run(["qemu-aarch64", BIN], input=p, capture_output=True, timeout=20)
    out = r.stdout.decode(errors='replace')
    line = out.split("\n")[1] if len(out.split("\n"))>1 else ""
    err = r.stderr.decode(errors='replace').strip()[:60]
    print(f"[{i}] {line} | err={err}")
EOF
