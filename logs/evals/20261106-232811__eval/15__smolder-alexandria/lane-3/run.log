import requests, urllib.parse
base='http://web.chal.csaw.io:3700/vault/search?q='
chars = list(";|&$`(){}[]<>*?!'\"\\ \t\n#~^%+,:=-_./@")
for c in chars:
    q = 'archive'+c+'id'
    try:
        r = requests.get(base+urllib.parse.quote(q, safe=''), timeout=15)
        body = r.text[:120].replace('\n','\\n')
        print(repr(c), r.status_code, body)
    except Exception as e:
        print(repr(c), 'ERR', e)
EOF
