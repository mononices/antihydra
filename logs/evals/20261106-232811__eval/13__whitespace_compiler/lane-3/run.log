import struct
f=open('whitespace_compiler','rb').read()
def v2o(v):
    # for vaddr in [0xb67000,0xe33700) rodata; [0x130fd40,0x1a48321) noptrdata
    if 0xb67000 <= v < 0xe33700: return v-0xb67000+0x767000
    if 0x12b96a0 <= v < 0x130f230: return v-0x12b96a0+0xeb86a0
    if 0x130fd40 <= v < 0x1a48421: return v-0x130fd40+0xf0ed40
    return None
ALPHA = set(b'\t\n\x0b\x0c\r \xc2\xa0')
hits=[]
for base,start,end in [(0,0xb67000,0xe33700),(0,0x12b96a0,0x130f230),(0,0x130fd40,0x1a48421)]:
    for off in range(start, end-16, 8):
        o=v2o(off)
        if o is None or o+16>len(f): continue
        p,l = struct.unpack('<QQ', f[o:o+16])
        if l<200 or l>200000: continue
        po=v2o(p)
        if po is None or po+l>len(f): continue
        data=f[po:po+l]
        s=set(data)
        if s <= ALPHA and len(s)>=2:
            hits.append((off,p,l,bytes(sorted(s))))
print(len(hits))
for h in hits[:20]: print(hex(h[0]), hex(h[1]), h[2], h[3])
EOF
