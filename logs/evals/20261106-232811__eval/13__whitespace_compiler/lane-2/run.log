import struct
data=open('whitespace_compiler','rb').read()
# compute vaddr->offset via program headers
phoff=int.from_bytes(data[0x20:0x28],'little'); phentsize=int.from_bytes(data[0x36:0x38],'little'); phnum=int.from_bytes(data[0x38:0x3a],'little')
segs=[]
for i in range(phnum):
    off=phoff+i*phentsize
    p_type,p_flags,p_offset,p_vaddr,p_paddr,p_filesz,p_memsz,p_align=struct.unpack_from('<IIQQQQQQ',data,off)
    segs.append((p_type,p_offset,p_vaddr,p_filesz))
def v2o(v):
    for t,o,va,fs in segs:
        if t==1 and va<=v<va+fs: return o+(v-va)
    return None
def rdstr(v,l):
    o=v2o(v)
    return data[o:o+l]
base=0xddc500
