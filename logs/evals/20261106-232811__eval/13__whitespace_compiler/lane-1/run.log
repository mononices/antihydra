[36] create_file {"content": "#!/usr/bin/env python3\n\"\"\"Interpreter for the custom whitespace VM found in dist/whitespace_compiler.\n\nSemantics (reversed from whitespace_compiler/vm.(*VM).Execute):\n  0x09 (TAB)   : push 0 onto the stack\n  0x0A (LF)    : push top of stack onto output rune list (copy)\n  0x0D (CR)    : XOR top of stack with popped value (a = stack.pop() ^ stack.top())\n  0x20 (SPACE) : increment top of stack\n  0xA0 (NBSP)  : pop (discard top of stack)\nEverything else is ignored.\n\"\"\"\nimport sys\n\ndef run(prog, verbose=False, maxsteps=10_000_000, progname='prog'):\n    stack = []\n    output = []\n    steps = 0\n    for ch in prog:\n        steps += 1\n        if steps > maxsteps:\n            raise RuntimeError('step limit exceeded')\n        c = ord(ch) if isinstance(ch, str) else ch\n        if c == 0x09:      # TAB: push 0\n            stack.append(0)\n        elif c == 0x0A:    # LF: emit (copy) top of stack to output\n            if not stack:\n                raise RuntimeError('stack underflow on LF')\n            output.append(stack[-1])\n        elif c == 0x0D:    # CR: xor top with popped value\n            if len(stack) < 2:\n                raise RuntimeError('stack underflow on CR')\n            top = stack[-1]\n            popped = stack.pop()\n            stack[-1] = top ^ popped\n        elif c == 0x20:    # SPACE: increment top\n            if not stack:\n                raise RuntimeError('stack underflow on SPACE')\n            stack[-1] += 1\n        elif c == 0xA0:    # NBSP: pop\n            if stack:\n                stack.pop()\n        # else: ignore\n    return output, stack\n\ndef to_text(output):\n    return ''.join(chr(v) for v in output)\n\nif __name__ == '__main__':\n    path = sys.argv[1]\n    raw = open(path, 'rb').read()\n    # replicate lexer.CleanAndParse: keep only 0x09,0x0A,0x0D,0x20,0xA0\n    prog = [b for b in raw if b in (0x09, 0x0A, 0x0D, 0x20, 0xA0)]\n    out, stack = run(prog)\n    print('output runes:', out)\n    print('output text :', repr(to_text(out)))\n    print('final stack :', stack)\n", "path": "/home/ctfplayer/workspace/ws_interp.py"}
